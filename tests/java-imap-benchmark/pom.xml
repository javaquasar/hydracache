<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.hydracache.test</groupId>
  <artifactId>java-imap-benchmark</artifactId>
  <version>0.75.0-SNAPSHOT</version>
  <name>HydraCache Java IMap benchmark</name>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url><distribution>repo</distribution></license></licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.14.1</junit.version>
    <project.build.outputTimestamp>2026-10-29T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration><argLine>@{argLine} -Xms16m -Xmx256m -XX:ActiveProcessorCount=2 -XX:ReservedCodeCacheSize=32m -XX:CompressedClassSpaceSize=64m -XX:ErrorFile=${project.build.directory}/jvm-%p.log</argLine><failIfNoTests>true</failIfNoTests></configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check-new-distributed-semantics</id>
            <phase>test</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <includes>
                    <include>io.hydracache.imap.semantic.BulkRetryLedger*</include>
                    <include>io.hydracache.imap.semantic.PartitionListenerProgress*</include>
                    <include>io.hydracache.imap.semantic.SeededSemanticScenario*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>io.hydracache.imap.semantic.BoundedIMapApi*</include>
                    <include>io.hydracache.imap.semantic.AsyncIMapFacade*</include>
                    <include>io.hydracache.imap.semantic.IMapCapabilityDescriptor*</include>
                    <include>io.hydracache.imap.semantic.UnifiedIMapService*</include>
                    <include>io.hydracache.imap.semantic.IMapDomainException*</include>
                    <include>io.hydracache.imap.semantic.IMapFlowPublisher*</include>
                    <include>io.hydracache.imap.semantic.UnifiedIMapAsyncFacade*</include>
                    <include>io.hydracache.imap.semantic.IMapTraceRunner*</include>
                    <include>io.hydracache.imap.semantic.IMapConcurrentRunner*</include>
                    <include>io.hydracache.imap.semantic.IMapMigrationDryRun*</include>
                    <include>io.hydracache.imap.semantic.UnifiedIMapServiceSemanticAdapter*</include>
                    <include>io.hydracache.imap.semantic.SemanticScenarioFingerprint*</include>
                    <include>io.hydracache.imap.semantic.IMapLocalHelper*</include>
                    <include>io.hydracache.imap.semantic.ExtendedSemantic*</include>
                    <include>io.hydracache.imap.semantic.ExtendedConcurrent*</include>
                    <include>io.hydracache.imap.semantic.DevelopmentBackendPort075*</include>
                    <include>io.hydracache.imap.semantic.UnifiedIMapExtendedSemanticAdapter*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
