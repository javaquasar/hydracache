# Release evidence hashes exact trace bytes; keep them stable across platforms.
crates/hydracache-cache-sim/traces/*.trace text eol=lf
*.sh text eol=lf
scripts/perf/*.py text eol=lf
docs/testing/hc2-compat/artifacts/**/*.pom text eol=lf
sdks/python/hydracache-client-hc2/src/hydracache_hc2_generated/** text eol=lf
.github/workflows/*.yml text eol=lf
docs/testing/memory/0.71/** text eol=lf
docs/testing/perf-scenarios/0.71/** text eol=lf
docs/testing/perf-host-profiles/memory-reference-071-v1.json text eol=lf
docs/testing/perf-artifacts/0.67.1/**/accepted-receipts/*.json text eol=lf

# Archived performance evidence is immutable. Do not normalize text files inside
# these byte-for-byte campaign copies on add or checkout.
docs/testing/perf-artifacts/0.71/** -text
docs/testing/perf-artifacts/0.71/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
docs/testing/perf-artifacts/0.71/**/*.zip filter=lfs diff=lfs merge=lfs -text
docs/testing/perf-artifacts/0.71/**/README.md text eol=lf
docs/testing/perf-artifacts/0.71/**/manifest.json text eol=lf
docs/testing/perf-artifacts/0.71/**/SHA256SUMS text eol=lf
docs/testing/perf-artifacts/0.71/**/verify.ps1 text eol=lf
docs/testing/perf-artifacts/0.71/**/redaction-receipt.json text eol=lf
docs/testing/perf-artifacts/0.73/** -text
docs/testing/perf-artifacts/0.73/**/*.zip -text
docs/testing/perf-artifacts/0.73/**/job-log.txt text eol=lf
docs/testing/perf-artifacts/0.73/**/README.md text eol=lf
docs/testing/perf-artifacts/0.73/**/manifest.json text eol=lf
docs/testing/perf-artifacts/0.73/**/SHA256SUMS text eol=lf
docs/testing/perf-artifacts/0.73/**/verify.ps1 text eol=lf

# D1 response-owner receipts hash raw bytes; never rewrite them on checkout.
docs/testing/performance/0.74/local-runs/response-owner-*/** -text
# Raw Windows runner receipts retain CRLF bytes; recognize CR as line ending.
docs/testing/performance/0.74/local-runs/get-owner-d3a-*/** -text whitespace=cr-at-eol
docs/testing/performance/0.74/local-runs/get-owner-b0-*/** -text whitespace=cr-at-eol
docs/testing/performance/0.74/local-runs/secure-memory-*/** -text whitespace=cr-at-eol
# Native test logs include a final blank line; preserve the receipt bytes.
docs/testing/performance/0.74/local-runs/secure-memory-*/**/*.log -text whitespace=cr-at-eol,-blank-at-eof
docs/testing/performance/0.74/local-runs/embedded-scheduled-*/** -text whitespace=cr-at-eol
docs/testing/performance/0.74/local-runs/embedded-scheduled-*/**/*.log -text whitespace=cr-at-eol,-blank-at-eof
# Timing instrumentation/semantic receipts also bind raw log bytes, not speedup.
docs/testing/performance/0.74/local-runs/timing-instrumentation-*/** -text whitespace=cr-at-eol
docs/testing/performance/0.74/local-runs/timing-instrumentation-*/**/*.log -text whitespace=cr-at-eol,-blank-at-eof
# Read-only host inventory receipts bind captured bytes, not admission.
scripts/perf/performance_rental_preflight_074.py text eol=lf
docs/testing/performance/0.74/local-runs/rental-preflight-*/** -text whitespace=cr-at-eol
