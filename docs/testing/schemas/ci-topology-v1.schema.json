{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydracache.dev/schemas/ci-topology-v1.schema.json",
  "title": "HydraCache CI topology contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "publication_producer", "workflows"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^0\\.71$"},
    "publication_producer": {"type": "string", "minLength": 1},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workflow"}
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "expires_after_release"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "expires_after_release": {"type": "string", "minLength": 1}
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "release-only", "scheduled-diagnostic", "manual-protected", "publish"],
      "properties": {
        "core": {"type": "array", "items": {"type": "string"}},
        "release-only": {"type": "array", "items": {"type": "string"}},
        "scheduled-diagnostic": {"type": "array", "items": {"type": "string"}},
        "manual-protected": {"type": "array", "items": {"type": "string"}},
        "publish": {"type": "array", "items": {"type": "string"}}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose", "triggers", "concurrency_markers", "classes"],
      "properties": {
        "path": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
        "purpose": {"type": "string", "minLength": 1},
        "triggers": {"type": "array", "items": {"type": "string"}},
        "concurrency_markers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "branch_tag_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "reason", "admission_job"],
          "properties": {
            "policy": {"enum": ["reuse-sha-core", "intentional-rerun"]},
            "reason": {"type": "string", "minLength": 1},
            "admission_job": {"type": "string", "minLength": 1}
          }
        },
        "classes": {"$ref": "#/$defs/classes"},
        "dependencies": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "timeout_exemptions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "artifact_identity_exemptions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/exception"}
        },
        "artifact_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_retention_days", "max_uploads_per_job", "max_bytes_per_artifact"],
          "properties": {
            "max_retention_days": {"type": "integer", "minimum": 1},
            "max_uploads_per_job": {"type": "integer", "minimum": 1},
            "max_bytes_per_artifact": {"type": "integer", "minimum": 1}
          }
        },
        "watchdog_jobs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
