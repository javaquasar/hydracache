{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydracache.dev/schemas/memory-statistics-v1.schema.json",
  "title": "HydraCache preregistered memory statistics contract",
  "type": "object",
  "required": ["schema_version", "release", "contract_id", "baseline_only_derivation", "candidate_may_amend", "pairing_order", "minimum_repetitions", "confidence_level", "multiple_comparison", "missing_row_policy", "bootstrap_method", "bootstrap_seed", "metric", "regression_budget"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"const": "0.71"},
    "baseline_only_derivation": {"const": true},
    "candidate_may_amend": {"const": false},
    "pairing_order": {"const": ["B1", "C", "C", "B1"]},
    "minimum_repetitions": {"type": "integer", "minimum": 5},
    "confidence_level": {"type": "number", "minimum": 0.95, "exclusiveMaximum": 1},
    "multiple_comparison": {"const": "holm-bonferroni"},
    "missing_row_policy": {"const": "fail-preflight-no-interpolation"},
    "bootstrap_method": {"const": "moving-block-v1"},
    "metric": {"type": "array", "minItems": 2},
    "regression_budget": {"type": "array", "minItems": 3}
  }
}
