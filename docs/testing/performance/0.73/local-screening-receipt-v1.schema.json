{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javaquasar.github.io/hydracache/schemas/local-screening-receipt-073-v1.json",
  "title": "HydraCache 0.73 local screening receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "profile_id",
    "attempt_id",
    "source_sha",
    "dirty_worktree",
    "binary_sha256",
    "scenario_sha256",
    "host_fingerprint_sha256",
    "raw_series_sha256",
    "environment_class",
    "promotable",
    "numerical_claim_eligible",
    "non_promotion_reason",
    "instrumentation_mode",
    "run_order_seed",
    "pair_index",
    "block_order",
    "candidate_role",
    "candidate_id",
    "started_at_utc",
    "result",
    "outcomes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "const": "0.73" },
    "profile_id": { "const": "local-screening-073-v1" },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty_worktree": { "type": "boolean" },
    "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "host_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raw_series_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment_class": { "const": "local_screening" },
    "promotable": { "const": false },
    "numerical_claim_eligible": { "const": false },
    "non_promotion_reason": { "type": "string", "minLength": 1 },
    "instrumentation_mode": { "enum": ["off", "production", "profile"] },
    "run_order_seed": { "type": "integer", "minimum": 0 },
    "pair_index": { "type": "integer", "minimum": 1 },
    "block_order": { "enum": ["baseline_candidate", "candidate_baseline"] },
    "candidate_role": { "enum": ["baseline", "candidate"] },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "result": { "enum": ["success", "failed", "invalidated"] },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "success", "rejected", "timeout", "late", "incomplete"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "success": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "late": { "type": "integer", "minimum": 0 },
        "incomplete": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
