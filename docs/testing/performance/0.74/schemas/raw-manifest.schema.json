{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydracache.dev/schemas/0.74/raw-manifest.schema.json",
  "title": "HydraCache 0.74 campaign raw file manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release", "campaign_id", "file_count", "total_bytes",
    "set_sha256", "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "const": "0.74" },
    "campaign_id": { "$ref": "#/$defs/hash" },
    "file_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "total_bytes": { "type": "integer", "minimum": 1, "maximum": 21474836480 },
    "set_sha256": { "$ref": "#/$defs/hash" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0, "maximum": 21474836480 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
