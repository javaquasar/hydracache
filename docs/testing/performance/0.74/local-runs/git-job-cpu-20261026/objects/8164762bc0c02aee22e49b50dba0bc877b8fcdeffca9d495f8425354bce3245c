"""Use the existing bounds, also inventory tracked/untracked CI Python sources."""
from pathlib import Path
import runpy
import subprocess

original = subprocess.check_output


def inventory(argv, *args, **kwargs):
    if argv[:3] == ['git', 'ls-files', '-z']:
        argv = [*argv[:3], '--cached', '--others', '--exclude-standard', *argv[3:], 'scripts/ci']
    return original(argv, *args, **kwargs)


subprocess.check_output = inventory
runpy.run_path(str(Path(__file__).with_name('run-source-step-20261024.py')), run_name='__main__')
