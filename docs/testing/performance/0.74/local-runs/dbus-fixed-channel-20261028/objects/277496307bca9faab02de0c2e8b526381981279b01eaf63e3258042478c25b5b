[package]
name = "dbus-probe-074"
version = "0.0.0"
edition = "2024"
rust-version = "1.88"
publish = false
license = "MIT"
[dependencies]
zbus = { path = "../zbus", default-features = false, features = ["tokio-multithread", "proxy", "p2p"] }
zruntime = { version = "=0.2.0", default-features = false }
tokio = { version = "=1.53.3", features = ["rt", "time"] }
serde = { version = "1", features = ["derive"] }

uuid = "=1.23.4"

serde_json = "=1.0.150"
thiserror = "=2.0.18"

rustix = { version = "=1.1.6", default-features = false, features = ["net", "process", "std"] }

libc = "=0.2.191"
tempfile = "=3.27.0"
