"""Seal source-only successor checks and independent fixed producer bodies."""
from pathlib import Path
import hashlib
import json
import subprocess

ROOT = Path(__file__).resolve().parent.parent
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members, objects = {}, {}


def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


labels = {
    'successor-view-first-red': 101, 'successor-view-candidate-first': 101,
    'successor-view-candidate-second': 0, 'successor-view-producer-first': 0,
    'successor-view-msrv-first': 0, 'successor-view-current-final': 0,
    'successor-view-msrv-artifact-first': 0,
    'successor-view-check-first': 0, 'successor-view-clippy-first': 0,
    'successor-view-fmt-first': 0, 'successor-view-doc-check-first': 0,
    'successor-view-contract-check-first': 0,
}
intents = {}
for label, expected in labels.items():
    folder = ROOT / 'target/source-continuation-20261024' / label
    intent = json.loads((folder / 'intent.json').read_bytes())
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == expected and result['outer_refusal'] is None
    assert result['head_unchanged'] and result['source_unchanged']
    assert result['source_after'] == intent['source']
    intents[label] = intent
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())

names = ['tools/source-successor-view-074/' + name for name in (
    'contract.rs', 'rules.json', 'generate.py', 'README.md')]
names += ['tools/authority-runtime-074/gate.rs',
          'tools/historical-input-view-074/contract.rs',
          'crates/xtask/tests/source_successor_view_074.rs']
for name in names:
    raw = (ROOT / name).read_bytes()
    assert sha(raw) == intents['successor-view-current-final']['source'][name]
    add('source-final/' + name, raw)
rules = json.loads((ROOT / 'tools/source-successor-view-074/rules.json').read_bytes())
assert sha((ROOT / 'tools/source-successor-view-074/rules.json').read_bytes()) == '61d3e1941cdae497600592a49af0487e4cf545573ba3f091add173110b560cda'
for row in rules['rows']:
    for rev_key, sha_key in [('revision', 'current_sha256'), ('previous_revision', 'previous_sha256')]:
        rev = row[rev_key]
        raw = subprocess.check_output(['git', '--no-replace-objects', 'show', rev + ':' + row['path']], cwd=ROOT)
        assert sha(raw.decode().replace('\r\n', '\n').encode()) == row[sha_key]
        add('producer/' + rev + '/' + row['path'], raw)
    history = subprocess.check_output(['git', '--no-replace-objects', 'log', '--format=%H %s',
        row['previous_revision'] + '..' + row['revision'], '--', row['path']], cwd=ROOT)
    add('history/' + row['path'] + '.raw', history)
    diff = subprocess.check_output(['git', '--no-replace-objects', 'diff', '--no-ext-diff', '--no-textconv',
        row['previous_revision'], row['revision'], '--', row['path']], cwd=ROOT)
    add('delta/' + row['path'] + '.raw', diff)
for name in ['run-fresh-reader-20261024.py', 'run-source-step-20261024.py',
             'retain-successor-view-20261026.py', 'run-successor-final-checks.py']:
    add('coordinator/' + name, (ROOT / 'target' / name).read_bytes())

out = ROOT / 'docs/testing/performance/0.74/local-runs/source-successor-view-20261026'
out.mkdir(exist_ok=True)
(out / 'objects').mkdir()
for digest, raw in objects.items():
    with (out / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-source-successor-evidence-v1', expected_exit=labels,
             members=members, source_only=True, artifact_tests_each=20,
             new_tests_each=5, inventory_tests_each=14,
             full_package_rerun=False, qualification=False, server=False)
with (out / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, indent=2, sort_keys=True)
    stream.write('\n')
print(dict(members=len(members), objects=len(objects), index_sha256=sha((out / 'index.json').read_bytes())))
