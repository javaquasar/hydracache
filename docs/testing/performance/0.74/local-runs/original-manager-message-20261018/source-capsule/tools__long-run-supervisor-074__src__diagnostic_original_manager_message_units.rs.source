use super::*;
use crate::systemd_unit::UnitProperty;
use std::os::fd::FromRawFd;
use zbus::zvariant::Value;
const MANAGER: &str = ":1.74";
const CLIENT: &str = ":1.75";
fn pipe() -> [File; 2] {
    let mut fds = [-1; 2];
    assert_eq!(unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC) }, 0);
    unsafe { [File::from_raw_fd(fds[0]), File::from_raw_fd(fds[1])] }
}
fn fixture() -> (TransientUnitSpec, [File; 2], [File; 2]) {
    (
        TransientUnitSpec {
            unit_name: "hc074-message-test.service".into(),
            properties: vec![(
                "Description",
                UnitProperty::Text("nonexecuted fixture".into()),
            )],
        },
        pipe(),
        pipe(),
    )
}
fn altered(input: &Inputs<'_>, kind: &str) -> Message {
    let body = input.legacy.body();
    let (name, mode, mut props, auxiliary): canonical::Body<'_> = body.deserialize().unwrap();
    if kind == "body" {
        props[0].1 = Value::from("different");
    }
    if kind == "swapped" {
        let n = props.len();
        props.swap(n - 1, n - 2);
    }
    let mut builder = Message::method_call(
        if kind == "path" {
            "/foreign"
        } else {
            canonical::PATH
        },
        if kind == "member" {
            "StopUnit"
        } else {
            canonical::METHOD
        },
    )
    .unwrap()
    .interface(canonical::INTERFACE)
    .unwrap()
    .destination(if kind == "well-known" {
        "org.freedesktop.systemd1"
    } else if kind == "manager" {
        ":1.99"
    } else {
        MANAGER
    })
    .unwrap()
    .serial(if kind == "serial" {
        NonZeroU32::new(input.legacy.primary_header().serial_num().get() + 1).unwrap()
    } else {
        input.legacy.primary_header().serial_num()
    });
    if kind == "sender" {
        builder = builder.sender(CLIENT).unwrap();
    }
    if kind == "flags" {
        builder = builder
            .with_flags(zbus::message::Flags::NoReplyExpected)
            .unwrap();
    }
    builder.build(&(name, mode, props, auxiliary)).unwrap()
}
impl Payload {
    pub(super) fn tamper(&mut self, input: &Inputs<'_>, kind: &str) {
        match kind {
            "missing" => self.message = None,
            "alias" => self.pinned.as_mut().unwrap().swap(0, 1),
            "client" => self.names.as_mut().unwrap().1 = ":1.99".into(),
            "flags-fd" => {
                assert_eq!(
                    unsafe { libc::fcntl(self.pinned.unwrap()[0], libc::F_SETFD, 0) },
                    0
                );
            }
            _ => self.message = Some(altered(input, kind)),
        }
    }
}
impl Payload {
    pub(in super::super) fn transfer_for_test(
        &self,
        frame: &OriginalEnrollmentFrame<'_, '_, '_, '_, '_, '_, '_, '_, '_, '_>,
    ) {
        let message = self.message.as_ref().unwrap();
        let transferred = frame.addressed_rights_roundtrip_for_test(message);
        let input = inputs(frame).unwrap();
        inspect(
            &input,
            &transferred,
            MANAGER,
            CLIENT,
            aliases(&transferred).unwrap(),
            self.serial.unwrap(),
        )
        .unwrap();
        assert_ne!(aliases(&transferred).unwrap(), self.pinned.unwrap());
        // This extra receiver owner must close before the original fence owner.
        drop(transferred);
    }
}
#[test]
fn original_addressed_message_keeps_exact_body_serial_and_distinct_original_writers() {
    let (spec, out, err) = fixture();
    let legacy = canonical::message(&spec, &out[1], &err[1]).unwrap();
    let input = Inputs {
        legacy: &legacy,
        spec,
        writers: [&out[1], &err[1]],
    };
    let message = encode(&legacy, MANAGER, CLIENT).unwrap();
    let pinned = aliases(&message).unwrap();
    for _ in 0..3 {
        inspect(
            &input,
            &message,
            MANAGER,
            CLIENT,
            pinned,
            legacy.primary_header().serial_num(),
        )
        .unwrap();
    }
    assert_ne!(pinned, aliases(&legacy).unwrap());
    assert_eq!(
        legacy.header().destination().unwrap().as_str(),
        "org.freedesktop.systemd1"
    );
}
#[test]
fn original_addressed_message_rejects_every_envelope_body_serial_and_alias_mutation() {
    let (spec, out, err) = fixture();
    let legacy = canonical::message(&spec, &out[1], &err[1]).unwrap();
    let input = Inputs {
        legacy: &legacy,
        spec,
        writers: [&out[1], &err[1]],
    };
    for kind in [
        "path",
        "member",
        "well-known",
        "manager",
        "serial",
        "sender",
        "flags",
        "body",
        "swapped",
    ] {
        let message = altered(&input, kind);
        assert!(
            inspect(
                &input,
                &message,
                MANAGER,
                CLIENT,
                aliases(&message).unwrap(),
                legacy.primary_header().serial_num()
            )
            .is_err(),
            "{kind}"
        );
    }
    for (manager, client) in [
        ("org.freedesktop.systemd1", CLIENT),
        (MANAGER, MANAGER),
        (MANAGER, "malformed"),
        (":1.0.3", CLIENT),
    ] {
        assert!(encode(&legacy, manager, client).is_err());
    }
}
#[test]
fn original_addressed_message_refuses_replaced_aliases_and_wrong_descriptor_flags() {
    let (spec, out, err) = fixture();
    let legacy = canonical::message(&spec, &out[1], &err[1]).unwrap();
    let input = Inputs {
        legacy: &legacy,
        spec,
        writers: [&out[1], &err[1]],
    };
    let message = encode(&legacy, MANAGER, CLIENT).unwrap();
    let pinned = aliases(&message).unwrap();
    let replacement = encode(&legacy, MANAGER, CLIENT).unwrap();
    assert!(inspect(
        &input,
        &replacement,
        MANAGER,
        CLIENT,
        pinned,
        legacy.primary_header().serial_num()
    )
    .is_err());
    assert_eq!(unsafe { libc::fcntl(pinned[0], libc::F_SETFD, 0) }, 0);
    assert!(inspect(
        &input,
        &message,
        MANAGER,
        CLIENT,
        pinned,
        legacy.primary_header().serial_num()
    )
    .is_err());
}
