use super::*;
#[test]
#[ignore = "manual attribution only of addressed round cost; never an acceptance cohort"]
fn original_addressed_round_cost_attribution() {
    let bundle = Bundle::new();
    with_original_at(true, None, |original, _paths, receiver, sender, model| {
        with_owned_empty_fence_for_test(|fence, root, leaf| {
            let mut frame = accepted(original, fence, leaf, receiver, sender, model)
                .prepare_original_outputs_for_test(|_| Ok(()))
                .unwrap()
                .prepare_enrollment_fixture_for_test(&bundle.path, 0, |_, _| {})
                .unwrap();
            let mut probe = frame.message_probe_for_test();
            let issued = frame.origins_for_test()[1];
            for pass in 0..2 {
                let before = frame.origins_for_test()[5];
                let ((result, checks), report) = trace::capture(|| {
                    trace::stage(Stage::Checks);
                    frame.message_round_for_test(
                        &mut probe,
                        if pass == 0 { "ok" } else { "delivery" },
                    )
                });
                let after = frame.origins_for_test()[5];
                let stats = report.stages[Stage::Checks as usize];
                println!("HC074-ADDRESSED-ATTRIBUTION pass={pass} issued={issued} before={before} after={after} age_before_ns={} age_after_ns={} wall_ns={} auth={} signatures={} channel_checks={checks} result={result:?} admission=false", before.saturating_sub(issued), after.saturating_sub(issued), stats.wall_ns, stats.authentication_calls, stats.signature_calls);
                assert_eq!(frame.origins_for_test()[1], issued);
                if result.is_err() {
                    let (retry, checks) = frame.message_round_for_test(&mut probe, "ok");
                    assert!(retry.is_err());
                    assert_eq!(checks, 0);
                    busy(root);
                    drop(probe);
                    drop(frame);
                    return;
                }
            }
            // A diagnostic healthy observation is not an acceptance retry. Explicit
            // test-only refusal closes this fixture's expected refused owner.
            frame.tamper_for_test("message");
            assert!(frame.message_round_for_test(&mut probe, "ok").0.is_err());
            println!("HC074-ADDRESSED-ATTRIBUTION historical_failure_not_reproduced=true forced_fixture_refusal=true admission=false");
            drop(probe);
            drop(frame);
        });
    });
}
#[test]
#[ignore = "manual nonroot original addressed message full-frame and owned rights controls"]
fn original_addressed_frame_controls() {
    for sample in 0..3 {
        let bundle = Bundle::new();
        with_original_at(false, None, |original, _paths, receiver, sender, model| {
            with_owned_empty_fence_for_test(|fence, root, leaf| {
                let mut frame = accepted(original, fence, leaf, receiver, sender, model)
                    .prepare_original_outputs_for_test(|_| Ok(()))
                    .unwrap()
                    .prepare_enrollment_fixture_for_test(&bundle.path, 0, |_, _| {})
                    .unwrap();
                let before = records(leaf);
                let origins = frame.origins_for_test();
                let mut probe = frame.message_probe_for_test();
                for pass in 0..2 {
                    let ((result, checks), report) = trace::capture(|| {
                        trace::stage(Stage::Checks);
                        frame.message_round_for_test(
                            &mut probe,
                            if pass == 0 { "ok" } else { "delivery" },
                        )
                    });
                    result.unwrap();
                    assert_eq!(checks, 4);
                    assert_eq!(
                        report.stages[Stage::Checks as usize].authentication_calls,
                        68
                    );
                    assert_eq!(report.stages[Stage::Checks as usize].signature_calls, 68);
                    assert!(report.first_time.is_none());
                    frame.assert_original_for_test();
                    assert_eq!(&frame.origins_for_test()[..4], &origins[..4]);
                    assert_eq!(
                        frame.offsets_for_test(),
                        [300_000_000_000, 60_000_000_000, 10_000_000_000]
                    );
                    assert_eq!(records(leaf), before);
                    println!("HC074-ADDRESSED-CONTROL sample={sample} pass={pass} frame_ipc=68 channel_checks=4 test_channel_only=true start=false");
                }
                busy(root);
                drop(probe);
                busy(root);
                drop(frame);
                assert_eq!(records(leaf), before);
                retained_context_refuses_for_test(root);
                println!("HC074-ADDRESSED-TRANSFER sample={sample} original_writers=2 rights=true same_process_socket=true system_bus_delivery=false start=false");
            });
        });
    }
}
#[test]
#[ignore = "manual nonroot original addressed message live refusals; no dispatch"]
fn original_addressed_frame_refusals() {
    for case in [
        "alias",
        "client",
        "flags-fd",
        "body",
        "swapped",
        "serial",
        "missing",
        "channel-before",
        "channel-after",
        "context-before",
        "trust",
        "collector-kill",
        "final-expiry",
    ] {
        let bundle = Bundle::new();
        with_original_at(true, None, |original, paths, receiver, sender, model| {
            with_owned_empty_fence_for_test(|fence, root, leaf| {
                let mut frame = accepted(original, fence, leaf, receiver, sender, model)
                    .prepare_original_outputs_for_test(|_| Ok(()))
                    .unwrap()
                    .prepare_enrollment_fixture_for_test(&bundle.path, 0, |_, _| {})
                    .unwrap();
                let before = records(leaf);
                let mut probe = frame.message_probe_for_test();
                match case {
                    "trust" => fs::write(&paths.worker, b"addressed trust drift").unwrap(),
                    "collector-kill" | "final-expiry" => frame.tamper_for_test(case),
                    _ => (),
                }
                let (result, _) = frame.message_round_for_test(&mut probe, case);
                let reason = format!("{:?}", result.unwrap_err());
                assert!(
                    !reason.contains("Time"),
                    "unexpected expiry {case}: {reason}"
                );
                let (retry, checks) = frame.message_round_for_test(&mut probe, "ok");
                assert!(retry.is_err());
                assert_eq!(checks, 0);
                busy(root);
                drop(probe);
                busy(root);
                drop(frame);
                assert_eq!(records(leaf), before);
                retained_context_refuses_for_test(root);
                println!(
                    "HC074-ADDRESSED-REFUSAL case={case} reason={reason} sticky=true start=false"
                );
            });
        });
    }
}
