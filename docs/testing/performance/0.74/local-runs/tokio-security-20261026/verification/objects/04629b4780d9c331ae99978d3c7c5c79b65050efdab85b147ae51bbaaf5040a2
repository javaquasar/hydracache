"""Retain first offline packet controls, without repeating native workloads."""
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/tokio-security-20261026'
OUT = PACKET/'verification'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def take(name, raw):
    digest = hashlib.sha256(raw).hexdigest()
    dest = OUT/'objects'/digest
    if not dest.exists():
        with dest.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw),sha256=digest)
names = ('Cargo.toml','Cargo.lock','deny.toml',
    'tools/long-run-supervisor-074/src/diagnostic_manager_channel.rs',
    'tools/long-run-supervisor-074/src/diagnostic_manager_alarm_tests.rs',
    'docs/testing/performance/0.74/qualification-manifest.toml')
before = {name:hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in names}
head = subprocess.check_output(['git','rev-parse','HEAD'], cwd=ROOT, text=True).strip()
for phase, name in (('integrity','verify.py'),('tamper','test_verify.py')):
    directory = OUT/phase
    directory.mkdir()
    argv = ['C:/Python313/python.exe', str(PACKET/name)]
    take(phase+'/intent.json', (json.dumps(dict(argv=argv,bound_seconds=60,source=before,source_commit=head))+'\n').encode())
    with (directory/'stdout.log').open('xb') as stdout, (directory/'stderr.log').open('xb') as stderr:
        result = subprocess.run(argv,cwd=ROOT,stdout=stdout,stderr=stderr,timeout=60,check=False)
    for path in directory.iterdir():
        take(phase+'/'+path.name,path.read_bytes())
    take(phase+'/result.json', (json.dumps(dict(exit=result.returncode,release_admitted=False))+'\n').encode())
    if result.returncode != 0:
        raise SystemExit('first offline control failed: '+phase)
if before != {name:hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in names}:
    raise ValueError('source changed')
if head != subprocess.check_output(['git','rev-parse','HEAD'], cwd=ROOT, text=True).strip():
    raise ValueError('HEAD changed')
for name in ('verify.py','test_verify.py'):
    take('verifier/'+name,(PACKET/name).read_bytes())
take('coordinator/'+Path(__file__).name,Path(__file__).read_bytes())
index = dict(schema='hc074-tokio-packet-controls-v1',
    parent_index_sha256=hashlib.sha256((PACKET/'index.json').read_bytes()).hexdigest(),
    source_unchanged=True,commit_unchanged=True,source_commit=head,
    policy_pass=False,full_package_pass=False,release_admitted=False,members=members)
raw = (json.dumps(index,sort_keys=True,indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(),members=len(members),release_admitted=False))
