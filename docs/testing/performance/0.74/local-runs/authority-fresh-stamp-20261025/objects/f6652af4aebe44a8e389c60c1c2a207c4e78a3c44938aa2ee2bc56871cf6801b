 assert refusal['age_ns']==10116757205==refusal['now_ns']-refusal['issued_ns'] and refusal['diagnostic_reason']=='expired'
 assert b'consuming_held_live.rs:267:59' in files['authority-stamp-holder-first/holder.stderr.log']
