from pathlib import Path
import copy,json,runpy,unittest
api=runpy.run_path(str(Path(__file__).with_name('audit-authority-stamp-20261025.py')))
files,frame=api['load']();sources={n:(api['ROOT']/'tools/long-run-supervisor-074/src'/n).read_bytes() for n in api['NAMES']};baseline=api['baseline_fixture']()
class SavedBytes(unittest.TestCase):
 def test_first_saved_results_pass_audit(self):
  self.assertFalse(api['review'](files,frame,sources,baseline)['admission'])
 def test_host_drift_refuses(self):
  changed=copy.deepcopy(frame);changed['synthetic_drift']=True
  with self.assertRaises(AssertionError):api['review'](files,changed,sources,baseline)
 def test_promoted_failure_changed_windows_and_weakened_lint_refuse(self):
  for name,field,value in [
   ('authority-stamp-holder-first/result.json','exit',0),
   ('authority-stamp-holder-first/consumed.json','original_windows',[300,60,11]),
   ('authority-stamp-build-first/clippy-command.json','argv',['cargo','clippy'])]:
   changed=dict(files);body=json.loads(changed[name]);body[field]=value;changed[name]=json.dumps(body).encode()
   with self.assertRaises(AssertionError):api['review'](changed,frame,sources,baseline)
 def test_process_reuse_and_source_change_refuse(self):
  changed=dict(files);changed['authority-stamp-installed-first/cohort-0-child.json']=changed['authority-stamp-screen-first/cohort-0-child.json']
  with self.assertRaises(AssertionError):api['review'](changed,frame,sources,baseline)
  source=dict(sources);source[api['NAMES'][0]]+=b'\n'
  with self.assertRaises(AssertionError):api['review'](files,frame,source,baseline)
if __name__=='__main__':unittest.main()
