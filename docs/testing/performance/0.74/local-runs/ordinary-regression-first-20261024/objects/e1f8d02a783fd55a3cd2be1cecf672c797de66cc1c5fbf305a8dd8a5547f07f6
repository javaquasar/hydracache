"""Retain failed complete ordinary regression and separate FD counterexamples."""
from pathlib import Path, PurePosixPath
import hashlib
import json
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
RAW = ROOT / 'target/status-field-scan-20261024'
DEST = ROOT / 'docs/testing/performance/0.74/local-runs/ordinary-regression-first-20261024'
def sha(raw):
    return hashlib.sha256(raw).hexdigest()
def read(path):
    return json.loads(path.read_bytes())
normal = RAW / 'normal-lib-194-first'
intent, result = read(normal / 'intent.json'), read(normal / 'result.json')
if result['exit'] != 101 or not result['source_unchanged'] or intent['source'] != result['source_after']:
    raise ValueError('Incomplete first failed ordinary lane')
for name, digest in intent['source'].items():
    part = PurePosixPath(name)
    if part.is_absolute() or '..' in part.parts or ':' in name or '\\' in name:
        raise ValueError('Unsafe source input')
    if sha((ROOT / name).read_bytes()) != digest:
        raise ValueError('Original checked input changed: ' + name)
stdout = (normal / 'stdout.log').read_text()
counts = 'test result: FAILED. 1465 passed; 16 failed; 141 ignored; 0 measured; 0 filtered out;'
if counts not in stdout or 'running 1622 tests' not in stdout:
    raise ValueError('First complete membership/counts changed')
failed = re.findall(r'^test (\S+) \.\.\. FAILED$', stdout, re.M)
if len(failed) != 16 or len(set(failed)) != 16:
    raise ValueError('Failed case membership changed')
fd = RAW / 'fd-oracle-first'
if read(fd / 'result.json')['Exit'] != 0 or 'Ran 2 tests' not in (fd / 'stderr.log').read_text():
    raise ValueError('Separate descriptor controls incomplete')
facts = dict(runtime_commit='81f4add2', ordinary=dict(selected=1622, passed=1465, failed=16,
    ignored=141, filtered=0, test_threads=4, exit=101, source_unchanged=True,
    failed_names=failed), descriptor_counterexamples=dict(passed=2,
    saved_failure_root_cause_proved=False, all_writer_retirement_proved=False),
    no_retry=True, original_owner_manual_run=False, ignored_manual_gates_run=False,
    admission=False, server=False, services=False, clock_changes=False, product_load=False,
    old_windows_seconds=[300, 60, 10], runtime_head=subprocess.check_output(
        ['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip())
DEST.mkdir()
(DEST / 'objects').mkdir()
files = {}
def retain(name, raw):
    digest = sha(raw)
    target = DEST / 'objects' / digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    elif target.read_bytes() != raw:
        raise ValueError('Content collision')
    files[name] = dict(bytes=len(raw), sha256=digest)
for folder in (normal, fd):
    for path in sorted(folder.iterdir()):
        if path.is_file():
            retain('observation/' + folder.name + '/' + path.name, path.read_bytes())
for name in ('target/status-field-scan-20261024/run-normal-lib-once.py',
             'tools/fd-oracle-control-074/test_controls.py',
             'docs/testing/performance/0.74/normal-regression-repair-plan-20261024.md'):
    retain('source/' + name, (ROOT / name).read_bytes())
retain('coordinator/' + Path(__file__).name, Path(__file__).read_bytes())
retain('analysis/facts.json', (json.dumps(facts, indent=2, sort_keys=True) + '\n').encode())
index = dict(schema='hc074-ordinary-regression-first-v1', files=files, facts=facts)
with (DEST / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, indent=2, sort_keys=True)
    stream.write('\n')
with (DEST / '.gitattributes').open('x', encoding='ascii', newline='\n') as stream:
    stream.write('index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for row in files.values():
    raw = (DEST / 'objects' / row['sha256']).read_bytes()
    if sha(raw) != row['sha256'] or len(raw) != row['bytes']:
        raise ValueError('Retained object failed verification')
print(dict(files=len(files), objects=len(list((DEST / 'objects').iterdir())),
           index_sha256=sha((DEST / 'index.json').read_bytes())))
