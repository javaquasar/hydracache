"""One bounded ordinary regression, not an admission or measurement attempt."""
import hashlib
import json
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parents[2]
OUT = Path(__file__).parent / 'normal-lib-194-first'
OUT.mkdir()
paths = [ROOT / 'Cargo.toml', ROOT / 'Cargo.lock']
paths += sorted(p for p in (ROOT / 'tools/long-run-supervisor-074').rglob('*') if p.is_file())
def snapshot():
    return {p.relative_to(ROOT).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
before = snapshot()
argv = ['wsl.exe', '-d', 'Ubuntu', '-u', 'artur', '--exec', '/usr/bin/timeout',
        '--signal=TERM', '--kill-after=5s', '1800s', '/usr/bin/env',
        'RUSTUP_AUTO_INSTALL=0', 'CARGO_INCREMENTAL=0',
        'CARGO_TARGET_DIR=/home/artur/.cache/hydracache-074-194-check',
        '/home/artur/.cargo/bin/cargo', '+1.94.0', 'test', '--offline', '--locked',
        '-p', 'hydracache-long-run-supervisor-074', '--release', '--all-features',
        '--lib', '--', '--test-threads=4']
intent = {'argv': argv, 'source': before, 'started_unix': time.time(),
          'ignored_tests_requested': False, 'server': False, 'services': False,
          'clock_mutation': False, 'original_owner_run': False, 'retry': False}
(OUT / 'intent.json').write_text(json.dumps(intent, indent=2), encoding='utf-8')
with (OUT / 'stdout.log').open('xb') as stdout, (OUT / 'stderr.log').open('xb') as stderr:
    result = subprocess.run(argv, cwd=ROOT, stdout=stdout, stderr=stderr, check=False)
after = snapshot()
receipt = {'exit': result.returncode, 'ended_unix': time.time(), 'source_unchanged': after == before,
           'source_after': after, 'admission': False, 'product_measurement': False}
(OUT / 'result.json').write_text(json.dumps(receipt, indent=2), encoding='utf-8')
print(json.dumps({k: v for k, v in receipt.items() if k != 'source_after'}), flush=True)
raise SystemExit(result.returncode or int(after != before))
