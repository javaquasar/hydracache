fn inspect_wrappers_keep_lazy_reads_optional_absence_and_wrong_type_refusal() {
    run(
        "inspect",
        vec![read("active", "running", 74, "/fixture")],
        || assert_eq!(inspect_unit(NAME).unwrap().main_pid, 74),
    );
    run(
        "optional-present",
        vec![read("active", "running", 74, "/fixture")],
