from pathlib import Path
import base64,hashlib,json,re
root=Path(__file__).resolve().parent.parent
phase=root/'target/authorized-server-session-20261025/capacity-unit-export'
packet=json.loads((phase/'stdout.log').read_bytes());out=phase/'raw';out.mkdir(exist_ok=False)
for name,item in packet['members'].items():
 assert Path(name).name==name
 raw=base64.b64decode(item['base64'],validate=True)
 assert len(raw)==item['bytes'] and hashlib.sha256(raw).hexdigest()==item['sha256']
 with (out/name).open('xb') as f:f.write(raw)
result=json.loads((out/'result.json').read_bytes())
assert (out/'preflight.json').read_bytes()==(out/'postflight.json').read_bytes()
assert packet['final_frame']==json.loads((out/'preflight.json').read_bytes())
log=(out/'unit.stdout.log').read_text()
counts=re.findall(r'test result: (ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored;',log)
assert len(counts)==1 and sum(map(int,counts[0][1:]))==1552
print(json.dumps(dict(result=result,verdict=counts,stdout_tail=log[-8000:],stderr_tail=(out/'unit.stderr.log').read_text()[-2400:]),indent=2))
