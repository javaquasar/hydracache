"""Bounded eight-CPU native compilation only, under the existing ordinary UID."""
from pathlib import Path
import hashlib,json,os,signal,subprocess,sys,time
base=Path('/tmp/hc074-server-gate-root-20261025.0k0xbdah')
root=base/'capacity-checks-first'
upload=Path('/tmp/hc074-server-gate-upload-20261025.pvdj0f6c')
image='6640e1b9b31ae7c87137b335be4f2665d729ea7b4324ee0e874bdbedc346c520'
raw=(base/'server-fault-worker-20261025.py').read_bytes()
assert hashlib.sha256(raw).hexdigest()=='af1e9926e1ad40bc49c1c225d79f5fffc788c715a7889743decea129ec4b17a3'
assert sys.argv[1]==image
scope={}
exec(compile(raw.decode().split('started=time.monotonic_ns()\n')[0],'<pinned-preflight>','exec'),scope)
preflight=scope['preflight']
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def publish(name,value):
 with (root/name).open('x') as f:json.dump(value,f,indent=2);f.flush();os.fsync(f.fileno())
def identity(pid):
 status=Path(f'/proc/{pid}/status').read_text().splitlines()
 return dict(pid=pid,start_ticks=scope['ticks'](pid),affinity=sorted(os.sched_getaffinity(pid)),
  status=[line for line in status if line.startswith(('Uid:','Gid:','Groups:','Cpus_allowed_list:'))])
def limited():
 os.sched_setaffinity(0,set(range(8)))
 os.setgroups([]);os.setgid(1000);os.setuid(1000)
publish('consumed.json',dict(cpu_budget=8,process_local_affinity_only=True,uid=1000,gid=1000,
 source_head='ee9692b672be093716822db13a22f5a63960f928',retry=False,
 schedule=['check-all-targets-all-features','clippy-all-targets-all-features'],outer_seconds_each=1200,
 release_install=False,product=False,qualification=False,admission=False))
result=dict(cases=[],first_refusal=None,postflight_refusal=None,source_unchanged=False,passed=False)
before=None
try:
 before=preflight();publish('preflight.json',before)
 assert (base/'capacity-profile-first/result.json').is_file()
 manifest=json.loads((base/'manifest.json').read_bytes())
 assert sha(base/'manifest.json')=='2a0f7c581a1e854ab71841efb71aaebee3de56d1c0357b54d55a41ae4011ea6d'
 source=upload/'source-v3';toolchain=upload/'toolchain-v3/bin'
 def verify():
  for name,item in manifest['members'].items():
   p=source/name
   assert p.is_file() and not p.is_symlink() and sha(p)==item['sha256'],name
 verify()
 assert sha(toolchain/'rustc')=='103b60e1b1339968c1d74202ea1d45686037e82c4ea3e0569de24b18a1e6836a'
 assert sha(toolchain/'cargo')=='77f14b761b02b47e6747473f556b3bc9f98f7e4525b7c3b8d74898ff816e4636'
 env=dict(PATH=str(toolchain)+':/usr/bin:/bin',HOME='/home/hydracache-admin',CARGO_HOME=str(upload/'cargo-home-v3'),
  CARGO_TARGET_DIR=str(upload/'build-target-v3'),CARGO_NET_OFFLINE='true',CARGO_INCREMENTAL='0',CARGO_BUILD_JOBS='8',
  RUSTC=str(toolchain/'rustc'),RUSTDOC=str(toolchain/'rustdoc'))
 for name,subcommand,suffix in [('check','check',[]),('clippy','clippy',['--','-D','warnings'])]:
  argv=[str(toolchain/'cargo'),subcommand,'--release','--offline','--locked','-p','hydracache-long-run-supervisor-074',
    '--all-targets','--all-features',*suffix]
  assert os.statvfs('/tmp').f_bavail*os.statvfs('/tmp').f_frsize>8*1024**3
  publish(name+'-command.json',dict(argv=argv,env=env,cwd=str(source),supervisor=identity(8839)))
  started=time.monotonic_ns()
  with (root/(name+'.stdout.log')).open('xb') as stdout,(root/(name+'.stderr.log')).open('xb') as stderr:
   child=subprocess.Popen(argv,cwd=source,env=env,stdout=stdout,stderr=stderr,preexec_fn=limited,start_new_session=True)
   publish(name+'-child.json',identity(child.pid))
   try:code=child.wait(timeout=1200)
   except subprocess.TimeoutExpired:
    os.killpg(child.pid,signal.SIGTERM)
    try:child.wait(timeout=5)
    except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait()
    raise RuntimeError('bounded compilation timeout; no retry')
  case=dict(name=name,exit=code,wall_ns=time.monotonic_ns()-started)
  result['cases'].append(case);publish(name+'-result.json',case)
  verify()
  # A compile/lint refusal is retained; each distinct check still gets its own first result.
 verify();result['source_unchanged']=True
 result['passed']=len(result['cases'])==2 and all(case['exit']==0 for case in result['cases'])
except BaseException as error:result['first_refusal']=f'{type(error).__name__}: {error}'
finally:
 try:
  after=preflight();assert before is not None and after==before;publish('postflight.json',after)
  publish('supervisor-after.json',identity(8839))
 except BaseException as error:result['postflight_refusal']=f'{type(error).__name__}: {error}';result['passed']=False
 publish('result.json',result)
