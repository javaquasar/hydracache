 verify()
 env=dict(PATH=str(addon)+':'+str(toolchain)+':/usr/bin:/bin',HOME='/home/hydracache-admin',CARGO_HOME=str(upload/'cargo-home-v3'),
  CARGO_TARGET_DIR=str(upload/'build-target-v3'),CARGO_NET_OFFLINE='true',CARGO_INCREMENTAL='0',CARGO_BUILD_JOBS='8',
  RUSTC=str(toolchain/'rustc'),RUSTDOC=str(toolchain/'rustdoc'))
 argv=[str(toolchain/'cargo'),'clippy','--release','--offline','--locked','-p','hydracache-long-run-supervisor-074',
  '--all-targets','--all-features','--','-D','warnings']
 result['cases'].append(execute('clippy',argv,env,source,1200));verify()
 target=upload/'origin-regression-first';target.mkdir(mode=0o700);os.chown(target,1000,1000)
 test=target/'libtest'
 with (base/'libtest').open('rb') as src,test.open('xb') as dst:shutil.copyfileobj(src,dst)
 os.chown(test,1000,1000);os.chmod(test,0o500);assert sha(test)==image
 scratch=target/'scratch';scratch.mkdir(mode=0o700);os.chown(scratch,1000,1000)
 env=dict(PATH='/usr/bin:/bin',TMPDIR=str(scratch))
 argv=[str(test),'diagnostic_kernel_admission::origin::','--nocapture','--test-threads=1']
 result['cases'].append(execute('origin',argv,env,source,180))
 log=(root/'origin.stdout.log').read_text()
 verdict=re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;',log)
 assert len(verdict)==1 and int(verdict[0][0])>0 and int(verdict[0][1])==0
 result['origin_counts']=dict(zip(('passed','failed','ignored'),map(int,verdict[0])))
 verify();result['source_unchanged']=True
