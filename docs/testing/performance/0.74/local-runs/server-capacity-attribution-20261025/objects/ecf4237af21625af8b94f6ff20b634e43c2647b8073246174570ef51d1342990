def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def publish(name,value):
 with (root/name).open('x') as f:json.dump(value,f,indent=2);f.flush();os.fsync(f.fileno())
def limited():
 os.sched_setaffinity(0,set(range(8)));os.setgroups([]);os.setgid(1000);os.setuid(1000)
def execute(name,argv,env,cwd,outer):
 publish(name+'-command.json',dict(argv=argv,env=env,cwd=str(cwd),uid=1000,gid=1000,cpu_budget=8,outer_seconds=outer))
 start=time.monotonic_ns()
 with (root/(name+'.stdout.log')).open('xb') as stdout,(root/(name+'.stderr.log')).open('xb') as stderr:
  child=subprocess.Popen(argv,cwd=cwd,env=env,stdout=stdout,stderr=stderr,preexec_fn=limited,start_new_session=True)
  publish(name+'-child.json',dict(pid=child.pid,start_ticks=scope['ticks'](child.pid),affinity=sorted(os.sched_getaffinity(child.pid))))
  try:code=child.wait(timeout=outer)
  except subprocess.TimeoutExpired:
   os.killpg(child.pid,signal.SIGTERM)
   try:child.wait(timeout=5)
   except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait()
   raise RuntimeError('bounded diagnostic timeout; no retry')
 result=dict(name=name,exit=code,wall_ns=time.monotonic_ns()-start);publish(name+'-result.json',result)
 return result
publish('consumed.json',dict(schedule=['clippy-with-exact-private-component','origin-ordinary-regressions'],
 previous_missing_component_refusal_preserved=True,retry=False,product=False,qualification=False,admission=False,
 original_windows=[300,60,10],live_check_frequency_unchanged=True))
result=dict(cases=[],first_refusal=None,postflight_refusal=None,source_unchanged=False,passed=False)
