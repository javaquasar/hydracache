 receipt=json.loads((base/'private-clippy-first/result.json').read_bytes());assert receipt['passed']
 assert receipt['archive_sha256']=='935529b0b9150084fa9cc1734c6598efe86b6e7d76f31ad3f8d4bb79ebf6031a'
 for name,digest in [('cargo-clippy','4ca38c6c514b6f5cb24bec4cc765672b174889583d3735549c02486f54484299'),
