     need(time.monotonic()<deadline,'original session origin exhausted');sources(review);capacity()
     label=f'{variant}-{compiler}-{action}';out=OUT/label;out.mkdir(exist_ok=False)
     argv,env,artifact,target,folder,_=command(label,review)
     write(out,'intent.json',dict(argv=argv,environment=env,prepare_sha256=sha((BASE/'prepare/result.json').read_bytes()),
      absolute_deadline=deadline,original_bound=1200,session_bound=1100,capacity_poll=5,retirement=5,artifact=artifact,retry=False))
     with (out/'stdout.log').open('xb') as stdout,(out/'stderr.log').open('xb') as stderr:
      child=subprocess.Popen(['/usr/bin/python3','-B',str(Path(__file__)),'worker',label,str(deadline)],
       stdin=subprocess.DEVNULL,stdout=stdout,stderr=stderr,start_new_session=True)
      code=child.wait(timeout=max(0,deadline-time.monotonic())+10)
     execution=json.loads((out/'execution.json').read_bytes());need(execution['retired'] and not execution['errors'],'kernel-owned phase retirement')
     sources(review);value=dict(exit=code,artifact=artifact,source_unchanged=True,release_admitted=False);raw=(out/'stdout.log').read_bytes()
