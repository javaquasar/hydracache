def need(value,why):
 if not value:raise ValueError(why)
def write(out,name,value):
 with (out/name).open('x',encoding='utf8',newline='\n') as f:f.write(json.dumps(value,indent=2,sort_keys=True)+'\n')
def load(path,name):
 spec=importlib.util.spec_from_file_location(name,path);module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);return module
def tree(folder):return {p.relative_to(folder).as_posix():sha(p.read_bytes()) for p in sorted(folder.rglob('*')) if p.is_file()}
def clocks():return {n:time.clock_gettime_ns(getattr(time,n)) for n in ('CLOCK_REALTIME','CLOCK_MONOTONIC','CLOCK_MONOTONIC_RAW','CLOCK_BOOTTIME')}
