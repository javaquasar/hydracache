    for entry in tar.getmembers():
     need(entry.name.startswith(item['name']+'/') and '..' not in Path(entry.name).parts,'archive member scope')
     if entry.isdir():continue
     need(entry.isfile(),'regular archive member');rel=entry.name[len(item['name'])+1:];dest=directory/rel
     dest.parent.mkdir(parents=True,exist_ok=True);raw=tar.extractfile(entry).read();dest.write_bytes(raw);members[rel]=sha(raw)
   write(directory,'.cargo-checksum.json',dict(package=item['sha256'],files=members));vendor[item['name']]=members
  write(OUT,'vendor-receipt.json',vendor);sources(review)
  run=load(CONTROL/'tools/dbus-linux-074/run.py','hc074_gnu_catalog')
  account=load(CONTROL/'tools/chitchat-mtu-review-074/accounting.py','hc074_gnu_account')
  for variant in ('baseline','fd'):
