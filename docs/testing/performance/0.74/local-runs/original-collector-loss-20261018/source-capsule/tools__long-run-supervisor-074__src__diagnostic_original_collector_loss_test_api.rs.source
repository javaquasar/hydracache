//! Only compiled into the opt-in fault-test image.
use super::*;
impl OriginalBarredCollector<'_, '_, '_, '_, '_, '_, '_, '_, '_, '_, '_> {
    pub(crate) fn deadline_for_test(&self) -> u64 {
        self.custody.deadline_for_test()
    }
}
impl BarredCollectorFailure<'_, '_, '_, '_, '_, '_, '_, '_, '_, '_, '_> {
    pub(crate) fn origins_for_test(&self) -> [u64; 6] {
        self.held.origins_for_test()
    }
    pub(crate) fn assert_lost_b_for_test(&self) {
        let kernel = self.held.collector.as_ref().unwrap();
        let mut poll = [
            libc::pollfd {
                fd: kernel.peer.as_raw_fd(),
                events: libc::POLLIN,
                revents: 0,
            },
            libc::pollfd {
                fd: kernel.pinned.as_raw_fd(),
                events: libc::POLLIN,
                revents: 0,
            },
        ];
        // Post-refusal observation fail-safe only, never authority time.
        assert_eq!(unsafe { libc::poll(poll.as_mut_ptr(), 2, 5000) }, 1);
        assert_eq!(poll[0].revents, libc::POLLIN);
        assert_eq!(poll[1].revents, 0);
        let mut byte = 0u8;
        assert_eq!(
            unsafe {
                libc::recv(
                    kernel.peer.as_raw_fd(),
                    (&mut byte as *mut u8).cast(),
                    1,
                    libc::MSG_TRUNC,
                )
            },
            1
        );
        // Same ordered endpoint sends B before E. A pre-read expiry leaves B
        // first and MUST fail this observation rather than count as lost B.
        assert_eq!(byte, b'E');
        kernel.alive().unwrap();
        self.held.custody.assert_original_for_test();
        let fds = self.held.custody.inventory.as_ref().unwrap().fds;
        assert_fds(kernel.pid, vec![fds[0], fds[1], kernel.child_peer]);
    }
}
