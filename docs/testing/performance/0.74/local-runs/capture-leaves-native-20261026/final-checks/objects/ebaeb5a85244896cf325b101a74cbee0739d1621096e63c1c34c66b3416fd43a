"""Retain final byte/model/check receipts without rewriting native evidence."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/capture-leaves-native-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for label in ('capture-leaves-native-integrity-first', 'capture-leaves-native-integrity-final',
              'capture-leaves-native-models', 'capture-leaves-native-syntax', 'capture-leaves-native-check',
              'capture-leaves-native-clippy', 'capture-leaves-native-doc', 'capture-leaves-native-contract'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('verify.py', 'test_verify.py'):
    take(name, PACKET/name)
take('first-test-verify.py', ROOT/'target/capture-leaves-native-first-test-verify.py')
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
take('collector.py', Path(__file__))
index = dict(schema='hc074-native-capture-leaves-final-checks-v1', checks=8,
    native_index_sha256='926f30f0eca6ae708b3706976f256a9ca52a3a5d7e9a9c447a8f45cec59a0855',
    new_native_attempts=0, new_workload_calls=0, overhead_accepted=False, package_pass=False, members=members)
raw = (json.dumps(index, indent=2, sort_keys=True)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
