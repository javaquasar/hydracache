"""Seal the sole leaf-enabled native attempt; no workload execution."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'docs/testing/performance/0.74/local-runs/capture-leaves-native-20261026'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for label in ('capture-leaves-native-build-first', 'capture-leaves-native-first'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for path in sorted((ROOT/'target/git-cpu-capture-leaves-20261026/first').iterdir()):
    assert path.is_file() and path.suffix in ('.json', '.log')
    take('native/'+path.name, path)
for folder in ('tools/xtask-package-attribution-074', 'tools/historical-blob-batch-074'):
    for path in sorted((ROOT/folder).glob('*.py')):
        take('source/'+folder+'/'+path.name, path)
for name in ('tools/xtask-package-attribution-074/capture-leaves-protocol.toml',
             'tools/xtask-package-attribution-074/capture-leaves-design.md',
             'tools/xtask-package-attribution-074/coordinator-frames-protocol.toml',
             'tools/xtask-package-attribution-074/git-cpu-overhead-protocol.toml',
             'scripts/ci/watchdog_windows_job.py', 'scripts/ci/run-with-heartbeat.py',
             'crates/xtask/tests/git_descendant_cpu_074.rs', 'tools/xtask-package-attribution-074/pipe_capture.rs',
             'docs/testing/performance/0.74/qualification-manifest.toml'):
    take('source/'+name, ROOT/name)
for name in ('run-ci-watchdog-step-20261026.py', 'run-source-step-20261024.py'):
    take('runners/'+name, ROOT/'target'/name)
take('collector.py', Path(__file__))
model = ROOT/'docs/testing/performance/0.74/local-runs/capture-leaves-20261026/index.json'
assert hashlib.sha256(model.read_bytes()).hexdigest() == 'd539ff2fa93959cf1fbb176e4994ebb5d7f83c5e141a0e1bae81f672f0cb2000'
take('baseline/model-index.json', model)
take('baseline/coordinator-native-verify.py', ROOT/'docs/testing/performance/0.74/local-runs/coordinator-native-20261026/verify.py')
index = dict(schema='hc074-native-capture-leaves-evidence-v1', source_commit='ef3d0cadd70e436b75be94e579a605447aaf7e2b',
    native_control_executed=True, native_attempts=1, workers=16, git_calls=64, retry=False,
    overhead_accepted=False, package_pass=False, server=False, members=members)
raw = (json.dumps(index, indent=2, sort_keys=True)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members), objects=len(list((OUT/'objects').iterdir()))))
