def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def tree(folder, prefix):
    return {prefix + '/' + p.relative_to(folder).as_posix(): p.read_bytes()
            for p in sorted(folder.rglob('*')) if p.is_file()}


def decode(files, name):
    return json.loads(files[name])


def metadata(raw):
    # Only decode terminal line endings; preserve prompts, NULs and raw archive bytes.
    text = raw.decode('utf-8').replace('\r\n', '\n').replace('\r', '\n')
    lines = text.splitlines()
    begin, end = 'HC074_ROOT_METADATA_BEGIN', 'HC074_ROOT_METADATA_END'
    if lines.count(begin) != 1 or lines.count(end) != 1 or lines.index(begin) >= lines.index(end):
        raise ValueError('Missing or ambiguous standalone metadata boundaries')
    body = '\n'.join(lines[lines.index(begin) + 1:lines.index(end)]) + '\n'
    for expected in ('BOOT ' + identity.BOOT, 'OBSERVER_PIDNS pid:[4026531836]',
                     'OBSERVER_TIMENS time:[4026531834]'):
        if body.splitlines().count(expected) != 1:
            raise ValueError('Unexpected root metadata context')
    chunks = re.split(r'^PROCESS (\d+)\n', body, flags=re.M)
    if [int(chunks[i]) for i in range(1, len(chunks), 2)] != [1, 210, 1157, 1126, 1112, 920]:
        raise ValueError('Different fixed process inventory')
    processes = []
    required = {'stat-before', 'stat-after', 'status', 'cgroup', 'exe', 'ns/pid',
                'ns/time', 'ns/mnt', 'executable-digest'}
    for i in range(1, len(chunks), 2):
        pid, block = int(chunks[i]), chunks[i + 1]
        values = identity.fields(block)
        if set(values) != required:
            raise ValueError('Missing or extra metadata fields')
        a, b = identity.stat(values['stat-before']), identity.stat(values['stat-after'])
        status = dict(line.split(':', 1) for line in values['status'].splitlines())
        sha, path = values['executable-digest'].split()
        chain = [int(x) for x in status['NSpid'].split()]
        if (a != b or a[0] != pid or int(status['Pid']) != pid or chain[0] != pid
                or status['Name'].strip() != a[1] or not re.fullmatch('[0-9a-f]{64}', sha)
                or path != f'/proc/{pid}/exe' or values['ns/time'] != 'time:[4026531834]'):
            raise ValueError('Inconsistent root process identity')
        processes.append({'pid': pid, 'comm': a[1], 'start_ticks': a[2],
                          'tgid': int(status['Tgid']), 'nspid': chain,
                          'nstgid': [int(x) for x in status['NStgid'].split()],
                          'uid': [int(x) for x in status['Uid'].split()],
                          'exe': values['exe'], 'sha256': sha, 'cgroup': values['cgroup'],
                          'pidns': values['ns/pid'], 'timens': values['ns/time'],
                          'mntns': values['ns/mnt']})
    return {'boot': identity.BOOT, 'observer_pidns': 'pid:[4026531836]',
            'observer_timens': 'time:[4026531834]', 'processes': processes}


def audit(files):
    intent = decode(files, 'request/intent.json')
    lookup = decode(files, 'journal/lookup/intent.json')
    assert intent['source_commit'] == lookup['git'] == COMMIT
    assert intent['first_unknown_outcome_sha256'] == FIRST
    assert intent['previous_known_refusal_index_sha256'] == REFUSAL
    assert intent['uac_requests_allowed'] == 1
    assert intent['original_windows'] == lookup['original_windows'] == [300, 60, 10]
    assert all(intent[k] is False for k in FLAGS)
    assert decode(files, 'request/uac-request-issued.json')['verb'] == 'RunAs'
    assert decode(files, 'request/controller.json')['exit'] == 0
    assert decode(files, 'request/uac-process-exit.json')['exit'] == 1
    assert decode(files, 'journal/launcher-result.json')['child_exit'] == 1
    assert decode(files, 'journal/launcher-started.json')['child_started'] is True
    assert 'request/uac-request-error.json' not in files
    failure = decode(files, 'journal/payload-failure.json')
    assert failure['phase'] == 'original-preflight-and-lookup'
    assert failure['error'] == "RuntimeError('First root lookup exit 124; preserve all files, no retry')"
    debug = decode(files, 'journal/lookup/debug-shell.json')
    assert debug['exit'] == 124 and debug['timeout_seconds'] == 30 and debug['retry'] is False
    assert debug['argv'] == [original.WSL, '--debug-shell']
    call = decode(files, 'journal/subprocess-04-intent.json')
    assert call == {'argv': debug['argv'], 'retry': False, 'timeout': 30}
    error = decode(files, 'journal/subprocess-04-error.json')
    assert 'TimeoutExpired' in error['error'] and error['retry'] is False
    assert error['outputs'] == []
    assert files['journal/lookup/stdin.sh'] == original.SCRIPT
    raw = files['journal/lookup/debug-shell.stdout.log']
    current = metadata(raw)
    assert files['journal/lookup/debug-shell.stderr.log'] == b''
    names = []
    for label in ('before', 'after'):
        receipt = decode(files, f'journal/lookup/running-{label}.json')
        assert receipt['exit'] == 0 and receipt['timeout_seconds'] == 15
        names.append(original.inventory(files[f'journal/lookup/running-{label}.stdout.log']))
    assert names[0] == names[1]
    assert decode(files, 'journal/subprocess-06-result.json')['exit'] == 0
    # Join saved earlier views only. No recollection or historical authentication.
    assert digest(files['input/writer-identity-index.json']) == original.IDENTITY_SHA
    old_index = json.loads(files['input/writer-identity-index.json'])
    entry = old_index['files']['observation/summary.json']
    old_raw = files['input/writer-identity-summary.json']
    assert digest(old_raw) == entry['sha256'] and len(old_raw) == entry['bytes']
    old = json.loads(old_raw)['current_timesyn']
    now = next(p for p in current['processes'] if p['pid'] == 1157)
    keys = ('comm', 'start_ticks', 'uid', 'exe', 'sha256', 'cgroup', 'pidns', 'timens', 'mntns')
    for previous, suffix in zip(old, (1, 2)):
        assert all(previous[k] == now[k] for k in keys)
        assert previous['nspid'] == now['nspid'][suffix:]
    return {'schema': 'hc074-root-uac-offline-outcome-v1', 'source_commit': COMMIT,
            'uac_requests': 1, 'elevated_powershell_pid': decode(files, 'request/uac-process-started.json')['pid'],
            'elevated_powershell_exit': 1,
            'python_pid': decode(files, 'journal/launcher-started.json')['child_pid'], 'python_exit': 1,
            'administrator_preflight_passed': True, 'debug_client_invocations': 1,
            'debug_client_timeout_seconds': 30, 'debug_client_receipt_exit': 124,
            'debug_client_exit_is_synthetic_timeout': True,
            'debug_stdout_bytes': len(raw), 'debug_stderr_bytes': 0,
            'guest_script_output_observed': True, 'guest_script_end_marker_observed': True,
            'guest_process_retirement_confirmed': None, 'root_metadata_observed': True,
            'client_exchange_success': False, 'original_collector_timeout_preserved': True,
            'current_root_metadata': current, 'current_timesyn_saved_views_match': True,
            'historical_writer_identity_authenticated': False,
            'running_distro_inventory': names[0], 'inventory_equal': True,
            'inventory_equality_proves_guest_retirement': False,
            'first_unknown_outcome_sha256': FIRST, 'previous_known_refusal_index_sha256': REFUSAL,
            'original_windows': [300, 60, 10], **FLAGS}


def snapshot():
    assert subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT).strip() == b''
    assert subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip() == COMMIT
    assert not original.OUT.exists()
    request = json.loads((REQUEST / 'intent.json').read_bytes())
    lookup = json.loads((JOURNAL / 'lookup/intent.json').read_bytes())
    proof = base.sources()
    assert lookup['sources'] == proof
    for name, sha in request['sources'].items():
        assert digest((ROOT / name).read_bytes()) == sha, name
    previous = ROOT / 'docs/testing/performance/0.74/local-runs/wsl-clock-root-namespace-logged-attempt-20261023/index.json'
    assert digest(previous.read_bytes()) == REFUSAL
    # The first offline audit reserved this directory then refused an incorrect
    # empty-stdout assumption. Preserve its exact source/error; do not touch live lanes.
    assert {p.name for p in OUT.iterdir()} == {'first-offline-audit-source.py', 'first-offline-audit-failure.json'}
    old_index = (identity.ARCHIVE / 'index.json').read_bytes()
    assert digest(old_index) == original.IDENTITY_SHA
    old_summary = json.loads(old_index)['files']['observation/summary.json']['sha256']
    inputs = tree(REQUEST, 'request') | tree(JOURNAL, 'journal') | {
        'input/writer-identity-index.json': old_index,
        'input/writer-identity-summary.json': (identity.ARCHIVE / 'objects' / old_summary).read_bytes()}
    base.put(OUT / 'analysis.json', audit(inputs))
    sources = set(proof) | set(request['sources'])
    source_inputs = {'source/' + name: (ROOT / name).read_bytes() for name in sorted(sources)}
    source_inputs['source/root-namespace-first-unconfirmed-20261023.json'] = (ROOT / 'docs/testing/performance/0.74/root-namespace-first-unconfirmed-20261023.json').read_bytes()
    # Snapshot before documentation changes; raw journals are never modified.
    snapshot_files = inputs | tree(PREP, 'controls') | source_inputs
    objects = OUT / 'snapshot'
    objects.mkdir()
    index = {}
    for name, raw in sorted(snapshot_files.items()):
        sha = digest(raw)
        path = objects / sha
        if not path.exists():
            with path.open('xb') as stream:
                stream.write(raw)
        index[name] = {'sha256': sha, 'bytes': len(raw)}
    base.put(OUT / 'snapshot.json', index)
    base.put(OUT / 'scope.json', {'source_commit': COMMIT, 'source_pins_unchanged': True,
             'qualification_manifest_sha256': base.FROZEN['qualification-manifest.toml'],
             'original_output_directory_absent': True, 'original_windows': [300, 60, 10], **FLAGS})
    print(json.dumps(audit(inputs), indent=2))


def seal():
    frozen = json.loads((OUT / 'snapshot.json').read_bytes())
    inputs = {}
    for name, entry in frozen.items():
        raw = (OUT / 'snapshot' / entry['sha256']).read_bytes()
        assert digest(raw) == entry['sha256'] and len(raw) == entry['bytes']
        inputs[name] = raw
    assert audit(inputs) == json.loads((OUT / 'analysis.json').read_bytes())
    groups = {
        'wsl-clock-root-namespace-uac-controls-20261023':
            {k: v for k, v in inputs.items() if k.startswith(('controls/', 'source/'))},
        'wsl-clock-root-namespace-uac-attempt-20261023':
            {k: v for k, v in inputs.items() if not k.startswith('controls/')},
    }
    outcomes = tree(OUT, 'outcome')
    outcomes = {k: v for k, v in outcomes.items() if not k.startswith('outcome/snapshot/')}
    for label, files in groups.items():
        if 'attempt' in label:
            files.update(outcomes)
        files['retention/retain-root-uac-20261023.py'] = Path(__file__).read_bytes()
        files['retention/test-root-uac-offline-20261023.py'] = (ROOT / 'target/test-root-uac-offline-20261023.py').read_bytes()
        archive = DEST / label
        archive.mkdir(exist_ok=False)
        objects = archive / 'objects'
        objects.mkdir()
        entries = {}
        for name, raw in sorted(files.items()):
            sha = digest(raw)
            if not (objects / sha).exists():
                with (objects / sha).open('xb') as stream:
                    stream.write(raw)
            entries[name] = {'sha256': sha, 'bytes': len(raw)}
        base.put(archive / 'index.json', {'schema': 'hc074-root-uac-evidence-v1',
                 'files': entries, 'source_commit': COMMIT,
                 'original_windows': [300, 60, 10], **FLAGS})
        print(json.dumps({'archive': label, 'files': len(entries),
                          'objects': len(list(objects.iterdir())),
                          'index_sha256': digest((archive / 'index.json').read_bytes())}))


if __name__ == '__main__':
    {'snapshot': snapshot, 'seal': seal}[sys.argv[1]]()
