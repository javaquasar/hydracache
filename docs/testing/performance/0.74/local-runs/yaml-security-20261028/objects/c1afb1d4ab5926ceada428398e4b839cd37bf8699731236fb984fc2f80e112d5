                  "text": "compare:\n  name: Exact I73 versus focused C73 integrated comparison\n  runs-on:\n  - self-hosted\n  - linux\n  - x64\n  - hydracache-release\n  environment: performance-reference-073\n  timeout-minutes: 180\n  env:\n    HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n    HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: '1'\n    HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n    HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n    HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n    I73_SHA: e757556d3a31d565f52a9561d6d4e555bb1cc373\n    C73_SHA: 7e3070894aa51af96cdcb3e350eff923a309e1fa\n    C73_TREE_OID: e2c438b9a248586a4f72d3eca3d1c5369fff440b\n    EVIDENCE_DIR: ${{ github.workspace }}/target/performance-evidence/0.73/integrated-host-${{ github.run_id }}-${{ github.run_attempt }}\n  steps:\n  - name: Check out reviewed tooling revision\n    uses: actions/checkout@v4\n    with:\n      fetch-depth: 0\n      ref: ${{ inputs.tooling_sha }}\n  - name: Resolve tooling identity and serialized lease\n    shell: bash\n    env:\n      INPUT_TOOLING_SHA: ${{ inputs.tooling_sha }}\n      INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n      INPUT_LEASE_END: ${{ inputs.lease_end }}\n    run: |\n      set -euo pipefail\n      [[ \"$INPUT_TOOLING_SHA\" =~ ^[0-9a-f]{40}$ ]]\n      test \"$(git rev-parse HEAD)\" = \"$INPUT_TOOLING_SHA\"\n      test -n \"$INPUT_LEASE_OWNER\"\n      date --date=\"$INPUT_LEASE_END\" >/dev/null\n      test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n      mkdir -p \"$EVIDENCE_DIR\"\n      {\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$INPUT_LEASE_OWNER\"\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$INPUT_LEASE_END\"\n        echo \"EXPECTED_TOOLING_SHA=$INPUT_TOOLING_SHA\"\n      } >> \"$GITHUB_ENV\"\n  - name: Expose and verify required host tools\n    shell: bash\n    run: |\n      set -euo pipefail\n      rust_bin=\"$HOME/.cargo/bin\"\n      test -x \"$rust_bin/cargo\"\n      test -x \"$rust_bin/rustc\"\n      echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n      cargo --version\n      rustc --version\n      python3 --version\n      taskset --version\n      pidstat -V\n  - name: Capture pre-campaign calibration\n    shell: bash\n    run: |\n      set -euo pipefail\n      cargo run -p xtask --locked -- perf-memory-preflight \\\n        --release 0.73 \\\n        --profile performance-reference-073-v1 \\\n        --output \"$EVIDENCE_DIR/preflight.json\"\n  - name: Materialize exact product trees and identical overlays\n    shell: bash\n    run: |\n      set -euo pipefail\n      run_key=\"${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}\"\n      i73_root=\"$RUNNER_TEMP/hydracache-i73-$run_key\"\n      c73_root=\"$RUNNER_TEMP/hydracache-c73-$run_key\"\n      i73_stage=\"$RUNNER_TEMP/integrated-i73-stage-$run_key\"\n      c73_stage=\"$RUNNER_TEMP/integrated-c73-stage-$run_key\"\n      git worktree prune\n      git worktree add --detach \"$i73_root\" \"$I73_SHA\"\n      git worktree add --detach \"$c73_root\" \"$C73_SHA\"\n      test \"$(git -C \"$i73_root\" rev-parse HEAD)\" = \"$I73_SHA\"\n      test \"$(git -C \"$c73_root\" rev-parse HEAD)\" = \"$C73_SHA\"\n      test \"$(git -C \"$c73_root\" rev-parse 'HEAD^{tree}')\" = \"$C73_TREE_OID\"\n      mkdir -p \"$i73_stage/tools\" \"$c73_stage/tools\"\n      cp -a tools/performance-integrated-073 \"$i73_stage/tools/\"\n      cp -a tools/performance-integrated-073 \"$c73_stage/tools/\"\n      ln -s \"$i73_root/Cargo.toml\" \"$i73_stage/Cargo.toml\"\n      ln -s \"$c73_root/Cargo.toml\" \"$c73_stage/Cargo.toml\"\n      ln -s \"$i73_root/crates\" \"$i73_stage/crates\"\n      ln -s \"$c73_root/crates\" \"$c73_stage/crates\"\n      {\n        echo \"I73_ROOT=$i73_root\"\n        echo \"C73_ROOT=$c73_root\"\n        echo \"I73_OVERLAY=$i73_stage/tools/performance-integrated-073\"\n        ech