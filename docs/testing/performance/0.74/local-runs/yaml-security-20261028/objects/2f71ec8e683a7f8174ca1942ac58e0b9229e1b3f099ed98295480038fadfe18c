ools_dir/redis-7.2.5/src/redis-benchmark\" >> \"$GITHUB_ENV\"\n- name: Pull pinned Redis image\n  run: |\n    docker pull \"$REDIS_IMAGE\"\n    docker image inspect \"$REDIS_IMAGE\" > target/redis-image-inspect.json\n- name: Run HydraCache and Redis memory campaign\n  shell: bash\n  run: scripts/perf/run-memory-leak-stage.sh \"$MEMORY_DIAGNOSTIC_OUTPUT\"\n- name: Publish report to job summary\n  if: always()\n  shell: bash\n  run: |\n    if [[ -f \"$MEMORY_DIAGNOSTIC_OUTPUT/report.md\" ]]; then\n      cat \"$MEMORY_DIAGNOSTIC_OUTPUT/report.md\" >> \"$GITHUB_STEP_SUMMARY\"\n    fi\n- name: Build compact diagnostic summary and non-gating trend\n  if: always()\n  env:\n    GH_TOKEN: ${{ github.token }}\n  shell: bash\n  run: |\n    set -euo pipefail\n    summary_dir=\"target/memory-summary\"\n    mkdir --parents \"$summary_dir\"\n    python3 scripts/perf/summarize-memory-diagnostic.py \\\n      --input \"$MEMORY_DIAGNOSTIC_OUTPUT\" \\\n      --output \"$summary_dir/summary.json\"\n    baseline_id=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/artifacts?per_page=100\" \\\n      --jq '.artifacts[] | select(.expired == false and (.name | startswith(\"memory-summary-\"))) | [.created_at, .id] | @tsv' \\\n      | sort --reverse | head -n 1 | cut -f 2)\"\n    if [[ -n \"$baseline_id\" ]]; then\n      baseline_dir=\"$RUNNER_TEMP/memory-summary-baseline\"\n      mkdir --parents \"$baseline_dir\"\n      gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$baseline_id/zip\" > \"$baseline_dir/artifact.zip\"\n      unzip -q \"$baseline_dir/artifact.zip\" -d \"$baseline_dir\"\n      baseline_summary=\"$(find \"$baseline_dir\" -name summary.json -type f -print -quit)\"\n      python3 scripts/perf/compare-memory-summaries.py \\\n        --baseline \"$baseline_summary\" \\\n        --candidate \"$summary_dir/summary.json\" \\\n        --output \"$summary_dir/trend.json\"\n    else\n      python3 scripts/perf/compare-memory-summaries.py \\\n        --candidate \"$summary_dir/summary.json\" \\\n        --output \"$summary_dir/trend.json\"\n    fi\n- name: Upload raw memory evidence\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: memory-diagnostic-${{ github.run_id }}-${{ github.run_attempt }}\n    path: |\n      target/memory-diagnostic/github-hosted\n      target/redis-image-inspect.json\n    if-no-files-found: error\n    retention-days: 30\n- name: Upload durable compact memory history\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: memory-summary-${{ github.run_id }}-${{ github.run_attempt }}\n    path: target/memory-summary\n    if-no-files-found: error\n    retention-days: 90\n"
