n      HYDRACACHE_OPERATOR_IDENTITY: release-066-ci\n    run: |\n      operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n      operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n      printf '%s\\n' \"$BASHPID\" > \"$operator_pid_file\"\n      exec \"$HYDRACACHE_OPERATOR_BINARY\" >> \"$operator_log\" 2>&1\n  - name: Verify current operator controller\n    shell: bash\n    run: |\n      operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n      operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n      operator_nonce=\"$HYDRACACHE_OPERATOR_EVIDENCE_NONCE\"\n      operator_ready=0\n      for _ in $(seq 1 30); do\n        if [[ -s \"$operator_pid_file\" ]]; then\n          operator_pid=\"$(cat \"$operator_pid_file\")\"\n        else\n          sleep 1\n          continue\n        fi\n        if kill -0 \"$operator_pid\" \\\n          && grep -Fq \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"; then\n          operator_ready=1\n          break\n        fi\n        sleep 1\n      done\n      kill -0 \"$operator_pid\"\n      test \"$operator_ready\" = 1\n      grep -F \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"\n  - name: Run 0.66 operator-kind release proof\n    run: cargo run -p xtask --locked -- evidence-run --release 0.66 --gate env.hydracache-operator-kind-066\n  - name: Stop current operator controller\n    cancel: operator-controller\n  - name: Capture operator-kind diagnostics\n    if: always()\n    continue-on-error: true\n    run: |\n      kubectl get pods,statefulsets,services,hydracacheclusters -A -o wide > target/test-evidence/0.66/operator-kind-resources-post.txt || true\n      kubectl get events -A --sort-by=.lastTimestamp > target/test-evidence/0.66/operator-kind-events-post.txt || true\n      kubectl logs -n default \\\n        --selector 'app.kubernetes.io/name=hydracache,app.kubernetes.io/instance=hydracache-066,app.kubernetes.io/component=server' \\\n        --all-containers=true \\\n        --prefix=true \\\n        --tail=-1 \\\n        > target/test-evidence/0.66/operator-kind-pod-logs-post.txt || true\n  - name: Upload 0.66 operator-kind evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: operator-kind-066-${{ github.sha }}\n      path: |\n        target/test-evidence/0.66/**\n        target/release-evidence/receipts/**\n      if-no-files-found: error\nperformance-067-shared-tripwire:\n  name: 0.67 Shared Performance Tripwire\n  runs-on: ubuntu-latest\n  timeout-minutes: 45\n  if: github.event_name == 'pull_request' || (github.event_name == 'push' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master')) || github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && inputs.run_nightly && !inputs.run_reference_performance && inputs.candidate_release == '0.67')\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install pinned Rust 1.94.0\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Validate shared-runner tripwire policy\n    run: cargo test -p xtask --test perf_budget_067 --locked ci_shared_is_a_rolling_only_non_enforcing_tripwire\n  - name: Evaluate non-ship shared-runner tripwire\n    run: cargo run -p xtask --locked -- perf-budget-check --release 0.67 --profile ci-shared\n  - name: Upload 0.67 shared tripwire\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: performance-shared-tripwire-067-${{ github.sha }}\n      path: target/test-evidence/0.67/perf-budget-verdict.json\n      if-no-files-found: error\nperformance-ci-instruction-v1:\n  name: CI Instruction Work Tripwire\n  runs-on: ubuntu-24.04\n  timeout-minutes: 45\n  if: github.event_name == 'pull_request' || (github.event_name == 'push' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master'))\n  steps:\n  - name: Checkout paired history\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n      ref: ${{ github.event.pull_request.head.sha || github.sha }}\n  - name: Install pinned Rust 1.94.0\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Install Callgrind\n    timeout-minutes: 10\n    run: |\n      sudo apt-get update\n      sudo apt-get install --yes --no-install-recommends valgrind\n      cargo install --locked gungraun-runner --version 0.19.4\n      gungraun-runner --version\n  - name: Resolve exact comparison commits\n    id: commits\n    env:\n      PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n      PUSH_BEFORE_SHA: ${{ github.event.before }}\n    run: |\n      base_sha=\"${PR_BASE_SHA:-${PUSH_BEFORE_SHA:-}}\"\n      if ! git cat-file -e \"${base_sha}^{commit}\" 2>/dev/null; then\n        base_sha=\"$(git rev-parse HEAD^)\"\n      fi\n      echo \"base_sha=$base_sha\" >>\"$GITHUB_OUTPUT\"\n      echo \"head_sha=$(git rev-parse HEAD)\" >>\"$GITHUB_OUTPUT\"\n  - name: Validate non-ship instruction profile\n    run: cargo test -p xtask --test perf_ci_instruction --locked\n  - name: Run paired base/head instruction tripwire\n    run: |\n      scripts/perf/run-ci-instruction-pair.sh \\\n        --base '${{ steps.commits.outputs.base_sha }}' \\\n        --head '${{ steps.commits.outputs.head_sha }}' \\\n        --output target/test-evidence/ci-instruction-v1\n  - name: Upload instruction profiles and receipt\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: ci-instruction-v1-${{ steps.commits.outputs.head_sha }}\n      path: target/test-evidence/ci-instruction-v1/**\n      if-no-files-found: error\nrelease-067-performance:\n  name: 0.67 Self-hosted Reference Evidence\n  runs-on:\n  - self-hosted\n  - linux\n  - x64\n  - hydracache-perf-v1\n  timeout-minutes: 360\n  if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' && inputs.run_reference_performance && inputs.candidate_release == '0.67'\n  concurrency:\n    group: release-067-performance-reference-v1\n    cancel-in-progress: false\n  env:\n    HYDRACACHE_RUN_PERF_REFERENCE: 1\n    HYDRACACHE_PERF_RUNNER_CLASS: self-hosted-bare-metal-v1\n    HYDRACACHE_PERFORMANCE_0671_MODE: qualify\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install pinned Rust 1.94.0\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Build pinned redis-benchmark 7.2.5\n    shell: bash\n    run: |\n      tools_dir=\"$RUNNER_TEMP/hydracache-perf-tools\"\n      mkdir --parents \"$tools_dir\"\n      cd \"$tools_dir\"\n      curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \\\n        --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 180 \\\n        --output redis-7.2.5.tar.gz \\\n        https://download.redis.io/releases/redis-7.2.5.tar.gz\n      printf '%s  redis-7.2.5.tar.gz\\n' '5981179706f8391f03be91d951acafaeda91af7fac56beffb2701963103e423d' \\\n        | sha256sum --check --strict -\n      tar --extract --gzip --file redis-7.2.5.tar.gz\n      env -i PATH=/usr/bin:/bin HOME=/tmp CC=gcc MALLOC=libc BUILD_TLS=no \\\n        make -C redis-7.2.5 -j1 redis-benchmark\n      test \"$(redis-7.2.5/src/redis-benchmark --version)\" = \"redis-benchmark 7.2.5\"\n      echo \"$tools_dir/redis-7.2.5/src\" >> \"$GITHUB_PATH\"\n  - name: Verify shipped 0.66 provenance\n    run: |\n      git rev-parse --verify refs/tags/v0.66.0\n      git merge-base --is-ancestor refs/tags/v0.66.0 HEAD\n  - name: Run 0.67 canary sweep\n    run: cargo run -p xtask --locked -- canary-sweep --release 0.67 --tier all\n  - name: Validate 0.67 performance contract\n    run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate fast.performance-contract-067\n  - name: Clear only prior performance evidence scratch\n    shell: bash\n    run: |\n      rm -rf -- \\\n        target/test-evidence/0.67 \\\n        target/test-evidence/