.gz \\\n        https://download.redis.io/releases/redis-7.2.5.tar.gz\n      printf '%s  redis-7.2.5.tar.gz\\n' '5981179706f8391f03be91d951acafaeda91af7fac56beffb2701963103e423d' \\\n        | sha256sum --check --strict -\n      rm -rf -- redis-7.2.5\n      tar --extract --gzip --file redis-7.2.5.tar.gz\n      env -i PATH=/usr/bin:/bin HOME=/tmp CC=gcc MALLOC=libc BUILD_TLS=no \\\n        make -C redis-7.2.5 -j1 redis-benchmark\n      test \"$(redis-7.2.5/src/redis-benchmark --version)\" = \"redis-benchmark 7.2.5\"\n      echo \"$tools_dir/redis-7.2.5/src\" >> \"$GITHUB_PATH\"\n  - name: Attest and preflight the 0.67.1 host\n    run: cargo run -p xtask --locked -- evidence-run --release 0.67.1 --gate tool.perf-attestation-v5-0671\n  - name: Prebuild exact 0.67 performance binaries\n    run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate tool.perf-prebuild-067\n  - name: Run bounded non-ship diagnostics\n    run: |\n      scripts/perf/run-reference-measurement.sh qualification-local\n      scripts/perf/run-reference-measurement.sh qualification-client-surface\n  - name: Materialize tmpfs reference evidence\n    if: always()\n    run: scripts/perf/reference-evidence-tmpfs.sh materialize\n  - name: Run 0.67.1 qualification gate\n    run: cargo run -p xtask --locked -- evidence-run --release 0.67.1 --gate tool.perf-qualification-0671\n  - name: Upload 0.67.1 qualification diagnostics\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: performance-0671-qualification-${{ github.sha }}-${{ github.run_id }}\n      path: |\n        target/test-evidence/0.67/**\n        target/test-evidence/0.67.1/**\n        target/release-evidence/receipts/**\n      if-no-files-found: warn\nrelease-0671-performance-full-dress:\n  name: 0.67.1 Full-Dress Bootstrap Admission\n  runs-on:\n  - self-hosted\n  - linux\n  - x64\n  - hydracache-perf-v1\n  timeout-minutes: 360\n  if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/