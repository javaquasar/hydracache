e-full-dress-admission\n    github-token: ${{ github.token }}\n    repository: ${{ github.repository }}\n    run-id: ${{ inputs.full_dress_admission_run_id }}\n- name: Download immediately prior bootstrap receipt\n  if: inputs.bootstrap_sample_index != '1'\n  uses: actions/download-artifact@v8\n  with:\n    name: performance-0671-bootstrap-receipt\n    path: ${{ runner.temp }}/hydracache-bootstrap-predecessor\n    github-token: ${{ github.token }}\n    repository: ${{ github.repository }}\n    run-id: ${{ inputs.bootstrap_predecessor_run_id }}\n- name: Resolve bootstrap admission and predecessor\n  shell: bash\n  run: |\n    mapfile -t admissions < <(find \"$RUNNER_TEMP/hydracache-full-dress-admission\" \\\n      -type f -name full-dress-admission.json -print)\n    test \"${#admissions[@]}\" -eq 1\n    echo \"HYDRACACHE_FULL_DRESS_ADMISSION=${admissions[0]}\" >> \"$GITHUB_ENV\"\n    if [[ '${{ inputs.bootstrap_sample_index }}' != 1 ]]; then\n      mapfile -t predecessors < <(find \"$RUNNER_TEMP/hydracache-bootstrap-predecessor\" \\\n        -type f -name bootstrap-sample.json -print)\n      test \"${#predecessors[@]}\" -eq 1\n      echo \"HYDRACACHE_BOOTSTRAP_PREDECESSOR=${predecessors[0]}\" >> \"$GITHUB_ENV\"\n    fi\n- name: Clear only prior performance evidence scratch\n  shell: bash\n  run: |\n    rm -rf -- \\\n      target/test-evidence/0.67 \\\n      target/test-evidence/0.67.1 \\\n      target/release-evidence/receipts\n- name: Prepare tmpfs reference evidence\n  run: scripts/perf/reference-evidence-tmpfs.sh prepare\n- name: Import frozen campaign host admission\n  run: scripts/perf/import-reference-campaign-admission.sh\n- name: Import offline runner provisioning proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67.1 --gate tool.perf-runner-provisioned-0671\n- name: Build pinned redis-benchmark 7.2.5\n  shell: bash\n  run: |\n    tools_dir=\"$RUNNER_TEMP/hydracache-perf-tools\"\n    mkdir --parents \"$tools_dir\"\n    cd \"$tools_dir\"\n 