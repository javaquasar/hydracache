                        "rendered": {
                          "ok": true,
                          "text": "name: DST and Soak Nightly\nruns-on: ubuntu-latest\ntimeout-minutes: 180\nif: github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && inputs.run_nightly)\nsteps:\n- name: Checkout\n  uses: actions/checkout@v5\n- name: Install Rust\n  uses: dtolnay/rust-toolchain@1.94.0\n- name: Cache Rust dependencies\n  uses: Swatinem/rust-cache@v2\n  with:\n    prefix-key: v1-rust-no-target\n    cache-targets: false\n    shared-key: dst-nightly-soak\n- name: Run deterministic simulation seeds\n  run: |\n    cargo run -p hydracache-sim --bin vopr --locked -- --seed 44 --steps 512\n    cargo run -p hydracache-sim --bin vopr --locked -- --seed 45 --steps 512\n    cargo run -p hydracache-sim --bin vopr --locked -- --seed 46 --steps 512\n- name: Run continuous soak and write SOAK_REPORT\n  timeout-minutes: 20\n  run: |\n    cargo run -p hydracache-sim --bin vopr --locked -- soak --master-seed 22530 --budget-secs 60 --steps-per-seed 512 --max-seeds 128 | tee SOAK_REPORT.json\n- name: Run ignored resource and operator skip sentinels\n  run: |\n    cargo test -p hydracache-server --test soak_resource --locked -- --ignored --nocapture\n    cargo test -p hydracache-operator --test soak_kind --locked -- --ignored --nocapture\n- name: Run networked daemon E2E tier\n  env:\n    HYDRACACHE_RUN_NETWORKED_DAEMON_E2E: '1'\n  run: cargo test -p hydracache-server --test grid_host multi_node --locked -- --nocapture\n- name: Run daemon-process cluster tier\n  run: cargo run -p xtask --locked -- evidence-run --release 0.64 --gate env.hydracache-run-daemon-process-e2e\n- name: Run 0.72 production management process proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.72 --gate env.hydracache-run-management-process-072\n- name: Run 0.72 management Linux resource proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.72 --gate env.hydracache-run-management-resource-linux-072\n- name: Redis RESP multinode debt sentinels\n  run: cargo run -p xtask --locked -- evidence-run --release 0.65 --gate env.hydracache-run-redis-resp-multinode-e2e\n- name: Upload daemon-process replay artifacts\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: daemon-process-replay-artifacts\n    path: target/test-hydracache-daemon-process/**\n    if-no-files-found: ignore\n- name: Upload daemon-process evidence receipt\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: daemon-process-evidence-${{ github.sha }}\n    path: target/release-evidence/receipts/**\n    if-no-files-found: error\n- name: Run membership-history tier\n  env:\n    HYDRACACHE_RUN_DAEMON_PROCESS_E2E: '1'\n  run: cargo test -p hydracache-server --test membership_history --locked -- --nocapture\n- name: Run pre-vote nightly soak\n  timeout-minutes: 30\n  env:\n    HYDRACACHE_RUN_PREVOTE_NIGHTLY_SOAK: '1'\n  run: cargo test -p hydracache-cluster-raft --test prevote_nightly_soak --locked -- --nocapture\n- name: Run raft nemesis nightly soak\n  timeout-minutes: 30\n  env:\n    HYDRACACHE_RUN_RAFT_NEMESIS_SOAK: '1'\n    HYDRACACHE_NEMESIS_BUDGET_SECS: '60'\n  run: cargo test -p hydracache-cluster-raft --test nemesis_membership nemesis_soak_over_seed_range_converges --locked -- --nocapture\n- name: Upload SOAK_REPORT\n  uses: actions/upload-artifact@v6\n  with:\n    name: SOAK_REPORT\n    path: SOAK_REPORT.json\n"
