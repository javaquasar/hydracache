                      "rendered": {
                        "ok": true,
                        "text": "name: 0.66 Operator Kind Release Proof\nruns-on: ubuntu-latest\ntimeout-minutes: 130\nif: github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && inputs.run_nightly)\nsteps:\n- name: Checkout\n  uses: actions/checkout@v5\n  with:\n    fetch-depth: 0\n- name: Install Rust\n  uses: dtolnay/rust-toolchain@1.94.0\n- name: Install Go\n  uses: actions/setup-go@v6\n  with:\n    go-version: 1.23.4\n    cache: false\n- name: Install kubectl\n  uses: azure/setup-kubectl@v5.1.0\n  with:\n    version: v1.32.0\n- name: Install Helm\n  uses: azure/setup-helm@v5.0.1\n  with:\n    version: v3.17.0\n- name: Cache Rust dependencies\n  uses: Swatinem/rust-cache@v2\n  with:\n    prefix-key: v2-rust-with-target\n    cache-targets: true\n    shared-key: release-066-operator-kind\n- name: Create kind cluster with enforcing CNI\n  shell: bash\n  run: |\n    go install sigs.k8s.io/kind@v0.26.0\n    echo \"$(go env GOPATH)/bin\" >> \"$GITHUB_PATH\"\n    \"$(go env GOPATH)/bin/kind\" create cluster \\\n      --name hydracache-066 \\\n      --image kindest/node:v1.32.0@sha256:c48c62eac5da28cdadcf560d1d8616cfa6783b58f0d94cf63ad1bf49600cb027 \\\n      --config - <<'EOF'\n    kind: Cluster\n    apiVersion: kind.x-k8s.io/v1alpha4\n    networking:\n      disableDefaultCNI: true\n    nodes:\n      - role: control-plane\n      - role: worker\n      - role: worker\n    EOF\n    kubectl apply -f https://raw.githubusercontent.com/projectcalico/calico/v3.29.2/manifests/calico.yaml\n    kubectl rollout status deployment/calico-kube-controllers -n kube-system --timeout=5m\n    kubectl rollout status daemonset/calico-node -n kube-system --timeout=5m\n- name: Install required Chaos Mesh IOChaos runtime\n  timeout-minutes: 15\n  run: |\n    helm repo add chaos-mesh https://charts.chaos-mesh.org\n    helm repo update\n    helm install chaos-mesh chaos-mesh/chaos-mesh \\\n      --namespace chaos-mesh \\\n      --create-namespace \\\n      --version 2.7.2 \\\n      --set chaosDaemon.runtime=containerd \\\n      --set chaosDaemon.socketPath=/run/containerd/containerd.sock \\\n      --wait \\\n      --timeout 10m\n    kubectl get crd iochaos.chaos-mesh.org\n- name: Build and load current server image\n  run: |\n    docker build --tag hydracache-server:0.66-candidate .\n    kind load docker-image --name hydracache-066 hydracache-server:0.66-candidate\n- name: Prepare current operator controller\n  shell: bash\n  run: |\n    mkdir -p target/test-evidence/0.66\n    kubectl apply -f deploy/operator/hydracacheclusters.hydracache.io.crd.yaml\n    kubectl auth can-i get pods --subresource=proxy --namespace default\n    kubectl auth can-i create pods --subresource=proxy --namespace default\n    cargo build -p hydracache-operator --locked\n    operator_candidate_directory=\"$(pwd)/target/ci-runtime/0.66\"\n    operator_binary=\"$operator_candidate_directory/hydracache-operator-${GITHUB_SHA}\"\n    mkdir -p \"$operator_candidate_directory\"\n    install -m 0755 \"$(pwd)/target/debug/hydracache-operator\" \"$operator_binary\"\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_nonce=\"release-066-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}-${GITHUB_SHA}\"\n    export HYDRACACHE_OPERATOR_EVIDENCE_NONCE=\"$operator_nonce\"\n    echo \"HYDRACACHE_OPERATOR_EVIDENCE_NONCE=$operator_nonce\" >> \"$GITHUB_ENV\"\n    echo \"HYDRACACHE_OPERATOR_BINARY=$operator_binary\" >> \"$GITHUB_ENV\"\n    printf 'HC-OPERATOR-CONTROLLER-START nonce=%s binary=%s\\n' \\\n      \"$operator_nonce\" \"$operator_binary\" > \"$operator_log\"\n- name: Start current operator controller\n  id: operator-controller\n  shell: bash\n  background: true\n  timeout-minutes: 120\n  env:\n    HYDRACACHE_OPERATOR_NAMESPACE: default\n    HYDRACACHE_OPERATOR_IDENTITY: release-066-ci\n  run: |\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n    printf '%s\\n' \"$BASHPID\" > \"$operator_pid_file\"\n    exec \"$HYDRACACHE_OPERATOR_BINARY\" >> \"$operator_log\" 2>&1\n- name: Verify current operator controller\n  shell: bash\n  run: |\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n    operator_nonce=\"$HYDRACACHE_OPERATOR_EVIDENCE_NONCE\"\n    operator_ready=0\n    for _ in $(seq 1 30); do\n      if [[ -s \"$operator_pid_file\" ]]; then\n        operator_pid=\"$(cat \"$operator_pid_file\")\"\n      else\n        sleep 1\n        continue\n      fi\n      if kill -0 \"$operator_pid\" \\\n        && grep -Fq \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"; then\n        operator_ready=1\n        break\n      fi\n      sleep 1\n    done\n    kill -0 \"$operator_pid\"\n    test \"$operator_ready\" = 1\n    grep -F \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"\n- name: Run 0.66 operator-kind release proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.66 --gate env.hydracache-operator-kind-066\n- name: Stop current operator controller\n  cancel: operator-controller\n- name: Capture operator-kind diagnostics\n  if: always()\n  continue-on-error: true\n  run: |\n    kubectl get pods,statefulsets,services,hydracacheclusters -A -o wide > target/test-evidence/0.66/operator-kind-resources-post.txt || true\n    kubectl get events -A --sort-by=.lastTimestamp > target/test-evidence/0.66/operator-kind-events-post.txt || true\n    kubectl logs -n default \\\n      --selector 'app.kubernetes.io/name=hydracache,app.kubernetes.io/instance=hydracache-066,app.kubernetes.io/component=server' \\\n      --all-containers=true \\\n      --prefix=true \\\n      --tail=-1 \\\n      > target/test-evidence/0.66/operator-kind-pod-logs-post.txt || true\n- name: Upload 0.66 operator-kind evidence\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: operator-kind-066-${{ github.sha }}\n    path: |\n      target/test-evidence/0.66/**\n      target/release-evidence/receipts/**\n    if-no-files-found: error\n"
