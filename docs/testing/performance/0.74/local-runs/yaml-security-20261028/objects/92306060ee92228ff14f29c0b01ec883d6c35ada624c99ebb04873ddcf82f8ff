se_end=\"${INPUT_LEASE_END:-$(date --utc --date='+90 minutes' --iso-8601=seconds)}\"\n        [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        test -n \"$lease_owner\"\n        lease_epoch=\"$(date --date=\"$lease_end\" +%s)\"\n        now_epoch=\"$(date +%s)\"\n        test \"$lease_epoch\" -gt \"$now_epoch\"\n        test \"$lease_epoch\" -le \"$((now_epoch + 7200))\"\n        {\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n        } >> \"$GITHUB_ENV\"\n    - name: Verify available profiling boundary\n      shell: bash\n      run: |\n        set -euo pipefail\n        test \"$(uname -s)\" = Linux\n        test \"$(uname -m)\" = x86_64\n        command -v cargo\n        command -v rustc\n        command -v python3\n        command -v strace\n        command -v ss\n        python3 -m unittest scripts.perf.test_performance_kernel_attribution_074\n    - name: Capture host and kernel capability receipt\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        python3 - \"$EVIDENCE_DIR/preflight.json\" <<'PY'\n        import hashlib, json, os, pathlib, platform, subprocess, sys\n        def command(*args):\n            return subprocess.check_output(args, text=True, stderr=subprocess.STDOUT).strip()\n        def readable(path):\n            try:\n                with open(path, 'rb') as stream:\n                    stream.read(1)\n                return True\n            except OSError:\n                return False\n        machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n        sysctls = {}\n        for name in ('kernel.perf_event_paranoid', 'kernel.unprivileged_bpf_disabled', 'kernel.kptr_restrict', 'kernel.yama.ptrace_scope'):\n            try:\n                sysctls[name] = command('sysctl', '-n', name)\n            except subprocess.CalledProcessError as error:\n                sysctls[name] = f'unavailable:{error.returncode}'\n        value = {\n            'schema_version': 1,\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'lease': {'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'], 'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END']},\n            'host': {\n                'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                'node': platform.node(), 'machine': platform.machine(), 'kernel': platform.release(),\n                'cpu_count': os.cpu_count(),\n            },\n            'toolchain': {\n                'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version'),\n                'strace': command('strace', '--version').splitlines()[0], 'ss': command('ss', '--version'),\n            },\n            'kernel_controls': sysctls,\n            'tracefs_syscall_events_readable': readable('/sys/kernel/tracing/events/syscalls'),\n            'debugfs_syscall_events_readable': readable('/sys/kernel/debug/tracing/events/syscalls'),\n        }\n        pathlib.Path(sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n        PY\n    - name: Build exact RESP attribution profiler\n      timeout-minutes: 30\n      shell: bash\n      run: |\n        set -euo pipefail\n        CARGO_TARGET_DIR=target/w9c-kernel-build cargo build \\\n          --manifest-path tools/resp-pipeline-profile-074/Cargo.toml \\\n          --release --locked\n    - name: Run counterbalanced syscall attribution\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_kernel_attribution_074.py \\\n          --binary target/w9c-kernel-build/release/resp-pipeline-profile-074 \\\n          --output-dir \"$EVIDENCE_DIR/campaign\" \\\n          --source-commit \"$EXPECTED_SOURCE_SHA\" \\\n          --tool-source tools/resp-pipeline-profile-074/src/main.rs \\\n          --tool-lock tools/resp-pipeline-profile-074/Cargo.lock \\\n          --contract docs/testing/performance/0.74/w9c-linux-kernel-attribution-contract.toml \\\n          --repeats 5\n    - name: Seal non-promotable attribution packet\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 - \"$EVIDENCE_DIR\" <<'PY'\n        import hashlib, json, os, pathlib, sys\n        root = pathlib.Path(sys.argv[1])\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        packet = {\n            'schema_version': 1, 'release': '0.74',\n            'profile_id': 'w9c-linux-kernel-attribution-074-v1',\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'result': 'incomplete-owner-attribution',\n            'candidate_data_present': False, 'acceptance_decision_allowed': False,\n            'promotable': False, 'silent_retry_allowed': False,\n        }\n        preflight = root / 'preflight.json'\n        if preflight.is_file():\n            packet['preflight_sha256'] = digest(preflight)\n            packet['host'] = json.loads(preflight.read_text())['host']\n        manifest_path = root / 'campaign' / 'manifest.json'\n        summary_path = root / 'campaign' / 'summary.json'\n        if manifest_path.is_file():\n            manifest = json.loads(manifest_path.read_text())\n            packet['manifest_sha256'] = digest(manifest_path)\n            packet['attempts'] = manifest['attempts']\n            packet['valid_attempts'] = manifest['valid_attempts']\n            packet['failed_attempts'] = manifest['failed_attempts']\n            if summary_path.is_file() and manifest['failed_attempts'] == 0:\n                packet['summary_sha256'] = digest(summary_path)\n                packet['result'] = 'complete-owner-attribution'\n        root.mkdir(parents=True, exist_ok=True)\n        (root / 'packet.json').write_text(json.dumps(packet, indent=2, sort_keys=True) + '\\n')\n        PY\n    - name: Retain W9c attribution packet\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-kernel-attribution-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.74/reference/w9c-kernel/**\n        if-no-files-found: error\n        retention-days: 90\n"
