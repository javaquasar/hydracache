{"id":".github/workflows/performance-long-run-qualification-073.yml","parsed":true,"roundtrip":{"ok":true,"tree":{"rendered":{"ok":true,"text":"name: Performance Long-Run Qualification 0.73\non:\n  workflow_call:\n    inputs:\n      tooling_sha:\n        required: true\n        type: string\n      lease_owner:\n        required: true\n        type: string\n      lease_end:\n        required: true\n        type: string\n      phase:\n        required: false\n        default: qualification\n        type: string\n      role:\n        required: false\n        default: pair\n        type: string\n      entry_serializes_host:\n        required: false\n        default: false\n        type: boolean\npermissions:\n  contents: read\nconcurrency:\n  group: ${{ inputs.entry_serializes_host && format('performance-reference-073-host-nested-{0}', github.run_id) || 'performance-reference-073-host' }}\n  cancel-in-progress: false\njobs:\n  qualify:\n    name: Exact ${{ inputs.role }} selected long-run phase\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-release\n    timeout-minutes: ${{ inputs.phase == 'confirmation' && 1740 || 900 }}\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: '1'\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      I73_SHA: e757556d3a31d565f52a9561d6d4e555bb1cc373\n      C73_SHA: 16d2e98b6cc9e22d9ccf95eb26fe28bbbcf80f2b\n      C73_TREE_OID: 92336607f21a68f563e65dc0fccccd8efaa14f7b\n      LONG_RUN_PHASE: ${{ inputs.phase }}\n      EVIDENCE_DIR: ${{ github.workspace }}/target/performance-evidence/0.73/long-run-${{ inputs.phase }}-${{ github.run_id }}-${{ github.run_attempt }}\n    steps:\n    - name: Check out reviewed tooling revision\n      uses: actions/checkout@v4\n      with:\n        fetch-depth: 0\n        ref: ${{ inputs.tooling_sha }}\n    - name: Resolve tooling identity and serialized lease\n      shell: bash\n      env:\n        INPUT_TOOLING_SHA: ${{ inputs.tooling_sha }}\n        INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n        INPUT_LEASE_END: ${{ inputs.lease_end }}\n        INPUT_PHASE: ${{ inputs.phase }}\n        INPUT_ROLE: ${{ inputs.role }}\n      run: |\n        set -euo pipefail\n        [[ \"$INPUT_TOOLING_SHA\" =~ ^[0-9a-f]{40}$ ]]\n        [[ \"$INPUT_PHASE\" = \"qualification\" || \"$INPUT_PHASE\" = \"confirmation\" ]]\n        [[ \"$INPUT_ROLE\" = \"pair\" || \"$INPUT_ROLE\" = \"I73\" || \"$INPUT_ROLE\" = \"C73\" ]]\n        if [[ \"$INPUT_PHASE\" = \"qualification\" ]]; then\n          test \"$INPUT_ROLE\" = \"pair\"\n        else\n          [[ \"$INPUT_ROLE\" = \"I73\" || \"$INPUT_ROLE\" = \"C73\" ]]\n        fi\n        test \"$(git rev-parse HEAD)\" = \"$INPUT_TOOLING_SHA\"\n        test -n \"$INPUT_LEASE_OWNER\"\n        date --date=\"$INPUT_LEASE_END\" >/dev/null\n        lease_seconds=$(( $(date --date=\"$INPUT_LEASE_END\" +%s) - $(date +%s) ))\n        if [[ \"$INPUT_PHASE\" = \"confirmation\" && \"$INPUT_ROLE\" = \"I73\" ]]; then\n          test \"$lease_seconds\" -ge $((3480 * 60))\n        elif [[ \"$INPUT_PHASE\" = \"confirmation\" ]]; then\n          test \"$lease_seconds\" -ge $((1740 * 60))\n        else\n          test \"$lease_seconds\" -ge $((900 * 60))\n        fi\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        mkdir -p \"$EVIDENCE_DIR/calibration\"\n        if [[ \"$INPUT_PHASE\" = \"confirmation\" ]]; then\n          cargo run -p xtask --locked -- performance-contract-check --release 0.73\n          python3 - <<'PY'\n        import pathlib\n        import tomllib\n\n        path = pathlib.Path(\"docs/testing/performance/0.73/w10-long-run-v2-qualification-passed-36532416869.toml\")\n        evidence = tomllib.loads(path.read_text(encoding=\"utf-8\"))\n        required = {\n            \"state\": \"six-hour-qualification-passed-confirmation-not-started\",\n            \"result\": \"passed\",\n            \"baseline_source_commit\": \"e757556d3a31d565f52a9561d6d4e555bb1cc373\",\n            \"candidate_source_commit\": \"16d2e98b6cc9e22d9ccf95eb26fe28bbbcf80f2b\",\n            \"decision\": \"accept-six-hour-qualification-and-hold-before-explicit-confirmation\",\n        }\n        for field, expected in required.items():\n            if evidence.get(field) != expected:\n                raise SystemExit(f\"qualification evidence {field} mismatch\")\n        for field in (\n            \"nested_sha256_verified\",\n            \"independent_role_reanalysis_matched\",\n            \"goodput_guard_passed\",\n            \"cpu_guard_passed\",\n            \"p99_guard_passed\",\n            \"rss_slope_guard_passed\",\n            \"anonymous_pss_slope_guard_passed\",\n            \"confirmation_allowed\",\n        ):\n            if evidence.get(field) is not True:\n                raise SystemExit(f\"qualification evidence {field} is not true\")\n        if evidence.get(\"confirmation_started\") is not False or evidence.get(\"final_c73_allowed\") is not False:\n            raise SystemExit(\"qualification evidence already crossed its promotion boundary\")\n        PY\n        fi\n        {\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$INPUT_LEASE_OWNER\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$INPUT_LEASE_END\"\n          echo \"EXPECTED_TOOLING_SHA=$INPUT_TOOLING_SHA\"\n          echo \"LONG_RUN_ROLE=$INPUT_ROLE\"\n        } >> \"$GITHUB_ENV\"\n    - name: Expose and verify required host tools\n      shell: bash\n      run: |\n        set -euo pipefail\n        rust_bin=\"$HOME/.cargo/bin\"\n        test -x \"$rust_bin/cargo\"\n        test -x \"$rust_bin/rustc\"\n        echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n        cargo --version\n        rustc --version\n        python3 --version\n        taskset --version\n        pidstat -V\n    - name: Materialize exact product trees and identical overlays\n      shell: bash\n      run: |\n        set -euo pipefail\n        run_key=\"${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}\"\n        i73_root=\"$RUNNER_TEMP/hydracache-long-i73-$run_key\"\n        c73_root=\"$RUNNER_TEMP/hydracache-long-c73-$run_key\"\n        i73_stage=\"$RUNNER_TEMP/long-i73-stage-$run_key\"\n        c73_stage=\"$RUNNER_TEMP/long-c73-stage-$run_key\"\n        git worktree prune\n        git worktree add --detach \"$i73_root\" \"$I73_SHA\"\n        git worktree add --detach \"$c73_root\" \"$C73_SHA\"\n        test \"$(git -C \"$i73_root\" rev-parse HEAD)\" = \"$I73_SHA\"\n        test \"$(git -C \"$c73_root\" rev-parse HEAD)\" = \"$C73_SHA\"\n        test \"$(git -C \"$c73_root\" rev-parse 'HEAD^{tree}')\" = \"$C73_TREE_OID\"\n        mkdir -p \"$i73_stage/tools\" \"$c73_stage/tools\"\n        cp -a tools/performance-integrated-073 \"$i73_stage/tools/\"\n        cp -a tools/performance-integrated-073 \"$c73_stage/tools/\"\n        ln -s \"$i73_root/Cargo.toml\" \"$i73_stage/Cargo.toml\"\n        ln -s \"$c73_root/Cargo.toml\" \"$c73_stage/Cargo.toml\"\n        ln -s \"$i73_root/crates\" \"$i73_stage/crates\"\n        ln -s \"$c73_root/crates\" \"$c73_stage/crates\"\n        {\n          echo \"I73_ROOT=$i73_root\"\n          echo \"C73_ROOT=$c73_root\"\n          echo \"I73_OVERLAY=$i73_stage/tools/performance-integrated-073\"\n          echo \"C73_OVERLAY=$c73_stage/tools/performance-integrated-073\"\n        } >> \"$GITHUB_ENV\"\n    - name: Build exact role servers and standalone harnesses\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo build --manifest-path \"$I73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n        cargo build --manifest-path \"$C73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n        test \"$(sha256sum \"$I73_OVERLAY/Cargo.lock\" | cut -d' ' -f1)\" = \"3c2e8a20a26c6105fec6f449ce6cad43ba4a9a65f78516f5c0110ff0a9ca4953\"\n        test \"$(sha256sum \"$C73_OVERLAY/Cargo.lock.c73\" | cut -d' ' -f1)\" = \"35b7ab4f62cee2ce41aa0547cc632a11d90e0d89861b87158bbcf7b184767630\"\n        cargo build --manifest-path \"$I73_OVERLAY/Cargo.toml\" --release --locked\n        cp \"$C73_OVERLAY/Cargo.lock.c73\" \"$C73_OVERLAY/Cargo.lock\"\n        cargo build --manifest-path \"$C73_OVERLAY/Cargo.toml\" --release --locked\n        cp \"$I73_OVERLAY/Cargo.lock\" \"$C73_OVERLAY/Cargo.lock\"\n        diff -qr --exclude=target \"$I73_OVERLAY\" \"$C73_OVERLAY\"\n        test -z \"$(git -C \"$I73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n        test -z \"$(git -C \"$C73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n        {\n          echo \"I73_SERVER=$I73_ROOT/target/release/hydracache-server\"\n          echo \"C73_SERVER=$C73_ROOT/target/release/hydracache-server\"\n          echo \"I73_HARNESS=$I73_OVERLAY/target/release/performance-integrated-073\"\n          echo \"C73_HARNESS=$C73_OVERLAY/target/release/performance-integrated-073\"\n        } >> \"$GITHUB_ENV\"\n    - name: Falsify missing-final-checkpoint admission\n      if: inputs.role != 'C73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_long_run_073.py \\\n          --mode canary --phase qualification \\\n          --i73-harness \"$I73_HARNESS\" --c73-harness \"$C73_HARNESS\" \\\n          --i73-server \"$I73_SERVER\" --c73-server \"$C73_SERVER\" \\\n          --i73-overlay \"$I73_OVERLAY\" --c73-overlay \"$C73_OVERLAY\" \\\n          --scenario docs/testing/performance/0.73/w10-long-run-qualification-v2-contract.toml \\\n          --output \"$EVIDENCE_DIR/canary\" \\\n          --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n          --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n    - name: Capture I73 pre-role calibration\n      if: inputs.role != 'C73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/calibration/pre-i73.json\"\n    - name: Run exact selected-phase I73 role\n      if: inputs.role != 'C73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_long_run_073.py \\\n          --mode role --role I73 --phase \"$LONG_RUN_PHASE\" \\\n          --i73-harness \"$I73_HARNESS\" --c73-harness \"$C73_HARNESS\" \\\n          --i73-server \"$I73_SERVER\" --c73-server \"$C73_SERVER\" \\\n          --i73-overlay \"$I73_OVERLAY\" --c73-overlay \"$C73_OVERLAY\" \\\n          --scenario docs/testing/performance/0.73/w10-long-run-qualification-v2-contract.toml \\\n          --output \"$EVIDENCE_DIR/i73\" \\\n          --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n          --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n    - name: Capture I73 post-role calibration\n      if: always() && inputs.role != 'C73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/calibration/post-i73.json\"\n    - name: Seal I73 continuation packet\n      if: inputs.phase == 'confirmation' && inputs.role == 'I73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        test -f \"$EVIDENCE_DIR/canary/canary.json\"\n        test -f \"$EVIDENCE_DIR/i73/attempt.json\"\n        test -f \"$EVIDENCE_DIR/i73/receipt.json\"\n        test -f \"$EVIDENCE_DIR/i73/baseline-bounds.json\"\n        test -f \"$EVIDENCE_DIR/calibration/pre-i73.json\"\n        test -f \"$EVIDENCE_DIR/calibration/post-i73.json\"\n        (\n          cd \"$EVIDENCE_DIR\"\n          find canary calibration i73 -type f -print0 \\\n            | sort -z \\\n            | xargs -0 sha256sum > continuation-SHA256SUMS\n        )\n    - name: Upload I73 continuation packet\n      if: always() && inputs.phase == 'confirmation' && inputs.role == 'I73'\n      uses: actions/upload-artifact@v4\n      with:\n        name: performance-long-run-confirmation-i73-stage-073-${{ inputs.tooling_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: ${{ env.EVIDENCE_DIR }}\n        if-no-files-found: error\n        retention-days: 30\n    - name: Download and verify I73 continuation packet\n      if: inputs.phase == 'confirmation' && inputs.role == 'C73'\n      uses: actions/download-artifact@v4\n      with:\n        name: performance-long-run-confirmation-i73-stage-073-${{ inputs.tooling_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: ${{ env.EVIDENCE_DIR }}\n    - name: Admit I73 continuation packet\n      if: inputs.phase == 'confirmation' && inputs.role == 'C73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        (\n          cd \"$EVIDENCE_DIR\"\n          sha256sum --check continuation-SHA256SUMS\n        )\n        python3 - <<'PY'\n        import json\n        import os\n        import pathlib\n\n        root = pathlib.Path(os.environ[\"EVIDENCE_DIR\"])\n        attempt = json.loads((root / \"i73\" / \"attempt.json\").read_text(encoding=\"utf-8\"))\n        receipt = json.loads((root / \"i73\" / \"receipt.json\").read_text(encoding=\"utf-8\"))\n        if attempt.get(\"valid\") is not True or attempt.get(\"role\") != \"I73\":\n            raise SystemExit(\"I73 continuation attempt is not valid\")\n        if attempt.get(\"attempt\", {}).get(\"exit_code\") != 0 or attempt.get(\"attempt\", {}).get(\"timed_out\") is not False:\n            raise SystemExit(\"I73 continuation process did not complete cleanly\")\n        expected = {\n            \"role\": \"I73\",\n            \"source_sha\": \"e757556d3a31d565f52a9561d6d4e555bb1cc373\",\n            \"operations\": 1036800000,\n            \"checkpoint_count\": 1442,\n            \"final_checkpoint_present\": True,\n            \"reconciliation_exact\": True,\n        }\n        for field, value in expected.items():\n            if receipt.get(field) != value:\n                raise SystemExit(f\"I73 continuation {field} mismatch\")\n        observation = receipt.get(\"observation\", {})\n        if observation.get(\"completed\") != 1036800000 or observation.get(\"errors\") != 0:\n            raise SystemExit(\"I73 continuation observation is incomplete\")\n        PY\n    - name: Capture C73 pre-role calibration\n      if: inputs.role != 'I73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        test -f \"$EVIDENCE_DIR/i73/baseline-bounds.json\"\n        cargo run -p xtask --locked -- perf-memory-preflight --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/calibration/pre-c73.json\"\n    - name: Run exact selected-phase C73 role\n      if: inputs.role != 'I73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_long_run_073.py \\\n          --mode role --role C73 --phase \"$LONG_RUN_PHASE\" \\\n          --i73-harness \"$I73_HARNESS\" --c73-harness \"$C73_HARNESS\" \\\n          --i73-server \"$I73_SERVER\" --c73-server \"$C73_SERVER\" \\\n          --i73-overlay \"$I73_OVERLAY\" --c73-overlay \"$C73_OVERLAY\" \\\n          --scenario docs/testing/performance/0.73/w10-long-run-qualification-v2-contract.toml \\\n          --output \"$EVIDENCE_DIR/c73\" \\\n          --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n          --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n    - name: Capture C73 post-role calibration\n      if: always() && inputs.role != 'I73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/calibration/post-c73.json\"\n    - name: Seal the complete selected-phase packet\n      if: inputs.role != 'I73'\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_long_run_073.py \\\n          --mode seal --phase \"$LONG_RUN_PHASE\" --tooling-sha \"$EXPECTED_TOOLING_SHA\" \\\n          --i73-harness \"$I73_HARNESS\" --c73-harness \"$C73_HARNESS\" \\\n          --i73-server \"$I73_SERVER\" --c73-server \"$C73_SERVER\" \\\n          --i73-overlay \"$I73_OVERLAY\" --c73-overlay \"$C73_OVERLAY\" \\\n          --scenario docs/testing/performance/0.73/w10-long-run-qualification-v2-contract.toml \\\n          --output \"$EVIDENCE_DIR\" \\\n          --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n          --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n    - name: Upload complete or incomplete selected-phase packet\n      if: always() && inputs.role != 'I73'\n      uses: actions/upload-artifact@v4\n      with:\n        name: performance-long-run-${{ inputs.phase }}-073-${{ inputs.tooling_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: ${{ env.EVIDENCE_DIR }}\n        if-no-files-found: error\n        retention-days: 30\n"},"shape":{"entries":[[{"rendered":{"ok":true,"text":"name\n"},"shape":{"kind":"string","value":"name"}},{"rendered":{"ok":true,"text":"Performance Long-Run Qualification 0.73\n"},"shape":{"kind":"string","value":"Performance Long-Run Qualification 0.73"}}],[{"rendered":{"ok":true,"text":"on\n"},"shape":{"kind":"string","value":"on"}},{"rendered":{"ok":true,"text":"workflow_call:\n  inputs:\n    tooling_sha:\n      required: true\n      type: string\n    lease_owner:\n      required: true\n      type: string\n    lease_end:\n      required: true\n      type: string\n    phase:\n      required: false\n      default: qualification\n      type: string\