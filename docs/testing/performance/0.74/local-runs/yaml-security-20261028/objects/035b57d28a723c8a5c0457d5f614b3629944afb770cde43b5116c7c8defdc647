          "ok": true,
          "text": "name: Performance Baseline Pilot V2 0.73\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact lowercase 40-character baseline or integrated-tooling source commit\n        required: true\n        type: string\n      lease_owner:\n        description: Operator holding the serialized performance-host lease\n        required: true\n        type: string\n      lease_end:\n        description: Approved lease end in RFC3339 form\n        required: true\n        type: string\npermissions:\n  contents: read\nconcurrency:\n  group: performance-reference-073-host\n  cancel-in-progress: false\njobs:\n  pilot:\n    if: inputs.source_sha == 'e757556d3a31d565f52a9561d6d4e555bb1cc373'\n    name: Paired baseline-only I73 rate and window pilot\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-release\n    environment: performance-reference-073\n    timeout-minutes: 120\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: '1'\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      EVIDENCE_DIR: target/performance-evidence/0.73/reference/baseline-pilot-v2\n    steps:\n    - name: Checkout exact baseline-only source\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n    - name: Resolve source and serialized lease\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n        INPUT_LEASE_END: ${{ inputs.lease_end }}\n      run: |\n        set -euo pipefail\n        source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n        lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n        lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+2 hours' --iso-8601=seconds)}\"\n        [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n        test -n \"$lease_owner\"\n        date --date=\"$lease_end\" >/dev/null\n        {\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n        } >> \"$GITHUB_ENV\"\n    - name: Expose and verify required host tools\n      shell: bash\n      run: |\n        set -euo pipefail\n        rust_bin=\"$HOME/.cargo/bin\"\n        test -x \"$rust_bin/cargo\"\n        test -x \"$rust_bin/rustc\"\n        echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n        cargo --version\n        rustc --version\n        pidstat -V\n    - name: Capture pre-pilot calibration\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$RUNNER_TEMP/performance-073-preflight.json\"\n    - name: Build exact standalone pilot harness\n      shell: bash\n      run: cargo build --manifest-path tools/performance-observer-073/Cargo.toml --release --locked\n    - name: Run baseline-only counterbalanced rate scan\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_baseline_pilot_073.py \\\n          --binary tools/performance-observer-073/target/release/performance-observer-073 \\\n          --output \"$EVIDENCE_DIR/campaign\" \\\n          --profile-id observer-baseline-pilot-073-v2 \\\n          --rates 2500,5000,10000,20000 \\\n          --repeats 5 \\\n          --window-seconds 10 \\\n          --warmup-operations 5000 \\\n          --seed 73073 \\\n          --cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\" \\\n          --source-sha \"$EXPECTED_SOURCE_SHA\"\n    - name: Capture post-pilot calibration\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$RUNNER_TEMP/performance-073-postflight.json\"\n    - name: Seal baseline-only packet\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        cp \"$RUNNER_TEMP/performance-073-preflight.json\" \"$EVIDENCE_DIR/preflight.json\"\n        cp \"$RUNNER_TEMP/performance-073-postflight.json\" \"$EVIDENCE_DIR/postflight.json\"\n        python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_SOURCE_SHA\" <<'PY'\n        import hashlib\n        import json\n        import pathlib\n        import sys\n\n        root = pathlib.Path(sys.argv[1])\n        source_sha = sys.argv[2]\n        before_path = root / \"preflight.json\"\n        after_path = root / \"postflight.json\"\n        pilot_path = root / \"campaign\" / \"baseline-pilot.json\"\n        before = json.loads(before_path.read_text(encoding=\"utf-8\"))\n        after = json.loads(after_path.read_text(encoding=\"utf-8\"))\n        pilot = json.loads(pilot_path.read_text(encoding=\"utf-8\"))\n        if before[\"host_fingerprint\"] != after[\"host_fingerprint\"]:\n            raise SystemExit(\"host fingerprint drifted across baseline pilot\")\n        if before[\"identity_probes\"] != after[\"identity_probes\"]:\n            raise SystemExit(\"host identity or held policy drifted across baseline pilot\")\n        if before[\"lease\"] != after[\"lease\"]:\n            raise SystemExit(\"serialized lease changed across baseline pilot\")\n        if before[\"source_sha\"] != source_sha or after[\"source_sha\"] != source_sha:\n            raise SystemExit(\"host receipts do not bind the baseline source\")\n        if before[\"result\"] != \"success\" or after[\"result\"] != \"success\":\n            raise SystemExit(\"pre/post host calibration did not pass\")\n        if (\n            pilot[\"source_sha\"] != source_sha\n            or pilot[\"candidate_data_present\"]\n            or pilot[\"profile_id\"] != \"observer-baseline-pilot-073-v2\"\n            or pilot[\"paired_estimator\"] != \"hodges-lehmann-v1\"\n        ):\n            raise SystemExit(\"pilot is not baseline-only\")\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        manifest = {\n            \"schema_version\": 1,\n            \"release\": \"0.73\",\n            \"profile_id\": \"observer-baseline-pilot-073-v2\",\n            \"source_sha\": source_sha,\n            \"result\": \"passed\" if pilot[\"i73_freeze_eligible\"] else \"insufficient-baseline\",\n            \"host_fingerprint\": before[\"host_fingerprint\"],\n            \"preflight_sha256\": digest(before_path),\n            \"postflight_sha256\": digest(after_path),\n            \"baseline_pilot_sha256\": digest(pilot_path),\n            \"candidate_data_present\": False,\n            \"candidate_measurement_authorized\": False,\n            \"silent_retry_allowed\": False,\n        }\n        (root / \"campaign-manifest.json\").write_text(\n            json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n        )\n        if manifest[\"result\"] != \"passed\":\n            raise SystemExit(\"baseline pilot did not establish three stable rates\")\n        PY\n    - name: Retain baseline-only pilot packet\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-baseline-pilot-v2-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.73/reference/baseline-pilot-v2/**\n        if-no-files-found: error\n        retention-days: 90\n  integrated:\n    if: inputs.source_sha != 'e757556d3a31d565f52a9561d6d4e555bb1cc373'\n    uses: ./.github/workflows/performance-integrated-host-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      entry_serializes_host: true\n    secrets: inherit\n"
