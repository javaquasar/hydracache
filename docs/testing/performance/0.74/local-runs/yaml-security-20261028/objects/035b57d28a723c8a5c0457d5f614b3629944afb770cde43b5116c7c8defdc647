ha \"$EXPECTED_SOURCE_SHA\"\n    - name: Capture post-pilot calibration\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$RUNNER_TEMP/performance-073-postflight.json\"\n    - name: Seal baseline-only packet\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        cp \"$RUNNER_TEMP/performance-073-preflight.json\" \"$EVIDENCE_DIR/preflight.json\"\n        cp \"$RUNNER_TEMP/performance-073-postflight.json\" \"$EVIDENCE_DIR/postflight.json\"\n        python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_SOURCE_SHA\" <<'PY'\n        import hashlib\n        import json\n        import pathlib\n        import sys\n\n        root = pathlib.Path(sys.argv[1])\n        source_sha = sys.argv[2]\n        before_path = root / \"preflight.json\"\n        after_path = root / \"postflight.json\"\n        pilot_path = root / \"campaign\" / \"baseline-pilot.json\"\n        before = json.loads(before_path.read_text(encoding=\"utf-8\"))\n        after = json.loads(after_path.read_text(encoding=\"utf-8\"))\n        pilot = json.loads(pilot_path.read_text(encoding=\"utf-8\"))\n        if before[\"host_fingerprint\"] != after[\"host_fingerprint\"]:\n            raise SystemExit(\"host fingerprint drifted across baseline pilot\")\n        if before[\"identity_probes\"] != after[\"identity_probes\"]:\n            raise SystemExit(\"host identity or held policy drifted across baseline pilot\")\n        if before[\"lease\"] != after[\"lease\"]:\n            raise SystemExit(\"serialized lease changed across baseline pilot\")\n        if before[\"source_sha\"] != source_sha or after[\"source_sha\"] != source_sha:\n            raise SystemExit(\"host receipts do not bind the baseline source\")\n        if before[\"result\"] != \"success\" or after[\"result\"] != \"success\":\n            raise SystemExit(\"pre/post host calibration did not pass\")\n        if (\n            pilot[\"source_sha\"] != source_sha\n            or pilot[\"candidate_data_present\"]\n            or pilot[\"profile_id\"] != \"observer-baseline-pilot-073-v2\"\n            or pilot[\"paired_estimator\"] != \"hodges-lehmann-v1\"\n        ):\n            raise SystemExit(\"pilot is not baseline-only\")\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        manifest = {\n            \"schema_version\": 1,\n            \"release\": \"0.73\",\n            \"profile_id\": \"observer-baseline-pilot-073-v2\",\n            \"source_sha\": source_sha,\n            \"result\": \"passed\" if pilot[\"i73_freeze_eligible\"] else \"insufficient-baseline\",\n            \"host_fingerprint\": before[\"host_fingerprint\"],\n            \"preflight_sha256\": digest(before_path),\n            \"postflight_sha256\": digest(after_path),\n            \"baseline_pilot_sha256\": digest(pilot_path),\n            \"candidate_data_present\": False,\n            \"candidate_measurement_authorized\": False,\n            \"silent_retry_allowed\": False,\n        }\n        (root / \"campaign-manifest.json\").write_text(\n            json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n        )\n        if manifest[\"result\"] != \"passed\":\n            raise SystemExit(\"baseline pilot did not establish three stable rates\")\n        PY\n    - name: Retain baseline-only pilot packet\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-baseline-pilot-v2-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.73/reference/baseline-pilot-v2/**\n        if-no-files-found: error\n        retention-days: 90\n  integrated:\n    if: inputs.source_sha != 'e757556d3a31d565f52a9561d6d4e555bb1cc373'\n    uses: ./.github/workflows/p