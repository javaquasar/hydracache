d_074.py \\\n            --attempts \"$EVIDENCE_DIR/attempts.json\" \\\n            --contract docs/testing/performance/0.74/long-run-controller-resilience-contract.toml \\\n            --statistics docs/testing/performance/0.74/statistics.toml \\\n            --expected-i74-source \"$INSTALLED_SOURCE_COMMIT\" \\\n            --expected-c74-source \"$INSTALLED_SOURCE_COMMIT\" \\\n            --expected-host-receipt \"$HOST_RECEIPT_SHA256\" \\\n            --output \"$EVIDENCE_DIR/analysis.json\"\n\n      - name: Verify stable service and rehearsal-only decision\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(systemctl is-active \"$SUPERVISOR_SERVICE\" || true)\" = active\n          test \"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=NRestarts --value)\" = 0\n          test ! -e /run/hydracache-perf/controller-loss-smoke-v1.json\n          if test -f \"$EVIDENCE_DIR/analysis.json\"; then\n            python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n\n          receipt = json.loads(\n              (pathlib.Path(os.environ[\"EVIDENCE_DIR\"]) / \"analysis.json\").read_text()\n          )\n          assert receipt[\"schema_version\"] == \"hydracache-w11-role-overhead-rehearsal-v1\"\n          assert receipt[\"evidence_class\"] == \"non-product-role-overhead-rehearsal\"\n          assert receipt[\"promotable\"] is False\n          assert receipt[\"pairs_per_role\"] == 5\n          assert receipt[\"host_receipt_sha256\"] == os.environ[\"HOST_RECEIPT_SHA256\"]\n          assert receipt[\"decision\"][\"role_overhead_qualification_complete\"] is False\n          assert receipt[\"decision\"][\"release_admission_allowed\"] is False\n          PY\n          fi\n\n      - name: Retain role-overhead rehearsal evidence\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-long-run-role-overhead-smoke-074-${{ github.sha }}-${