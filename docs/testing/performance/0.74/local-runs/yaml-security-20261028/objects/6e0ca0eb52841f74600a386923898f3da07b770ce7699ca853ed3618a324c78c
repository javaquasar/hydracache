{"expect": "valid", "id": ".github/workflows/performance-host-admission-073.yml", "source_sha256": "1666f6fec881bc380be4f1a85bdf20fca713be3815152c48551ad72fcc74adcd", "text": "name: Performance Host Admission 0.73\n\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: \"Exact lowercase 40-character source commit\"\n        required: true\n        type: string\n      lease_owner:\n        description: \"Operator holding the serialized performance-host lease\"\n        required: true\n        type: string\n      lease_end:\n        description: \"Approved lease end in RFC3339 form\"\n        required: true\n        type: string\n      long_run_phase:\n        description: \"Explicit long-run phase; confirmation requires checked-in green qualification evidence\"\n        required: true\n        default: qualification\n        type: choice\n        options:\n          - qualification\n          - confirmation\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ inputs.lease_owner == 'compatibility-073' && 'compatibility-073' || 'performance-reference-073-host' }}\n  cancel-in-progress: false\n\njobs:\n  authorize-long-run:\n    if: startsWith(inputs.lease_owner, 'long-run-073@')\n    name: Approve serialized 0.73 long-run phase\n    runs-on: ubuntu-latest\n    environment: performance-reference-073\n    timeout-minutes: 10\n    steps:\n      - name: Bind approved dispatch inputs\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n          INPUT_PHASE: ${{ inputs.long_run_phase }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]\n          [[ \"$INPUT_LEASE_OWNER\" = long-run-073@* ]]\n          [[ \"$INPUT_PHASE\" = \"qualification\" || \"$INPUT_PHASE\" = \"confirmation\" ]]\n          date --date=\"$INPUT_LEASE_END\" >/dev/null\n\n  admit:\n    if: inputs.lease_owner != 'compatibility-073' && !startsWith(inputs.lease_owner, 'long-run-073@')\n    name: Fresh 0.73 host admission\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-073\n    timeout-minutes: 120\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: \"1\"\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      EVIDENCE_DIR: target/performance-evidence/0.73/reference/host-admission\n\n    steps:\n      - name: Checkout exact source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Resolve dispatch identity and serialized lease\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n        run: |\n          set -euo pipefail\n          source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n          lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n          lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+2 hours' --iso-8601=seconds)}\"\n          [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n          test -n \"$lease_owner\"\n          date --date=\"$lease_end\" >/dev/null\n          mkdir -p \"$EVIDENCE_DIR\"\n          {\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n            echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Expose runner Rust toolchain\n        shell: bash\n        run: |\n          set -euo pipefail\n          rust_bin=\"$HOME/.cargo/bin\"\n          test -x \"$rust_bin/cargo\"\n          test -x \"$rust_bin/rustc\"\n          echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n          \"$rust_bin/cargo\" --version\n          \"$rust_bin/rustc\" --version\n\n      - name: Provision required host diagnostics before fingerprinting\n        shell: bash\n        run: |\n          set -euo pipefail\n          if ! command -v pidstat >/dev/null 2>&1; then\n            sudo apt-get update\n            sudo DEBIAN_FRONTEND=noninteractive apt-get install --yes sysstat\n          fi\n          pidstat -V\n\n      - name: Capture pre-build host identity and calibration\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$EVIDENCE_DIR/preflight.json\"\n\n      - name: Build the exact release load generator\n        shell: bash\n        run: cargo build -p hydracache-loadgen --release --locked\n\n      - name: Capture post-build host identity and calibration\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$EVIDENCE_DIR/postflight.json\"\n\n      - name: Seal admission manifest\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_SOURCE_SHA\" <<'PY'\n          import hashlib\n          import json\n          import pathlib\n          import sys\n\n          evidence = pathlib.Path(sys.argv[1])\n          expected_sha = sys.argv[2]\n          before_path = evidence / \"preflight.json\"\n          after_path = evidence / \"postflight.json\"\n          before = json.loads(before_path.read_text(encoding=\"utf-8\"))\n          after = json.loads(after_path.read_text(encoding=\"utf-8\"))\n\n          for name, receipt in ((\"preflight\", before), (\"postflight\", after)):\n              if receipt[\"release\"] != \"0.73\" or receipt[\"profile_id\"] != \"performance-reference-073-v1\":\n                  raise SystemExit(f\"{name} receipt identity mismatch\")\n              if receipt[\"source_sha\"] != expected_sha or receipt[\"result\"] != \"success\":\n                  raise SystemExit(f\"{name} receipt did not admit exact source\")\n              if not receipt[\"ship_evidence_eligible\"]:\n                  raise SystemExit(f\"{name} receipt is not host eligible\")\n              if receipt[\"calibration\"][\"relative_spread\"] > receipt[\"calibration_limit\"]:\n                  raise SystemExit(f\"{name} calibration exceeded the frozen limit\")\n\n          if before[\"host_fingerprint\"] != after[\"host_fingerprint\"]:\n              raise SystemExit(\"host fingerprint drifted across admission\")\n          if before[\"identity_probes\"] != after[\"identity_probes\"]:\n              raise SystemExit(\"identity or held host policy drifted across admission\")\n          if before[\"lease\"] != after[\"lease\"]:\n              raise SystemExit(\"serialized lease changed across admission\")\n\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          manifest = {\n              \"schema_version\": 1,\n              \"release\": \"0.73\",\n              \"profile_id\": \"performance-reference-073-v1\",\n              \"source_sha\": expected_sha,\n              \"result\": \"admitted\",\n              \"host_fingerprint\": before[\"host_fingerprint\"],\n              \"lease\": before[\"lease\"],\n              \"calibration_limit\": before[\"calibration_limit\"],\n              \"pre_calibration_relative_spread\": before[\"calibration\"][\"relative_spread\"],\n              \"post_calibration_relative_spread\": after[\"calibration\"][\"relative_spread\"],\n              \"preflight_sha256\": digest(before_path),\n              \"postflight_sha256\": digest(after_path),\n              \"silent_retry_allowed\": False,\n              \"candidate_measurement_authorized\": False,\n          }\n          (evidence / \"admission-manifest.json\").write_text(\n              json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n          )\n          PY\n\n      - name: Retain host admission packet\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-host-admission-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/performance-evidence/0.73/reference/host-admission/*.json\n          if-no-files-found: error\n          retention-days: 90\n\n  compatibility:\n    if: inputs.lease_owner == 'compatibility-073'\n    name: Published B72/C73 compatibility bootstrap\n    runs-on: ubuntu-latest\n    timeout-minutes: 120\n    steps:\n      - name: Check out exact compatibility tooling\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          ref: ${{ inputs.source_sha }}\n\n      - name: Run exact wire, durable, and rolling campaign\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          EVIDENCE_DIR: ${{ github.workspace }}/target/compatibility-evidence/0.73/${{ github.run_id }}-${{ github.run_attempt }}\n        run: |\n          set -o pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          bash scripts/perf/run_compatibility_073_ci.sh \\\n            \"$INPUT_SOURCE_SHA\" \"$EVIDENCE_DIR\" 2>&1 | tee \"$EVIDENCE_DIR/ci.log\"\n\n      - name: Upload complete or incomplete compatibility packet\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: compatibility-073-${{ inputs.source_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ github.workspace }}/target/compatibility-evidence/0.73/${{ github.run_id }}-${{ github.run_attempt }}\n          if-no-files-found: error\n          retention-days: 30\n\n  long-run-qualification:\n    needs: authorize-long-run\n    if: startsWith(inputs.lease_owner, 'long-run-073@') && inputs.long_run_phase == 'qualification'\n    name: Integrated I73/C73 long-run qualification bootstrap\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: ${{ inputs.long_run_phase }}\n      role: pair\n      entry_serializes_host: true\n\n  long-run-confirmation-i73:\n    needs: authorize-long-run\n    if: startsWith(inputs.lease_owner, 'long-run-073@') && inputs.long_run_phase == 'confirmation'\n    name: Integrated I73 confirmation role\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: confirmation\n      role: I73\n      entry_serializes_host: true\n\n  long-run-confirmation-c73:\n    needs: long-run-confirmation-i73\n    if: needs.long-run-confirmation-i73.result == 'success'\n    name: Integrated C73 confirmation role and seal\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: confirmation\n      role: C73\n      entry_serializes_host: true\n"}
{"expect": "valid", "id": ".github/workflows/performance-integrated-host-073.yml", "source_sha256": "d7e6a294d275cea3f4785299db230b4d583feb274afe6bd26b53dcf6b64fc338", "text": "name: Performance Integrated Host 0.73\n\non:\n  workflow_dispatch:\n    inputs:\n      tooling_sha:\n        description: \"Exact lowercase 40-character commit containing the reviewed harness and runner\"\n        required: true\n        type: string\n      lease_owner:\n        description: \"Operator holding the serialized performance-host lease\"\n        required: true\n        type: string\n      lease_end:\n        description: \"Approved lease end in RFC3339 form\"\n        required: true\n        type: string\n  workflow_call:\n    inputs:\n      tooling_sha:\n        description: \"Exact lowercase 40-character commit containing the reviewed harness and runner\"\n        required: true\n        type: string\n      lease_owner:\n        description: \"Operator holding the serialized performance-host lease\"\n        required: true\n        type: string\n      lease_end:\n        description: \"Approved lease end in RFC3339 form\"\n        required: true\n        type: string\n      entry_serializes_host:\n        description: \"The registered caller already holds the shared host concurrency group\"\n        required: false\n        default: false\n        type: boolean\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ inputs.entry_serializes_host && format('performance-reference-073-host-nested-{0}', github.run_id) || 'performance-reference-073-host' }}\n  cancel-in-progress: false\n\njobs:\n  compare:\n    name: Exact I73 versus focused C73 integrated comparison\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-073\n    timeout-minutes: 180\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: \"1\"\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      I73_SHA: e757556d3a31d565f52a9561d6d4e555bb1cc373\n      C73_SHA: 7e3070894aa51af96cdcb3e350eff923a309e1fa\n      C73_TREE_OID: e2c438b9a248586a4f72d3eca3d1c5369fff440b\n      EVIDENCE_DIR: ${{ github.workspace }}/target/performance-evidence/0.73/integrated-host-${{ github.run_id }}-${{ github.run_attempt }}\n\n    steps:\n      - name: Check out reviewed tooling revision\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          ref: ${{ inputs.tooling_sha }}\n\n      - name: Resolve tooling identity and serialized lease\n        shell: bash\n        env:\n          INPUT_TOOLING_SHA: ${{ inputs.tooling_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_TOOLING_SHA\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$INPUT_TOOLING_SHA\"\n          test -n \"$INPUT_LEASE_OWNER\"\n          date --date=\"$INPUT_LEASE_END\" >/dev/null\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          mkdir -p \"$EVIDENCE_DIR\"\n          {\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$INPUT_LEASE_OWNER\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$INPUT_LEASE_END\"\n            echo \"EXPECTED_TOOLING_SHA=$INPUT_TOOLING_SHA\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Expose and verify required host tools\n        shell: bash\n        run: |\n          set -euo pipefail\n          rust_bin=\"$HOME/.cargo/bin\"\n          test -x \"$rust_bin/cargo\"\n          test -x \"$rust_bin/rustc\"\n          echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n          cargo --version\n          rustc --version\n          python3 --version\n          taskset --version\n          pidstat -V\n\n      - name: Capture pre-campaign calibration\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$EVIDENCE_DIR/preflight.json\"\n\n      - name: Materialize exact product trees and identical overlays\n        shell: bash\n        run: |\n          set -euo pipefail\n          run_key=\"${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}\"\n          i73_root=\"$RUNNER_TEMP/hydracache-i73-$run_key\"\n          c73_root=\"$RUNNER_TEMP/hydracache-c73-$run_key\"\n          i73_stage=\"$RUNNER_TEMP/integrated-i73-stage-$run_key\"\n          c73_stage=\"$RUNNER_TEMP/integrated-c73-stage-$run_key\"\n          git worktree prune\n          git worktree add --detach \"$i73_root\" \"$I73_SHA\"\n          git worktree add --detach \"$c73_root\" \"$C73_SHA\"\n          test \"$(git -C \"$i73_root\" rev-parse HEAD)\" = \"$I73_SHA\"\n          test \"$(git -C \"$c73_root\" rev-parse HEAD)\" = \"$C73_SHA\"\n          test \"$(git -C \"$c73_root\" rev-parse 'HEAD^{tree}')\" = \"$C73_TREE_OID\"\n          mkdir -p \"$i73_stage/tools\" \"$c73_stage/tools\"\n          cp -a tools/performance-integrated-073 \"$i73_stage/tools/\"\n          cp -a tools/performance-integrated-073 \"$c73_stage/tools/\"\n          ln -s \"$i73_root/Cargo.toml\" \"$i73_stage/Cargo.toml\"\n          ln -s \"$c73_root/Cargo.toml\" \"$c73_stage/Cargo.toml\"\n          ln -s \"$i73_root/crates\" \"$i73_stage/crates\"\n          ln -s \"$c73_root/crates\" \"$c73_stage/crates\"\n          {\n            echo \"I73_ROOT=$i73_root\"\n            echo \"C73_ROOT=$c73_root\"\n            echo \"I73_OVERLAY=$i73_stage/tools/performance-integrated-073\"\n            echo \"C73_OVERLAY=$c73_stage/tools/performance-integrated-073\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Build exact role servers and standalone harnesses\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo build --manifest-path \"$I73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n          cargo build --manifest-path \"$C73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n          test \"$(sha256sum \"$I73_OVERLAY/Cargo.lock\" | cut -d' ' -f1)\" = \"3c2e8a20a26c6105fec6f449ce6cad43ba4a9a65f78516f5c0110ff0a9ca4953\"\n          test \"$(sha256sum \"$C73_OVERLAY/Cargo.lock.c73\" | cut -d' ' -f1)\" = \"35b7ab4f62cee2ce41aa0547cc632a11d90e0d89861b87158bbcf7b184767630\"\n          cargo build --manifest-path \"$I73_OVERLAY/Cargo.toml\" --release --locked\n          cp \"$C73_OVERLAY/Cargo.lock.c73\" \"$C73_OVERLAY/Cargo.lock\"\n          cargo build --manifest-path \"$C73_OVERLAY/Cargo.toml\" --release --locked\n          cp \"$I73_OVERLAY/Cargo.lock\" \"$C73_OVERLAY/Cargo.lock\"\n          diff -qr --exclude=target \"$I73_OVERLAY\" \"$C73_OVERLAY\"\n          test -z \"$(git -C \"$I73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n          test -z \"$(git -C \"$C73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n          {\n            echo \"I73_SERVER=$I73_ROOT/target/release/hydracache-server\"\n            echo \"C73_SERVER=$C73_ROOT/target/release/hydracache-server\"\n            echo \"I73_HARNESS=$I73_OVERLAY/target/release/performance-integrated-073\"\n            echo \"C73_HARNESS=$C73_OVERLAY/target/release/performance-integrated-073\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Falsify the integrated accounting guard\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_integrated_host_073.py \\\n            --mode canary \\\n            --i73-harness \"$I73_HARNESS\" \\\n            --c73-harness \"$C73_HARNESS\" \\\n            --i73-server \"$I73_SERVER\" \\\n            --c73-server \"$C73_SERVER\" \\\n            --i73-overlay \"$I73_OVERLAY\" \\\n            --c73-overlay \"$C73_OVERLAY\" \\\n            --scenario docs/testing/performance/0.73/w10-focused-host-comparison-contract.toml \\\n            --output \"$EVIDENCE_DIR/canary\" \\\n            --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n            --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n\n      - name: Run all frozen counterbalanced pairs\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_integrated_host_073.py \\\n            --mode campaign \\\n            --i73-harness \"$I73_HARNESS\" \\\n            --c73-harness \"$C73_HARNESS\" \\\n            --i73-server \"$I73_SERVER\" \\\n            --c73-server \"$C73_SERVER\" \\\n            --i73-overlay \"$I73_OVERLAY\" \\\n            --c73-overlay \"$C73_OVERLAY\" \\\n            --scenario docs/testing/performance/0.73/w10-focused-host-comparison-contract.toml \\\n            --output \"$EVIDENCE_DIR/campaign\" \\\n            --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n            --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n\n      - name: Capture post-campaign calibration\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$EVIDENCE_DIR/postflight.json\"\n\n      - name: Seal campaign packet\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_TOOLING_SHA\" <<'PY'\n          import hashlib\n          import json\n          import pathlib\n          import sys\n\n          root = pathlib.Path(sys.argv[1])\n          tooling_sha = sys.argv[2]\n          pre_path = root / \"preflight.json\"\n          post_path = root / \"postflight.json\"\n          canary_path = root / \"canary\" / \"canary.json\"\n          campaign_path = root / \"campaign\" / \"integrated-host-campaign.json\"\n          required = (pre_path, post_path, canary_path, campaign_path)\n          missing = [str(path.relative_to(root)) for path in required if not path.is_file()]\n          if missing:\n              digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n              incomplete = {\n                  \"schema_version\": 1,\n                  \"release\": \"0.73\",\n                  \"profile_id\": \"integrated-focused-host-073-v1\",\n                  \"tooling_sha\": tooling_sha,\n                  \"result\": \"incomplete\",\n                  \"missing\": missing,\n                  \"available_sha256\": {\n                      str(path.relative_to(root)): digest(path)\n                      for path in required\n                      if path.is_file()\n                  },\n                  \"allocation_and_rss_promotable\": False,\n                  \"silent_retry_allowed\": False,\n              }\n              (root / \"manifest.json\").write_text(\n                  json.dumps(incomplete, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n              )\n              raise SystemExit(\"campaign packet is incomplete: \" + \", \".join(missing))\n          pre = json.loads(pre_path.read_text(encoding=\"utf-8\"))\n          post = json.loads(post_path.read_text(encoding=\"utf-8\"))\n          canary = json.loads(canary_path.read_text(encoding=\"utf-8\"))\n          campaign = json.loads(campaign_path.read_text(encoding=\"utf-8\"))\n          for label, receipt in ((\"pre\", pre), (\"post\", post)):\n              if receipt[\"source_sha\"] != tooling_sha or receipt[\"result\"] != \"success\":\n                  raise SystemExit(f\"{label} calibration did not admit the tooling revision\")\n              if not receipt[\"ship_evidence_eligible\"]:\n                  raise SystemExit(f\"{label} host receipt is not promotable\")\n              if receipt[\"calibration\"][\"relative_spread\"] > receipt[\"calibration_limit\"]:\n                  raise SystemExit(f\"{label} calibration exceeded its frozen limit\")\n          if pre[\"host_fingerprint\"] != post[\"host_fingerprint\"]:\n              raise SystemExit(\"host fingerprint drifted across campaign\")\n          if pre[\"identity_probes\"] != post[\"identity_probes\"] or pre[\"lease\"] != post[\"lease\"]:\n              raise SystemExit(\"host policy or serialized lease drifted across campaign\")\n          if canary[\"result\"] != \"passed\" or not canary[\"marker_observed\"] or not canary[\"receipt_absent\"]:\n              raise SystemExit(\"accounting canary did not fail closed\")\n          expected_attempts = 3 * 5 * 2\n          if campaign[\"attempt_count\"] != expected_attempts or campaign[\"failed_attempts\"]:\n              raise SystemExit(\"campaign does not contain thirty valid independent attempts\")\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          manifest = {\n              \"schema_version\": 1,\n              \"release\": \"0.73\",\n              \"profile_id\": \"integrated-focused-host-073-v1\",\n              \"tooling_sha\": tooling_sha,\n              \"baseline_source_sha\": campaign[\"baseline_source_sha\"],\n              \"candidate_source_sha\": campaign[\"candidate_source_sha\"],\n              \"result\": campaign[\"result\"],\n              \"host_fingerprint\": pre[\"host_fingerprint\"],\n              \"lease\": pre[\"lease\"],\n              \"preflight_sha256\": digest(pre_path),\n              \"postflight_sha256\": digest(post_path),\n              \"canary_sha256\": digest(canary_path),\n              \"campaign_sha256\": digest(campaign_path),\n              \"identity\": campaign[\"identity\"],\n              \"allocation_and_rss_promotable\": False,\n              \"silent_retry_allowed\": False,\n          }\n          (root / \"manifest.json\").write_text(\n              json.dumps(manifest, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n          )\n          if campaign[\"result\"] != \"passed\":\n              raise SystemExit(\"focused integrated candidate failed a primary guard\")\n          PY\n\n      - name: Upload complete campaign packet\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: performance-integrated-host-073-${{ inputs.tooling_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ env.EVIDENCE_DIR }}\n          if-no-files-found: error\n          retention-days: 30\n"}
{"expect": "valid", "id": ".github/workflows/performance-kernel-attribution-074.yml", "source_sha256": "88f4a05cdc25e1a800c5274ecff129a6f06d7b26066b0709a2af4e56d4caff04", "text": "name: Performance Kernel Attribution 0.74\n\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact lowercase 40-character attribution source commit\n        required: true\n        type: string\n      lease_owner:\n        description: Operator holding the serialized performance-host lease\n        required: true\n        type: string\n      lease_end:\n        description: Approved lease end in RFC3339 form\n        required: true\n        type: string\n  push:\n    branches:\n      - feat/0.74-resp-native-throughput\n    paths:\n      - .github/workflows/performance-kernel-attribution-074.yml\n      - scripts/perf/performance_kernel_attribution_074.py\n      - scripts/perf/test_performance_kernel_attribution_074.py\n      - tools/resp-pipeline-profile-074/**\n      - docs/testing/performance/0.74/w9c-linux-kernel-attribution-contract.toml\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: performance-reference-074-host\n  cancel-in-progress: false\n\njobs:\n  attribute:\n    if: github.event_name == 'workflow_dispatch'\n    name: Non-promotable Linux scheduler/socket attribution\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 90\n    env:\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w9c-kernel\n\n    steps:\n      - name: Check out exact attribution source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha || github.sha }}\n\n      - name: Resolve immutable source and lease\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n        run: |\n          set -euo pipefail\n          source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n          lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n          lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+90 minutes' --iso-8601=seconds)}\"\n          [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          test -n \"$lease_owner\"\n          lease_epoch=\"$(date --date=\"$lease_end\" +%s)\"\n          now_epoch=\"$(date +%s)\"\n          test \"$lease_epoch\" -gt \"$now_epoch\"\n          test \"$lease_epoch\" -le \"$((now_epoch + 7200))\"\n          {\n            echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Verify available profiling boundary\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(uname -s)\" = Linux\n          test \"$(uname -m)\" = x86_64\n          command -v cargo\n          command -v rustc\n          command -v python3\n          command -v strace\n          command -v ss\n          python3 -m unittest scripts.perf.test_performance_kernel_attribution_074\n\n      - name: Capture host and kernel capability receipt\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          python3 - \"$EVIDENCE_DIR/preflight.json\" <<'PY'\n          import hashlib, json, os, pathlib, platform, subprocess, sys\n          def command(*args):\n              return subprocess.check_output(args, text=True, stderr=subprocess.STDOUT).strip()\n          def readable(path):\n              try:\n                  with open(path, 'rb') as stream:\n                      stream.read(1)\n                  return True\n              except OSError:\n                  return False\n          machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n          sysctls = {}\n          for name in ('kernel.perf_event_paranoid', 'kernel.unprivileged_bpf_disabled', 'kernel.kptr_restrict', 'kernel.yama.ptrace_scope'):\n              try:\n                  sysctls[name] = command('sysctl', '-n', name)\n              except subprocess.CalledProcessError as error:\n                  sysctls[name] = f'unavailable:{error.returncode}'\n          value = {\n              'schema_version': 1,\n              'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n              'lease': {'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'], 'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END']},\n              'host': {\n                  'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                  'node': platform.node(), 'machine': platform.machine(), 'kernel': platform.release(),\n                  'cpu_count': os.cpu_count(),\n              },\n              'toolchain': {\n                  'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version'),\n                  'strace': command('strace', '--version').splitlines()[0], 'ss': command('ss', '--version'),\n              },\n              'kernel_controls': sysctls,\n              'tracefs_syscall_events_readable': readable('/sys/kernel/tracing/events/syscalls'),\n              'debugfs_syscall_events_readable': readable('/sys/kernel/debug/tracing/events/syscalls'),\n          }\n          pathlib.Path(sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n          PY\n\n      - name: Build exact RESP attribution profiler\n        timeout-minutes: 30\n        shell: bash\n        run: |\n          set -euo pipefail\n          CARGO_TARGET_DIR=target/w9c-kernel-build cargo build \\\n            --manifest-path tools/resp-pipeline-profile-074/Cargo.toml \\\n            --release --locked\n\n      - name: Run counterbalanced syscall attribution\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_kernel_attribution_074.py \\\n            --binary target/w9c-kernel-build/release/resp-pipeline-profile-074 \\\n            --output-dir \"$EVIDENCE_DIR/campaign\" \\\n            --source-commit \"$EXPECTED_SOURCE_SHA\" \\\n            --tool-source tools/resp-pipeline-profile-074/src/main.rs \\\n            --tool-lock tools/resp-pipeline-profile-074/Cargo.lock \\\n            --contract docs/testing/performance/0.74/w9c-linux-kernel-attribution-contract.toml \\\n            --repeats 5\n\n      - name: Seal non-promotable attribution packet\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - \"$EVIDENCE_DIR\" <<'PY'\n          import hashlib, json, os, pathlib, sys\n          root = pathlib.Path(sys.argv[1])\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          packet = {\n              'schema_version': 1, 'release': '0.74',\n              'profile_id': 'w9c-linux-kernel-attribution-074-v1',\n              'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n              'result': 'incomplete-owner-attribution',\n              'candidate_data_present': False, 'acceptance_decision_allowed': False,\n              'promotable': False, 'silent_retry_allowed': False,\n          }\n          preflight = root / 'preflight.json'\n          if preflight.is_file():\n              packet['preflight_sha256'] = digest(preflight)\n              packet['host'] = json.loads(preflight.read_text())['host']\n          manifest_path = root / 'campaign' / 'manifest.json'\n          summary_path = root / 'campaign' / 'summary.json'\n          if manifest_path.is_file():\n              manifest = json.loads(manifest_path.read_text())\n              packet['manifest_sha256'] = digest(manifest_path)\n              packet['attempts'] = manifest['attempts']\n              packet['valid_attempts'] = manifest['valid_attempts']\n              packet['failed_attempts'] = manifest['failed_attempts']\n              if summary_path.is_file() and manifest['failed_attempts'] == 0:\n                  packet['summary_sha256'] = digest(summary_path)\n                  packet['result'] = 'complete-owner-attribution'\n          root.mkdir(parents=True, exist_ok=True)\n          (root / 'packet.json').write_text(json.dumps(packet, indent=2, sort_keys=True) + '\\n')\n          PY\n\n      - name: Retain W9c attribution packet\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-kernel-attribution-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/performance-evidence/0.74/reference/w9c-kernel/**\n          if-no-files-found: error\n          retention-days: 90\n"}
{"expect": "valid", "id": ".github/workflows/performance-kernel-capability-074.yml", "source_sha256": "dfe07b986b8b9772019bf9f16f3d2701d9998404702ab3c5a48e4a2264e0f58a", "text": "name: Performance Kernel Capability Probe 0.74\n\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact lowercase 40-character profiling source commit\n        required: true\n        type: string\n  push:\n    branches:\n      - feat/0.74-resp-native-throughput\n    paths:\n      - .github/workflows/performance-kernel-capability-074.yml\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: performance-reference-074-host\n  cancel-in-progress: false\n\njobs:\n  probe:\n    name: Read-only kernel profiling capability probe\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 15\n    steps:\n      - name: Check out exact profiling source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha || github.sha }}\n\n      - name: Validate source identity\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        run: |\n          set -euo pipefail\n          source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n          [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\" >> \"$GITHUB_ENV\"\n\n      - name: Probe available read-only kernel interfaces\n        shell: bash\n        run: |\n          set -euo pipefail\n          output=\"target/performance-evidence/0.74/reference/w9c-kernel-capability\"\n          mkdir -p \"$output\"\n          python3 - \"$output/capability.json\" <<'PY'\n          import hashlib\n          import json\n          import os\n          import pathlib\n          import shutil\n          import subprocess\n          import sys\n\n          def read(path):\n              value = pathlib.Path(path)\n              try:\n                  return value.read_text().strip() if value.is_file() else None\n              except OSError as error:\n                  return {\"error\": str(error)}\n\n          def accessible(path):\n              try:\n                  value = pathlib.Path(path)\n                  if not value.is_file():\n                      return {\"exists\": False, \"readable\": False}\n                  value.read_bytes()\n                  return {\"exists\": True, \"readable\": True}\n              except OSError as error:\n                  return {\"exists\": True, \"readable\": False, \"error\": str(error)}\n\n          def command(argv):\n              try:\n                  completed = subprocess.run(argv, text=True, capture_output=True, timeout=20)\n                  return {\n                      \"argv\": argv,\n                      \"exit_code\": completed.returncode,\n                      \"stdout\": completed.stdout[-8192:],\n                      \"stderr\": completed.stderr[-8192:],\n                  }\n              except (OSError, subprocess.TimeoutExpired) as error:\n                  return {\"argv\": argv, \"error\": str(error)}\n\n          tools = {}\n          for name in (\"strace\", \"perf\", \"pidstat\", \"ss\", \"bpftool\", \"bpftrace\", \"capsh\"):\n              path = shutil.which(name)\n              tools[name] = {\"path\": path}\n              if path:\n                  version_args = {\n                      \"strace\": [path, \"--version\"],\n                      \"perf\": [path, \"--version\"],\n                      \"pidstat\": [path, \"-V\"],\n                      \"ss\": [path, \"--version\"],\n                      \"bpftool\": [path, \"version\"],\n                      \"bpftrace\": [path, \"--version\"],\n                      \"capsh\": [path, \"--print\"],\n                  }[name]\n                  tools[name][\"version\"] = command(version_args)\n\n          machine = pathlib.Path(\"/etc/machine-id\").read_bytes().strip()\n          receipt = {\n              \"schema_version\": \"hydracache-w9c-kernel-capability-v1\",\n              \"release\": \"0.74\",\n              \"source_sha\": os.environ[\"EXPECTED_SOURCE_SHA\"],\n              \"host\": {\n                  \"machine_id_sha256\": hashlib.sha256(machine).hexdigest(),\n                  \"kernel_release\": os.uname().release,\n                  \"machine\": os.uname().machine,\n                  \"euid\": os.geteuid(),\n                  \"groups\": os.getgroups(),\n              },\n              \"policy\": {\n                  \"perf_event_paranoid\": read(\"/proc/sys/kernel/perf_event_paranoid\"),\n                  \"kptr_restrict\": read(\"/proc/sys/kernel/kptr_restrict\"),\n                  \"unprivileged_bpf_disabled\": read(\"/proc/sys/kernel/unprivileged_bpf_disabled\"),\n                  \"yama_ptrace_scope\": read(\"/proc/sys/kernel/yama/ptrace_scope\"),\n                  \"tracefs_sys_enter_write\": accessible(\"/sys/kernel/tracing/events/syscalls/sys_enter_write/id\"),\n                  \"debugfs_sys_enter_write\": accessible(\"/sys/kernel/debug/tracing/events/syscalls/sys_enter_write/id\"),\n              },\n              \"tools\": tools,\n              \"probes\": {\n                  \"strace_summary\": command([\"strace\", \"-f\", \"-qq\", \"-c\", \"-e\", \"trace=read,write,readv,writev,recvfrom,sendto,recvmsg,sendmsg\", \"true\"]),\n                  \"perf_software\": command([\"perf\", \"stat\", \"-x,\", \"-e\", \"task-clock,context-switches,cpu-migrations,page-faults\", \"--\", \"true\"]),\n                  \"perf_syscall_tracepoint\": command([\"perf\", \"stat\", \"-x,\", \"-e\", \"syscalls:sys_enter_write\", \"--\", \"true\"]),\n                  \"socket_inventory\": command([\"ss\", \"-tinm\"]),\n              },\n              \"product_mutation\": False,\n              \"promotable\": False,\n          }\n          pathlib.Path(sys.argv[1]).write_text(json.dumps(receipt, indent=2, sort_keys=True) + \"\\n\")\n          PY\n          python3 -m json.tool \"$output/capability.json\" >/dev/null\n\n      - name: Retain capability receipt\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-kernel-capability-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/performance-evidence/0.74/reference/w9c-kernel-capability/capability.json\n          if-no-files-found: error\n          retention-days: 90\n"}
