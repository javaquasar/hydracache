stemd_unit::tests::reads_a_real_loaded_service_over_dbus \\\n            --locked -- --ignored --exact\n\n      - name: Run bounded fixture-only transient unit smoke\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \\\n            > \"$EVIDENCE_DIR/provisioning.json\"\n          test \"$(python3 -c 'import json, os; print(json.load(open(os.environ[\"EVIDENCE_DIR\"] + \"/provisioning.json\"))[\"source_commit\"])')\" = \"$GITHUB_SHA\"\n          sudo -n /usr/local/sbin/hydracache-provision-host-074 --systemd-smoke \\\n            > \"$EVIDENCE_DIR/systemd-smoke.json\"\n          python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n\n          receipt = json.loads(\n              (pathlib.Path(os.environ[\"EVIDENCE_DIR\"]) / \"systemd-smoke.json\").read_text()\n          )\n          assert receipt[\"schema_version\"] == \"hydracache-w11-systemd-smoke-v1\"\n          assert receipt[\"fixture_command\"] == \"/usr/bin/sleep 1\"\n          assert receipt[\"product_candidate_started\"] is False\n          assert receipt[\"saw_running\"] is True\n          assert receipt[\"running_main_pid\"] > 0\n          assert receipt[\"terminal\"][\"active_state\"] == \"active\"\n          assert receipt[\"terminal\"][\"sub_state\"] == \"exited\"\n          assert receipt[\"terminal\"][\"result\"] == \"success\"\n          after_stop = receipt[\"after_stop\"]\n          assert after_stop is None or (\n              after_stop[\"active_state\"] == \"inactive\"\n              and after_stop[\"sub_state\"] == \"dead\"\n              and after_stop[\"main_pid\"] == 0\n          )\n          PY\n\n      - name: Retain bounded systemd smoke receipt\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-long-run-systemd-smoke-074-${{ github.sha }}-${{ github.run_id }}-${{ g