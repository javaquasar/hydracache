 30\n"}
{"expect": "valid", "id": ".github/workflows/performance-long-run-qualification-074.yml", "source_sha256": "33904a5c12a102bac1ae8b7d62b3bb87c45e01d969a74f84675bdec057a31324", "text": "name: Performance Long-Run Controller 0.74\n\non:\n  workflow_call:\n    inputs:\n      source_sha:\n        description: Exact reviewed 40-character tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n      operation:\n        description: Explicit typed supervisor mutation\n        required: true\n        type: string\n      campaign_id:\n        description: Existing frozen 64-character campaign id\n        required: true\n        type: string\n      manifest_sha256:\n        description: Exact frozen campaign manifest SHA-256\n        required: true\n        type: string\n      expected_state_revision:\n        description: Exact durable revision expected by this operation\n        required: true\n        type: string\n      request_id:\n        description: New UUIDv4\n        required: true\n        type: string\n      approval_nonce_sha256:\n        description: Required only for abort\n        required: false\n        default: \"\"\n        type: string\n      start_bundle_run_id:\n        description: Source workflow run containing the revision-zero start bundle\n        required: false\n        default: \"\"\n        type: string\n      start_bundle_artifact_name:\n        description: Exact six-file start bundle artifact name\n        required: false\n        default: \"\"\n        type: string\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact reviewed 40-character tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n      operation:\n        description: Explicit typed supervisor mutation; status remains available through the monitor\n        required: true\n        type: choice\n        options:\n          - start\n          - attach\n          - seal\n          - abort\n      campaign_id:\n        description: Existing frozen 64-character campaign id\n        required: true\n        type: string\n      manifest_sha256:\n        description: Exact frozen campaign manifest SHA-256\n        required: true\n        type: string\n      expected_state_revision:\n        description: Exact durable revision expected by this operation\n        required: true\n        type: string\n      request_id:\n        description: New UUIDv4; retry must reuse the original packet artifact instead\n        required: true\n        type: string\n      approval_nonce_sha256:\n        description: Required only for abort; 64 lowercase hex from the protected approval\n        required: false\n        default: \"\"\n        type: string\n      start_bundle_run_id:\n        description: Source workflow run containing the immutable start bundle; revision-zero start only\n        required: false\n        default: \"\"\n        type: string\n      start_bundle_artifact_name:\n        description: Exact artifact name containing the six-file start bundle; revision-zero start only\n        required: false\n        default: \"\"\n        type: string\n\npermissions:\n  contents: read\n  actions: read\n\nconcurrency:\n  group: long-run-074-${{ inputs.host_id }}\n  cancel-in-progress: false\n\njobs:\n  authorize:\n    name: Build exact signed controller packet\n    runs-on: ubuntu-latest\n    environment: performance-reference-074\n    timeout-minutes: 15\n    steps:\n      - name: Check out the reviewed tooling commit\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha }}\n\n      - name: Validate immutable dispatch identity\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_HOST_ID: ${{ inputs.host_id }}\n          INPUT_OPERATION: ${{ inputs.operation }}\n          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}\n          INPUT_MANIFEST_SHA256: ${{ inputs.manifest_sha256 }}\n          INPUT_REVISION: ${{ inputs.expected_state_revision }}\n          INPUT_REQUEST_ID: ${{ inputs.request_id }}\n          INPUT_APPROVAL_NONCE: ${{ inputs.approval_nonce_sha256 }}\n          INPUT_START_BUNDLE_RUN_ID: ${{ inputs.start_bundle_run_id }}\n          INPUT_START_BUNDLE_ARTIFACT: ${{ inputs.start_bundle_artifact_name }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$INPUT_SOURCE_SHA\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          [[ \"$INPUT_HOST_ID\" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]\n          [[ \"$INPUT_OPERATION\" =~ ^(start|attach|seal|abort)$ ]]\n          [[ \"$INPUT_CAMPAIGN_ID\" =~ ^[0-9a-f]{64}$ ]]\n          [[ \"$INPUT_MANIFEST_SHA256\" =~ ^[0-9a-f]{64}$ ]]\n          [[ \"$INPUT_REVISION\" =~ ^(0|[1-9][0-9]*)$ ]]\n          [[ \"$INPUT_REQUEST_ID\" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]\n          if [[ \"$INPUT_OPERATION\" = abort ]]; then\n            [[ \"$INPUT_APPROVAL_NONCE\" =~ ^[0-9a-f]{64}$ ]]\n          else\n            test -z \"$INPUT_APPROVAL_NONCE\"\n          fi\n          if [[ \"$INPUT_OPERATION\" != start ]]; then\n            test \"$INPUT_REVISION\" -gt 0\n          fi\n          if [[ \"$INPUT_OPERATION\" = start && \"$INPUT_REVISION\" = 0 ]]; then\n            [[ \"$INPUT_START_BUNDLE_RUN_ID\" =~ ^[1-9][0-9]*$ ]]\n            [[ \"$INPUT_START_BUNDLE_ARTIFACT\" =~ ^long-run-074-start-bundle-[0-9a-f]{64}$ ]]\n          else\n            test -z \"$INPUT_START_BUNDLE_RUN_ID\"\n            test -z \"$INPUT_START_BUNDLE_ARTIFACT\"\n          fi\n\n      - name: Build the reviewed typed client\n        shell: bash\n        run: cargo build -p hydracache-long-run-supervisor-074 --release --locked\n\n      - name: Construct the strict unsigned request\n        shell: bash\n        env:\n          INPUT_OPERATION: ${{ inputs.operation }}\n          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}\n          INPUT_MANIFEST_SHA256: ${{ inputs.manifest_sha256 }}\n          INPUT_REVISION: ${{ inputs.expected_state_revision }}\n          INPUT_REQUEST_ID: ${{ inputs.request_id }}\n          INPUT_APPROVAL_NONCE: ${{ inputs.approval_nonce_sha256 }}\n          REPOSITORY_ID: ${{ github.repository_id }}\n          RUN_ID: ${{ github.run_id }}\n          RUN_ATTEMPT: ${{ github.run_attempt }}\n          ACTOR_ID: ${{ github.actor_id }}\n        run: |\n          set -euo pipefail\n          mkdir -p target/controller-request-074\n          python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n\n          operation = os.environ[\"INPUT_OPERATION\"]\n          campaign = os.environ[\"INPUT_CAMPAIGN_ID\"]\n          revision = int(os.environ[\"INPUT_REVISION\"])\n          request = {\n              \"schema_version\": 1,\n              \"request_id\": os.environ[\"INPUT_REQUEST_ID\"],\n              \"operation\": operation,\n              \"campaign_id\": campaign,\n              \"expected_state_revision\": revision,\n              \"manifest_path\": (\n                  f\"/var/lib/hydracache-performance/staging/{campaign}/campaign-start.json\"\n                  if operation == \"start\" and revision == 0 else None\n              ),\n              \"manifest_sha256\": os.environ[\"INPUT_MANIFEST_SHA256\"],\n              \"controller\": {\n                  \"repository_id\": int(os.environ[\"REPOSITORY_ID\"]),\n                  \"run_id\": int(os.environ[\"RUN_ID\"]),\n                  \"run_attempt\": int(os.environ[\"RUN_ATTEMPT\"]),\n                  \"actor_id\": int(os.environ[\"ACTOR_ID\"]),\n                  \"authorization_sha256\": \"0\" * 64,\n              },\n              \"abort_reason\": \"operator-request\" if operation == \"abort\" else None,\n              \"approval_nonce_sha256\": (\n                  os.environ[\"INPUT_APPROVAL_NONCE\"] if operation == \"abort\" else None\n              ),\n          }\n          path = pathlib.Path(\"target/controller-request-074/unsigned.json\")\n          path.write_text(json.dumps(request, sort_keys=True, separators=(\",\", \":\")), encoding=\"utf-8\")\n          PY\n\n      - name: Sign and self-verify the request packet\n        shell: bash\n        env:\n          SIGNING_KEY_HEX: ${{ secrets.HYDRACACHE_074_AUTH_SIGNING_KEY_HEX }}\n        run: |\n          set -euo pipefail\n          test -n \"$SIGNING_KEY_HEX\"\n          umask 077\n          key_file=\"$RUNNER_TEMP/hydracache-074-signing-key\"\n          trap 'rm -f \"$key_file\"' EXIT\n          printf '%s\\n' \"$SIGNING_KEY_HEX\" > \"$key_file\"\n          issued=\"$(date +%s)\"\n          expires=\"$((issued + 300))\"\n          target/release/hydracache-long-run-supervisor-074 build-request \\\n            target/controller-request-074/unsigned.json \\\n            \"$key_file\" \"$issued\" \"$expires\" \\\n            target/controller-request-074/request.json \\\n            > target/controller-request-074/request.sha256\n          rm -f \"$key_file\"\n          trap - EXIT\n          test \"$(sha256sum target/controller-request-074/request.json | cut -d' ' -f1)\" = \\\n            \"$(tr -d '\\r\\n' < target/controller-request-074/request.sha256)\"\n\n      - name: Publish the immutable controller packet\n        uses: actions/upload-artifact@v4\n        with:\n          name: long-run-074-request-${{ inputs.request_id }}\n          path: |\n            target/controller-request-074/request.json\n            target/controller-request-074/request.sha256\n          if-no-files-found: error\n          retention-days: 7\n\n  dispatch:\n    name: Send packet to the detached host supervisor\n    needs: authorize\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 15\n    steps:\n      - name: Check out the exact reviewed tooling commit\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha }}\n\n      - name: Download the exact signed packet\n        uses: actions/download-artifact@v5\n        with:\n          name: long-run-074-request-${{ inputs.request_id }}\n          path: target/controller-request-074\n\n      - name: Download the immutable revision-zero start bundle\n        if: inputs.operation == 'start' && inputs.expected_state_revision == '0'\n        uses: actions/download-artifact@v5\n        with:\n          name: ${{ inputs.start_bundle_artifact_name }}\n          path: target/controller-start-bundle-074\n          github-token: ${{ github.token }}\n          repository: ${{ github.repository }}\n          run-id: ${{ inputs.start_bundle_run_id }}\n\n      - name: Verify source and packet transport digest\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        run: |\n          set -euo pipefail\n          test \"$(git rev-parse HEAD)\" = \"$INPUT_SOURCE_SHA\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          expected=\"$(tr -d '\\r\\n' < target/controller-request-074/request.sha256)\"\n          test \"$(sha256sum target/controller-request-074/request.json | cut -d' ' -f1)\" = \"$expected\"\n          cargo build -p hydracache-long-run-supervisor-074 --release --locked\n\n      - name: Verify the transported revision-zero start bundle\n        if: inputs.operation == 'start' && inputs.expected_state_revision == '0'\n        shell: bash\n        env:\n          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}\n          INPUT_MANIFEST_SHA256: ${{ inputs.manifest_sha256 }}\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_long_run_074.py \\\n            --verify-start-bundle \\\n            --output target/controller-start-bundle-074\n          python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n\n          bundle = json.loads(\n              pathlib.Path(\"target/controller-start-bundle-074/start-bundle.json\").read_text(\n                  encoding=\"utf-8\"\n              )\n          )\n          if bundle[\"campaign_id\"] != os.environ[\"INPUT_CAMPAIGN_ID\"]:\n              raise SystemExit(\"start bundle campaign differs from dispatch identity\")\n          if bundle[\"manifest_sha256\"] != os.environ[\"INPUT_MANIFEST_SHA256\"]:\n              raise SystemExit(\"start bundle manifest differs from dispatch identity\")\n          PY\n\n      - name: Execute the one typed operation\n        id: request\n        if: inputs.operation != 'start' || inputs.expected_state_revision != '0'\n        shell: bash\n        run: |\n          set +e\n          target/release/hydracache-long-run-supervisor-074 request \\\n            /run/hydracache-perf/supervisor-v1.sock \\\n            target/controller-request-074/request.json \\\n            > target/controller-request-074/response.json\n          code=$?\n          set -e\n          echo \"exit_code=$code\" >> \"$GITHUB_OUTPUT\"\n          exit \"$code\"\n\n      - name: Upload and execute the revision-zero start operation\n        id: request_start\n        if: inputs.operation == 'start' && inputs.expected_state_revision == '0'\n        shell: bash\n        run: |\n          set +e\n          target/release/hydracache-long-run-supervisor-074 request-start \\\n            /run/hydracache-perf/supervisor-v1.sock \\\n            target/controller-request-074/request.json \\\n            target/controller-start-bundle-074 \\\n            > target/controller-request-074/response.json\n          code=$?\n          set -e\n          echo \"exit_code=$code\" >> \"$GITHUB_OUTPUT\"\n          exit \"$code\"\n\n      - name: Capture a best-effort read-only status snapshot\n        if: always()\n        shell: bash\n        env:\n          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}\n          INPUT_MANIFEST_SHA256: ${{ inputs.manifest_sha256 }}\n          INPUT_REVISION: ${{ inputs.expected_state_revision }}\n          REPOSITORY_ID: ${{ github.repository_id }}\n          RUN_ID: ${{ github.run_id }}\n          RUN_ATTEMPT: ${{ github.run_attempt }}\n          ACTOR_ID: ${{ github.actor_id }}\n        run: |\n          set -euo pipefail\n          python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n          import uuid\n\n          request = {\n              \"schema_version\": 1,\n              \"request_id\": str(uuid.uuid4()),\n              \"operation\": \"status\",\n              \"campaign_id\": os.environ[\"INPUT_CAMPAIGN_ID\"],\n              \"expected_state_revision\": int(os.environ[\"INPUT_REVISION\"]),\n              \"manifest_path\": None,\n              \"manifest_sha256\": os.environ[\"INPUT_MANIFEST_SHA256\"],\n              \"controller\": {\n                  \"repository_id\": int(os.environ[\"REPOSITORY_ID\"]),\n                  \"run_id\": int(os.environ[\"RUN_ID\"]),\n                  \"run_attempt\": int(os.environ[\"RUN_ATTEMPT\"]),\n                  \"actor_id\": int(os.environ[\"ACTOR_ID\"]),\n                  \"authorization_sha256\": \"0\" * 64,\n              },\n              \"abort_reason\": None,\n              \"approval_nonce_sha256\": None,\n          }\n          wire = {\"request\": request, \"authorization\": None}\n          pathlib.Path(\"target/controller-request-074/status.json\").write_text(\n              json.dumps(wire, sort_keys=True, separators=(\",\", \":\")), encoding=\"utf-8\"\n          )\n          PY\n          set +e\n          target/release/hydracache-long-run-supervisor-074 request \\\n            /run/hydracache-perf/supervisor-v1.sock \\\n            target/controller-request-074/status.json \\\n            > target/controller-request-074/status-response.json\n          echo \"$?\" > target/controller-request-074/status-exit-code.txt\n          exit 0\n\n      - name: Upload controller response and status snapshot\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: long-run-074-response-${{ inputs.request_id }}\n          path: |\n            target/controller-request-074/request.sha256\n            target/controller-request-074/response.json\n            target/controller-request-074/status-response.json\n            target/controller-request-074/status-exit-code.txt\n          if-no-files-found: error\n          retention-days: 30\n"}
{"expect": "valid", "id": ".github/workflows/performance-long-run-start-bundle-074.yml", "source_sha256": "4cd629de1931a6b8dd3cf384add1524ac0367947d06b5e6e52233ac567fec432", "text": "name: Performance Long-Run Non-Product Start Bundle 0.74\n\non:\n  workflow_call:\n    inputs:\n      source_sha:\n        description: Exact installed supervisor and reviewed tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact installed supervisor and reviewed tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n\npermissions:\n  contents: read\n  actions: read\n\nconcurrency:\n  group: long-run-074-start-bundle-${{ inputs.host_id }}-${{ inputs.source_sha }}-${{ github.run_id }}\n  cancel-in-progress: false\n\njobs:\n  observe:\n    name: Collect exact source-bound host input\n    permissions:\n      contents: read\n    uses: ./.github/workflows/performance-long-run-host-observation-074.yml\n    with:\n      source_sha: ${{ inputs.source_sha }}\n      host_id: ${{ inputs.host_id }}\n\n  assemble:\n    name: Assemble immutable non-product start bundle\n    needs: observe\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      OBSERVATION_DIR: target/controller-host-observation-074\n      BUNDLE_DIR: target/controller-start-bundle-074\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-start-bundle\n    steps:\n      - name: Check out exact reviewed bundle tooling\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha }}\n\n      - name: Download exact source-bound host observation\n        uses: actions/download-artifact@v5\n        with:\n          name: long-run-074-host-observation-${{ inputs.source_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/controller-host-observation-074\n\n      - name: Validate exact tooling and local bundle tests\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$INPUT_SOURCE_SHA\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          python3 -m unittest \\\n            scripts.perf.test_performance_long_run_074 \\\n            scripts.perf.test_performance_non_product_start_bundle_074\n\n      - name: Assemble and independently verify six-file bundle\n        id: bundle\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          REPOSITORY_ID: ${{ github.repository_id }}\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_non_product_start_bundle_074.py \\\n            --observation-directory \"$OBSERVATION_DIR\" \\\n            --output \"$BUNDLE_DIR\" \\\n            --evidence-output \"$EVIDENCE_DIR\" \\\n            --source-sha \"$INPUT_SOURCE_SHA\" \\\n            --repository-id \"$REPOSITORY_ID\"\n          verified=\"$(python3 scripts/perf/performance_long_run_074.py \\\n            --verify-start-bundle --output \"$BUNDLE_DIR\")\"\n          printf '%s\\n' \"$verified\"\n          bundle_sha256=\"$(tr -d '\\r\\n' < \"$BUNDLE_DIR/start-bundle.sha256\")\"\n          [[ \"$bundle_sha256\" =~ ^[0-9a-f]{64}$ ]]\n          campaign_id=\"$(python3 -c 'import json; print(json.load(open(\"target/controller-start-bundle-074/start-bundle.json\"))[\"campaign_id\"])')\"\n          manifest_sha256=\"$(tr -d '\\r\\n' < \"$BUNDLE_DIR/campaign-start.sha256\")\"\n          echo \"bundle_sha256=$bundle_sha256\" >> \"$GITHUB_OUTPUT\"\n          echo \"campaign_id=$campaign_id\" >> \"$GITHUB_OUTPUT\"\n          echo \"manifest_sha256=$manifest_sha256\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Retain immutable non-product start bundle\n        uses: actions/upload-artifact@v6\n        with:\n          name: long-run-074-start-bundle-${{ steps.bundle.outputs.bundle_sha256 }}\n          path: target/controller-start-bundle-074/**\n          if-no-files-found: error\n          retention-days: 7\n\n      - name: Retain non-promotable bundle-construction evidence\n        uses: actions/upload-artifact@v6\n        with:\n          name: long-run-074-start-bundle-evidence-${{ steps.bundle.outputs.bundle_sha256 }}\n          path: target/performance-evidence/0.74/reference/w11-start-bundle/**\n          if-no-files-found: error\n          retention-days: 30\n"}
{"expect": "valid", "id": ".github/workflows/post-publish.yml", "source_sha256": "02a9c5a789ce6c5b160dfe52e12963e5979b67fc66ab7ce672b29d951690940e", "text": "name: Post Publish Verification\n\non:\n  workflow_call:\n    inputs:\n      version:\n        description: Published HydraCache version to verify\n        required: true\n        type: string\n      metadata_artifact:\n        description: Release metadata artifact produced by Publish Crates\n        required: false\n        default: \"\"\n        type: string\n  workflow_dispatch:\n    inputs:\n      version:\n        description: Published HydraCache version to verify\n        required: true\n        default: 0.24.0\n      metadata_artifact:\n        description: Optional release metadata artifact produced by Publish Crates\n        required: false\n        default: \"\"\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: post-publish-${{ inputs.version }}-${{ github.sha }}\n  cancel-in-progress: false\n\njobs:\n  verify:\n    name: Verify published crates\n    runs-on: ubuntu-latest\n    timeout-minutes: 60\n\n    steps:\n      - name: Checkout verification fixture\n        uses: actions/checkout@v5\n\n      - name: Install Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Download publication manifest\n        if: inputs.metadata_artifact != ''\n        uses: actions/download-artifact@v8\n        with:\n          name: ${{ inputs.metadata_artifact }}\n          path: target/release-publish\n\n      - name: Create consumer project\n        run: cargo new hydracache-consumer --lib\n\n      - name: Create dependency-order smoke project\n        run: cargo new hydracache-order-smoke --lib\n\n      - name: Add published dependencies in package order\n        working-directory: hydracache-order-smoke\n        run: |\n          set -euo pipefail\n          manifest=\"$GITHUB_WORKSPACE/target/release-publish/packages.txt\"\n          if [[ -f \"$manifest\" ]]; then\n            mapfile -t packages < \"$manifest\"\n          else\n            packages=(\n              hydracache-client-protocol hydracache-core hydracache-macros\n              hydracache-sql-lint hydracache hydracache-client\n              hydracache-client-hc2\n              hydracache-cluster-chitchat hydracache-cluster-raft\n              hydracache-cluster-transport-axum hydracache-db\n              hydracache-observability hydracache-transport-nats\n              hydracache-transport-redis hydracache-actuator-axum\n              hydracache-cdc-postgres hydracache-client-transport-axum\n              hydracache-cluster hydracache-diesel hydracache-seaorm\n              hydracache-sqlx hydracache-redis-compat hydracache-server\n            )\n          fi\n          for package in \"${packages[@]}\"; do\n            [[ -z \"$package\" ]] && continue\n            cargo add \"$package@${{ inputs.version }}\"\n            cargo check\n          done\n\n      - name: Add published dependencies\n        working-directory: hydracache-consumer\n        run: |\n          set -euo pipefail\n          manifest=\"$GITHUB_WORKSPACE/target/release-publish/packages.txt\"\n          if [[ -f \"$manifest\" ]]; then\n            mapfile -t packages < \"$manifest\"\n          else\n            packages=(\n              hydracache-client-protocol hydracache-core hydracache-macros\n              hydracache-sql-lint hydracache hydracache-client\n              hydracache-client-hc2\n              hydracache-cluster-chitchat hydracache-cluster-raft\n              hydracache-cluster-transport-axum hydracache-db\n              hydracache-observability hydracache-transport-nats\n              hydracache-transport-redis hydracache-actuator-axum\n              hydracache-cdc-postgres hydracache-client-transport-axum\n              hydracache-cluster hydracache-diesel hydracache-seaorm\n              hydracache-sqlx hydracache-redis-compat hydracache-server\n            )\n          fi\n          for package in \"${packages[@]}\"; do\n            [[ -z \"$package\" ]] && continue\n            cargo add \"$package@${{ inputs.version }}\"\n          done\n          cargo add serde --features derive\n          cargo add serde_json --dev\n          cargo add tokio --features macros,rt-multi-thread\n\n      - name: Install smoke test fixture\n        timeout-minutes: 15\n        working-directory: hydracache-consumer\n        run: cp \"$GITHUB_WORKSPACE/tests/post-publish-consumer/src/lib.rs\" src/lib.rs\n\n      - name: Check published consumer\n        working-directory: hydracache-consumer\n        run: cargo check\n\n      - name: Test published consumer\n        working-directory: hydracache-consumer\n        run: cargo test\n\n      - name: Build published docs\n        working-directory: hydracache-consumer\n        env:\n          RUSTDOCFLAGS: -D warnings\n        run: cargo doc --no-deps\n"}
{"expect": "valid", "id": ".github/workflows/publish-crates.yml", "source_sha256": "faca1b7d3e78b732df62b2553e77fa2e85e1d2c8747d9e02fb30e1a0946fedc5", "text": "name: Publish Crates\n\non:\n  workflow_run:\n    workflows: [\"CI\"]\n    types: [completed]\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Existing release tag to re-qualify and publish\n        required: true\n        type: string\n\npermissions:\n  contents: read\n  actions: read\n\nconcurrency:\n  group: crates-release-${{ github.event.workflow_run.head_sha || inputs.tag || github.run_id }}\n  cancel-in-progress: false\n\njobs:\n  resolve:\n    name: Resolve and validate release candidate\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    outputs:\n      eligible: ${{ steps.resolve.outputs.eligible }}\n      version: ${{ steps.resolve.outputs.version }}\n      tag: ${{ steps.resolve.outputs.tag }}\n      source_sha: ${{ steps.resolve.outputs.source_sha }}\n      metadata_artifact: ${{ steps.resolve.outputs.metadata_artifact }}\n\n    steps:\n      - name: Checkout candidate commit\n        uses: actions/checkout@v5\n        with:\n          ref: ${{ github.event_name == 'workflow_dispatch' && format('refs/tags/{0}', inputs.tag) || github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n\n      - name: Resolve tag, CI result, versions, and publish order\n        id: resolve\n        env:\n          EVENT_NAME: ${{ github.event_name }}\n          WORKFLOW_RUN_CONCLUSION: ${{ github.event.workflow_run.conclusion || '' }}\n          WORKFLOW_RUN_SHA: ${{ github.event.workflow_run.head_sha || '' }}\n          WORKFLOW_RUN_ID: ${{ github.event.workflow_run.id || '' }}\n          WORKFLOW_RUN_REF: ${{ github.event.workflow_run.head_branch || '' }}\n          INPUT_TAG: ${{ inputs.tag || '' }}\n          GH_TOKEN: ${{ github.token }}\n        shell: bash\n        run: |\n          set -euo pipefail\n\n          if [[ \"$EVENT_NAME\" == \"workflow_run\" ]]; then\n            if [[ \"$WORKFLOW_RUN_CONCLUSION\" != \"success\" && \"$WORKFLOW_RUN_CONCLUSION\" != \"failure\" ]]; then\n              echo \"CI conclusion is $WORKFLOW_RUN_CONCLUSION; publication is not eligible.\"\n              echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n              exit 0\n            fi\n\n            source_sha=\"$WORKFLOW_RUN_SHA\"\n            git fetch --force --tags origin\n            mapfile -t tags < <(git tag --points-at \"$source_sha\" --list 'v*.*.*')\n            if [[ \"${#tags[@]}\" -eq 0 ]]; then\n              echo \"CI run $source_sha has no release tag; nothing to publish.\"\n              echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n              exit 0\n            fi\n            if [[ \"${#tags[@]}\" -ne 1 ]]; then\n              printf 'Expected one release tag at %s, found: %s\\n' \"$source_sha\" \"${tags[*]}\" >&2\n              exit 1\n            fi\n            release_tag=\"${tags[0]}\"\n          else\n            release_tag=\"$INPUT_TAG\"\n            if [[ ! \"$release_tag\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then\n              echo \"Input tag must be a SemVer tag such as v0.65.0, got: $release_tag\" >&2\n              exit 1\n            fi\n            git fetch --force --tags origin\n            if ! git rev-parse -q --verify \"refs/tags/$release_tag\" >/dev/null; then\n              echo \"Tag $release_tag does not exist.\" >&2\n              exit 1\n            fi\n            source_sha=\"$(git rev-list -n1 \"$release_tag\")\"\n            ci_runs=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$source_sha&per_page=100\")\"\n            if ! printf '%s' \"$ci_runs\" | jq -e --arg sha \"$source_sha\" '[.workflow_runs[] | select(.head_sha == $sha and .conclusion == \"success\")] | length > 0' >/dev/null; then\n              echo \"No successful CI run exists for $release_tag at $source_sha.\" >&2\n              exit 1\n            fi\n          fi\n\n          version=\"${release_tag#v}\"\n\n          if [[ \"$version\" == 0.71.* ]]; then\n            if [[ \"$EVENT_NAME\" == \"workflow_run\" && \"$WORKFLOW_RUN_REF\" != \"$release_tag\" ]]; then\n              echo \"CI ref $WORKFLOW_RUN_REF is not release tag $release_tag; nothing to publish.\"\n              echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n              exit 0\n            fi\n            # The source commit already has a complete green main-branch CI run.\n            # The tag run adds one exact-tag 0.71 admission; unrelated legacy or\n            # nightly jobs may fail without changing that release decision.\n            ci_runs=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$source_sha&status=completed&per_page=100\")\"\n            if ! printf '%s' \"$ci_runs\" | jq -e --arg sha \"$source_sha\" \\\n              '[.workflow_runs[] | select(.head_sha == $sha and .event == \"push\" and .head_branch == \"main\" and .conclusion == \"success\")] | length > 0' >/dev/null; then\n              echo \"No complete successful main CI run exists at measured source $source_sha.\" >&2\n              exit 1\n            fi\n            if [[ \"$EVENT_NAME\" == \"workflow_run\" ]]; then\n              candidate_run_ids=(\"$WORKFLOW_RUN_ID\")\n            else\n              mapfile -t candidate_run_ids < <(\n                printf '%s' \"$ci_runs\" | jq -r --arg sha \"$source_sha\" --arg tag \"$release_tag\" \\\n                  '.workflow_runs[] | select(.head_sha == $sha and .event == \"push\" and .head_branch == $tag and (.conclusion == \"success\" or .conclusion == \"failure\")) | .id'\n              )\n            fi\n            designated_admission=false\n            for run_id in \"${candidate_run_ids[@]}\"; do\n              if gh api --paginate \\\n                \"repos/$GITHUB_REPOSITORY/actions/runs/$run_id/jobs?per_page=100\" \\\n                --jq '.jobs[] | select(.name == \"Release 0.71 CI Admission\" and .conclusion == \"success\") | .id' \\\n                | grep -q .; then\n                designated_admission=true\n                break\n              fi\n            done\n            if [[ \"$designated_admission\" != \"true\" ]]; then\n              echo \"No designated Release 0.71 CI Admission exists for $release_tag at $source_sha.\" >&2\n              exit 1\n            fi\n          elif [[ \"$EVENT_NAME\" == \"workflow_run\" && \"$WORKFLOW_RUN_CONCLUSION\" != \"success\" ]]; then\n            echo \"CI conclusion is $WORKFLOW_RUN_CONCLUSION; publication is not eligible.\"\n            echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          git fetch --force origin main\n          if ! git merge-base --is-ancestor \"$source_sha\" origin/main; then\n            echo \"$release_tag does not point to a commit reachable from origin/main.\" >&2\n            exit 1\n          fi\n\n          if [[ \"$version\" == \"0.68.0\" ]]; then\n            hosted_admission=false\n            for attempt in $(seq 1 30); do\n              hc2_runs=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/workflows/hc2-client-plane.yml/runs?head_sha=$source_sha&status=completed&per_page=100\")\"\n              mapfile -t hc2_run_ids < <(\n                printf '%s' \"$hc2_runs\" | jq -r --arg sha \"$source_sha\" \\\n                  '.workflow_runs[] | select(.head_sha == $sha and .conclusion == \"success\") | .id'\n              )\n              for hc2_run_id in \"${hc2_run_ids[@]}\"; do\n                if gh api --paginate \\\n                  \"repos/$GITHUB_REPOSITORY/actions/runs/$hc2_run_id/jobs?per_page=100\" \\\n                  --jq '.jobs[] | select(.name == \"HC/2 Hosted Release Admission\" and .conclusion == \"success\") | .id' \\\n                  | grep -q .; then\n                  hosted_admission=true\n                  break\n                fi\n              done\n              if [[ \"$hosted_admission\" == \"true\" ]]; then\n                break\n              fi\n              if [[ \"$attempt\" -lt 30 ]]; then\n                echo \"Waiting for HC/2 hosted admission at $source_sha (attempt $attempt/30).\"\n                sleep 60\n              fi\n            done\n            if [[ \"$hosted_admission\" != \"true\" ]]; then\n              echo \"No successful HC/2 Hosted Release Admission exists for 0.68.0 at $source_sha.\" >&2\n              echo \"Java/Python SDK promotion is separate and still requires the deferred fixed-host admission.\" >&2\n              exit 1\n            fi\n          fi\n\n          python - \"$version\" \"$release_tag\" \"$source_sha\" <<'PY'\n          import json\n          import pathlib\n          import re\n          import subprocess\n          import sys\n\n          version, release_tag, source_sha = sys.argv[1:]\n          metadata = json.loads(\n              subprocess.check_output(\n                  [\"cargo\", \"metadata\", \"--locked\", \"--format-version\", \"1\"],\n                  text=True,\n              )\n          )\n          packages = metadata[\"packages\"]\n          publishable = [\n              package\n              for package in packages\n              if package.get(\"source\") is None and package.get(\"publish\") is None\n          ]\n          versions = {package[\"version\"] for package in publishable}\n          if versions != {version}:\n              raise SystemExit(\n                  f\"publishable package versions {sorted(versions)} do not match tag {version}\"\n              )\n\n          # Runtime packages come from the measured tag, while finalization\n          # documentation is committed afterwards on main. The ancestry check\n          # above binds the two without silently retagging unmeasured code.\n          manifest = subprocess.check_output(\n              [\"git\", \"show\", \"origin/main:docs/plans/releases.toml\"], text=True\n          )\n          blocks = re.split(r\"(?m)^\\[\\[release\\]\\]\\s*$\", manifest)\n          matching = None\n          for block in blocks:\n              if re.search(rf'(?m)^\\s*version\\s*=\\s*\"{re.escape(version)}\"\\s*$', block):\n                  matching = block\n                  break\n          if matching is None:\n              raise SystemExit(f\"release {version} is missing from docs/plans/releases.toml\")\n          status = re.search(r'(?m)^\\s*status\\s*=\\s*\"([^\"]+)\"\\s*$', matching)\n          if status is None or status.group(1) != \"shipped\":\n              actual = status.group(1) if status else \"missing\"\n              raise SystemExit(f\"release {version} has status {actual!r}, expected shipped\")\n\n          release_notes = pathlib.Path(f\"docs/releases/{version}.md\")\n          try:\n              notes_text = subprocess.check_output(\n                  [\"git\", \"show\", f\"origin/main:{release_notes}\"], text=True\n              )\n          except subprocess.CalledProcessError as exc:\n              raise SystemExit(f\"missing release notes on main: {release_notes}\") from exc\n\n          by_id = {package[\"id\"]: package[\"name\"] for package in packages}\n          publishable_ids = {package[\"id\"] for package in publishable}\n          dependencies = {package[\"name\"]: set() for package in publishable}\n          for node in metadata[\"resolve\"][\"nodes\"]:\n              if node[\"id\"] not in publishable_ids:\n                  continue\n              name = by_id[node[\"id\"]]\n              for dependency in node[\"deps\"]:\n                  dependency_id = dependency[\"pkg\"]\n                  # Cargo resolves every packaged dependency kind during\n                  # `cargo publish`, including dev, build, and target-specific\n                  # dependencies. They must all precede the dependent crate.\n                  if dependency_id in publishable_ids:\n                      dependencies[name].add(by_id[dependency_id])\n\n          order = []\n          while dependencies:\n              ready = sorted(name for name, deps in dependencies.items() if not deps)\n              if not ready:\n                  raise SystemExit(\"publishable workspace dependency graph contains a cycle\")\n              for name in ready:\n                  order.append(name)\n                  del dependencies[name]\n              for deps in dependencies.values():\n                  deps.difference_update(ready)\n\n          output = pathlib.Path(\"target/release-publish\")\n          output.mkdir(parents=True, exist_ok=True)\n          (output / \"release-notes.md\").write_text(notes_text, encoding=\"utf-8\")\n          (output / \"release.env\").write_text(\n              f\"VERSION={version}\\nTAG={release_tag}\\nSOURCE_SHA={source_sha}\\n\",\n              encoding=\"utf-8\",\n          )\n          (output / \"packages.txt\").write_text(\"\\n\".join(order) + \"\\n\", encoding=\"utf-8\")\n          print(f\"release candidate: {release_tag} at {source_sha}\")\n          print(f\"publishable packages: {len(order)}\")\n          print(\"dependency order:\")\n          print(\"\\n\".join(f\"  {index}: {name}\" for index, name in enumerate(order, 1)))\n          PY\n\n          echo \"eligible=true\" >> \"$GITHUB_OUTPUT\"\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n          echo \"tag=$release_tag\" >> \"$GITHUB_OUTPUT\"\n          echo \"source_sha=$source_sha\" >> \"$GITHUB_OUTPUT\"\n          echo \"metadata_artifact=release-publish-metadata-${GITHUB_RUN_ID}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Upload release metadata\n        if: steps.resolve.outputs.eligible == 'true'\n        uses: actions/upload-artifact@v6\n        with:\n          name: ${{ steps.resolve.outputs.metadata_artifact }}\n          path: target/release-publish\n          if-no-files-found: error\n          retention-days: 30\n\n  publish:\n    name: Publish crates.io packages\n    needs: resolve\n    if: needs.resolve.outputs.eligible == 'true'\n    runs-on: ubuntu-latest\n    timeout-minutes: 120\n    environment: release\n    env:\n      CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}\n\n    steps:\n      - name: Checkout candidate commit\n        uses: actions/checkout@v5\n        with:\n          ref: ${{ needs.resolve.outputs.source_sha }}\n          fetch-depth: 0\n\n      - name: Install Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Download release metadata\n        uses: actions/download-artifact@v8\n        with:\n          name: ${{ needs.resolve.outputs.metadata_artifact }}\n          path: target/release-publish\n\n      - name: Publish dependency-aware and idempotently\n        shell: bash\n        run: |\n          set -euo pipefail\n          if [[ -z \"${CARGO_REGISTRY_TOKEN:-}\" ]]; then\n            echo \"CARGO_REGISTRY_TOKEN is missing from the release environment.\" >&2\n            exit 1\n          fi\n\n          # crates.io versions are immutable. An exact existing version is a safe\n          # retry; every other registry response is treated as a release failure.\n          : > target/release-publish/publication-results.tsv\n          version=\"${{ needs.resolve.outputs.version }}\"\n\n          crates_io_status() {\n            local package=\"$1\"\n            local url=\"https://crates.io/api/v1/crates/$package/$version\"\n            local status=\"\"\n\n            for attempt in $(seq 1 5); do\n              if status=\"$(curl \\\n                --silent \\\n                --show-error \\\n                --connect-timeout 15 \\\n                --max-time 30 \\\n                --user-agent \"hydracache-release-workflow/$version (+https://github.com/$GITHUB_REPOSITORY)\" \\\n                --output /dev/null \\\n                --write-out '%{http_code}' \\\n                \"$url\")\"; then\n                case \"$status\" in\n                  200|404)\n                    printf '%s' \"$status\"\n                    return 0\n                    ;;\n                  429|5??)\n                    ;;\n                  *)\n                    printf '%s' \"$status\"\n                    return 0\n                    ;;\n                esac\n              fi\n\n              if [[ \"$attempt\" -lt 5 ]]; then\n                echo \"Transient crates.io probe failure for $package@$version (status ${status:-transport-error}, attempt $attempt/5).\" >&2\n                sleep \"$((attempt * 2))\"\n              fi\n            done\n\n            if [[ -n \"$status\" && \"$status\" != \"000\" ]]; then\n              printf '%s' \"$status\"\n              return 0\n            fi\n            return 1\n          }\n\n          wait_for_registry_package() {\n            local package=\"$1\"\n            for attempt in $(seq 1 30); do\n              if cargo info \"$package@$version\" >/dev/null 2>&1; then\n                return 0\n              fi\n              echo \"Waiting for $package@$version in the crates.io index ($attempt/30)...\"\n              sleep 10\n            done\n            return 1\n          }\n\n          while IFS= read -r package; do\n            [[ -z \"$package\" ]] && continue\n            if ! status=\"$(crates_io_status \"$package\")\"; then\n              echo \"Could not query crates.io for $package@$version after 5 attempts.\" >&2\n              exit 1\n            fi\n            case \"$status\" in\n              200)\n                if ! wait_for_registry_package \"$package\"; then\n                  echo \"$package@$version exists in the API but not in the Cargo index.\" >&2\n                  exit 1\n                fi\n                printf '%s\\t%s\\n' \"$package\" \"already-published\" | tee -a target/release-publish/publication-results.tsv\n                continue\n                ;;\n              404)\n                cargo publish --package \"$package\" --locked --dry-run\n                cargo publish --package \"$package\" --locked\n                ;;\n              *)\n                echo \"Unexpected crates.io response $status for $package@$version.\" >&2\n                exit 1\n                ;;\n            esac\n\n            if ! wait_for_registry_package \"$package\"; then\n              echo \"Timed out waiting for $package@$version to appear in the Cargo index.\" >&2\n              exit 1\n            fi\n            printf '%s\\t%s\\n' \"$package\" \"published\" | tee -a target/release-publish/publication-results.tsv\n          done < target/release-publish/packages.txt\n\n      - name: Upload publication evidence\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: crates-publication-${{ needs.resolve.outputs.version }}\n          path: target/release-publish/publication-results.tsv\n          if-no-files-found: error\n          retention-days: 30\n\n  consumer-verification:\n    name: Verify published crates from crates.io\n    needs: [resolve, publish]\n    if: needs.resolve.outputs.eligible == 'true' && needs.publish.result == 'success'\n    uses: ./.github/workflows/post-publish.yml\n    with:\n      version: ${{ needs.resolve.outputs.version }}\n      metadata_artifact: ${{ needs.resolve.outputs.metadata_artifact }}\n    permissions:\n      contents: read\n\n  github-release:\n    name: Create GitHub Release after publication\n    needs: [resolve, publish, consumer-verification]\n    if: needs.resolve.outputs.eligible == 'true' && needs.publish.result == 'success' && needs.consumer-verification.result == 'success'\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    permissions:\n      contents: write\n      actions: read\n\n    steps:\n      - name: Checkout candidate commit\n        uses: actions/checkout@v5\n        with:\n          ref: ${{ needs.resolve.outputs.source_sha }}\n          fetch-depth: 0\n\n      - name: Download validated release metadata and notes\n        uses: actions/download-artifact@v7\n        with:\n          name: ${{ needs.resolve.outputs.metadata_artifact }}\n          path: target/release-publish\n\n      - name: Create or update GitHub Release\n        env:\n          GH_TOKEN: ${{ github.token }}\n          RELEASE_VERSION: ${{ needs.resolve.outputs.version }}\n          RELEASE_TAG: ${{ needs.resolve.outputs.tag }}\n          RELEASE_NOTES: target/release-publish/release-notes.md\n        shell: bash\n        run: |\n          set -euo pipefail\n          title=\"HydraCache $RELEASE_VERSION\"\n          prerelease_flag=()\n          if [[ \"$RELEASE_VERSION\" == *-* ]]; then\n            prerelease_flag=(--prerelease)\n          fi\n\n          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n            gh release edit \"$RELEASE_TAG\" \\\n              --title \"$title\" \\\n              --notes-file \"$RELEASE_NOTES\" \\\n              \"${prerelease_flag[@]}\"\n          else\n            gh release create \"$RELEASE_TAG\" \\\n              --title \"$title\" \\\n              --notes-file \"$RELEASE_NOTES\" \\\n              --verify-tag \\\n              \"${prerelease_flag[@]}\"\n          fi\n"}
{"expect": "valid", "id": ".github/workflows/publish-release-notes.yml", "source_sha256": "2e7f3034b60236767b443dd5d6db7cdf60ce6957e432d8d4fa3251576a0cd67e", "text": "name: Publish Release Notes (manual fallback)\n\non:\n  workflow_dispatch:\n    inputs:\n      version:\n        description: \"HydraCache version to publish, without the leading v\"\n        required: true\n        default: \"0.63.0\"\n\npermissions:\n  contents: write\n\nconcurrency:\n  group: release-notes-${{ inputs.version }}-${{ github.sha }}\n  cancel-in-progress: false\n\njobs:\n  publish:\n    name: Publish GitHub release\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n\n      - name: Install Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Cache Rust dependencies\n        uses: Swatinem/rust-cache@v2\n        with:\n          prefix-key: v1-rust-no-target\n          cache-targets: false\n          shared-key: release-notes\n\n      - name: Resolve release version\n        id: release\n        shell: bash\n        run: |\n          set -euo pipefail\n\n          if [[ \"${{ github.event_name }}\" == \"workflow_dispatch\" ]]; then\n            version=\"${{ inputs.version }}\"\n          else\n            version=\"${GITHUB_REF_NAME#v}\"\n          fi\n\n          if [[ ! \"$version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then\n            echo \"Version must look like a SemVer value without leading v, got: $version\" >&2\n            exit 1\n          fi\n\n          tag=\"v$version\"\n          git fetch --force --tags\n          if ! git rev-parse -q --verify \"refs/tags/$tag\" >/dev/null; then\n            echo \"Tag $tag does not exist. Create/push the tag before publishing release notes.\" >&2\n            exit 1\n          fi\n\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n          echo \"tag=$tag\" >> \"$GITHUB_OUTPUT\"\n          echo \"notes=docs/releases/$version.md\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Run docs consistency gate\n        run: cargo run -p xtask --locked -- doc-check\n\n      - name: Validate release notes source\n        env:\n          RELEASE_VERSION: ${{ steps.release.outputs.version }}\n          RELEASE_NOTES: ${{ steps.release.outputs.notes }}\n        shell: bash\n        run: |\n          set -euo pipefail\n\n          if [[ ! -f \"$RELEASE_NOTES\" ]]; then\n            echo \"$RELEASE_NOTES does not exist.\" >&2\n            exit 1\n          fi\n\n          python - <<'PY'\n          import os\n          import pathlib\n          import re\n          import sys\n\n          version = os.environ[\"RELEASE_VERSION\"]\n          manifest = pathlib.Path(\"docs/plans/releases.toml\")\n          text = manifest.read_text(encoding=\"utf-8\")\n\n          for block in re.split(r\"(?m)^\\[\\[release\\]\\]\\s*$\", text):\n              version_match = re.search(r'(?m)^\\s*version\\s*=\\s*\"([^\"]+)\"', block)\n              if not version_match or version_match.group(1) != version:\n                  continue\n\n              status_match = re.search(r'(?m)^\\s*status\\s*=\\s*\"([^\"]+)\"', block)\n              status = status_match.group(1) if status_match else \"\"\n              if status != \"shipped\":\n                  print(\n                      f\"{manifest}: release {version} has status {status!r}; \"\n                      \"only shipped manifest releases may be published to GitHub.\",\n                      file=sys.stderr,\n                  )\n                  sys.exit(1)\n              break\n          else:\n              print(\n                  f\"{manifest}: release {version} is not in the manifest; \"\n                  \"publishing as a legacy release with docs/releases notes only.\"\n              )\n          PY\n\n      - name: Create or update GitHub release\n        env:\n          GH_TOKEN: ${{ github.token }}\n          RELEASE_VERSION: ${{ steps.release.outputs.version }}\n          RELEASE_TAG: ${{ steps.release.outputs.tag }}\n          RELEASE_NOTES: ${{ steps.release.outputs.notes }}\n        shell: bash\n        run: |\n          set -euo pipefail\n\n          title=\"HydraCache $RELEASE_VERSION\"\n          prerelease_flag=()\n          if [[ \"$RELEASE_VERSION\" == *-* ]]; then\n            prerelease_flag=(--prerelease)\n          fi\n\n          if gh release view \"$RELEASE_TAG\" >/dev/null 2>&1; then\n            gh release edit \"$RELEASE_TAG\" \\\n              --title \"$title\" \\\n              --notes-file \"$RELEASE_NOTES\" \\\n              \"${prerelease_flag[@]}\"\n          else\n            gh release create \"$RELEASE_TAG\" \\\n              --title \"$title\" \\\n              --notes-file \"$RELEASE_NOTES\" \\\n              --verify-tag \\\n              \"${prerelease_flag[@]}\"\n          fi\n"}
