{"expect": "valid", "id": ".github/workflows/performance-long-run-host-observation-074.yml", "source_sha256": "9cf25848f6c06422d8a702e4616cdcc65c552c8f0c65ba16901d45811d571c63", "text": "name: Performance Long-Run Host Observation 0.74\n\non:\n  workflow_call:\n    inputs:\n      source_sha:\n        description: Exact reviewed 40-character supervisor/tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact reviewed 40-character supervisor/tooling commit\n        required: true\n        type: string\n      host_id:\n        description: Stable admitted-host identifier used only for serialization\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: long-run-074-${{ inputs.host_id }}\n  cancel-in-progress: false\n\njobs:\n  observe:\n    name: Export canonical host observation through the root supervisor\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 15\n    env:\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-host-observation\n    steps:\n      - name: Check out exact reviewed observation source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha }}\n\n      - name: Verify immutable source and idle supervisor boundary\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_HOST_ID: ${{ inputs.host_id }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]\n          [[ \"$INPUT_HOST_ID\" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$INPUT_SOURCE_SHA\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          test \"$(systemctl is-active hydracache-performance-supervisor-074.service)\" = active\n          test -S /run/hydracache-perf/supervisor-v1.sock\n          test -f /opt/hydracache-perf/bin/hydracache-long-run-supervisor-074\n          test ! -L /opt/hydracache-perf/bin/hydracache-long-run-supervisor-074\n\n      - name: Build the exact typed client and protocol tests\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo test -p hydracache-long-run-supervisor-074 \\\n            --test protocol --test service --locked\n          cargo build -p hydracache-long-run-supervisor-074 --release --locked\n\n      - name: Construct the fixed-scope read-only request\n        shell: bash\n        env:\n          REPOSITORY_ID: ${{ github.repository_id }}\n          RUN_ID: ${{ github.run_id }}\n          RUN_ATTEMPT: ${{ github.run_attempt }}\n          ACTOR_ID: ${{ github.actor_id }}\n        run: |\n          set -euo pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          python3 - <<'PY'\n          import json\n          import os\n          import pathlib\n          import uuid\n\n          request = {\n              \"schema_version\": 1,\n              \"request_id\": str(uuid.uuid4()),\n              \"operation\": \"host_observation\",\n              \"campaign_id\": \"2dd3f4aa960289c385aad3988d988533197269368f851e5834f535a753cd92ba\",\n              \"expected_state_revision\": 0,\n              \"manifest_path\": None,\n              \"manifest_sha256\": \"baa6e451a7248643e7a96fc5908ac07e0c97d38255e31b1bb1494ea5ac26c6ec\",\n              \"controller\": {\n                  \"repository_id\": int(os.environ[\"REPOSITORY_ID\"]),\n                  \"run_id\": int(os.environ[\"RUN_ID\"]),\n                  \"run_attempt\": int(os.environ[\"RUN_ATTEMPT\"]),\n                  \"actor_id\": int(os.environ[\"ACTOR_ID\"]),\n                  \"authorization_sha256\": \"0\" * 64,\n              },\n              \"abort_reason\": None,\n              \"approval_nonce_sha256\": None,\n          }\n          wire = {\"request\": request, \"authorization\": None}\n          path = pathlib.Path(os.environ[\"EVIDENCE_DIR\"]) / \"request.json\"\n          path.write_bytes(\n              json.dumps(wire, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n          )\n          PY\n\n      - name: Collect and independently bind the host receipt\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        run: |\n          set -euo pipefail\n          target/release/hydracache-long-run-supervisor-074 request \\\n            /run/hydracache-perf/supervisor-v1.sock \\\n            \"$EVIDENCE_DIR/request.json\" \\\n            > \"$EVIDENCE_DIR/response.json\"\n          python3 - <<'PY'\n          import hashlib\n          import json\n          import os\n          import pathlib\n          import re\n\n          root = pathlib.Path(os.environ[\"EVIDENCE_DIR\"])\n          request_bytes = (root / \"request.json\").read_bytes()\n          response_bytes = (root / \"response.json\").read_bytes()\n          wire = json.loads(request_bytes)\n          response = json.loads(response_bytes)\n          expected_response_fields = {\n              \"schema_version\", \"request_id\", \"campaign_id\", \"ok\", \"state_revision\",\n              \"server_time_unix_seconds\", \"result\", \"error_code\", \"response_sha256\",\n          }\n          if set(response) != expected_response_fields:\n              raise SystemExit(\"host observation response fields differ\")\n          body = {key: value for key, value in response.items() if key != \"response_sha256\"}\n          canonical_body = json.dumps(body, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n          if hashlib.sha256(canonical_body).hexdigest() != response[\"response_sha256\"]:\n              raise SystemExit(\"host observation response digest differs\")\n          request = wire[\"request\"]\n          if (\n              response[\"request_id\"] != request[\"request_id\"]\n              or response[\"campaign_id\"] != request[\"campaign_id\"]\n              or response[\"ok\"] is not True\n              or response[\"state_revision\"] != 0\n              or response[\"error_code\"] is not None\n          ):\n              raise SystemExit(\"host observation response identity or outcome differs\")\n          result = response[\"result\"]\n          if not isinstance(result, dict) or set(result) != {\n              \"schema_version\", \"installed_source_commit\", \"active_campaign_absent\", \"fixture_binary\",\n              \"receipt_sha256\", \"receipt\"\n          } or result[\"schema_version\"] != 1 or result[\"active_campaign_absent\"] is not True:\n              raise SystemExit(\"host observation result fields differ\")\n          if result[\"installed_source_commit\"] != os.environ[\"INPUT_SOURCE_SHA\"]:\n              raise SystemExit(\"installed supervisor source differs from requested source\")\n          fixture = result[\"fixture_binary\"]\n          if not isinstance(fixture, dict) or set(fixture) != {\n              \"path\", \"sha256\", \"size\", \"inode\", \"device\", \"uid\", \"gid\", \"mode\"\n          } or (\n              fixture[\"path\"] != \"/opt/hydracache-performance/0.74/campaign-lifecycle-fixture\"\n              or not re.fullmatch(r\"[0-9a-f]{64}\", fixture[\"sha256\"])\n              or any(type(fixture[field]) is not int or fixture[field] <= 0\n                     for field in [\"size\", \"inode\", \"device\"])\n              or type(fixture[\"uid\"]) is not int or fixture[\"uid\"] != 0\n              or type(fixture[\"gid\"]) is not int or fixture[\"gid\"] != 0\n              or type(fixture[\"mode\"]) is not int or fixture[\"mode\"] != 0o755\n          ):\n              raise SystemExit(\"fixed non-product fixture identity differs\")\n          receipt = result[\"receipt\"]\n          receipt_bytes = json.dumps(\n              receipt, sort_keys=True, separators=(\",\", \":\")\n          ).encode(\"utf-8\")\n          receipt_sha256 = hashlib.sha256(receipt_bytes).hexdigest()\n          if receipt_sha256 != result[\"receipt_sha256\"]:\n              raise SystemExit(\"host observation receipt digest differs\")\n          (root / \"host-observation.json\").write_bytes(receipt_bytes + b\"\\n\")\n          (root / \"host-observation.sha256\").write_text(\n              receipt_sha256 + \"\\n\", encoding=\"ascii\", newline=\"\\n\"\n          )\n          evidence = {\n              \"schema_version\": \"hydracache-w11-host-observation-socket-v1\",\n              \"source_commit\": os.environ[\"INPUT_SOURCE_SHA\"],\n              \"installed_source_commit\": result[\"installed_source_commit\"],\n              \"installed_supervisor_binary_sha256\": receipt[\"supervisor_binary\"][\"sha256\"],\n              \"installed_fixture_binary\": fixture,\n              \"request_sha256\": hashlib.sha256(request_bytes).hexdigest(),\n              \"response_sha256\": response[\"response_sha256\"],\n              \"host_receipt_sha256\": receipt_sha256,\n              \"peer_admission_required\": True,\n              \"signed_authorization_used\": False,\n              \"arbitrary_output_path_accepted\": False,\n              \"campaign_state_mutated\": False,\n              \"product_candidate_started\": False,\n              \"promotable\": False,\n          }\n          (root / \"evidence.json\").write_bytes(\n              json.dumps(evidence, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n              + b\"\\n\"\n          )\n          PY\n          test \"$(systemctl is-active hydracache-performance-supervisor-074.service)\" = active\n\n      - name: Retain immutable host observation evidence\n        uses: actions/upload-artifact@v6\n        with:\n          name: long-run-074-host-observation-${{ inputs.