{"expect": "valid", "id": ".github/workflows/demo.yml", "source_sha256": "175462ae9f784fb9586aca1decd20209e1b05efc91aad76606d5fe591bb27b70", "text": "name: Simulator Demo\n\non:\n  workflow_dispatch:\n  schedule:\n    - cron: \"17 4 * * *\"\n  push:\n    branches:\n      - main\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: simulator-demo-${{ github.sha }}\n  cancel-in-progress: false\n\njobs:\n  build:\n    name: Build and smoke demo\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v5\n\n      - name: Install Rust\n        uses: dtolnay/rust-toolchain@stable\n        with:\n          targets: wasm32-unknown-unknown\n\n      - name: Cache Rust dependencies\n        uses: Swatinem/rust-cache@v2\n        with:\n          prefix-key: v1-rust-no-target\n          cache-targets: false\n          shared-key: simulator-demo\n\n      - name: Install wasm-pack\n        uses: taiki-e/install-action@wasm-pack\n\n      - name: Install Node\n        uses: actions/setup-node@v5\n        with:\n          node-version: 22\n\n      - name: Build WASM crate\n        run: cargo build -p hydracache-sim-wasm --target wasm32-unknown-unknown --locked\n\n      - name: Build browser package\n        timeout-minutes: 10\n        run: wasm-pack build crates/hydracache-sim-wasm --target web --out-dir ../../demo/pkg --release -- --locked\n\n      - name: Install demo dependencies\n        timeout-minutes: 10\n        run: npm --prefix demo ci\n\n      - name: Check static demo package\n        run: npm --prefix demo run build\n\n      - name: Install Playwright browsers\n        timeout-minutes: 10\n        run: |\n          npx --prefix demo playwright install --with-deps chromium\n\n      - name: Run headless smoke\n        env:\n          HYDRACACHE_DEMO_URL: http://127.0.0.1:5173/demo/\n        run: npx --prefix demo playwright test demo/tests/ui_smoke.spec.js demo/tests/seed_share.spec.js\n\n      - name