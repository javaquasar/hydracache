obes\"] != after[\"identity_probes\"]:\n              raise SystemExit(\"host identity or held policy drifted across CPU attribution\")\n          if before[\"lease\"] != after[\"lease\"]:\n              raise SystemExit(\"serialized lease changed across CPU attribution\")\n          if before[\"source_sha\"] != source_sha or after[\"source_sha\"] != source_sha:\n              raise SystemExit(\"host receipts do not bind the diagnostic source\")\n          if before[\"result\"] != \"success\" or after[\"result\"] != \"success\":\n              raise SystemExit(\"pre/post host calibration did not pass\")\n          if diagnostic[\"source_sha\"] != source_sha or diagnostic[\"candidate_data_present\"]:\n              raise SystemExit(\"CPU attribution is not baseline-only diagnostic evidence\")\n          if not diagnostic[\"diagnostic_complete\"]:\n              raise SystemExit(\"CPU attribution did not retain a complete four-mode block\")\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          manifest = {\n              \"schema_version\": 1,\n              \"release\": \"0.73\",\n              \"profile_id\": \"observer-cpu-attribution-073-v1\",\n              \"source_sha\": source_sha,\n              \"result\": \"complete-diagnostic\",\n              \"host_fingerprint\": before[\"host_fingerprint\"],\n              \"preflight_sha256\": digest(before_path),\n              \"postflight_sha256\": digest(after_path),\n              \"cpu_attribution_sha256\": digest(diagnostic_path),\n              \"candidate_data_present\": False,\n              \"candidate_measurement_authorized\": False,\n              \"acceptance_decision_allowed\": False,\n              \"silent_retry_allowed\": False,\n          }\n          (root / \"campaign-manifest.json\").write_text(\n              json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n          )\n          PY\n\n      - name: Retain CPU attribution packet\n        if: always