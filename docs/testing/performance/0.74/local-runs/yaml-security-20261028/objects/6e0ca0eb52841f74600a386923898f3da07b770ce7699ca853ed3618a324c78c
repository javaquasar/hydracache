{"expect": "valid", "id": ".github/workflows/diagnostic-builder-074.yml", "source_sha256": "9ea33263c8f4d5509c60ed7106b4e9d5333d997ca2fbc7bb1782f37a059c6472", "text": "name: Separate Diagnostic Builder 0.74\n\non:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  actions: read\n\nconcurrency:\n  group: diagnostic-builder-074\n  cancel-in-progress: false\n\njobs:\n  build:\n    name: Frozen observer build without signing authority\n    if: github.repository_id == '1217101761' && github.ref == 'refs/heads/feat/0.74-resp-native-throughput'\n    runs-on: ubuntu-24.04\n    environment: performance-diagnostic-builder-074\n    timeout-minutes: 40\n    steps:\n      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          ref: ${{ github.sha }}\n          path: tooling\n          persist-credentials: false\n      - name: Refuse absent or unprotected signing environment\n        env:\n          GH_TOKEN: ${{ github.token }}\n        shell: bash\n        run: |\n          set -euo pipefail\n          gh api repos/javaquasar/hydracache/environments/performance-diagnostic-builder-074 > \"$RUNNER_TEMP/environment.json\"\n          gh api repos/javaquasar/hydracache/environments/performance-diagnostic-builder-074/deployment-branch-policies > \"$RUNNER_TEMP/branches.json\"\n          python3 tooling/scripts/perf/diagnostic_builder_074.py check-protection \"$RUNNER_TEMP/environment.json\" \"$RUNNER_TEMP/branches.json\"\n      - name: Refuse missing reviewed policy before observer compilation\n        env:\n          BUILDER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_BUILDER_PUBLIC_KEY_HEX }}\n          CONTROLLER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_CONTROLLER_PUBLIC_KEY_HEX }}\n          BUILDER_POLICY_SHA256: ${{ vars.HYDRACACHE_074_BUILDER_POLICY_SHA256 }}\n        run: python3 tooling/scripts/perf/diagnostic_builder_074.py policy \"$RUNNER_TEMP/build-policy.json\"\n      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          ref: 62114be0f5da3218706e30d7424acfb5d0579d07\n          path: observer\n          persist-credentials: false\n      - name: Install exact reviewed compiler\n        timeout-minutes: 10\n        run: rustup toolchain install 1.94.0 --profile minimal\n      - name: Build once and retain native observations; validation only\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(git rev-parse HEAD)\" = \"$GITHUB_SHA\"\n          test -z \"$(git status --porcelain=v1)\"\n          python3 -m unittest scripts.perf.test_diagnostic_builder_074\n        working-directory: tooling\n      - name: Execute fixed build coordinator\n        run: python3 tooling/scripts/perf/diagnostic_builder_074.py build observer tooling/docs/testing/performance/0.74/rental-pilot-draft build-bundle\n      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: diagnostic-unsigned-build-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: build-bundle/**\n          if-no-files-found: error\n          retention-days: 7\n          overwrite: false\n\n  sign:\n    name: Protected separate builder signing boundary\n    needs: build\n    runs-on: ubuntu-24.04\n    environment: performance-diagnostic-builder-074\n    timeout-minutes: 25\n    steps:\n      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          ref: ${{ github.sha }}\n          persist-credentials: false\n      - name: Recheck human review and exact branch before signing preparation\n        env:\n          GH_TOKEN: ${{ github.token }}\n        shell: bash\n        run: |\n          set -euo pipefail\n          gh api repos/javaquasar/hydracache/environments/performance-diagnostic-builder-074 > \"$RUNNER_TEMP/environment.json\"\n          gh api repos/javaquasar/hydracache/environments/performance-diagnostic-builder-074/deployment-branch-policies > \"$RUNNER_TEMP/branches.json\"\n          python3 scripts/perf/diagnostic_builder_074.py check-protection \"$RUNNER_TEMP/environment.json\" \"$RUNNER_TEMP/branches.json\"\n      - name: Check reviewed policy configuration before compilation\n        env:\n          BUILDER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_BUILDER_PUBLIC_KEY_HEX }}\n          CONTROLLER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_CONTROLLER_PUBLIC_KEY_HEX }}\n          BUILDER_POLICY_SHA256: ${{ vars.HYDRACACHE_074_BUILDER_POLICY_SHA256 }}\n        run: python3 scripts/perf/diagnostic_builder_074.py policy \"$RUNNER_TEMP/builder-policy.json\"\n      - name: Build reviewed signer without any signing secret\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(git rev-parse HEAD)\" = \"$GITHUB_SHA\"\n          test -z \"$(git status --porcelain=v1)\"\n          rustup toolchain install 1.94.0 --profile minimal\n          cargo +1.94.0 test -p hydracache-long-run-supervisor-074 --locked --test diagnostic_artifacts --lib builder\n          cargo +1.94.0 build -p hydracache-long-run-supervisor-074 --locked --bin diagnostic_builder\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8\n        with:\n          name: diagnostic-unsigned-build-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: build-bundle\n      - name: Sign only this run's checked fixed build with the separate key\n        shell: bash\n        env:\n          BUILDER_SIGNING_KEY_HEX: ${{ secrets.HYDRACACHE_074_BUILDER_SIGNING_KEY_HEX }}\n          CONTROLLER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_CONTROLLER_PUBLIC_KEY_HEX }}\n          BUILDER_POLICY_SHA256: ${{ vars.HYDRACACHE_074_BUILDER_POLICY_SHA256 }}\n        run: |\n          set -euo pipefail\n          umask 077\n          private=$(mktemp -d \"$RUNNER_TEMP/diagnostic-builder-074.XXXXXXXX\")\n          key=\"$private/key.hex\"\n          trap 'rm -f -- \"$key\"' EXIT\n          test -n \"$BUILDER_SIGNING_KEY_HEX\"\n          printf '%s\\n' \"$BUILDER_SIGNING_KEY_HEX\" > \"$key\"\n          unset BUILDER_SIGNING_KEY_HEX\n          mkdir -m 0700 signed-build\n          target/debug/diagnostic_builder sign \\\n            \"$RUNNER_TEMP/builder-policy.json\" \"$BUILDER_POLICY_SHA256\" \\\n            \"$CONTROLLER_PUBLIC_KEY_HEX\" \"$key\" \\\n            \"$PWD/build-bundle/observation.json\" \"$PWD/build-bundle\" \\\n            \"$PWD/signed-build/build-receipt-v1.json\"\n          cp \"$RUNNER_TEMP/builder-policy.json\" signed-build/builder-policy.json\n          sha256sum signed-build/build-receipt-v1.json > signed-build/build-receipt.sha256\n      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: diagnostic-signed-build-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: signed-build/**\n          if-no-files-found: error\n          retention-days: 30\n          overwrite: false\n"}
{"expect": "valid", "id": ".github/workflows/docs-site.yml", "source_sha256": "bb755b622ebf8098b7926cb482ff5fe7631e4145061e4942345f4eba473ea708", "text": "name: Documentation Site\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - \"README.md\"\n      - \"docs-site/**\"\n      - \"docs/releases/**\"\n      - \"docs/performance/memory-*.md\"\n      - \"scripts/docs-*.mjs\"\n      - \".github/workflows/docs-site.yml\"\n  pull_request:\n    paths:\n      - \"README.md\"\n      - \"docs-site/**\"\n      - \"docs/releases/**\"\n      - \"docs/performance/memory-*.md\"\n      - \"scripts/docs-*.mjs\"\n      - \".github/workflows/docs-site.yml\"\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  pages: write\n  id-token: write\n\nconcurrency:\n  group: docs-site-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  build:\n    name: Build and verify docs\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v5\n\n      - name: Install Rust\n        uses: dtolnay/rust-toolchain@stable\n        with:\n          components: rustfmt\n\n      - name: Install Node\n        uses: actions/setup-node@v5\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: console/package-lock.json\n\n      - name: Cache Rust dependencies\n        uses: Swatinem/rust-cache@v2\n        with:\n          prefix-key: v1-docs-site\n          cache-targets: true\n\n      - name: Install mdBook\n        uses: taiki-e/install-action@v2\n        with:\n          tool: mdbook@0.5.2\n\n      - name: Check docs examples formatting\n        run: cargo fmt --manifest-path docs-site/examples/Cargo.toml --check\n\n      - name: Check docs examples\n        run: cargo check --manifest-path docs-site/examples/Cargo.toml --all-targets --locked\n\n      - name: Build docs site\n        run: mdbook build docs-site\n\n      - name: Check documentation links\n        run: node scripts/docs-link-check.mjs\n\n      - name: Check release documentation synchronization\n        run: |\n          node --test scripts/docs-release-check.test.mjs\n          node scripts/docs-release-check.mjs\n\n      - name: Install browser dependencies\n        timeout-minutes: 10\n        run: |\n          npm --prefix console ci\n          npx --prefix console playwright install --with-deps chromium\n\n      - name: Run visual smoke\n        run: |\n          python3 -m http.server 3000 --directory docs-site/book &\n          node scripts/docs-visual-smoke.mjs\n\n      - name: Configure Pages\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n        uses: actions/configure-pages@v6\n\n      - name: Upload Pages artifact\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n        uses: actions/upload-pages-artifact@v5\n        with:\n          path: docs-site/book\n\n  deploy:\n    name: Publish docs\n    if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n    needs: build\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v5\n"}
{"expect": "valid", "id": ".github/workflows/hc2-client-plane.yml", "source_sha256": "041a8d54363f4eebc42363ccd6f7368bd864a5ba1a104bec367770c3aa709e38", "text": "name: HC/2 Client Plane Evidence\n\non:\n  pull_request:\n  push:\n    branches:\n      - main\n      - master\n    tags:\n      - \"v0.68.*\"\n  schedule:\n    - cron: \"17 4 * * 1\"\n  workflow_dispatch:\n    inputs:\n      run_hc2_fuzz:\n        description: \"Run the time-boxed HC/2 fuzz lane\"\n        required: false\n        default: false\n        type: boolean\n      run_hc2_fixed_host_soak:\n        description: \"Run the HC/2 soak lane on the labelled fixed host\"\n        required: false\n        default: false\n        type: boolean\n      run_hc2_hosted_admission:\n        description: \"Require same-SHA Linux, Docker, and fuzz receipts for the Rust 0.68 release\"\n        required: false\n        default: false\n        type: boolean\n      run_hc2_release_admission:\n        description: \"Require all four same-SHA receipts before promoting client SDK distributions\"\n        required: false\n        default: false\n        type: boolean\n      retain_hc2_daemon_commit:\n        description: \"Exact 40-hex commit whose production HC/2 daemon must be retained\"\n        required: false\n        default: \"\"\n        type: string\n\npermissions:\n  contents: read\n  actions: read\n\nconcurrency:\n  group: \"hc2-client-plane-${{ github.workflow }}-${{ github.ref }}\"\n  cancel-in-progress: true\n\nenv:\n  HYDRACACHE_EVIDENCE_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n  HYDRACACHE_EVIDENCE_BASE_SHA: ${{ github.event.pull_request.base.sha || github.sha }}\n  HYDRACACHE_EVIDENCE_TESTED_SHA: ${{ github.sha }}\n  HC2_RUST_TOOLCHAIN: \"1.94.0\"\n  HC2_FUZZ_TOOLCHAIN: \"nightly-2026-08-01\"\n  HC2_FUZZ_SEED: \"220068\"\n  HC2_SOAK_ITERATIONS: \"12\"\n  HC2_INTEROP_IMAGE: \"ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea\"\n  CARGO_INCREMENTAL: 0\n  CARGO_PROFILE_DEV_DEBUG: 0\n  CARGO_PROFILE_TEST_DEBUG: 0\n\njobs:\n  retain-production-daemon:\n    name: HC/2 Retain Production Daemon (${{ matrix.platform }})\n    if: >-\n      github.event_name == 'workflow_dispatch'\n      && inputs.retain_hc2_daemon_commit != ''\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - platform: linux-x86_64\n            runner: ubuntu-24.04\n            executable: hydracache-server\n          - platform: windows-x86_64\n            runner: windows-2025\n            executable: hydracache-server.exe\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 30\n    steps:\n      - name: Validate requested producer identity\n        shell: bash\n        env:\n          PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n        run: |\n          if [[ ! \"$PRODUCER_COMMIT\" =~ ^[0-9a-f]{40}$ ]]; then\n            echo \"retain_hc2_daemon_commit must be an exact lowercase 40-hex commit\" >&2\n            exit 1\n          fi\n      - name: Checkout exact producer\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          ref: ${{ inputs.retain_hc2_daemon_commit }}\n          fetch-depth: 1\n      - name: Refuse checkout drift\n        shell: bash\n        env:\n          PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n        run: test \"$(git rev-parse HEAD)\" = \"$PRODUCER_COMMIT\"\n      - name: Install pinned Rust\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Build production daemon\n        shell: bash\n        run: cargo build --release -p hydracache-server --bin hydracache-server --locked\n      - name: Create identity-bound archive and receipt\n        shell: bash\n        env:\n          EXECUTABLE: ${{ matrix.executable }}\n          PLATFORM: ${{ matrix.platform }}\n          PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n        run: |\n          set -euo pipefail\n          short_commit=\"${PRODUCER_COMMIT:0:8}\"\n          bundle=\"target/hc2-retained-daemon-${short_commit}-${PLATFORM}\"\n          mkdir -p \"$bundle/bin\"\n          cp \"target/release/$EXECUTABLE\" \"$bundle/bin/$EXECUTABLE\"\n          executable_sha256=\"$(sha256sum \"$bundle/bin/$EXECUTABLE\" | cut -d' ' -f1)\"\n          executable_size=\"$(wc -c < \"$bundle/bin/$EXECUTABLE\" | tr -d ' ')\"\n          contract_blob=\"$(git rev-parse HEAD:crates/hydracache-client-hc2/proto/hc2_contract.proto)\"\n          producer_tree=\"$(git rev-parse 'HEAD^{tree}')\"\n          printf '%s\\n' \\\n            \"schema_version=hydracache.hc2.retained-daemon.v1\" \\\n            \"producer_commit=$PRODUCER_COMMIT\" \\\n            \"producer_tree=$producer_tree\" \\\n            \"contract_blob=$contract_blob\" \\\n            \"platform=$PLATFORM\" \\\n            \"executable=bin/$EXECUTABLE\" \\\n            \"executable_sha256=$executable_sha256\" \\\n            \"executable_size_bytes=$executable_size\" \\\n            > \"$bundle/receipt.txt\"\n          archive=\"$bundle.tar.gz\"\n          tar -czf \"$archive\" -C target \"$(basename \"$bundle\")\"\n          archive_sha256=\"$(sha256sum \"$archive\" | cut -d' ' -f1)\"\n          archive_size=\"$(wc -c < \"$archive\" | tr -d ' ')\"\n          printf '%s\\n' \\\n            \"archive=$(basename \"$archive\")\" \\\n            \"archive_sha256=$archive_sha256\" \\\n            \"archive_size_bytes=$archive_size\" \\\n            > \"$archive.sha256\"\n      - name: Upload retained production daemon\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-retained-daemon-${{ inputs.retain_hc2_daemon_commit }}-${{ matrix.platform }}\"\n          path: |\n            target/hc2-retained-daemon-*.tar.gz\n            target/hc2-retained-daemon-*.tar.gz.sha256\n          if-no-files-found: error\n          retention-days: 30\n\n  linux-required:\n    name: HC/2 Linux Required\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          fetch-depth: 0\n      - name: Install pinned Rust\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n          components: rustfmt, clippy\n      - name: Install pinned Java\n        uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5\n        with:\n          distribution: temurin\n          java-version: \"17\"\n          cache: maven\n      - name: Install pinned Python\n        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6\n        with:\n          python-version: \"3.12\"\n      - name: Validate workflow and generation contract\n        run: |\n          cargo fmt --all -- --check\n          cargo run -p xtask --locked -- client-plane-ci-check\n          cargo run -p xtask --locked -- client-schema-check\n      - name: Validate cross-SDK semantics\n        env:\n          PIP_NO_INDEX: \"1\"\n          PIP_DISABLE_PIP_VERSION_CHECK: \"1\"\n        run: cargo run -p xtask --locked -- client-conformance --all-sdks\n      - name: Validate lifecycle and retained replay\n        env:\n          PIP_NO_INDEX: \"1\"\n          PIP_DISABLE_PIP_VERSION_CHECK: \"1\"\n        run: cargo run -p xtask --locked -- client-plane-spike-check --runtime-only\n      - name: Validate publishable SDK packages from clean consumers\n        env:\n          PIP_NO_INDEX: \"1\"\n          PIP_DISABLE_PIP_VERSION_CHECK: \"1\"\n        run: cargo run -p xtask --locked -- client-package-check\n      - name: Clippy the HC/2 evidence surface\n        run: cargo clippy -p hydracache-client-plane-spike -p hydracache-client-hc2 -p hydracache-server -p xtask --all-targets --locked -- -D warnings\n      - name: Emit Linux receipt\n        run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane linux-required --output target/hc2-ci/linux-required.receipt.json\n      - name: Upload Linux receipt\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-linux-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: target/hc2-ci/*.receipt.json\n          if-no-files-found: warn\n          retention-days: 30\n\n  java-sdk-compatibility:\n    name: HC/2 Java SDK (Temurin ${{ matrix.java }})\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    strategy:\n      fail-fast: false\n      matrix:\n        java: [\"17\", \"21\"]\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n      - name: Install pinned Java\n        uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961 # v5\n        with:\n          distribution: temurin\n          java-version: ${{ matrix.java }}\n          cache: maven\n      - name: Install pinned Rust for process interoperability\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Build Rust fixtures and verify the native SDK\n        run: cargo run -p xtask --locked -- client-plane-java-sdk-check\n      - name: Verify the external facade consumer\n        run: mvn -B -ntp -f tests/java-hazelcast-facade-consumer/pom.xml verify\n\n  docker-interop:\n    name: HC/2 Docker Interop\n    runs-on: ubuntu-24.04\n    # The digest-pinned image is rebuilt with --pull on every candidate. Keep a\n    # bounded margin for transient Ubuntu archive slowness before the actual\n    # interop suite starts.\n    timeout-minutes: 90\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          fetch-depth: 0\n      - name: Install pinned receipt toolchain\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Build digest-pinned interop environment\n        run: docker build --pull --file scripts/hc2/Dockerfile.interop --tag hydracache-hc2-interop:${{ github.sha }} .\n      - name: Run Rust, Java, and offline Python process interop in Docker\n        run: |\n          mkdir -p target/hc2-docker\n          docker run --rm \\\n            --volume \"$PWD:/workspace\" \\\n            --workdir /workspace \\\n            --env CARGO_TARGET_DIR=/workspace/target/hc2-docker \\\n            --env HC2_SHARED_TARGET_DIR=target/hc2-docker \\\n            hydracache-hc2-interop:${{ github.sha }} \\\n            run -p xtask --locked -- client-plane-docker-interop-check 2>&1 | tee target/hc2-ci-docker.log\n      - name: Emit Docker receipt\n        run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane docker-interop --image \"$HC2_INTEROP_IMAGE\" --output target/hc2-ci/docker-interop.receipt.json\n      - name: Upload Docker receipt and log\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-docker-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: |\n            target/hc2-ci/*.receipt.json\n            target/hc2-ci-docker.log\n          if-no-files-found: warn\n          retention-days: 30\n\n  fuzz:\n    name: HC/2 Fuzz Scheduled\n    if: >-\n      github.event_name == 'schedule'\n      || startsWith(github.ref, 'refs/tags/v0.68.')\n      || (github.event_name == 'workflow_dispatch'\n          && (inputs.run_hc2_fuzz\n              || inputs.run_hc2_hosted_admission\n              || inputs.run_hc2_release_admission))\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n      - name: Install pinned stable Rust for receipts\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Install pinned fuzz toolchain and cargo-fuzz\n        timeout-minutes: 10\n        run: |\n          rustup toolchain install \"$HC2_FUZZ_TOOLCHAIN\"\n          cargo install cargo-fuzz --version 0.13.2 --locked\n      - name: Run bounded HC/2 corpus fuzzing\n        working-directory: fuzz\n        run: |\n          cargo +\"$HC2_FUZZ_TOOLCHAIN\" fuzz build fuzz_hc2_client_plane\n          set +e\n          timeout --signal=INT --kill-after=10s 180s \\\n            cargo +\"$HC2_FUZZ_TOOLCHAIN\" fuzz run fuzz_hc2_client_plane -- \\\n              -seed=\"$HC2_FUZZ_SEED\" -timeout=5 \\\n              -error_exitcode=77 -timeout_exitcode=70 \\\n            2>&1 | tee ../target/hc2-ci-fuzz.log\n          fuzz_status=${PIPESTATUS[0]}\n          set -e\n          if [[ \"$fuzz_status\" -ne 0 && \"$fuzz_status\" -ne 124 ]]; then\n            echo \"HC/2 fuzz target failed with status $fuzz_status\" >&2\n            exit \"$fuzz_status\"\n          fi\n          if find artifacts/fuzz_hc2_client_plane -type f -print -quit | grep -q .; then\n            echo \"HC/2 fuzz target produced a failure artifact\" >&2\n            exit 1\n          fi\n          echo \"HC/2 fuzz timebox completed without a failure artifact\"\n      - name: Emit fuzz receipt\n        run: cargo +\"$HC2_RUST_TOOLCHAIN\" run -p xtask --locked -- client-plane-ci-receipt --lane fuzz --seed \"$HC2_FUZZ_SEED\" --output target/hc2-ci/fuzz.receipt.json\n      - name: Upload fuzz corpus, failures, log, and receipt\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-fuzz-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: |\n            fuzz/corpus/fuzz_hc2_client_plane/**\n            fuzz/artifacts/fuzz_hc2_client_plane/**\n            target/hc2-ci-fuzz.log\n            target/hc2-ci/*.receipt.json\n          if-no-files-found: warn\n          retention-days: 30\n\n  fixed-host-soak:\n    name: HC/2 Fixed-host Soak\n    if: >-\n      (github.event_name == 'schedule' && vars.HC2_FIXED_HOST_SOAK_ENABLED == 'true')\n      || (github.event_name == 'workflow_dispatch'\n          && (inputs.run_hc2_fixed_host_soak || inputs.run_hc2_release_admission))\n    runs-on: [self-hosted, linux, x64, hydracache-hc2-soak-v1]\n    timeout-minutes: 90\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n        with:\n          fetch-depth: 0\n      - name: Install pinned Rust\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Verify fixed-host contract and capture metadata\n        env:\n          HC2_FIXED_HOST_PROFILE: hc2-fixed-soak-v1\n        run: scripts/hc2/verify-fixed-host.sh --output target/hc2-ci/fixed-host-metadata.log\n      - name: Run bounded lifecycle soak\n        timeout-minutes: 60\n        run: |\n          set -o pipefail\n          for iteration in $(seq 1 \"$HC2_SOAK_ITERATIONS\"); do\n            echo \"hc2-soak-iteration=$iteration\"\n            cargo test -p hydracache-client-plane-spike --locked --test grpc_bidirectional_loopback --test fault_proxy --test http2_drain_faults --test observability_contract\n          done 2>&1 | tee target/hc2-ci/fixed-host-soak.log\n      - name: Emit fixed-host receipt\n        run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane fixed-host-soak --iterations \"$HC2_SOAK_ITERATIONS\" --output target/hc2-ci/fixed-host-soak.receipt.json\n      - name: Upload fixed-host metadata, log, and receipt\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-soak-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: target/hc2-ci/**\n          if-no-files-found: warn\n          retention-days: 30\n\n  hosted-release-admission:\n    name: HC/2 Hosted Release Admission\n    if: >-\n      always()\n      && (startsWith(github.ref, 'refs/tags/v0.68.')\n          || (github.event_name == 'workflow_dispatch'\n              && (inputs.run_hc2_hosted_admission || inputs.run_hc2_release_admission)))\n    needs: [linux-required, docker-interop, fuzz]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n      - name: Install pinned Rust\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Download same-run HC/2 receipts\n        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1\n        with:\n          pattern: \"hc2-*-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: target/hc2-ci-admission\n          merge-multiple: true\n      - name: Refuse incomplete or red hosted 0.68 claim\n        run: cargo run -p xtask --locked -- evidence-run --release 0.68 --gate tool.hc2-hosted-admission-068\n      - name: Upload hosted release-admission evidence\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-hosted-admission-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: |\n            target/test-evidence/0.68/hc2-hosted-admission.json\n            target/release-evidence/**\n          if-no-files-found: error\n          retention-days: 30\n\n  release-admission:\n    name: HC/2 Client Promotion Admission\n    if: >-\n      always()\n      && github.event_name == 'workflow_dispatch'\n      && inputs.run_hc2_release_admission\n    needs: [linux-required, docker-interop, fuzz, fixed-host-soak]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout exact candidate\n        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\n      - name: Install pinned Rust\n        uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n        with:\n          toolchain: \"1.94.0\"\n      - name: Download same-run HC/2 receipts\n        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1\n        with:\n          pattern: \"hc2-*-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: target/hc2-ci-admission\n          merge-multiple: true\n      - name: Refuse incomplete or red HC/2 client promotion\n        run: cargo run -p xtask --locked -- evidence-run --release 0.68 --gate tool.hc2-release-admission-068\n      - name: Upload client-promotion evidence\n        if: always()\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6\n        with:\n          name: \"hc2-client-promotion-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\"\n          path: |\n            target/test-evidence/0.68/hc2-release-admission.json\n            target/release-evidence/**\n          if-no-files-found: error\n          retention-days: 30\n"}
{"expect": "valid", "id": ".github/workflows/management-baseline-072.yml", "source_sha256": "78a6fc471038d72e19a0603db0a3b537eb4864d84a348bc9ec66a65abbe78e69", "text": "name: Management Baselines 0.72\n\non:\n  push:\n    branches:\n      - evidence/0.72-baseline-capture\n    paths:\n      - \"scripts/management/capture-baseline-072.mjs\"\n      - \"scripts/management/capture-baseline-072.test.mjs\"\n      - \".github/workflows/management-baseline-072.yml\"\n  workflow_dispatch:\n    inputs:\n      candidate_sha:\n        description: \"Already-qualified 0.72 candidate SHA\"\n        required: true\n        default: \"24927c28c279c6c34ad90111ee6470b4065e0815\"\n        type: string\n\nconcurrency:\n  group: management-baseline-072-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  capture:\n    name: Capture immutable pre-feature and v0.71 baselines\n    runs-on: ubuntu-24.04\n    timeout-minutes: 90\n    container:\n      image: mcr.microsoft.com/playwright:v1.57.0-noble\n      options: --ipc=host\n    env:\n      CANDIDATE_SHA: ${{ inputs.candidate_sha || '24927c28c279c6c34ad90111ee6470b4065e0815' }}\n      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright\n\n    steps:\n      - name: Checkout evidence tooling\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          path: tooling\n\n      - name: Checkout exact qualified candidate\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          ref: ${{ env.CANDIDATE_SHA }}\n          path: candidate\n\n      - name: Checkout exact pre-feature baseline\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          ref: 8d205fa302d81a07c19147cb4431e16390d256c3\n          path: baseline-pre-feature\n\n      - name: Checkout published v0.71.0 baseline\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          ref: v0.71.0\n          path: baseline-v071\n\n      - name: Install Node\n        uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: |\n            baseline-pre-feature/console/package-lock.json\n            baseline-v071/console/package-lock.json\n\n      - name: Verify capture unit and tamper tests\n        working-directory: tooling\n        run: node --test scripts/management/capture-baseline-072.test.mjs\n\n      - name: Capture pre-feature baseline\n        working-directory: tooling\n        run: >-\n          node scripts/management/capture-baseline-072.mjs\n          --baseline pre_feature\n          --source-root ../baseline-pre-feature\n          --candidate-root ../candidate\n          --output ../candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json\n\n      - name: Capture published v0.71.0 baseline\n        working-directory: tooling\n        run: >-\n          node scripts/management/capture-baseline-072.mjs\n          --baseline published_previous\n          --source-root ../baseline-v071\n          --candidate-root ../candidate\n          --output ../candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json\n\n      - name: Refuse candidate or source mutation\n        run: |\n          test \"$(git -C candidate rev-parse HEAD)\" = \"$CANDIDATE_SHA\"\n          test -z \"$(git -C candidate status --porcelain --untracked-files=normal)\"\n          test -z \"$(git -C baseline-pre-feature status --porcelain --untracked-files=normal)\"\n          test -z \"$(git -C baseline-v071 status --porcelain --untracked-files=normal)\"\n\n      - name: Upload immutable baseline evidence\n        uses: actions/upload-artifact@v6\n        with:\n          name: management-baselines-072-${{ env.CANDIDATE_SHA }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json\n            candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json.raw.json\n            candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json\n            candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json.raw.json\n          if-no-files-found: error\n          retention-days: 90\n"}
{"expect": "valid", "id": ".github/workflows/memory-reference-071.yml", "source_sha256": "a258f9b37258826496ad492a738ec6c2b6fa566ee50a78e804309ee1888b59df", "text": "name: Memory Reference 0.71\n\nrun-name: Memory 0.71 ${{ inputs.case_id }} ${{ inputs.campaign_id }} source ${{ inputs.source_sha }}\n\non:\n  workflow_dispatch:\n    inputs:\n      campaign_id:\n        description: \"Immutable operator-approved campaign id\"\n        required: true\n        type: string\n      source_sha:\n        description: \"Exact lowercase 40-character candidate commit from the canonical repository\"\n        required: true\n        type: string\n      campaign_role:\n        description: \"Baseline freezes B0/B1; candidate measures the frozen B1/C pair\"\n        required: true\n        default: candidate\n        type: choice\n        options:\n          - candidate\n          - baseline\n      case_id:\n        description: \"One preregistered scenario row\"\n        required: true\n        default: M0-cold\n        type: choice\n        options:\n          - M0-cold\n          - M1-shape\n          - M2-rewrite\n          - M3-ttl\n          - M4-reset\n          - M5-tags\n          - M6-connections\n          - M7-persistence\n          - M8-60m\n          - M9-6h\n          - M10-24h\n      lease_owner:\n        description: \"Protected-host lease owner recorded by preflight\"\n        required: true\n        type: string\n      lease_end:\n        description: \"Approved lease end in RFC3339 form\"\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: memory-reference-071-${{ inputs.source_sha }}-${{ inputs.campaign_id }}\n  cancel-in-progress: false\n\njobs:\n  campaign:\n    name: Protected memory campaign\n    runs-on: [self-hosted, linux, x64, memory-reference-071]\n    environment: memory-reference-071\n    timeout-minutes: 4320\n    defaults:\n      run:\n        working-directory: trusted-harness\n    env:\n      CAMPAIGN_ROOT: /var/lib/hydracache-memory/campaigns\n      BUILD_ROOT: /var/lib/hydracache-memory/build\n      MIRROR_ROOT: /mnt/hydracache-protected-memory\n      HYDRACACHE_MEMORY_PROTECTED_ENV: memory-reference-071\n      HYDRACACHE_MEMORY_DEDICATED_BARE_METAL: \"1\"\n      HYDRACACHE_MEMORY_LEASE_OWNER: ${{ inputs.lease_owner }}\n      HYDRACACHE_MEMORY_LEASE_END: ${{ inputs.lease_end }}\n      HYDRACACHE_MEMORY_WORKFLOW_SHA: ${{ github.sha }}\n      HYDRACACHE_MEMORY_SOURCE_SHA: ${{ inputs.source_sha }}\n      HYDRACACHE_MEMORY_CAMPAIGN_ROLE: ${{ inputs.campaign_role }}\n      HYDRACACHE_MEMORY_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_MEMORY_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_MEMORY_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      BOOTSTRAP_RECEIPT: /var/lib/hydracache-memory/admission/reference-activation.json\n      HISTORICAL_RECEIPT: /var/lib/hydracache-memory/admission/historical-input-receipt.json\n      OVERHEAD_RECEIPT: /var/lib/hydracache-memory/admission/instrumentation-overhead.json\n      OVERHEAD_HOST_PREFLIGHT: /var/lib/hydracache-memory/admission/instrumentation-overhead-host-preflight.json\n\n    steps:\n      - name: Checkout trusted campaign harness from main\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          path: trusted-harness\n\n      - name: Reject non-main workflow dispatch\n        shell: bash\n        timeout-minutes: 1\n        env:\n          SOURCE_SHA: ${{ inputs.source_sha }}\n          WORKFLOW_SHA: ${{ github.sha }}\n        run: |\n          set -euo pipefail\n          if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n            echo \"Memory Reference 0.71 must be dispatched from main, observed $GITHUB_REF\" >&2\n            exit 1\n          fi\n          if [[ ! \"$SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]; then\n            echo \"source_sha must be a lowercase 40-character commit SHA\" >&2\n            exit 1\n          fi\n          test \"$(git rev-parse HEAD)\" = \"$WORKFLOW_SHA\"\n\n      - name: Expose and verify the runner Rust toolchain\n        shell: bash\n        timeout-minutes: 1\n        run: |\n          set -euo pipefail\n          rust_bin=\"$HOME/.cargo/bin\"\n          test -x \"$rust_bin/cargo\"\n          test -x \"$rust_bin/rustc\"\n          echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n          \"$rust_bin/cargo\" --version\n          \"$rust_bin/rustc\" --version\n\n      - name: Checkout exact candidate source without persisted credentials\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 1\n          persist-credentials: false\n          path: candidate-source\n          ref: ${{ inputs.source_sha }}\n\n      - name: Resolve exact candidate source without executing it\n        shell: bash\n        timeout-minutes: 5\n        env:\n          SOURCE_SHA: ${{ inputs.source_sha }}\n          WORKFLOW_SHA: ${{ github.sha }}\n        run: |\n          set -euo pipefail\n          test \"$(git rev-parse HEAD)\" = \"$WORKFLOW_SHA\"\n          test \"$(git -C \"$GITHUB_WORKSPACE/candidate-source\" rev-parse HEAD)\" = \"$SOURCE_SHA\"\n          git fetch --no-tags \"$GITHUB_WORKSPACE/candidate-source\" \"$SOURCE_SHA\"\n          test \"$(git rev-parse 'FETCH_HEAD^{commit}')\" = \"$SOURCE_SHA\"\n          git cat-file -e \"$SOURCE_SHA^{commit}\"\n\n      - name: Preflight host and freeze campaign plan\n        shell: bash\n        timeout-minutes: 15\n        run: |\n          set -euo pipefail\n          test -n \"${{ inputs.campaign_id }}\"\n          test -f \"$BOOTSTRAP_RECEIPT\"\n          test -f \"$HISTORICAL_RECEIPT\"\n          python3 scripts/perf/memory_campaign_071.py doctor --evidence\n          taskset --cpu-list \"$HYDRACACHE_MEMORY_LOADGEN_CPUSET\" \\\n            cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.71 \\\n            --profile memory-reference-071-v1 \\\n            --output \"$RUNNER_TEMP/host-preflight.json\"\n          campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n          if [[ ! -f \"$campaign_dir/state.json\" ]]; then\n            if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" == \"candidate\" ]]; then\n              cohort_args=(--cohort B1-instrumented --cohort C-candidate)\n            else\n              cohort_args=(--cohort B1-instrumented)\n              if [[ \"${{ inputs.case_id }}\" == \"M0-cold\" ]]; then\n                cohort_args=(--cohort B0-release --cohort B1-instrumented)\n              fi\n            fi\n            python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" plan \\\n              --campaign-id \"${{ inputs.campaign_id }}\" \\\n              --case \"${{ inputs.case_id }}\" \\\n              --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n              --source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n              --campaign-role \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" \\\n              --mirror-root \"$MIRROR_ROOT\" \\\n              \"${cohort_args[@]}\"\n          fi\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" verify-identity \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --case \"${{ inputs.case_id }}\" \\\n            --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n            --source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n            --campaign-role \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\"\n\n      - name: Build immutable cohorts\n        shell: bash\n        timeout-minutes: 120\n        run: |\n          set -euo pipefail\n          prerequisite=\"\"\n          case \"${{ inputs.case_id }}\" in\n            M8-60m) prerequisite=\"M3-ttl\" ;;\n            M9-6h) prerequisite=\"M8-60m\" ;;\n            M10-24h) prerequisite=\"M9-6h\" ;;\n          esac\n          if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" == \"candidate\" && -n \"$prerequisite\" ]]; then\n            cargo run -p xtask --locked -- memory-campaign-check \\\n              --release 0.71 \\\n              --campaigns \"$CAMPAIGN_ROOT\" \\\n              --require-through \"$prerequisite\" \\\n              --expected-source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\"\n          fi\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" prepare \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --build-root \"$BUILD_ROOT\"\n\n      - name: Measure and freeze S5 instrumentation overhead\n        shell: bash\n        timeout-minutes: 720\n        run: |\n          set -euo pipefail\n          campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n          if [[ ! -f \"$OVERHEAD_RECEIPT\" ]]; then\n            if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" != \"baseline\" ]]; then\n              echo \"candidate campaigns require the frozen baseline-only S5 receipt\" >&2\n              exit 1\n            fi\n            readarray -t retained < <(python3 - \"$campaign_dir/state.json\" <<'PY'\n          import json\n          import pathlib\n          import sys\n          state_path = pathlib.Path(sys.argv[1])\n          state = json.loads(state_path.read_text(encoding=\"utf-8\"))\n          root = state_path.parent\n          print(root / state[\"builds\"][\"B1-instrumented\"][\"manifest\"])\n          print(root / state[\"controller_tools\"][\"hc2_helper_manifest\"])\n          print(state[\"scenario_digest\"])\n          PY\n            )\n            overhead_tmp=\"${OVERHEAD_RECEIPT}.${{ github.run_id }}.${{ github.run_attempt }}.tmp\"\n            trap 'rm -f -- \"$overhead_tmp\"' EXIT\n            python3 scripts/perf/memory_instrumentation_overhead_071.py \\\n              --build-manifest \"${retained[0]}\" \\\n              --hc2-helper-manifest \"${retained[1]}\" \\\n              --scenario-digest \"${retained[2]}\" \\\n              --host-preflight \"$RUNNER_TEMP/host-preflight.json\" \\\n              --work-root \"$CAMPAIGN_ROOT/_s5/${{ inputs.campaign_id }}-${{ github.run_id }}-${{ github.run_attempt }}\" \\\n              --output \"$overhead_tmp\"\n            cp --no-clobber \"$RUNNER_TEMP/host-preflight.json\" \"$OVERHEAD_HOST_PREFLIGHT\"\n            chmod 0444 \"$OVERHEAD_HOST_PREFLIGHT\"\n            mv --no-clobber \"$overhead_tmp\" \"$OVERHEAD_RECEIPT\"\n            chmod 0444 \"$OVERHEAD_RECEIPT\"\n            trap - EXIT\n          fi\n\n      - name: Admit campaign or verify retained host identity\n        shell: bash\n        timeout-minutes: 5\n        run: |\n          set -euo pipefail\n          campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n          test -f \"$OVERHEAD_RECEIPT\"\n          test -f \"$OVERHEAD_HOST_PREFLIGHT\"\n          if [[ ! -f \"$campaign_dir/admission/admission-manifest.json\" ]]; then\n            python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" admit \\\n              --campaign-id \"${{ inputs.campaign_id }}\" \\\n              --host-preflight \"$RUNNER_TEMP/host-preflight.json\" \\\n              --bootstrap \"$BOOTSTRAP_RECEIPT\" \\\n              --historical \"$HISTORICAL_RECEIPT\" \\\n              --overhead \"$OVERHEAD_RECEIPT\" \\\n              --overhead-host-preflight \"$OVERHEAD_HOST_PREFLIGHT\"\n          else\n            python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" verify-host \\\n              --campaign-id \"${{ inputs.campaign_id }}\" \\\n              --host-preflight \"$RUNNER_TEMP/host-preflight.json\"\n          fi\n\n      - name: Prove real v0.70 candidate upgrade restart and rollback before M10\n        if: inputs.campaign_role == 'candidate' && inputs.case_id == 'M10-24h'\n        shell: bash\n        timeout-minutes: 180\n        run: |\n          set -euo pipefail\n          campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n          bash scripts/perf/memory_compat_071.sh \\\n            --candidate-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n            --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --output \"$campaign_dir/compatibility-receipt.json\"\n\n      - name: Run or resume bounded row\n        shell: bash\n        timeout-minutes: 4250\n        run: |\n          set -euo pipefail\n          python3 scripts/ci/run-with-heartbeat.py \\\n            --timeout-seconds 252000 \\\n            --heartbeat-seconds 30 \\\n            --attempt-id \"${{ github.run_attempt }}\" \\\n            --status-json \"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}/watchdog-status-${{ github.run_attempt }}.json\" \\\n            --log-file \"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}/watchdog-${{ github.run_attempt }}.log\" \\\n            -- \\\n            python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" resume \\\n              --campaign-id \"${{ inputs.campaign_id }}\"\n\n      - name: Finalize immutable campaign manifest\n        shell: bash\n        timeout-minutes: 15\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" finalize \\\n            --campaign-id \"${{ inputs.campaign_id }}\"\n\n      - name: Retain compact attempt state\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: memory-reference-071-${{ inputs.source_sha }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/campaign-identity.json\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/state.json\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/events.jsonl\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/watchdog-*\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/campaign-receipt.json\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/compatibility-receipt.json\n            ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/admission/*.json\n          if-no-files-found: error\n          retention-days: 90\n"}
{"expect": "valid", "id": ".github/workflows/observer-semantics-074.yml", "source_sha256": "901943df7431794aa27c9d85a28442f6b3221be65ff151fbbc8d5dc1918cdf51", "text": "name: Observer Semantics 0.74\n\non:\n  push:\n    branches: [feat/0.74-resp-native-throughput]\n    paths:\n      - .github/workflows/observer-semantics-074.yml\n      - tools/get-owner-scheduled-controls-074/**\n      - tools/resp-scratch-screen-074/src/memory.rs\n      - crates/hydracache-server/src/redis_tcp.rs\n      - crates/hydracache-server/src/config.rs\n      - crates/hydracache-server/src/bootstrap.rs\n      - crates/hydracache-redis-compat/src/**\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: observer-semantics-074-${{ github.sha }}\n  cancel-in-progress: false\n\njobs:\n  semantic:\n    name: Exact-SHA default and get-owner semantic controls (not qualification)\n    runs-on: ubuntu-24.04\n    timeout-minutes: 40\n    env:\n      CARGO_BUILD_JOBS: 2\n      CARGO_INCREMENTAL: 0\n      CARGO_PROFILE_DEV_DEBUG: 0\n      CARGO_PROFILE_TEST_DEBUG: 0\n    steps:\n      - name: Check out exact event source\n        uses: actions/checkout@v5\n        with:\n          ref: ${{ github.sha }}\n          persist-credentials: false\n      - name: Install reviewed toolchain\n        uses: dtolnay/rust-toolchain@1.94.0\n        with:\n          components: rustfmt, clippy\n      - name: Record exact non-promotable source and toolchain\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(git rev-parse HEAD)\" = \"$GITHUB_SHA\"\n          test -z \"$(git status --porcelain)\"\n          mkdir -p target/observer-semantics-074\n          printf 'source_commit=%s\\nrun_id=%s\\nattempt=%s\\npromotable=false\\nqualification=false\\n' \"$GITHUB_SHA\" \"$GITHUB_RUN_ID\" \"$GITHUB_RUN_ATTEMPT\" > target/observer-semantics-074/identity.txt\n          rustc -Vv > target/observer-semantics-074/rustc.txt\n          sha256sum Cargo.lock tools/get-owner-scheduled-controls-074/Cargo.lock docs/testing/performance/0.74/qualification-manifest.toml > target/observer-semantics-074/locks.txt\n      - name: Format and strict lint (no numerical executable invocation)\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo fmt --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --check\n          cargo check --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --all-targets --all-features --locked 2>&1 | tee target/observer-semantics-074/check.log\n          cargo clippy --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --all-targets --all-features --locked -- -D warnings 2>&1 | tee target/observer-semantics-074/clippy.log\n      - name: Default semantic tests with allocation-counter unit tests only\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo test --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --all-targets --features allocation-diagnostics --locked -- --test-threads=1 2>&1 | tee target/observer-semantics-074/default.log\n      - name: Get-owner semantic tests (not native numerical nonregression)\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo test --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --all-targets --all-features --locked -- --test-threads=1 2>&1 | tee target/observer-semantics-074/get-owner.log\n          test -z \"$(git status --porcelain)\"\n      - name: Unprofiled executable entry-point correctness (one offer, not a cohort)\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo test --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --test timing_cli --no-default-features --locked -- --test-threads=1 2>&1 | tee target/observer-semantics-074/timing-cli-default.log\n          cargo test --manifest-path tools/get-owner-scheduled-controls-074/Cargo.toml --test timing_cli --no-default-features --features get-owner --locked -- --test-threads=1 2>&1 | tee target/observer-semantics-074/timing-cli-get-owner.log\n          test -z \"$(git status --porcelain)\"\n      - name: Retain immutable attempt logs even on failure\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: observer-semantics-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/observer-semantics-074/**\n          if-no-files-found: error\n          retention-days: 30\n"}
{"expect": "valid", "id": ".github/workflows/performance-allocator-attribution-074.yml", "source_sha256": "68bc98dc4332d44fd7fb969c8ac3204e5be8708a676add7d8ae47cdcac3235ad", "text": "name: Performance Allocator Attribution 0.74\n\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact lowercase 40-character attribution source commit\n        required: true\n        type: string\n      lease_owner:\n        description: Operator holding the serialized performance-host lease\n        required: true\n        type: string\n      lease_end:\n        description: Approved lease end in RFC3339 form\n        required: true\n        type: string\n  push:\n    branches:\n      - feat/0.74-resp-native-throughput\n    paths:\n      - .github/workflows/performance-allocator-attribution-074.yml\n      - scripts/perf/performance_allocator_profile_074.py\n      - tools/allocator-profile-074/**\n      - docs/testing/performance/0.74/w9e-linux-allocator-profile-contract.toml\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: performance-reference-074-host\n  cancel-in-progress: false\n\njobs:\n  attribute:\n    name: Non-promotable Linux allocator owner attribution\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 75\n    env:\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w9e-allocator\n\n    steps:\n      - name: Check out exact attribution source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n          ref: ${{ inputs.source_sha || github.sha }}\n\n      - name: Resolve immutable source and lease\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n        run: |\n          set -euo pipefail\n          source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n          lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n          lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+75 minutes' --iso-8601=seconds)}\"\n          [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n          test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n          test -n \"$lease_owner\"\n          lease_epoch=\"$(date --date=\"$lease_end\" +%s)\"\n          now_epoch=\"$(date +%s)\"\n          test \"$lease_epoch\" -gt \"$now_epoch\"\n          test \"$lease_epoch\" -le \"$((now_epoch + 7200))\"\n          {\n            echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Verify Linux toolchain and allocator prerequisites\n        shell: bash\n        run: |\n          set -euo pipefail\n          test \"$(uname -s)\" = Linux\n          test \"$(uname -m)\" = x86_64\n          test -r /proc/self/smaps_rollup\n          test -r /etc/machine-id\n          command -v cargo\n          command -v rustc\n          command -v python3\n          cargo --version\n          rustc --version\n          ldd --version | head -n 1\n\n      - name: Capture pre-attribution host identity\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          python3 - \"$EVIDENCE_DIR/preflight.json\" <<'PY'\n          import hashlib, json, os, pathlib, platform, subprocess\n          def command(*args):\n              return subprocess.check_output(args, text=True).strip()\n          machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n          value = {\n              'schema_version': 1,\n              'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n              'lease': {\n                  'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'],\n                  'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END'],\n              },\n              'host': {\n                  'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                  'node': platform.node(),\n                  'machine': platform.machine(),\n                  'kernel': platform.release(),\n                  'cpu_count': os.cpu_count(),\n                  'cpu_model': next(\n                      line.split(':', 1)[1].strip()\n                      for line in pathlib.Path('/proc/cpuinfo').read_text().splitlines()\n                      if line.startswith('model name')\n                  ),\n              },\n              'toolchain': {'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version')},\n          }\n          pathlib.Path(os.sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n          PY\n\n      - name: Build three exact allocator variants\n        shell: bash\n        run: |\n          set -euo pipefail\n          for allocator in system mimalloc jemalloc; do\n            CARGO_TARGET_DIR=\"target/w9e-$allocator\" cargo build \\\n              --manifest-path tools/allocator-profile-074/Cargo.toml \\\n              --release --locked --no-default-features --features \"allocator-$allocator\"\n          done\n\n      - name: Run counterbalanced owner attribution\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_allocator_profile_074.py \\\n            --system-binary target/w9e-system/release/allocator-profile-074 \\\n            --mimalloc-binary target/w9e-mimalloc/release/allocator-profile-074 \\\n            --jemalloc-binary target/w9e-jemalloc/release/allocator-profile-074 \\\n            --output-dir \"$EVIDENCE_DIR/campaign\" \\\n            --source-commit \"$EXPECTED_SOURCE_SHA\" \\\n            --tool-source tools/allocator-profile-074/src/main.rs \\\n            --tool-lock tools/allocator-profile-074/Cargo.lock \\\n            --contract docs/testing/performance/0.74/w9e-linux-allocator-profile-contract.toml \\\n            --repeats 5\n\n      - name: Capture post-attribution host identity\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - \"$EVIDENCE_DIR/postflight.json\" <<'PY'\n          import hashlib, json, os, pathlib, platform, subprocess\n          def command(*args):\n              return subprocess.check_output(args, text=True).strip()\n          machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n          value = {\n              'schema_version': 1,\n              'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n              'lease': {\n                  'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'],\n                  'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END'],\n              },\n              'host': {\n                  'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                  'node': platform.node(),\n                  'machine': platform.machine(),\n                  'kernel': platform.release(),\n                  'cpu_count': os.cpu_count(),\n                  'cpu_model': next(\n                      line.split(':', 1)[1].strip()\n                      for line in pathlib.Path('/proc/cpuinfo').read_text().splitlines()\n                      if line.startswith('model name')\n                  ),\n              },\n              'toolchain': {'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version')},\n          }\n          pathlib.Path(os.sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n          PY\n\n      - name: Seal non-promotable attribution packet\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - \"$EVIDENCE_DIR\" <<'PY'\n          import hashlib, json, os, pathlib, sys\n          root = pathlib.Path(sys.argv[1])\n          before = json.loads((root / 'preflight.json').read_text())\n          after = json.loads((root / 'postflight.json').read_text())\n          manifest_path = root / 'campaign' / 'manifest.json'\n          summary_path = root / 'campaign' / 'summary.json'\n          manifest = json.loads(manifest_path.read_text())\n          summary = json.loads(summary_path.read_text())\n          if before != after:\n              raise SystemExit('host, toolchain, lease, or source identity drifted')\n          if manifest['source_commit'] != os.environ['EXPECTED_SOURCE_SHA']:\n              raise SystemExit('matrix source identity drifted')\n          if manifest['failed_attempts'] or manifest['candidate_data_present']:\n              raise SystemExit('matrix is incomplete or contains candidate data')\n          if manifest['acceptance_decision_allowed'] or manifest['promotable']:\n              raise SystemExit('attribution crossed its claim boundary')\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          packet = {\n              'schema_version': 1,\n              'release': '0.74',\n              'profile_id': 'w9e-linux-allocator-profile-074-v1',\n              'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n              'result': 'complete-owner-attribution',\n              'host': before['host'],\n              'toolchain': before['toolchain'],\n              'lease': before['lease'],\n              'preflight_sha256': digest(root / 'preflight.json'),\n              'postflight_sha256': digest(root / 'postflight.json'),\n              'matrix_manifest_sha256': digest(manifest_path),\n              'summary_sha256': digest(summary_path),\n              'attempts': summary['attempts'],\n              'candidate_data_present': False,\n              'acceptance_decision_allowed': False,\n              'promotable': False,\n              'silent_retry_allowed': False,\n          }\n          (root / 'packet.json').write_text(json.dumps(packet, indent=2, sort_keys=True) + '\\n')\n          PY\n\n      - name: Retain W9e attribution packet\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-allocator-attribution-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/performance-evidence/0.74/reference/w9e-allocator/**\n          if-no-files-found: error\n          retention-days: 90\n"}
{"expect": "valid", "id": ".github/workflows/performance-baseline-pilot-073.yml", "source_sha256": "7fbb6d8950b04457a923055edaedfd5ce5458415088fb391d1ef232b316a2a6f", "text": "name: Performance Baseline Pilot V2 0.73\n\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: \"Exact lowercase 40-character baseline or integrated-tooling source commit\"\n        required: true\n        type: string\n      lease_owner:\n        description: \"Operator holding the serialized performance-host lease\"\n        required: true\n        type: string\n      lease_end:\n        description: \"Approved lease end in RFC3339 form\"\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: performance-reference-073-host\n  cancel-in-progress: false\n\njobs:\n  pilot:\n    if: inputs.source_sha == 'e757556d3a31d565f52a9561d6d4e555bb1cc373'\n    name: Paired baseline-only I73 rate and window pilot\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-073\n    timeout-minutes: 120\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: \"1\"\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      EVIDENCE_DIR: target/performance-evidence/0.73/reference/baseline-pilot-v2\n\n    steps:\n      - name: Checkout exact baseline-only source\n        uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Resolve source and serialized lease\n        shell: bash\n        env:\n          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n          INPUT_LEASE_END: ${{ inputs.lease_end }}\n        run: |\n          set -euo pipefail\n          source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n          lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n          lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+2 hours' --iso-8601=seconds)}\"\n          [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n          test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n          test -n \"$lease_owner\"\n          date --date=\"$lease_end\" >/dev/null\n          {\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n            echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n            echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n          } >> \"$GITHUB_ENV\"\n\n      - name: Expose and verify required host tools\n        shell: bash\n        run: |\n          set -euo pipefail\n          rust_bin=\"$HOME/.cargo/bin\"\n          test -x \"$rust_bin/cargo\"\n          test -x \"$rust_bin/rustc\"\n          echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n          cargo --version\n          rustc --version\n          pidstat -V\n\n      - name: Capture pre-pilot calibration\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$RUNNER_TEMP/performance-073-preflight.json\"\n\n      - name: Build exact standalone pilot harness\n        shell: bash\n        run: cargo build --manifest-path tools/performance-observer-073/Cargo.toml --release --locked\n\n      - name: Run baseline-only counterbalanced rate scan\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 scripts/perf/performance_baseline_pilot_073.py \\\n            --binary tools/performance-observer-073/target/release/performance-observer-073 \\\n            --output \"$EVIDENCE_DIR/campaign\" \\\n            --profile-id observer-baseline-pilot-073-v2 \\\n            --rates 2500,5000,10000,20000 \\\n            --repeats 5 \\\n            --window-seconds 10 \\\n            --warmup-operations 5000 \\\n            --seed 73073 \\\n            --cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\" \\\n            --source-sha \"$EXPECTED_SOURCE_SHA\"\n\n      - name: Capture post-pilot calibration\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n            --release 0.73 \\\n            --profile performance-reference-073-v1 \\\n            --output \"$RUNNER_TEMP/performance-073-postflight.json\"\n\n      - name: Seal baseline-only packet\n        if: always()\n        shell: bash\n        run: |\n          set -euo pipefail\n          mkdir -p \"$EVIDENCE_DIR\"\n          cp \"$RUNNER_TEMP/performance-073-preflight.json\" \"$EVIDENCE_DIR/preflight.json\"\n          cp \"$RUNNER_TEMP/performance-073-postflight.json\" \"$EVIDENCE_DIR/postflight.json\"\n          python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_SOURCE_SHA\" <<'PY'\n          import hashlib\n          import json\n          import pathlib\n          import sys\n\n          root = pathlib.Path(sys.argv[1])\n          source_sha = sys.argv[2]\n          before_path = root / \"preflight.json\"\n          after_path = root / \"postflight.json\"\n          pilot_path = root / \"campaign\" / \"baseline-pilot.json\"\n          before = json.loads(before_path.read_text(encoding=\"utf-8\"))\n          after = json.loads(after_path.read_text(encoding=\"utf-8\"))\n          pilot = json.loads(pilot_path.read_text(encoding=\"utf-8\"))\n          if before[\"host_fingerprint\"] != after[\"host_fingerprint\"]:\n              raise SystemExit(\"host fingerprint drifted across baseline pilot\")\n          if before[\"identity_probes\"] != after[\"identity_probes\"]:\n              raise SystemExit(\"host identity or held policy drifted across baseline pilot\")\n          if before[\"lease\"] != after[\"lease\"]:\n              raise SystemExit(\"serialized lease changed across baseline pilot\")\n          if before[\"source_sha\"] != source_sha or after[\"source_sha\"] != source_sha:\n              raise SystemExit(\"host receipts do not bind the baseline source\")\n          if before[\"result\"] != \"success\" or after[\"result\"] != \"success\":\n              raise SystemExit(\"pre/post host calibration did not pass\")\n          if (\n              pilot[\"source_sha\"] != source_sha\n              or pilot[\"candidate_data_present\"]\n              or pilot[\"profile_id\"] != \"observer-baseline-pilot-073-v2\"\n              or pilot[\"paired_estimator\"] != \"hodges-lehmann-v1\"\n          ):\n              raise SystemExit(\"pilot is not baseline-only\")\n          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n          manifest = {\n              \"schema_version\": 1,\n              \"release\": \"0.73\",\n              \"profile_id\": \"observer-baseline-pilot-073-v2\",\n              \"source_sha\": source_sha,\n              \"result\": \"passed\" if pilot[\"i73_freeze_eligible\"] else \"insufficient-baseline\",\n              \"host_fingerprint\": before[\"host_fingerprint\"],\n              \"preflight_sha256\": digest(before_path),\n              \"postflight_sha256\": digest(after_path),\n              \"baseline_pilot_sha256\": digest(pilot_path),\n              \"candidate_data_present\": False,\n              \"candidate_measurement_authorized\": False,\n              \"silent_retry_allowed\": False,\n          }\n          (root / \"campaign-manifest.json\").write_text(\n              json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n          )\n          if manifest[\"result\"] != \"passed\":\n              raise SystemExit(\"baseline pilot did not establish three stable rates\")\n          PY\n\n      - name: Retain baseline-only pilot packet\n        if: always()\n        uses: actions/upload-artifact@v6\n        with:\n          name: performance-baseline-pilot-v2-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n          path: target/performance-evidence/0.73/reference/baseline-pilot-v2/**\n          if-no-files-found: error\n          retention-days: 90\n\n  integrated:\n    if: inputs.source_sha != 'e757556d3a31d565f52a9561d6d4e555bb1cc373'\n    uses: ./.github/workflows/performance-integrated-host-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      entry_serializes_host: true\n    secrets: inherit\n"}
