a256 }}\n    secrets: inherit\n\n  controller-rehearsal-terminal:\n    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-seal-rehearsal'\n    needs: controller-rehearsal-start\n    name: Wait for exact non-product terminal unit\n    runs-on: [self-hosted, linux, x64, hydracache-release]\n    environment: performance-reference-074\n    timeout-minutes: 16\n    steps:\n      - name: Wait only for the deterministic successful terminal shape\n        shell: bash\n        env:\n          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}\n        run: |\n          set -euo pipefail\n          [[ \"$INPUT_CAMPAIGN_ID\" =~ ^[0-9a-f]{64}$ ]]\n          unit=\"hydracache-performance-074-i74-${INPUT_CAMPAIGN_ID}.service\"\n          for _ in $(seq 1 445); do\n            active=\"$(systemctl show \"$unit\" --property ActiveState --value)\"\n            sub=\"$(systemctl show \"$unit\" --property SubState --value)\"\n            main_pid=\"$(systemctl show \"$unit\" --property MainPID --value)\"\n            result=\"$(systemctl show \"$unit\" --property Result --value)\"\n            if [[ \"$active\" = active && \"$sub\" = exited && \"$main_pid\" = 0 && \"$result\" = success ]]; then\n              exit 0\n            fi\n            if [[ \"$active\" =~ ^(failed|inactive)$ ]]; then\n              printf 'terminal rehearsal unit failed early: %s/%s pid=%s result=%s\\n' \\\n                \"$active\" \"$sub\" \"$main_pid\" \"$result\" >&2\n              exit 1\n            fi\n            sleep 2\n          done\n          printf 'terminal rehearsal unit did not complete inside the bounded wait\\n' >&2\n          exit 1\n\n  controller-rehearsal-seal:\n    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-seal-rehearsal'\n    needs: controller-rehearsal-terminal-attach\n    name: Seal the same protected controller run\n    permissions:\n      contents: read\n      actions: read\n    uses: ./.github/workflows/performance