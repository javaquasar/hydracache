{"id":".github/workflows/hc2-client-plane.yml","parsed":true,"roundtrip":{"ok":true,"tree":{"rendered":{"ok":true,"text":"name: HC/2 Client Plane Evidence\non:\n  pull_request: null\n  push:\n    branches:\n    - main\n    - master\n    tags:\n    - v0.68.*\n  schedule:\n  - cron: 17 4 * * 1\n  workflow_dispatch:\n    inputs:\n      run_hc2_fuzz:\n        description: Run the time-boxed HC/2 fuzz lane\n        required: false\n        default: false\n        type: boolean\n      run_hc2_fixed_host_soak:\n        description: Run the HC/2 soak lane on the labelled fixed host\n        required: false\n        default: false\n        type: boolean\n      run_hc2_hosted_admission:\n        description: Require same-SHA Linux, Docker, and fuzz receipts for the Rust 0.68 release\n        required: false\n        default: false\n        type: boolean\n      run_hc2_release_admission:\n        description: Require all four same-SHA receipts before promoting client SDK distributions\n        required: false\n        default: false\n        type: boolean\n      retain_hc2_daemon_commit:\n        description: Exact 40-hex commit whose production HC/2 daemon must be retained\n        required: false\n        default: ''\n        type: string\npermissions:\n  contents: read\n  actions: read\nconcurrency:\n  group: hc2-client-plane-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\nenv:\n  HYDRACACHE_EVIDENCE_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n  HYDRACACHE_EVIDENCE_BASE_SHA: ${{ github.event.pull_request.base.sha || github.sha }}\n  HYDRACACHE_EVIDENCE_TESTED_SHA: ${{ github.sha }}\n  HC2_RUST_TOOLCHAIN: 1.94.0\n  HC2_FUZZ_TOOLCHAIN: nightly-2026-08-01\n  HC2_FUZZ_SEED: '220068'\n  HC2_SOAK_ITERATIONS: '12'\n  HC2_INTEROP_IMAGE: ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea\n  CARGO_INCREMENTAL: 0\n  CARGO_PROFILE_DEV_DEBUG: 0\n  CARGO_PROFILE_TEST_DEBUG: 0\njobs:\n  retain-production-daemon:\n    name: HC/2 Retain Production Daemon (${{ matrix.platform }})\n    if: github.event_name == 'workflow_dispatch' && inputs.retain_hc2_daemon_commit != ''\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n        - platform: linux-x86_64\n          runner: ubuntu-24.04\n          executable: hydracache-server\n        - platform: windows-x86_64\n          runner: windows-2025\n          executable: hydracache-server.exe\n    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 30\n    steps:\n    - name: Validate requested producer identity\n      shell: bash\n      env:\n        PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n      run: |\n        if [[ ! \"$PRODUCER_COMMIT\" =~ ^[0-9a-f]{40}$ ]]; then\n          echo \"retain_hc2_daemon_commit must be an exact lowercase 40-hex commit\" >&2\n          exit 1\n        fi\n    - name: Checkout exact producer\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n      with:\n        ref: ${{ inputs.retain_hc2_daemon_commit }}\n        fetch-depth: 1\n    - name: Refuse checkout drift\n      shell: bash\n      env:\n        PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n      run: test \"$(git rev-parse HEAD)\" = \"$PRODUCER_COMMIT\"\n    - name: Install pinned Rust\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Build production daemon\n      shell: bash\n      run: cargo build --release -p hydracache-server --bin hydracache-server --locked\n    - name: Create identity-bound archive and receipt\n      shell: bash\n      env:\n        EXECUTABLE: ${{ matrix.executable }}\n        PLATFORM: ${{ matrix.platform }}\n        PRODUCER_COMMIT: ${{ inputs.retain_hc2_daemon_commit }}\n      run: |\n        set -euo pipefail\n        short_commit=\"${PRODUCER_COMMIT:0:8}\"\n        bundle=\"target/hc2-retained-daemon-${short_commit}-${PLATFORM}\"\n        mkdir -p \"$bundle/bin\"\n        cp \"target/release/$EXECUTABLE\" \"$bundle/bin/$EXECUTABLE\"\n        executable_sha256=\"$(sha256sum \"$bundle/bin/$EXECUTABLE\" | cut -d' ' -f1)\"\n        executable_size=\"$(wc -c < \"$bundle/bin/$EXECUTABLE\" | tr -d ' ')\"\n        contract_blob=\"$(git rev-parse HEAD:crates/hydracache-client-hc2/proto/hc2_contract.proto)\"\n        producer_tree=\"$(git rev-parse 'HEAD^{tree}')\"\n        printf '%s\\n' \\\n          \"schema_version=hydracache.hc2.retained-daemon.v1\" \\\n          \"producer_commit=$PRODUCER_COMMIT\" \\\n          \"producer_tree=$producer_tree\" \\\n          \"contract_blob=$contract_blob\" \\\n          \"platform=$PLATFORM\" \\\n          \"executable=bin/$EXECUTABLE\" \\\n          \"executable_sha256=$executable_sha256\" \\\n          \"executable_size_bytes=$executable_size\" \\\n          > \"$bundle/receipt.txt\"\n        archive=\"$bundle.tar.gz\"\n        tar -czf \"$archive\" -C target \"$(basename \"$bundle\")\"\n        archive_sha256=\"$(sha256sum \"$archive\" | cut -d' ' -f1)\"\n        archive_size=\"$(wc -c < \"$archive\" | tr -d ' ')\"\n        printf '%s\\n' \\\n          \"archive=$(basename \"$archive\")\" \\\n          \"archive_sha256=$archive_sha256\" \\\n          \"archive_size_bytes=$archive_size\" \\\n          > \"$archive.sha256\"\n    - name: Upload retained production daemon\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-retained-daemon-${{ inputs.retain_hc2_daemon_commit }}-${{ matrix.platform }}\n        path: |\n          target/hc2-retained-daemon-*.tar.gz\n          target/hc2-retained-daemon-*.tar.gz.sha256\n        if-no-files-found: error\n        retention-days: 30\n  linux-required:\n    name: HC/2 Linux Required\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n      with:\n        fetch-depth: 0\n    - name: Install pinned Rust\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n        components: rustfmt, clippy\n    - name: Install pinned Java\n      uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n      with:\n        distribution: temurin\n        java-version: '17'\n        cache: maven\n    - name: Install pinned Python\n      uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1\n      with:\n        python-version: '3.12'\n    - name: Validate workflow and generation contract\n      run: |\n        cargo fmt --all -- --check\n        cargo run -p xtask --locked -- client-plane-ci-check\n        cargo run -p xtask --locked -- client-schema-check\n    - name: Validate cross-SDK semantics\n      env:\n        PIP_NO_INDEX: '1'\n        PIP_DISABLE_PIP_VERSION_CHECK: '1'\n      run: cargo run -p xtask --locked -- client-conformance --all-sdks\n    - name: Validate lifecycle and retained replay\n      env:\n        PIP_NO_INDEX: '1'\n        PIP_DISABLE_PIP_VERSION_CHECK: '1'\n      run: cargo run -p xtask --locked -- client-plane-spike-check --runtime-only\n    - name: Validate publishable SDK packages from clean consumers\n      env:\n        PIP_NO_INDEX: '1'\n        PIP_DISABLE_PIP_VERSION_CHECK: '1'\n      run: cargo run -p xtask --locked -- client-package-check\n    - name: Clippy the HC/2 evidence surface\n      run: cargo clippy -p hydracache-client-plane-spike -p hydracache-client-hc2 -p hydracache-server -p xtask --all-targets --locked -- -D warnings\n    - name: Emit Linux receipt\n      run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane linux-required --output target/hc2-ci/linux-required.receipt.json\n    - name: Upload Linux receipt\n      if: always()\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-linux-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/hc2-ci/*.receipt.json\n        if-no-files-found: warn\n        retention-days: 30\n  java-sdk-compatibility:\n    name: HC/2 Java SDK (Temurin ${{ matrix.java }})\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    strategy:\n      fail-fast: false\n      matrix:\n        java:\n        - '17'\n        - '21'\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n    - name: Install pinned Java\n      uses: actions/setup-java@b6effb05e454b25005698d916606bdc6ffcbf961\n      with:\n        distribution: temurin\n        java-version: ${{ matrix.java }}\n        cache: maven\n    - name: Install pinned Rust for process interoperability\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Build Rust fixtures and verify the native SDK\n      run: cargo run -p xtask --locked -- client-plane-java-sdk-check\n    - name: Verify the external facade consumer\n      run: mvn -B -ntp -f tests/java-hazelcast-facade-consumer/pom.xml verify\n  docker-interop:\n    name: HC/2 Docker Interop\n    runs-on: ubuntu-24.04\n    timeout-minutes: 90\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n      with:\n        fetch-depth: 0\n    - name: Install pinned receipt toolchain\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Build digest-pinned interop environment\n      run: docker build --pull --file scripts/hc2/Dockerfile.interop --tag hydracache-hc2-interop:${{ github.sha }} .\n    - name: Run Rust, Java, and offline Python process interop in Docker\n      run: |\n        mkdir -p target/hc2-docker\n        docker run --rm \\\n          --volume \"$PWD:/workspace\" \\\n          --workdir /workspace \\\n          --env CARGO_TARGET_DIR=/workspace/target/hc2-docker \\\n          --env HC2_SHARED_TARGET_DIR=target/hc2-docker \\\n          hydracache-hc2-interop:${{ github.sha }} \\\n          run -p xtask --locked -- client-plane-docker-interop-check 2>&1 | tee target/hc2-ci-docker.log\n    - name: Emit Docker receipt\n      run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane docker-interop --image \"$HC2_INTEROP_IMAGE\" --output target/hc2-ci/docker-interop.receipt.json\n    - name: Upload Docker receipt and log\n      if: always()\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-docker-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: |\n          target/hc2-ci/*.receipt.json\n          target/hc2-ci-docker.log\n        if-no-files-found: warn\n        retention-days: 30\n  fuzz:\n    name: HC/2 Fuzz Scheduled\n    if: |-\n      github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v0.68.') || (github.event_name == 'workflow_dispatch'\n          && (inputs.run_hc2_fuzz\n              || inputs.run_hc2_hosted_admission\n              || inputs.run_hc2_release_admission))\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n    - name: Install pinned stable Rust for receipts\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Install pinned fuzz toolchain and cargo-fuzz\n      timeout-minutes: 10\n      run: |\n        rustup toolchain install \"$HC2_FUZZ_TOOLCHAIN\"\n        cargo install cargo-fuzz --version 0.13.2 --locked\n    - name: Run bounded HC/2 corpus fuzzing\n      working-directory: fuzz\n      run: |\n        cargo +\"$HC2_FUZZ_TOOLCHAIN\" fuzz build fuzz_hc2_client_plane\n        set +e\n        timeout --signal=INT --kill-after=10s 180s \\\n          cargo +\"$HC2_FUZZ_TOOLCHAIN\" fuzz run fuzz_hc2_client_plane -- \\\n            -seed=\"$HC2_FUZZ_SEED\" -timeout=5 \\\n            -error_exitcode=77 -timeout_exitcode=70 \\\n          2>&1 | tee ../target/hc2-ci-fuzz.log\n        fuzz_status=${PIPESTATUS[0]}\n        set -e\n        if [[ \"$fuzz_status\" -ne 0 && \"$fuzz_status\" -ne 124 ]]; then\n          echo \"HC/2 fuzz target failed with status $fuzz_status\" >&2\n          exit \"$fuzz_status\"\n        fi\n        if find artifacts/fuzz_hc2_client_plane -type f -print -quit | grep -q .; then\n          echo \"HC/2 fuzz target produced a failure artifact\" >&2\n          exit 1\n        fi\n        echo \"HC/2 fuzz timebox completed without a failure artifact\"\n    - name: Emit fuzz receipt\n      run: cargo +\"$HC2_RUST_TOOLCHAIN\" run -p xtask --locked -- client-plane-ci-receipt --lane fuzz --seed \"$HC2_FUZZ_SEED\" --output target/hc2-ci/fuzz.receipt.json\n    - name: Upload fuzz corpus, failures, log, and receipt\n      if: always()\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-fuzz-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: |\n          fuzz/corpus/fuzz_hc2_client_plane/**\n          fuzz/artifacts/fuzz_hc2_client_plane/**\n          target/hc2-ci-fuzz.log\n          target/hc2-ci/*.receipt.json\n        if-no-files-found: warn\n        retention-days: 30\n  fixed-host-soak:\n    name: HC/2 Fixed-host Soak\n    if: |-\n      (github.event_name == 'schedule' && vars.HC2_FIXED_HOST_SOAK_ENABLED == 'true') || (github.event_name == 'workflow_dispatch'\n          && (inputs.run_hc2_fixed_host_soak || inputs.run_hc2_release_admission))\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-hc2-soak-v1\n    timeout-minutes: 90\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n      with:\n        fetch-depth: 0\n    - name: Install pinned Rust\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Verify fixed-host contract and capture metadata\n      env:\n        HC2_FIXED_HOST_PROFILE: hc2-fixed-soak-v1\n      run: scripts/hc2/verify-fixed-host.sh --output target/hc2-ci/fixed-host-metadata.log\n    - name: Run bounded lifecycle soak\n      timeout-minutes: 60\n      run: |\n        set -o pipefail\n        for iteration in $(seq 1 \"$HC2_SOAK_ITERATIONS\"); do\n          echo \"hc2-soak-iteration=$iteration\"\n          cargo test -p hydracache-client-plane-spike --locked --test grpc_bidirectional_loopback --test fault_proxy --test http2_drain_faults --test observability_contract\n        done 2>&1 | tee target/hc2-ci/fixed-host-soak.log\n    - name: Emit fixed-host receipt\n      run: cargo run -p xtask --locked -- client-plane-ci-receipt --lane fixed-host-soak --iterations \"$HC2_SOAK_ITERATIONS\" --output target/hc2-ci/fixed-host-soak.receipt.json\n    - name: Upload fixed-host metadata, log, and receipt\n      if: always()\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-soak-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/hc2-ci/**\n        if-no-files-found: warn\n        retention-days: 30\n  hosted-release-admission:\n    name: HC/2 Hosted Release Admission\n    if: |-\n      always() && (startsWith(github.ref, 'refs/tags/v0.68.')\n          || (github.event_name == 'workflow_dispatch'\n              && (inputs.run_hc2_hosted_admission || inputs.run_hc2_release_admission)))\n    needs:\n    - linux-required\n    - docker-interop\n    - fuzz\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n    - name: Install pinned Rust\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Download same-run HC/2 receipts\n      uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c\n      with:\n        pattern: hc2-*-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/hc2-ci-admission\n        merge-multiple: true\n    - name: Refuse incomplete or red hosted 0.68 claim\n      run: cargo run -p xtask --locked -- evidence-run --release 0.68 --gate tool.hc2-hosted-admission-068\n    - name: Upload hosted release-admission evidence\n      if: always()\n      uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n      with:\n        name: hc2-hosted-admission-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: |\n          target/test-evidence/0.68/hc2-hosted-admission.json\n          target/release-evidence/**\n        if-no-files-found: error\n        retention-days: 30\n  release-admission:\n    name: HC/2 Client Promotion Admission\n    if: always() && github.event_name == 'workflow_dispatch' && inputs.run_hc2_release_admission\n    needs:\n    - linux-required\n    - docker-interop\n    - fuzz\n    - fixed-host-soak\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n    - name: Checkout exact candidate\n      uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09\n    - name: Install pinned Rust\n      uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c\n      with:\n        toolchain: 1.94.0\n    - name: Download same-run HC/2 receipts\n      uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c\n      with:\n        pattern: hc2-*-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/hc2-ci-admission\n        merge-multiple: true\n    - name: Refuse incomplete or red HC/2 client promotion\n      run: cargo run -p xtask --locked -- evidence-run --release 0.68 --gate tool.hc2-release-admission-068\n    - name: Upload client-promotion evidence\