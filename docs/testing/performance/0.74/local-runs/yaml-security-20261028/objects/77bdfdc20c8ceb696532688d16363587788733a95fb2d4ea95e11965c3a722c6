dered":{"ok":true,"text":"retention-days\n"},"shape":{"kind":"string","value":"retention-days"}},{"rendered":{"ok":true,"text":"90\n"},"shape":{"display":"90","f64_bits":"4056800000000000","i64":"90","kind":"number","u64":"90"}}]],"kind":"mapping"}}]],"kind":"mapping"}}],"kind":"sequence"}}]],"kind":"mapping"}}],[{"rendered":{"ok":true,"text":"supervisor-overhead-smoke\n"},"shape":{"kind":"string","value":"supervisor-overhead-smoke"}},{"rendered":{"ok":true,"text":"if: github.event_name == 'workflow_dispatch' && inputs.mode == 'supervisor-overhead-smoke'\nname: Read-only supervisor idle-overhead screen\nruns-on:\n- self-hosted\n- linux\n- x64\n- hydracache-release\nenvironment: performance-reference-074\ntimeout-minutes: 10\nenv:\n  EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-supervisor-idle-overhead\n  SUPERVISOR_SERVICE: hydracache-performance-supervisor-074.service\nsteps:\n- name: Check out exact idle-overhead screen source\n  uses: actions/checkout@v5\n  with:\n    fetch-depth: 0\n    persist-credentials: false\n- name: Verify immutable source and collector tests\n  shell: bash\n  run: |\n    set -euo pipefail\n    test \"$(git rev-parse HEAD)\" = \"$GITHUB_SHA\"\n    test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n    python3 -m unittest scripts.perf.test_performance_long_run_supervisor_overhead_074\n- name: Bind the active installed supervisor identity\n  timeout-minutes: 2\n  shell: bash\n  run: |\n    set -euo pipefail\n    mkdir -p \"$EVIDENCE_DIR\"\n    main_pid=\"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=MainPID --value)\"\n    restarts=\"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=NRestarts --value)\"\n    control_group=\"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=ControlGroup --value)\"\n    {\n      printf 'active_state=%s\\n' \"$(systemctl is-active \"$SUPERVISOR_SERVICE\" || true)\"\n      printf 'main_pid=%s\\n' \"$main_pid\"\n      printf 'restarts=%s\\n' \"$restarts\"\n      printf 'c