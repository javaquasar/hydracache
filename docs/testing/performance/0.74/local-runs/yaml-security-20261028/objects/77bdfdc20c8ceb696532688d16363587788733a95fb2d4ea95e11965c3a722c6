ervisor_overhead_074.py \\\n          --source-commit \"$GITHUB_SHA\" \\\n          --installed-source-commit \"$INSTALLED_SOURCE_COMMIT\" \\\n          --pid \"$SUPERVISOR_PID\" \\\n          --control-group \"$SUPERVISOR_CONTROL_GROUP\" \\\n          --duration-seconds 30 \\\n          --interval-seconds 0.5 \\\n          --maximum-cpu-percent 0.5 \\\n          --maximum-rss-bytes 67108864 \\\n          --maximum-io-bytes-per-second 1048576 \\\n          --output \"$EVIDENCE_DIR/overhead.json\"\n    - name: Verify stable service and non-promotable result\n      shell: bash\n      run: |\n        set -euo pipefail\n        test \"$(systemctl is-active \"$SUPERVISOR_SERVICE\" || true)\" = active\n        test \"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=MainPID --value)\" = \"$SUPERVISOR_PID\"\n        test \"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=NRestarts --value)\" = 0\n        test \"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=ControlGroup --value)\" = \"$SUPERVISOR_CONTROL_GROUP\"\n        python3 - <<'PY'\n        import json\n        import os\n        import pathlib\n\n        receipt = json.loads(\n            (pathlib.Path(os.environ[\"EVIDENCE_DIR\"]) / \"overhead.json\").read_text()\n        )\n        assert receipt[\"schema_version\"] == \"hydracache-w11-supervisor-idle-overhead-v1\"\n        assert receipt[\"source_commit\"] == os.environ[\"GITHUB_SHA\"]\n        assert receipt[\"installed_source_commit\"] == os.environ[\"INSTALLED_SOURCE_COMMIT\"]\n        assert receipt[\"pid\"] == int(os.environ[\"SUPERVISOR_PID\"])\n        assert receipt[\"control_group\"] == os.environ[\"SUPERVISOR_CONTROL_GROUP\"]\n        assert receipt[\"read_only\"] is True\n        assert receipt[\"mutation_performed\"] is False\n        assert receipt[\"product_candidate_started\"] is False\n        assert receipt[\"workload_started\"] is False\n        summary = receipt[\"summary\"]\n        assert summary[\"cpu_budget_passed\"] is True\n        assert summary[\"rss_budget_passed\"] is True\n        assert summary[\"cpu_rss_partial_screen_passed\"] is True\n        assert summary[\"idle_screen_passed\"] is (summary[\"io_budget_passed\"] is True)\n        assert receipt[\"decision\"][\"idle_screen_only\"] is True\n        assert receipt[\"decision\"][\"role_overhead_qualification_complete\"] is False\n        assert receipt[\"decision\"][\"release_admission_allowed\"] is False\n        PY\n    - name: Retain supervisor idle-overhead receipt\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-long-run-supervisor-idle-overhead-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.74/reference/w11-supervisor-idle-overhead/**\n        if-no-files-found: error\n        retention-days: 90\n  role-overhead-smoke:\n    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'role-overhead-smoke'\n    name: Non-product role-overhead collector rehearsal\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-release\n    environment: performance-reference-074\n    timeout-minutes: 15\n    env:\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-role-overhead-smoke\n      SUPERVISOR_SERVICE: hydracache-performance-supervisor-074.service\n    steps:\n    - name: Check out exact role-overhead collector source\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n    - name: Verify immutable source and analyzer tests\n      shell: bash\n      run: |\n        set -euo pipefail\n        test \"$(git rev-parse HEAD)\" = \"$GITHUB_SHA\"\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        python3 -m unittest \\\n          scripts.perf.test_performance_long_run_role_overhead_collect_074 \\\n          scripts.perf.test_performance_long_run_role_overhead_074\n    - name: Bind idle host and installed identity\n      timeout-minutes: 2\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        test \"$(systemctl is-active \"$SUPERVISOR_SERVICE\" || true)\" = active\n        test \"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=NRestarts --value)\" = 0\n        test ! -e /run/hydracache-perf/controller-loss-smoke-v1.json\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \\\n          > \"$EVIDENCE_DIR/provisioning.json\"\n        installed_source_commit=\"$(python3 -c 'import json, os; print(json.load(open(os.environ[\"EVIDENCE_DIR\"] + \"/provisioning.json\"))[\"source_commit\"])')\"\n        host_receipt_sha256=\"$(sha256sum \"$EVIDENCE_DIR/provisioning.json\" | awk '{print $1}')\"\n        test \"$installed_source_commit\" = \"$GITHUB_SHA\"\n        [[ \"$host_receipt_sha256\" =~ ^[0-9a-f]{64}$ ]]\n        supervisor_pid=\"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=MainPID --value)\"\n        supervisor_control_group=\"$(systemctl show \"$SUPERVISOR_SERVICE\" --property=ControlGroup --value)\"\n        [[ \"$supervisor_pid\" =~ ^[1-9][0-9]*$ ]]\n        test \"$supervisor_pid\" -gt 1\n        test \"$supervisor_control_group\" = \"/system.slice/$SUPERVISOR_SERVICE\"\n        {\n          printf 'INSTALLED_SOURCE_COMMIT=%s\\n' \"$installed_source_commit\"\n          printf 'HOST_RECEIPT_SHA256=%s\\n' \"$host_receipt_sha256\"\n          printf 'SUPERVISOR_PID=%s\\n' \"$supervisor_pid\"\n          printf 'SUPERVISOR_CONTROL_GROUP=%s\\n' \"$supervisor_control_group\"\n        } >> \"$GITHUB_ENV\"\n    - name: Collect fixed counterbalanced attempt set\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_long_run_role_overhead_collect_074.py \\\n          --source-commit \"$INSTALLED_SOURCE_COMMIT\" \\\n          --provisioning-receipt \"$EVIDENCE_DIR/provisioning.json\" \\\n          --installed-binary /opt/hydracache-perf/bin