          "text": "name: Memory Reference 0.71\nrun-name: Memory 0.71 ${{ inputs.case_id }} ${{ inputs.campaign_id }} source ${{ inputs.source_sha }}\non:\n  workflow_dispatch:\n    inputs:\n      campaign_id:\n        description: Immutable operator-approved campaign id\n        required: true\n        type: string\n      source_sha:\n        description: Exact lowercase 40-character candidate commit from the canonical repository\n        required: true\n        type: string\n      campaign_role:\n        description: Baseline freezes B0/B1; candidate measures the frozen B1/C pair\n        required: true\n        default: candidate\n        type: choice\n        options:\n        - candidate\n        - baseline\n      case_id:\n        description: One preregistered scenario row\n        required: true\n        default: M0-cold\n        type: choice\n        options:\n        - M0-cold\n        - M1-shape\n        - M2-rewrite\n        - M3-ttl\n        - M4-reset\n        - M5-tags\n        - M6-connections\n        - M7-persistence\n        - M8-60m\n        - M9-6h\n        - M10-24h\n      lease_owner:\n        description: Protected-host lease owner recorded by preflight\n        required: true\n        type: string\n      lease_end:\n        description: Approved lease end in RFC3339 form\n        required: true\n        type: string\npermissions:\n  contents: read\nconcurrency:\n  group: memory-reference-071-${{ inputs.source_sha }}-${{ inputs.campaign_id }}\n  cancel-in-progress: false\njobs:\n  campaign:\n    name: Protected memory campaign\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - memory-reference-071\n    environment: memory-reference-071\n    timeout-minutes: 4320\n    defaults:\n      run:\n        working-directory: trusted-harness\n    env:\n      CAMPAIGN_ROOT: /var/lib/hydracache-memory/campaigns\n      BUILD_ROOT: /var/lib/hydracache-memory/build\n      MIRROR_ROOT: /mnt/hydracache-protected-memory\n      HYDRACACHE_MEMORY_PROTECTED_ENV: memory-reference-071\n      HYDRACACHE_MEMORY_DEDICATED_BARE_METAL: '1'\n      HYDRACACHE_MEMORY_LEASE_OWNER: ${{ inputs.lease_owner }}\n      HYDRACACHE_MEMORY_LEASE_END: ${{ inputs.lease_end }}\n      HYDRACACHE_MEMORY_WORKFLOW_SHA: ${{ github.sha }}\n      HYDRACACHE_MEMORY_SOURCE_SHA: ${{ inputs.source_sha }}\n      HYDRACACHE_MEMORY_CAMPAIGN_ROLE: ${{ inputs.campaign_role }}\n      HYDRACACHE_MEMORY_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_MEMORY_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_MEMORY_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      BOOTSTRAP_RECEIPT: /var/lib/hydracache-memory/admission/reference-activation.json\n      HISTORICAL_RECEIPT: /var/lib/hydracache-memory/admission/historical-input-receipt.json\n      OVERHEAD_RECEIPT: /var/lib/hydracache-memory/admission/instrumentation-overhead.json\n      OVERHEAD_HOST_PREFLIGHT: /var/lib/hydracache-memory/admission/instrumentation-overhead-host-preflight.json\n    steps:\n    - name: Checkout trusted campaign harness from main\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n        path: trusted-harness\n    - name: Reject non-main workflow dispatch\n      shell: bash\n      timeout-minutes: 1\n      env:\n        SOURCE_SHA: ${{ inputs.source_sha }}\n        WORKFLOW_SHA: ${{ github.sha }}\n      run: |\n        set -euo pipefail\n        if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n          echo \"Memory Reference 0.71 must be dispatched from main, observed $GITHUB_REF\" >&2\n          exit 1\n        fi\n        if [[ ! \"$SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]; then\n          echo \"source_sha must be a lowercase 40-character commit SHA\" >&2\n          exit 1\n        fi\n        test \"$(git rev-parse HEAD)\" = \"$WORKFLOW_SHA\"\n    - name: Expose and verify the runner Rust toolchain\n      shell: bash\n      timeout-minutes: 1\n      run: |\n        set -euo pipefail\n        rust_bin=\"$HOME/.cargo/bin\"\n        test -x \"$rust_bin/cargo\"\n        test -x \"$rust_bin/rustc\"\n        echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n        \"$rust_bin/cargo\" --version\n        \"$rust_bin/rustc\" --version\n    - name: Checkout exact candidate source without persisted credentials\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 1\n        persist-credentials: false\n        path: candidate-source\n        ref: ${{ inputs.source_sha }}\n    - name: Resolve exact candidate source without executing it\n      shell: bash\n      timeout-minutes: 5\n      env:\n        SOURCE_SHA: ${{ inputs.source_sha }}\n        WORKFLOW_SHA: ${{ github.sha }}\n      run: |\n        set -euo pipefail\n        test \"$(git rev-parse HEAD)\" = \"$WORKFLOW_SHA\"\n        test \"$(git -C \"$GITHUB_WORKSPACE/candidate-source\" rev-parse HEAD)\" = \"$SOURCE_SHA\"\n        git fetch --no-tags \"$GITHUB_WORKSPACE/candidate-source\" \"$SOURCE_SHA\"\n        test \"$(git rev-parse 'FETCH_HEAD^{commit}')\" = \"$SOURCE_SHA\"\n        git cat-file -e \"$SOURCE_SHA^{commit}\"\n    - name: Preflight host and freeze campaign plan\n      shell: bash\n      timeout-minutes: 15\n      run: |\n        set -euo pipefail\n        test -n \"${{ inputs.campaign_id }}\"\n        test -f \"$BOOTSTRAP_RECEIPT\"\n        test -f \"$HISTORICAL_RECEIPT\"\n        python3 scripts/perf/memory_campaign_071.py doctor --evidence\n        taskset --cpu-list \"$HYDRACACHE_MEMORY_LOADGEN_CPUSET\" \\\n          cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.71 \\\n          --profile memory-reference-071-v1 \\\n          --output \"$RUNNER_TEMP/host-preflight.json\"\n        campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n        if [[ ! -f \"$campaign_dir/state.json\" ]]; then\n          if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" == \"candidate\" ]]; then\n            cohort_args=(--cohort B1-instrumented --cohort C-candidate)\n          else\n            cohort_args=(--cohort B1-instrumented)\n            if [[ \"${{ inputs.case_id }}\" == \"M0-cold\" ]]; then\n              cohort_args=(--cohort B0-release --cohort B1-instrumented)\n            fi\n          fi\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" plan \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --case \"${{ inputs.case_id }}\" \\\n            --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n            --source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n            --campaign-role \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" \\\n            --mirror-root \"$MIRROR_ROOT\" \\\n            \"${cohort_args[@]}\"\n        fi\n        python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" verify-identity \\\n          --campaign-id \"${{ inputs.campaign_id }}\" \\\n          --case \"${{ inputs.case_id }}\" \\\n          --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n          --source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n          --campaign-role \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\"\n    - name: Build immutable cohorts\n      shell: bash\n      timeout-minutes: 120\n      run: |\n        set -euo pipefail\n        prerequisite=\"\"\n        case \"${{ inputs.case_id }}\" in\n          M8-60m) prerequisite=\"M3-ttl\" ;;\n          M9-6h) prerequisite=\"M8-60m\" ;;\n          M10-24h) prerequisite=\"M9-6h\" ;;\n        esac\n        if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" == \"candidate\" && -n \"$prerequisite\" ]]; then\n          cargo run -p xtask --locked -- memory-campaign-check \\\n            --release 0.71 \\\n            --campaigns \"$CAMPAIGN_ROOT\" \\\n            --require-through \"$prerequisite\" \\\n            --expected-source-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\"\n        fi\n        python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" prepare \\\n          --campaign-id \"${{ inputs.campaign_id }}\" \\\n          --build-root \"$BUILD_ROOT\"\n    - name: Measure and freeze S5 instrumentation overhead\n      shell: bash\n      timeout-minutes: 720\n      run: |\n        set -euo pipefail\n        campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n        if [[ ! -f \"$OVERHEAD_RECEIPT\" ]]; then\n          if [[ \"$HYDRACACHE_MEMORY_CAMPAIGN_ROLE\" != \"baseline\" ]]; then\n            echo \"candidate campaigns require the frozen baseline-only S5 receipt\" >&2\n            exit 1\n          fi\n          readarray -t retained < <(python3 - \"$campaign_dir/state.json\" <<'PY'\n        import json\n        import pathlib\n        import sys\n        state_path = pathlib.Path(sys.argv[1])\n        state = json.loads(state_path.read_text(encoding=\"utf-8\"))\n        root = state_path.parent\n        print(root / state[\"builds\"][\"B1-instrumented\"][\"manifest\"])\n        print(root / state[\"controller_tools\"][\"hc2_helper_manifest\"])\n        print(state[\"scenario_digest\"])\n        PY\n          )\n          overhead_tmp=\"${OVERHEAD_RECEIPT}.${{ github.run_id }}.${{ github.run_attempt }}.tmp\"\n          trap 'rm -f -- \"$overhead_tmp\"' EXIT\n          python3 scripts/perf/memory_instrumentation_overhead_071.py \\\n            --build-manifest \"${retained[0]}\" \\\n            --hc2-helper-manifest \"${retained[1]}\" \\\n            --scenario-digest \"${retained[2]}\" \\\n            --host-preflight \"$RUNNER_TEMP/host-preflight.json\" \\\n            --work-root \"$CAMPAIGN_ROOT/_s5/${{ inputs.campaign_id }}-${{ github.run_id }}-${{ github.run_attempt }}\" \\\n            --output \"$overhead_tmp\"\n          cp --no-clobber \"$RUNNER_TEMP/host-preflight.json\" \"$OVERHEAD_HOST_PREFLIGHT\"\n          chmod 0444 \"$OVERHEAD_HOST_PREFLIGHT\"\n          mv --no-clobber \"$overhead_tmp\" \"$OVERHEAD_RECEIPT\"\n          chmod 0444 \"$OVERHEAD_RECEIPT\"\n          trap - EXIT\n        fi\n    - name: Admit campaign or verify retained host identity\n      shell: bash\n      timeout-minutes: 5\n      run: |\n        set -euo pipefail\n        campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n        test -f \"$OVERHEAD_RECEIPT\"\n        test -f \"$OVERHEAD_HOST_PREFLIGHT\"\n        if [[ ! -f \"$campaign_dir/admission/admission-manifest.json\" ]]; then\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" admit \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --host-preflight \"$RUNNER_TEMP/host-preflight.json\" \\\n            --bootstrap \"$BOOTSTRAP_RECEIPT\" \\\n            --historical \"$HISTORICAL_RECEIPT\" \\\n            --overhead \"$OVERHEAD_RECEIPT\" \\\n            --overhead-host-preflight \"$OVERHEAD_HOST_PREFLIGHT\"\n        else\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" verify-host \\\n            --campaign-id \"${{ inputs.campaign_id }}\" \\\n            --host-preflight \"$RUNNER_TEMP/host-preflight.json\"\n        fi\n    - name: Prove real v0.70 candidate upgrade restart and rollback before M10\n      if: inputs.campaign_role == 'candidate' && inputs.case_id == 'M10-24h'\n      shell: bash\n      timeout-minutes: 180\n      run: |\n        set -euo pipefail\n        campaign_dir=\"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}\"\n        bash scripts/perf/memory_compat_071.sh \\\n          --candidate-sha \"$HYDRACACHE_MEMORY_SOURCE_SHA\" \\\n          --workflow-sha \"$HYDRACACHE_MEMORY_WORKFLOW_SHA\" \\\n          --campaign-id \"${{ inputs.campaign_id }}\" \\\n          --output \"$campaign_dir/compatibility-receipt.json\"\n    - name: Run or resume bounded row\n      shell: bash\n      timeout-minutes: 4250\n      run: |\n        set -euo pipefail\n        python3 scripts/ci/run-with-heartbeat.py \\\n          --timeout-seconds 252000 \\\n          --heartbeat-seconds 30 \\\n          --attempt-id \"${{ github.run_attempt }}\" \\\n          --status-json \"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}/watchdog-status-${{ github.run_attempt }}.json\" \\\n          --log-file \"$CAMPAIGN_ROOT/${{ inputs.campaign_id }}/watchdog-${{ github.run_attempt }}.log\" \\\n          -- \\\n          python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" resume \\\n            --campaign-id \"${{ inputs.campaign_id }}\"\n    - name: Finalize immutable campaign manifest\n      shell: bash\n      timeout-minutes: 15\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/memory_campaign_071.py --output-root \"$CAMPAIGN_ROOT\" finalize \\\n          --campaign-id \"${{ inputs.campaign_id }}\"\n    - name: Retain compact attempt state\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: memory-reference-071-${{ inputs.source_sha }}-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: |\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/campaign-identity.json\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/state.json\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/events.jsonl\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/watchdog-*\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/campaign-receipt.json\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/compatibility-receipt.json\n          ${{ env.CAMPAIGN_ROOT }}/${{ inputs.campaign_id }}/admission/*.json\n        if-no-files-found: error\n        retention-days: 90\n"
