p --release 0.66 --tier all\n      cargo run -p xtask --locked -- canary-sweep --release 0.67 --tier all\n      cargo run -p xtask --locked -- canary-sweep --release 0.67.1 --tier all\n      cargo run -p xtask --locked -- canary-sweep --release 0.68 --tier all\n      cargo run -p xtask --locked -- canary-sweep --release 0.69 --tier all\n      cargo run -p xtask --locked -- canary-sweep --release 0.72 --tier all\n  - name: Run deterministic suite sweep\n    run: cargo run -p xtask --locked -- evidence-run --release 0.64 --gate tool.determinism-sweep\n  - name: Upload complete canary evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: canary-all-${{ github.sha }}\n      path: |\n        target/release-evidence/canaries/*.json\n        target/release-evidence/receipts/**\n        target/test-evidence/0.64/determinism-sweep.json\n        target/test-evidence/0.64/raft-spec-canary.json\n      if-no-files-found: error\ncoverage-ratchet:\n  name: Coverage Ratchet\n  runs-on: ubuntu-latest\n  timeout-minutes: 120\n  if: github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && inputs.run_nightly)\n  env:\n    HYDRACACHE_TEST_POSTGRES_URL: postgres://hydracache:hydracache@127.0.0.1:5432/hydracache\n  services:\n    postgres:\n      image: postgres:16.4-alpine\n      env:\n        POSTGRES_DB: hydracache\n        POSTGRES_PASSWORD: hydracache\n        POSTGRES_USER: hydracache\n      ports:\n      - 5432:5432\n      options: --health-cmd \"pg_isready -U hydracache -d hydracache\" --health-interval 5s --health-timeout 5s --health-retries 12\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n    with:\n      components: llvm-tools-preview\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-rust-no-target\n      cache-targets: false\n      shared-key: coverage-ratchet\n  - name: Install cargo-llvm-cov\n    uses: taiki-e/install-action@v2\n    with:\n      tool: cargo-llvm-cov@0.8.7\n  - name: Install cargo-deny\n    uses: taiki-e/install-action@cargo-deny\n  - name: Run commit-bound coverage ratchet\n    run: cargo run -p xtask --locked -- evidence-run --release \"$HYDRACACHE_CANDIDATE_RELEASE\" --gate tool.coverage-ratchet\n  - name: Generate coverage artifacts on failure\n    if: failure()\n    continue-on-error: true\n    run: |\n      cargo llvm-cov report --ignore-filename-regex '(^|/)crates/(xtask|hydracache-loadgen)/' --html --output-dir target/llvm-cov-html\n      cargo llvm-cov report --ignore-filename-regex '(^|/)crates/(xtask|hydracache-loadgen)/' --lcov --output-path target/llvm-cov.lcov\n  - name: Upload coverage evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: coverage-ratchet-${{ github.sha }}\n      path: |\n        target/llvm-cov-html\n        target/llvm-cov.lcov\n        target/test-evidence/0.64/coverage-*.json\n        target/release-evidence/receipts/**\n      if-no-files-found: error\n  - name: Clean Rust test scratch links\n    if: always()\n    run: rm -rf target/tests\nmsrv:\n  name: MSRV 1.88.0\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-latest\n  timeout-minutes: 120\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install Rust 1.88.0\n    uses: dtolnay/rust-toolchain@1.88.0\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-rust-no-target\n      cache-targets: false\n      shared-key: msrv-1.88.0\n  - name: Install cargo-deny\n    uses: taiki-e/install-action@cargo-deny\n  - name: Check MSRV\n    run: cargo check --workspace --all-targets --locked\n  - name: Test MSRV\n    run: cargo test --workspace --locked\n  - name: Clean Rust test scratch links