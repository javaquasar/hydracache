\n      source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n      lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n      lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+2 hours' --iso-8601=seconds)}\"\n      [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n      test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n      test -n \"$lease_owner\"\n      date --date=\"$lease_end\" >/dev/null\n      mkdir -p \"$EVIDENCE_DIR\"\n      {\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n        echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n      } >> \"$GITHUB_ENV\"\n  - name: Expose runner Rust toolchain\n    shell: bash\n    run: |\n      set -euo pipefail\n      rust_bin=\"$HOME/.cargo/bin\"\n      test -x \"$rust_bin/cargo\"\n      test -x \"$rust_bin/rustc\"\n      echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n      \"$rust_bin/cargo\" --version\n      \"$rust_bin/rustc\" --version\n  - name: Provision required host diagnostics before fingerprinting\n    shell: bash\n    run: |\n      set -euo pipefail\n      if ! command -v pidstat >/dev/null 2>&1; then\n        sudo apt-get update\n        sudo DEBIAN_FRONTEND=noninteractive apt-get install --yes sysstat\n      fi\n      pidstat -V\n  - name: Capture pre-build host identity and calibration\n    shell: bash\n    run: |\n      set -euo pipefail\n      cargo run -p xtask --locked -- perf-memory-preflight \\\n        --release 0.73 \\\n        --profile performance-reference-073-v1 \\\n        --output \"$EVIDENCE_DIR/preflight.json\"\n  - name: Build the exact release load generator\n    shell: bash\n    run: cargo build -p hydracache-loadgen --release --locked\n  - name: Capture post-build host identity and calibration\n    shell: bash\n    run: |\n      set -euo pipefail\n      cargo run -p xtask --locked -- perf-memory-preflight \\\n        --release 0.73 \\\n        --profile performance-reference-073-v1 \\\n        --output \"$EVIDENCE_DIR/postflight.