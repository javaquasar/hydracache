ependency-aware and idempotently\n      shell: bash\n      run: |\n        set -euo pipefail\n        if [[ -z \"${CARGO_REGISTRY_TOKEN:-}\" ]]; then\n          echo \"CARGO_REGISTRY_TOKEN is missing from the release environment.\" >&2\n          exit 1\n        fi\n\n        # crates.io versions are immutable. An exact existing version is a safe\n        # retry; every other registry response is treated as a release failure.\n        : > target/release-publish/publication-results.tsv\n        version=\"${{ needs.resolve.outputs.version }}\"\n\n        crates_io_status() {\n          local package=\"$1\"\n          local url=\"https://crates.io/api/v1/crates/$package/$version\"\n          local status=\"\"\n\n          for attempt in $(seq 1 5); do\n            if status=\"$(curl \\\n              --silent \\\n              --show-error \\\n              --connect-timeout 15 \\\n              --max-time 30 \\\n              --user-agent \"hydracache-release-workflow/$version (+https://github.com/$GITHUB_REPOSITORY)\" \\\n              --output /dev/null \\\n              --write-out '%{http_code}' \\\n              \"$url\")\"; then\n              case \"$status\" in\n                200|404)\n                  printf '%s' \"$status\"\n                  return 0\n                  ;;\n                429|5??)\n                  ;;\n                *)\n                  printf '%s' \"$status\"\n                  return 0\n                  ;;\n              esac\n            fi\n\n            if [[ \"$attempt\" -lt 5 ]]; then\n              echo \"Transient crates.io probe failure for $package@$version (status ${status:-transport-error}, attempt $attempt/5).\" >&2\n              sleep \"$((attempt * 2))\"\n            fi\n          done\n\n          if [[ -n \"$status\" && \"$status\" != \"000\" ]]; then\n            printf '%s' \"$status\"\n            return 0\n          fi\n          return 1\n        }\n\n        wait_for_registry_package() {\n          local pac