n all frozen counterbalanced pairs\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_integrated_host_073.py \\\n          --mode campaign \\\n          --i73-harness \"$I73_HARNESS\" \\\n          --c73-harness \"$C73_HARNESS\" \\\n          --i73-server \"$I73_SERVER\" \\\n          --c73-server \"$C73_SERVER\" \\\n          --i73-overlay \"$I73_OVERLAY\" \\\n          --c73-overlay \"$C73_OVERLAY\" \\\n          --scenario docs/testing/performance/0.73/w10-focused-host-comparison-contract.toml \\\n          --output \"$EVIDENCE_DIR/campaign\" \\\n          --daemon-cpu-set \"$HYDRACACHE_PERFORMANCE_DAEMON_CPUSET\" \\\n          --loadgen-cpu-set \"$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET\"\n    - name: Capture post-campaign calibration\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/postflight.json\"\n    - name: Seal campaign packet\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_TOOLING_SHA\" <<'PY'\n        import hashlib\n        import json\n        import pathlib\n        import sys\n\n        root = pathlib.Path(sys.argv[1])\n        tooling_sha = sys.argv[2]\n        pre_path = root / \"preflight.json\"\n        post_path = root / \"postflight.json\"\n        canary_path = root / \"canary\" / \"canary.json\"\n        campaign_path = root / \"campaign\" / \"integrated-host-campaign.json\"\n        required = (pre_path, post_path, canary_path, campaign_path)\n        missing = [str(path.relative_to(root)) for path in required if not path.is_file()]\n        if missing:\n            digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n            incomplete = {\n                \"schema_version\": 1,\n                \"release\": \"0.73\",\n                \"profile_id\": \"integrated-focused-host-073-v1\",\n                \"tooling_sha\": tooling_sha,\n                \"result\": \"incomplete\",\n                \"missing\": missing,\n                \"available_sha256\": {\n                    str(path.relative_to(root)): digest(path)\n                    for path in required\n                    if path.is_file()\n                },\n                \"allocation_and_rss_promotable\": False,\n                \"silent_retry_allowed\": False,\n            }\n            (root / \"manifest.json\").write_text(\n                json.dumps(incomplete, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n            )\n            raise SystemExit(\"campaign packet is incomplete: \" + \", \".join(missing))\n        pre = json.loads(pre_path.read_text(encoding=\"utf-8\"))\n        post = json.loads(post_path.read_text(encoding=\"utf-8\"))\n        canary = json.loads(canary_path.read_text(encoding=\"utf-8\"))\n        campaign = json.loads(campaign_path.read_text(encoding=\"utf-8\"))\n        for label, receipt in ((\"pre\", pre), (\"post\", post)):\n            if receipt[\"source_sha\"] != tooling_sha or receipt[\"result\"] != \"success\":\n                raise SystemExit(f\"{label} calibration did not admit the tooling revision\")\n            if not receipt[\"ship_evidence_eligible\"]:\n                raise SystemExit(f\"{label} host receipt is not promotable\")\n            if receipt[\"calibration\"][\"relative_spread\"] > receipt[\"calibration_limit\"]:\n                raise SystemExit(f\"{label} calibration exceeded its frozen limit\")\n        if pre[\"host_fingerprint\"] != post[\"host_fingerprint\"]:\n            raise SystemExit(\"host fingerprint drifted across campaign\")\n        if pre[\"identity_probes\"] != post[\"identity_probes\"] or pre[\"lease\"] != post[\"lease\"]:\n            raise SystemExit(\"host policy or serialized lease drifted across campaign\")\n        if canary[\"result\"] != \"passed\" or not canary[\"marker_observed\"] or not canary[\"receipt_absent\"]:\n            raise SystemExit(\"accounting canary did not fail closed\")\n        expected_attempts = 3 * 5 * 2\n        if campaign[\"attempt_count\"] != expected_attempts or campaign[\"failed_attempts\"]:\n            raise SystemExit(\"campaign does not contain thirty valid independent attempts\")\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        manifest = {\n            \"schema_version\": 1,\n            \"release\": \"0.73\",\n            \"profile_id\": \"integrated-focused-host-073-v1\",\n            \"tooling_sha\": tooling_sha,\n            \"baseline_source_sha\": campaign[\"baseline_source_sha\"],\n            \"candidate_source_sha\": campaign[\"candidate_source_sha\"],\n            \"result\": campaign[\"result\"],\n            \"host_fingerprint\": pre[\"host_fingerprint\"],\n            \"lease\": pre[\"lease\"],\n            \"preflight_sha256\": digest(pre_path),\n            \"postflight_sha256\": digest(post_path),\n            \"canary_sha256\": digest(canary_path),\n            \"campaign_sha256\": digest(campaign_path),\n            \"identity\": campaign[\"identity\"],\n            \"allocation_and_rss_promotable\": False,\n            \"silent_retry_allowed\": False,\n        }\n        (root / \"manifest.json\").write_text(\n            json.dumps(manifest, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n        )\n        if campaign[\"result\"] != \"passed\":\n            raise SystemExit(\"focused integrated candidate failed a primary guard\")\n        PY\n    - name: Upload complete campaign packet\n      if: always()\n      uses: actions/upload-artifact@v4\n      with:\n        name: performance-integrated-host-073-${{ inputs.tooling_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: ${{ env.EVIDENCE_DIR }}\n        if-no-files-found: error\n   