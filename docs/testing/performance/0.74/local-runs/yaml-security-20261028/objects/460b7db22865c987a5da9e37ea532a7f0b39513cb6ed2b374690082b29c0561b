sha\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        test -n \"$lease_owner\"\n        lease_epoch=\"$(date --date=\"$lease_end\" +%s)\"\n        now_epoch=\"$(date +%s)\"\n        test \"$lease_epoch\" -gt \"$now_epoch\"\n        test \"$lease_epoch\" -le \"$((now_epoch + 7200))\"\n        {\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n        } >> \"$GITHUB_ENV\"\n    - name: Verify Linux toolchain and allocator prerequisites\n      shell: bash\n      run: |\n        set -euo pipefail\n        test \"$(uname -s)\" = Linux\n        test \"$(uname -m)\" = x86_64\n        test -r /proc/self/smaps_rollup\n        test -r /etc/machine-id\n        command -v cargo\n        command -v rustc\n        command -v python3\n        cargo --version\n        rustc --version\n        ldd --version | head -n 1\n    - name: Capture pre-attribution host identity\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        python3 - \"$EVIDENCE_DIR/preflight.json\" <<'PY'\n        import hashlib, json, os, pathlib, platform, subprocess\n        def command(*args):\n            return subprocess.check_output(args, text=True).strip()\n        machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n        value = {\n            'schema_version': 1,\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'lease': {\n                'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'],\n                'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END'],\n            },\n            'host': {\n                'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                'node': platform.node(),\n                'machine': platform.machine(),\n   