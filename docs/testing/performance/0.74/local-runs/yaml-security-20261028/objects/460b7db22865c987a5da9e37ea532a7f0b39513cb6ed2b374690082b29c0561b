          "rendered": {
            "ok": true,
            "text": "name: Performance Allocator Attribution 0.74\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact lowercase 40-character attribution source commit\n        required: true\n        type: string\n      lease_owner:\n        description: Operator holding the serialized performance-host lease\n        required: true\n        type: string\n      lease_end:\n        description: Approved lease end in RFC3339 form\n        required: true\n        type: string\n  push:\n    branches:\n    - feat/0.74-resp-native-throughput\n    paths:\n    - .github/workflows/performance-allocator-attribution-074.yml\n    - scripts/perf/performance_allocator_profile_074.py\n    - tools/allocator-profile-074/**\n    - docs/testing/performance/0.74/w9e-linux-allocator-profile-contract.toml\npermissions:\n  contents: read\nconcurrency:\n  group: performance-reference-074-host\n  cancel-in-progress: false\njobs:\n  attribute:\n    name: Non-promotable Linux allocator owner attribution\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-release\n    environment: performance-reference-074\n    timeout-minutes: 75\n    env:\n      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w9e-allocator\n    steps:\n    - name: Check out exact attribution source\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n        ref: ${{ inputs.source_sha || github.sha }}\n    - name: Resolve immutable source and lease\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n        INPUT_LEASE_END: ${{ inputs.lease_end }}\n      run: |\n        set -euo pipefail\n        source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n        lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n        lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+75 minutes' --iso-8601=seconds)}\"\n        [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        test -n \"$lease_owner\"\n        lease_epoch=\"$(date --date=\"$lease_end\" +%s)\"\n        now_epoch=\"$(date +%s)\"\n        test \"$lease_epoch\" -gt \"$now_epoch\"\n        test \"$lease_epoch\" -le \"$((now_epoch + 7200))\"\n        {\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n        } >> \"$GITHUB_ENV\"\n    - name: Verify Linux toolchain and allocator prerequisites\n      shell: bash\n      run: |\n        set -euo pipefail\n        test \"$(uname -s)\" = Linux\n        test \"$(uname -m)\" = x86_64\n        test -r /proc/self/smaps_rollup\n        test -r /etc/machine-id\n        command -v cargo\n        command -v rustc\n        command -v python3\n        cargo --version\n        rustc --version\n        ldd --version | head -n 1\n    - name: Capture pre-attribution host identity\n      shell: bash\n      run: |\n        set -euo pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        python3 - \"$EVIDENCE_DIR/preflight.json\" <<'PY'\n        import hashlib, json, os, pathlib, platform, subprocess\n        def command(*args):\n            return subprocess.check_output(args, text=True).strip()\n        machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n        value = {\n            'schema_version': 1,\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'lease': {\n                'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'],\n                'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END'],\n            },\n            'host': {\n                'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                'node': platform.node(),\n                'machine': platform.machine(),\n                'kernel': platform.release(),\n                'cpu_count': os.cpu_count(),\n                'cpu_model': next(\n                    line.split(':', 1)[1].strip()\n                    for line in pathlib.Path('/proc/cpuinfo').read_text().splitlines()\n                    if line.startswith('model name')\n                ),\n            },\n            'toolchain': {'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version')},\n        }\n        pathlib.Path(os.sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n        PY\n    - name: Build three exact allocator variants\n      shell: bash\n      run: |\n        set -euo pipefail\n        for allocator in system mimalloc jemalloc; do\n          CARGO_TARGET_DIR=\"target/w9e-$allocator\" cargo build \\\n            --manifest-path tools/allocator-profile-074/Cargo.toml \\\n            --release --locked --no-default-features --features \"allocator-$allocator\"\n        done\n    - name: Run counterbalanced owner attribution\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 scripts/perf/performance_allocator_profile_074.py \\\n          --system-binary target/w9e-system/release/allocator-profile-074 \\\n          --mimalloc-binary target/w9e-mimalloc/release/allocator-profile-074 \\\n          --jemalloc-binary target/w9e-jemalloc/release/allocator-profile-074 \\\n          --output-dir \"$EVIDENCE_DIR/campaign\" \\\n          --source-commit \"$EXPECTED_SOURCE_SHA\" \\\n          --tool-source tools/allocator-profile-074/src/main.rs \\\n          --tool-lock tools/allocator-profile-074/Cargo.lock \\\n          --contract docs/testing/performance/0.74/w9e-linux-allocator-profile-contract.toml \\\n          --repeats 5\n    - name: Capture post-attribution host identity\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 - \"$EVIDENCE_DIR/postflight.json\" <<'PY'\n        import hashlib, json, os, pathlib, platform, subprocess\n        def command(*args):\n            return subprocess.check_output(args, text=True).strip()\n        machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n        value = {\n            'schema_version': 1,\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'lease': {\n                'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'],\n                'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END'],\n            },\n            'host': {\n                'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n                'node': platform.node(),\n                'machine': platform.machine(),\n                'kernel': platform.release(),\n                'cpu_count': os.cpu_count(),\n                'cpu_model': next(\n                    line.split(':', 1)[1].strip()\n                    for line in pathlib.Path('/proc/cpuinfo').read_text().splitlines()\n                    if line.startswith('model name')\n                ),\n            },\n            'toolchain': {'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version')},\n        }\n        pathlib.Path(os.sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n        PY\n    - name: Seal non-promotable attribution packet\n      if: always()\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 - \"$EVIDENCE_DIR\" <<'PY'\n        import hashlib, json, os, pathlib, sys\n        root = pathlib.Path(sys.argv[1])\n        before = json.loads((root / 'preflight.json').read_text())\n        after = json.loads((root / 'postflight.json').read_text())\n        manifest_path = root / 'campaign' / 'manifest.json'\n        summary_path = root / 'campaign' / 'summary.json'\n        manifest = json.loads(manifest_path.read_text())\n        summary = json.loads(summary_path.read_text())\n        if before != after:\n            raise SystemExit('host, toolchain, lease, or source identity drifted')\n        if manifest['source_commit'] != os.environ['EXPECTED_SOURCE_SHA']:\n            raise SystemExit('matrix source identity drifted')\n        if manifest['failed_attempts'] or manifest['candidate_data_present']:\n            raise SystemExit('matrix is incomplete or contains candidate data')\n        if manifest['acceptance_decision_allowed'] or manifest['promotable']:\n            raise SystemExit('attribution crossed its claim boundary')\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        packet = {\n            'schema_version': 1,\n            'release': '0.74',\n            'profile_id': 'w9e-linux-allocator-profile-074-v1',\n            'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n            'result': 'complete-owner-attribution',\n            'host': before['host'],\n            'toolchain': before['toolchain'],\n            'lease': before['lease'],\n            'preflight_sha256': digest(root / 'preflight.json'),\n            'postflight_sha256': digest(root / 'postflight.json'),\n            'matrix_manifest_sha256': digest(manifest_path),\n            'summary_sha256': digest(summary_path),\n            'attempts': summary['attempts'],\n            'candidate_data_present': False,\n            'acceptance_decision_allowed': False,\n            'promotable': False,\n            'silent_retry_allowed': False,\n        }\n        (root / 'packet.json').write_text(json.dumps(packet, indent=2, sort_keys=True) + '\\n')\n        PY\n    - name: Retain W9e attribution packet\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-allocator-attribution-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.74/reference/w9e-allocator/**\n        if-no-files-found: error\n        retention-days: 90\n"
