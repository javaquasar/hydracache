.chaos-mesh.org\n- name: Build and load current server image\n  run: |\n    docker build --tag hydracache-server:0.66-candidate .\n    kind load docker-image --name hydracache-066 hydracache-server:0.66-candidate\n- name: Prepare current operator controller\n  shell: bash\n  run: |\n    mkdir -p target/test-evidence/0.66\n    kubectl apply -f deploy/operator/hydracacheclusters.hydracache.io.crd.yaml\n    kubectl auth can-i get pods --subresource=proxy --namespace default\n    kubectl auth can-i create pods --subresource=proxy --namespace default\n    cargo build -p hydracache-operator --locked\n    operator_candidate_directory=\"$(pwd)/target/ci-runtime/0.66\"\n    operator_binary=\"$operator_candidate_directory/hydracache-operator-${GITHUB_SHA}\"\n    mkdir -p \"$operator_candidate_directory\"\n    install -m 0755 \"$(pwd)/target/debug/hydracache-operator\" \"$operator_binary\"\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_nonce=\"release-066-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}-${GITHUB_SHA}\"\n    export HYDRACACHE_OPERATOR_EVIDENCE_NONCE=\"$operator_nonce\"\n    echo \"HYDRACACHE_OPERATOR_EVIDENCE_NONCE=$operator_nonce\" >> \"$GITHUB_ENV\"\n    echo \"HYDRACACHE_OPERATOR_BINARY=$operator_binary\" >> \"$GITHUB_ENV\"\n    printf 'HC-OPERATOR-CONTROLLER-START nonce=%s binary=%s\\n' \\\n      \"$operator_nonce\" \"$operator_binary\" > \"$operator_log\"\n- name: Start current operator controller\n  id: operator-controller\n  shell: bash\n  background: true\n  timeout-minutes: 120\n  env:\n    HYDRACACHE_OPERATOR_NAMESPACE: default\n    HYDRACACHE_OPERATOR_IDENTITY: release-066-ci\n  run: |\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n    printf '%s\\n' \"$BASHPID\" > \"$operator_pid_file\"\n    exec \"$HYDRACACHE_OPERATOR_BINARY\" >> \"$operator_log\" 2>&1\n- name: Verify current operator controller\n  shell: bash\n  run: |\n    operator_log=\"target/test-evidence/0.66/operator-controller-live.log\"\n    operator_pid_file=\"target/test-evidence/0.66/operator-controller.pid\"\n    operator_nonce=\"$HYDRACACHE_OPERATOR_EVIDENCE_NONCE\"\n    operator_ready=0\n    for _ in $(seq 1 30); do\n      if [[ -s \"$operator_pid_file\" ]]; then\n        operator_pid=\"$(cat \"$operator_pid_file\")\"\n      else\n        sleep 1\n        continue\n      fi\n      if kill -0 \"$operator_pid\" \\\n        && grep -Fq \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"; then\n        operator_ready=1\n        break\n      fi\n      sleep 1\n    done\n    kill -0 \"$operator_pid\"\n    test \"$operator_ready\" = 1\n    grep -F \"HC-OPERATOR-CONTROLLER-RUNTIME nonce=$operator_nonce \" \"$operator_log\"\n- name: Run 0.66 operator-kind release proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.66 --gate env.hydracache-operator-kind-066\n- name: Stop current operator controller\n  cancel: operator-controller\n- name: Capture operator-kind diagnostics\n  if: always()\n  continue-on-error: true\n  run: |\n    kubectl get pods,statefulsets,services,hydracacheclusters -A -o wide > target/test-evidence/0.66/operator-kind-resources-post.txt || true\n    kubectl get events -A --sort-by=.lastTimestamp > target/test-evidence/0.66/operator-kind-events-post.txt || true\n    kubectl logs -n default \\\n      --selector 'app.kubernetes.io/name=hydracache,app.kubernetes.io/instance=hydracache-066,app.kubernetes.io/component=server' \\\n      --all-containers=true \\\n      --prefix=true \\\n      --tail=-1 \\\n      > target/test-evidence/0.66/operator-kind-pod-logs-post.txt || true\n- name: Upload 0.66 operator-kind evidence\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: operator-kind-066-${{ github.sha }}\n    path: |\n      target/test-evidence/0.66/**\n      target/release-evidence/receipts/**\n    if-no-files-found: error\n"
