 hydracache-release\n    environment: performance-reference-073\n    timeout-minutes: 120\n    env:\n      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: '1'\n      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n      EVIDENCE_DIR: target/performance-evidence/0.73/reference/host-admission\n    steps:\n    - name: Checkout exact source\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n    - name: Resolve dispatch identity and serialized lease\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n        INPUT_LEASE_END: ${{ inputs.lease_end }}\n      run: |\n        set -euo pipefail\n        source_sha=\"${INPUT_SOURCE_SHA:-$GITHUB_SHA}\"\n        lease_owner=\"${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}\"\n        lease_end=\"${INPUT_LEASE_END:-$(date --utc --date='+2 hours' --iso-8601=seconds)}\"\n        [[ \"$source_sha\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$source_sha\"\n        test -n \"$lease_owner\"\n        date --date=\"$lease_end\" >/dev/null\n        mkdir -p \"$EVIDENCE_DIR\"\n        {\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner\"\n          echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end\"\n          echo \"EXPECTED_SOURCE_SHA=$source_sha\"\n        } >> \"$GITHUB_ENV\"\n    - name: Expose runner Rust toolchain\n      shell: bash\n      run: |\n        set -euo pipefail\n        rust_bin=\"$HOME/.cargo/bin\"\n        test -x \"$rust_bin/cargo\"\n        test -x \"$rust_bin/rustc\"\n        echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n        \"$rust_bin/cargo\" --version\n        \"$rust_bin/rustc\" --version\n    - name: Provision required host diagnostics before fingerprinting\n      shell: bash\n      run: |\n        set -euo pipefail\n        if ! command -v pidstat >/dev/null 2>&1; then\n          sudo apt-get update\n          sudo DEBIAN_FRONTEND=noninteractive apt-get install --yes sysstat\n        fi\n        pidstat -V\n    - name: Capture pre-build host identity and calibration\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/preflight.json\"\n    - name: Build the exact release load generator\n      shell: bash\n      run: cargo build -p hydracache-loadgen --release --locked\n    - name: Capture post-build host identity and calibration\n      shell: bash\n      run: |\n        set -euo pipefail\n        cargo run -p xtask --locked -- perf-memory-preflight \\\n          --release 0.73 \\\n          --profile performance-reference-073-v1 \\\n          --output \"$EVIDENCE_DIR/postflight.json\"\n    - name: Seal admission manifest\n      shell: bash\n      run: |\n        set -euo pipefail\n        python3 - \"$EVIDENCE_DIR\" \"$EXPECTED_SOURCE_SHA\" <<'PY'\n        import hashlib\n        import json\n        import pathlib\n        import sys\n\n        evidence = pathlib.Path(sys.argv[1])\n        expected_sha = sys.argv[2]\n        before_path = evidence / \"preflight.json\"\n        after_path = evidence / \"postflight.json\"\n        before = json.loads(before_path.read_text(encoding=\"utf-8\"))\n        after = json.loads(after_path.read_text(encoding=\"utf-8\"))\n\n        for name, receipt in ((\"preflight\", before), (\"postflight\", after)):\n            if receipt[\"release\"] != \"0.73\" or receipt[\"profile_id\"] != \"performance-reference-073-v1\":\n                raise SystemExit(f\"{name} receipt identity mismatch\")\n            if receipt[\"source_sha\"] != expected_sha or receipt[\"result\"] != \"success\":\n                raise SystemExit(f\"{name} receipt did not admit exact source\")\n            if not receipt[\"ship_evidence_eligible\"]:\n                raise SystemExit(f\"{name} receipt is not host eligible\")\n            if receipt[\"calibration\"][\"relative_spread\"] > receipt[\"calibration_limit\"]:\n                raise SystemExit(f\"{name} calibration exceeded the frozen limit\")\n\n        if before[\"host_fingerprint\"] != after[\"host_fingerprint\"]:\n            raise SystemExit(\"host fingerprint drifted across admission\")\n        if before[\"identity_probes\"] != after[\"identity_probes\"]:\n            raise SystemExit(\"identity or held host policy drifted across admission\")\n        if before[\"lease\"] != after[\"lease\"]:\n            raise SystemExit(\"serialized lease changed across admission\")\n\n        digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()\n        manifest = {\n            \"schema_version\": 1,\n            \"release\": \"0.73\",\n            \"profile_id\": \"performance-reference-073-v1\",\n            \"source_sha\": expected_sha,\n            \"result\": \"admitted\",\n            \"host_fingerprint\": before[\"host_fingerprint\"],\n            \"lease\": before[\"lease\"],\n            \"calibration_limit\": before[\"calibration_limit\"],\n            \"pre_calibration_relative_spread\": before[\"calibration\"][\"relative_spread\"],\n            \"post_calibration_relative_spread\": after[\"calibration\"][\"relative_spread\"],\n            \"preflight_sha256\": digest(before_path),\n            \"postflight_sha256\": digest(after_path),\n            \"silent_retry_allowed\": False,\n            \"candidate_measurement_authorized\": False,\n        }\n        (evidence / \"admission-manifest.json\").write_text(\n            json.dumps(manifest, indent=2) + \"\\n\", encoding=\"utf-8\"\n        )\n        PY\n    - name: Retain host admission packet\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-host-admission-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.73/reference/host-admission/*.json\n        if-no-files-found: error\n        retention-days: 90\n  compatibility:\n    if: inputs.lease_owner == 'compatibility-073'\n    name: Published B72/C73 compatibility bootstrap\n    runs-on: ubuntu-latest\n    timeout-minutes: 120\n    steps:\n    - name: Check out exact compatibility tooling\n      uses: actions/checkout@v4\n      with:\n        fetch-depth: 0\n        ref: ${{ inputs.source_sha }}\n    - name: Run exact wire, durable, and rolling campaign\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        EVIDENCE_DIR: ${{ github.workspace }}/target/compatibility-evidence/0.73/${{ github.run_id }}-${{ github.run_attempt }}\n      run: |\n        set -o pipefail\n        mkdir -p \"$EVIDENCE_DIR\"\n        bash scripts/perf/run_compatibility_073_ci.sh \\\n          \"$INPUT_SOURCE_SHA\" \"$EVIDENCE_DIR\" 2>&1 | tee \"$EVIDENCE_DIR/ci.log\"\n    - name: Upload complete or incomplete compatibility packet\n      if: always()\n      uses: actions/upload-artifact@v4\n      with:\n        name: compatibility-073-${{ inputs.source_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: ${{ github.workspace }}/target/compatibility-evidence/0.73/${{ github.run_id }}-${{ github.run_attempt }}\n        if-no-files-found: error\n        retention-days: 30\n  long-run-qualification:\n    needs: authorize-long-run\n    if: startsWith(inputs.lease_owner, 'long-run-073@') && inputs.long_run_phase == 'qualification'\n    name: Integrated I73/C73 long-run qualification bootstrap\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: ${{ inputs.long_run_phase }}\n      role: pair\n      entry_serializes_host: true\n  long-run-confirmation-i73:\n    needs: authorize-long-run\n    if: startsWith(inputs.lease_owner, 'long-run-073@') && inputs.long_run_phase == 'confirmation'\n    name: Integrated I73 confirmation role\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: confirmation\n      role: I73\n      entry_serializes_host: true\n  long-run-confirmation-c73:\n    needs: long-run-confirmation-i73\n    if: needs.long-run-confirmation-i73.result == 'success'\n    name: Integrated C73 confirmation role and seal\n    uses: ./.github/workflows/performance-long-run-qualification-073.yml\n    with:\n      tooling_sha: ${{ inputs.source_sha }}\n      lease_owner: ${{ inputs.lease_owner }}\n      lease_end: ${{ inputs.lease_end }}\n      phase: confirmation\n      role: C73\n      entry_serializes_host: true\n"
