                },
                {
                  "rendered": {
                    "ok": true,
                    "text": "campaign:\n  name: Protected memory campaign\n  runs-on:\n  - self-hosted\n  - linux\n  - x64\n  - memory-reference-071\n  environment: memory-reference-071\n  timeout-minutes: 4320\n  defaults:\n    run:\n      working-directory: trusted-harness\n  env:\n    CAMPAIGN_ROOT: /var/lib/hydracache-memory/campaigns\n    BUILD_ROOT: /var/lib/hydracache-memory/build\n    MIRROR_ROOT: /mnt/hydracache-protected-memory\n    HYDRACACHE_MEMORY_PROTECTED_ENV: memory-reference-071\n    HYDRACACHE_MEMORY_DEDICATED_BARE_METAL: '1'\n    HYDRACACHE_MEMORY_LEASE_OWNER: ${{ inputs.lease_owner }}\n    HYDRACACHE_MEMORY_LEASE_END: ${{ inputs.lease_end }}\n    HYDRACACHE_MEMORY_WORKFLOW_SHA: ${{ github.sha }}\n    HYDRACACHE_MEMORY_SOURCE_SHA: ${{ inputs.source_sha }}\n    HYDRACACHE_MEMORY_CAMPAIGN_ROLE: ${{ inputs.campaign_role }}\n    HYDRACACHE_MEMORY_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n    HYDRACACHE_MEMORY_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n    HYDRACACHE_MEMORY_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n    BOOTSTRAP_RECEIPT: /var/lib/hydracache-memory/admission/reference-activation.json\n    HISTORICAL_RECEIPT: /var/lib/hydracache-memory/admission/historical-input-receipt.json\n    OVERHEAD_RECEIPT: /var/lib/hydracache-memory/admission/instrumentation-overhead.json\n    OVERHEAD_HOST_PREFLIGHT: /var/lib/hydracache-memory/admission/instrumentation-overhead-host-preflight.json\n  steps:\n  - name: Checkout trusted campaign harness from main\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n      persist-credentials: false\n      path: trusted-harness\n  - name: Reject non-main workflow dispatch\n    shell: bash\n    timeout-minutes: 1\n    env:\n      SOURCE_SHA: ${{ inputs.source_sha }}\n      WORKFLOW_SHA: ${{ github.sha }}\n    run: |\n      set -euo pipefail\n      if [[ \"$GITHUB_REF\" != \"refs/heads/main\" ]]; then\n        echo \"Memory