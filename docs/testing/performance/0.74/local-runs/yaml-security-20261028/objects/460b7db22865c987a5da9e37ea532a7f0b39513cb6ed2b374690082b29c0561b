                          "rendered": {
                            "ok": true,
                            "text": "name: 0.67.1 Bootstrap Sample Acquisition\nruns-on:\n- self-hosted\n- linux\n- x64\n- hydracache-perf-v1\ntimeout-minutes: 360\nif: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' && inputs.performance_0671_mode == 'bootstrap' && inputs.candidate_release == '0.67.1'\nconcurrency:\n  group: release-067-performance-reference-v1\n  cancel-in-progress: false\nenv:\n  HYDRACACHE_RUN_PERF_REFERENCE: 1\n  HYDRACACHE_PERF_RUNNER_CLASS: self-hosted-bare-metal-v1\n  HYDRACACHE_PERFORMANCE_0671_MODE: bootstrap\nsteps:\n- name: Validate optional campaign correlation\n  shell: bash\n  env:\n    HYDRACACHE_CAMPAIGN: ${{ inputs.performance_0671_campaign }}\n  run: |\n    if [[ -n \"$HYDRACACHE_CAMPAIGN\" ]]; then\n      [[ \"$HYDRACACHE_CAMPAIGN\" =~ ^hc0671-[a-z0-9][a-z0-9-]{5,55}:bootstrap-[1-5]$ ]]\n      test \"${HYDRACACHE_CAMPAIGN##*-}\" = '${{ inputs.bootstrap_sample_index }}'\n    fi\n- name: Checkout trusted main\n  uses: actions/checkout@v5\n  with:\n    fetch-depth: 0\n    persist-credentials: false\n    clean: true\n- name: Install pinned Rust 1.94.0\n  uses: dtolnay/rust-toolchain@1.94.0\n- name: Verify trusted bootstrap context\n  run: cargo run -p xtask --locked -- perf-bootstrap --release 0.67.1 --profile reference-v1 --phase context\n- name: Validate serialized bootstrap dispatch inputs\n  shell: bash\n  run: |\n    sample_index='${{ inputs.bootstrap_sample_index }}'\n    admission_run='${{ inputs.full_dress_admission_run_id }}'\n    predecessor_run='${{ inputs.bootstrap_predecessor_run_id }}'\n    [[ \"$sample_index\" =~ ^[1-5]$ ]]\n    [[ \"$admission_run\" =~ ^[1-9][0-9]*$ ]]\n    if [[ \"$sample_index\" = 1 ]]; then\n      test -z \"$predecessor_run\"\n    else\n      [[ \"$predecessor_run\" =~ ^[1-9][0-9]*$ ]]\n    fi\n- name: Download two-run full-dress admission\n  uses: actions/download-artifact@v8\n  with:\n    name: performance-0671-full-dress-admission\n    path: ${{ runner.temp }}/hydracache-full-dress-admission\n    github-token: ${{ github.token }}\n    repository: ${{ github.repository }}\n    run-id: ${{ inputs.full_dress_admission_run_id }}\n- name: Download immediately prior bootstrap receipt\n  if: inputs.bootstrap_sample_index != '1'\n  uses: actions/download-artifact@v8\n  with:\n    name: performance-0671-bootstrap-receipt\n    path: ${{ runner.temp }}/hydracache-bootstrap-predecessor\n    github-token: ${{ github.token }}\n    repository: ${{ github.repository }}\n    run-id: ${{ inputs.bootstrap_predecessor_run_id }}\n- name: Resolve bootstrap admission and predecessor\n  shell: bash\n  run: |\n    mapfile -t admissions < <(find \"$RUNNER_TEMP/hydracache-full-dress-admission\" \\\n      -type f -name full-dress-admission.json -print)\n    test \"${#admissions[@]}\" -eq 1\n    echo \"HYDRACACHE_FULL_DRESS_ADMISSION=${admissions[0]}\" >> \"$GITHUB_ENV\"\n    if [[ '${{ inputs.bootstrap_sample_index }}' != 1 ]]; then\n      mapfile -t predecessors < <(find \"$RUNNER_TEMP/hydracache-bootstrap-predecessor\" \\\n        -type f -name bootstrap-sample.json -print)\n      test \"${#predecessors[@]}\" -eq 1\n      echo \"HYDRACACHE_BOOTSTRAP_PREDECESSOR=${predecessors[0]}\" >> \"$GITHUB_ENV\"\n    fi\n- name: Clear only prior performance evidence scratch\n  shell: bash\n  run: |\n    rm -rf -- \\\n      target/test-evidence/0.67 \\\n      target/test-evidence/0.67.1 \\\n      target/release-evidence/receipts\n- name: Prepare tmpfs reference evidence\n  run: scripts/perf/reference-evidence-tmpfs.sh prepare\n- name: Import frozen campaign host admission\n  run: scripts/perf/import-reference-campaign-admission.sh\n- name: Import offline runner provisioning proof\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67.1 --gate tool.perf-runner-provisioned-0671\n- name: Build pinned redis-benchmark 7.2.5\n  shell: bash\n  run: |\n    tools_dir=\"$RUNNER_TEMP/hydracache-perf-tools\"\n    mkdir --parents \"$tools_dir\"\n    cd \"$tools_dir\"\n    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \\\n      --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 180 \\\n      --output redis-7.2.5.tar.gz \\\n      https://download.redis.io/releases/redis-7.2.5.tar.gz\n    printf '%s  redis-7.2.5.tar.gz\\n' '5981179706f8391f03be91d951acafaeda91af7fac56beffb2701963103e423d' \\\n      | sha256sum --check --strict -\n    rm -rf -- redis-7.2.5\n    tar --extract --gzip --file redis-7.2.5.tar.gz\n    env -i PATH=/usr/bin:/bin HOME=/tmp CC=gcc MALLOC=libc BUILD_TLS=no \\\n      make -C redis-7.2.5 -j1 redis-benchmark\n    test \"$(redis-7.2.5/src/redis-benchmark --version)\" = \"redis-benchmark 7.2.5\"\n    echo \"$tools_dir/redis-7.2.5/src\" >> \"$GITHUB_PATH\"\n- name: Attest and preflight the 0.67.1 host\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67.1 --gate tool.perf-attestation-v5-0671\n- name: Prebuild exact 0.67 performance binaries\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate tool.perf-prebuild-067\n- name: Authorize exact serialized bootstrap sample before measurement\n  shell: bash\n  run: |\n    args=(\n      --release 0.67.1\n      --profile reference-v1\n      --phase authorize\n      --sample-index '${{ inputs.bootstrap_sample_index }}'\n      --admission \"$HYDRACACHE_FULL_DRESS_ADMISSION\"\n    )\n    if [[ -n \"${HYDRACACHE_BOOTSTRAP_PREDECESSOR:-}\" ]]; then\n      args+=(--predecessor \"$HYDRACACHE_BOOTSTRAP_PREDECESSOR\")\n    fi\n    cargo run -p xtask --locked -- perf-bootstrap \"${args[@]}\"\n- name: Run bootstrap control-plane reference evidence\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate env.hydracache-run-067-perf-control-plane\n- name: Run bootstrap core reference evidence\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate env.hydracache-run-067-perf-core\n- name: Start isolated rootless Docker for Redis comparison\n  run: scripts/perf/rootless-docker.sh start\n- name: Run bootstrap RESP reference evidence\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate env.hydracache-run-067-perf-resp\n- name: Stop isolated rootless Docker after Redis comparison\n  if: always()\n  run: scripts/perf/rootless-docker.sh stop\n- name: Materialize tmpfs reference evidence\n  if: always()\n  run: scripts/perf/reference-evidence-tmpfs.sh materialize\n- name: Retain non-ship bootstrap sample\n  shell: bash\n  run: |\n    args=(\n      --release 0.67.1\n      --profile reference-v1\n      --phase sample\n      --sample-index '${{ inputs.bootstrap_sample_index }}'\n      --admission \"$HYDRACACHE_FULL_DRESS_ADMISSION\"\n    )\n    if [[ -n \"${HYDRACACHE_BOOTSTRAP_PREDECESSOR:-}\" ]]; then\n      args+=(--predecessor \"$HYDRACACHE_BOOTSTRAP_PREDECESSOR\")\n    fi\n    cargo run -p xtask --locked -- perf-bootstrap \"${args[@]}\"\n- name: Upload reusable bootstrap receipt\n  uses: actions/upload-artifact@v6\n  with:\n    name: performance-0671-bootstrap-receipt\n    path: target/test-evidence/0.67.1/bootstrap-sample.json\n    if-no-files-found: error\n- name: Upload 0.67.1 bootstrap sample\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: performance-0671-bootstrap-${{ github.sha }}-${{ github.run_id }}\n    path: |\n      target/test-evidence/0.67/**\n      target/test-evidence/0.67.1/**\n      target/release-evidence/receipts/**\n    if-no-files-found: warn\n"
