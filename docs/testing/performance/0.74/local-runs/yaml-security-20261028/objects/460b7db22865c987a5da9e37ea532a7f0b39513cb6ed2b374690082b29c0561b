edis comparison\n  run: scripts/perf/rootless-docker.sh start\n- name: Run full-dress RESP reference evidence\n  run: cargo run -p xtask --locked -- evidence-run --release 0.67 --gate env.hydracache-run-067-perf-resp\n- name: Stop isolated rootless Docker after full-dress Redis comparison\n  if: always()\n  run: scripts/perf/rootless-docker.sh stop\n- name: Materialize tmpfs reference evidence\n  if: always()\n  run: scripts/perf/reference-evidence-tmpfs.sh materialize\n- name: Retain non-promotable full-dress receipt\n  run: cargo run -p xtask --locked -- perf-full-dress --release 0.67.1 --profile reference-v1 --phase receipt\n- name: Admit bootstrap after the second identical full-dress run\n  if: inputs.full_dress_predecessor_run_id != ''\n  run: cargo run -p xtask --locked -- perf-full-dress --release 0.67.1 --profile reference-v1 --phase admission --predecessor-receipt \"$HYDRACACHE_FULL_DRESS_PREDECESSOR\"\n- name: Upload reusable full-dress receipt\n  uses: actions/upload-artifact@v6\n  with:\n    name: performance-0671-full-dress-receipt\n    path: target/test-evidence/0.67.1/full-dress-receipt.json\n    if-no-files-found: error\n- name: Upload two-run full-dress admission\n  if: inputs.full_dress_predecessor_run_id != ''\n  uses: actions/upload-artifact@v6\n  with:\n    name: performance-0671-full-dress-admission\n    path: target/test-evidence/0.67.1/full-dress-admission.json\n    if-no-files-found: error\n- name: Upload full-dress diagnostics\n  if: always()\n  uses: actions/upload-artifact@v6\n  with:\n    name: performance-0671-full-dress-${{ github.sha }}-${{ github.run_id }}\n    path: |\n      target/test-evidence/0.67/**\n      target/test-evidence/0.67.1/**\n      target/release-evidence/receipts/**\n    if-no-files-found: warn\n"
