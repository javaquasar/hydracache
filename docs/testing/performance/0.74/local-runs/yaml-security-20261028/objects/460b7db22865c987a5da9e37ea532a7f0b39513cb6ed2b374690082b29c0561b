                  {
                    "rendered": {
                      "ok": true,
                      "text": "qualify:\n  name: Exact ${{ inputs.role }} selected long-run phase\n  runs-on:\n  - self-hosted\n  - linux\n  - x64\n  - hydracache-release\n  timeout-minutes: ${{ inputs.phase == 'confirmation' && 1740 || 900 }}\n  env:\n    HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073\n    HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: '1'\n    HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}\n    HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}\n    HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}\n    I73_SHA: e757556d3a31d565f52a9561d6d4e555bb1cc373\n    C73_SHA: 16d2e98b6cc9e22d9ccf95eb26fe28bbbcf80f2b\n    C73_TREE_OID: 92336607f21a68f563e65dc0fccccd8efaa14f7b\n    LONG_RUN_PHASE: ${{ inputs.phase }}\n    EVIDENCE_DIR: ${{ github.workspace }}/target/performance-evidence/0.73/long-run-${{ inputs.phase }}-${{ github.run_id }}-${{ github.run_attempt }}\n  steps:\n  - name: Check out reviewed tooling revision\n    uses: actions/checkout@v4\n    with:\n      fetch-depth: 0\n      ref: ${{ inputs.tooling_sha }}\n  - name: Resolve tooling identity and serialized lease\n    shell: bash\n    env:\n      INPUT_TOOLING_SHA: ${{ inputs.tooling_sha }}\n      INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}\n      INPUT_LEASE_END: ${{ inputs.lease_end }}\n      INPUT_PHASE: ${{ inputs.phase }}\n      INPUT_ROLE: ${{ inputs.role }}\n    run: |\n      set -euo pipefail\n      [[ \"$INPUT_TOOLING_SHA\" =~ ^[0-9a-f]{40}$ ]]\n      [[ \"$INPUT_PHASE\" = \"qualification\" || \"$INPUT_PHASE\" = \"confirmation\" ]]\n      [[ \"$INPUT_ROLE\" = \"pair\" || \"$INPUT_ROLE\" = \"I73\" || \"$INPUT_ROLE\" = \"C73\" ]]\n      if [[ \"$INPUT_PHASE\" = \"qualification\" ]]; then\n        test \"$INPUT_ROLE\" = \"pair\"\n      else\n        [[ \"$INPUT_ROLE\" = \"I73\" || \"$INPUT_ROLE\" = \"C73\" ]]\n      fi\n      test \"$(git rev-parse HEAD)\" = \"$INPUT_TOOLING_SHA\"\n      test -n \"$INPUT_LEASE_OWNER\"\n      date --date=\"$INPUT_LEASE_END\" >/dev/null\n      lease_seconds=$(( $(date --date=\"$INPUT_LEASE_END\" +%s) - $(date +%s) ))\n      if [[ \"$INPUT_PHASE\" = \"confirmation\" && \"$INPUT_ROLE\" = \"I73\" ]]; then\n        test \"$lease_seconds\" -ge $((3480 * 60))\n      elif [[ \"$INPUT_PHASE\" = \"confirmation\" ]]; then\n        test \"$lease_seconds\" -ge $((1740 * 60))\n      else\n        test \"$lease_seconds\" -ge $((900 * 60))\n      fi\n      test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n      mkdir -p \"$EVIDENCE_DIR/calibration\"\n      if [[ \"$INPUT_PHASE\" = \"confirmation\" ]]; then\n        cargo run -p xtask --locked -- performance-contract-check --release 0.73\n        python3 - <<'PY'\n      import pathlib\n      import tomllib\n\n      path = pathlib.Path(\"docs/testing/performance/0.73/w10-long-run-v2-qualification-passed-36532416869.toml\")\n      evidence = tomllib.loads(path.read_text(encoding=\"utf-8\"))\n      required = {\n          \"state\": \"six-hour-qualification-passed-confirmation-not-started\",\n          \"result\": \"passed\",\n          \"baseline_source_commit\": \"e757556d3a31d565f52a9561d6d4e555bb1cc373\",\n          \"candidate_source_commit\": \"16d2e98b6cc9e22d9ccf95eb26fe28bbbcf80f2b\",\n          \"decision\": \"accept-six-hour-qualification-and-hold-before-explicit-confirmation\",\n      }\n      for field, expected in required.items():\n          if evidence.get(field) != expected:\n              raise SystemExit(f\"qualification evidence {field} mismatch\")\n      for field in (\n          \"nested_sha256_verified\",\n          \"independent_role_reanalysis_matched\",\n          \"goodput_guard_passed\",\n          \"cpu_guard_passed\",\n          \"p99_guard_passed\",\n          \"rss_slope_guard_passed\",\n          \"anonymous_pss_slope_guard_passed\",\n          \"confirmation_allowed\",\n      ):\n          if evidence.get(field) is not True:\n              raise SystemExit(f\"qualification evidence {field} is not true\")\n      if evidence.get(\"confirmation_started\") is not False or evidence.get(\"final_c73_allowed\") is not False:\n          raise SystemExit(\"qualification evidence already crossed its promotion boundary\")\n      PY\n      fi\n      {\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_OWNER=$INPUT_LEASE_OWNER\"\n        echo \"HYDRACACHE_PERFORMANCE_LEASE_END=$INPUT_LEASE_END\"\n        echo \"EXPECTED_TOOLING_SHA=$INPUT_TOOLING_SHA\"\n        echo \"LONG_RUN_ROLE=$INPUT_ROLE\"\n      } >> \"$GITHUB_ENV\"\n  - name: Expose and verify required host tools\n    shell: bash\n    run: |\n      set -euo pipefail\n      rust_bin=\"$HOME/.cargo/bin\"\n      test -x \"$rust_bin/cargo\"\n      test -x \"$rust_bin/rustc\"\n      echo \"$rust_bin\" >> \"$GITHUB_PATH\"\n      cargo --version\n      rustc --version\n      python3 --version\n      taskset --version\n      pidstat -V\n  - name: Materialize exact product trees and identical overlays\n    shell: bash\n    run: |\n      set -euo pipefail\n      run_key=\"${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}\"\n      i73_root=\"$RUNNER_TEMP/hydracache-long-i73-$run_key\"\n      c73_root=\"$RUNNER_TEMP/hydracache-long-c73-$run_key\"\n      i73_stage=\"$RUNNER_TEMP/long-i73-stage-$run_key\"\n      c73_stage=\"$RUNNER_TEMP/long-c73-stage-$run_key\"\n      git worktree prune\n      git worktree add --detach \"$i73_root\" \"$I73_SHA\"\n      git worktree add --detach \"$c73_root\" \"$C73_SHA\"\n      test \"$(git -C \"$i73_root\" rev-parse HEAD)\" = \"$I73_SHA\"\n      test \"$(git -C \"$c73_root\" rev-parse HEAD)\" = \"$C73_SHA\"\n      test \"$(git -C \"$c73_root\" rev-parse 'HEAD^{tree}')\" = \"$C73_TREE_OID\"\n      mkdir -p \"$i73_stage/tools\" \"$c73_stage/tools\"\n      cp -a tools/performance-integrated-073 \"$i73_stage/tools/\"\n      cp -a tools/performance-integrated-073 \"$c73_stage/tools/\"\n      ln -s \"$i73_root/Cargo.toml\" \"$i73_stage/Cargo.toml\"\n      ln -s \"$c73_root/Cargo.toml\" \"$c73_stage/Cargo.toml\"\n      ln -s \"$i73_root/crates\" \"$i73_stage/crates\"\n      ln -s \"$c73_root/crates\" \"$c73_stage/crates\"\n      {\n        echo \"I73_ROOT=$i73_root\"\n        echo \"C73_ROOT=$c73_root\"\n        echo \"I73_OVERLAY=$i73_stage/tools/performance-integrated-073\"\n        echo \"C73_OVERLAY=$c73_stage/tools/performance-integrated-073\"\n      } >> \"$GITHUB_ENV\"\n  - name: Build exact role servers and standalone harnesses\n    shell: bash\n    run: |\n      set -euo pipefail\n      cargo build --manifest-path \"$I73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n      cargo build --manifest-path \"$C73_ROOT/Cargo.toml\" --release --locked -p hydracache-server\n      test \"$(sha256sum \"$I73_OVERLAY/Cargo.lock\" | cut -d' ' -f1)\" = \"3c2e8a20a26c6105fec6f449ce6cad43ba4a9a65f78516f5c0110ff0a9ca4953\"\n      test \"$(sha256sum \"$C73_OVERLAY/Cargo.lock.c73\" | cut -d' ' -f1)\" = \"35b7ab4f62cee2ce41aa0547cc632a11d90e0d89861b87158bbcf7b184767630\"\n      cargo build --manifest-path \"$I73_OVERLAY/Cargo.toml\" --release --locked\n      cp \"$C73_OVERLAY/Cargo.lock.c73\" \"$C73_OVERLAY/Cargo.lock\"\n      cargo build --manifest-path \"$C73_OVERLAY/Cargo.toml\" --release --locked\n      cp \"$I73_OVERLAY/Cargo.lock\" \"$C73_OVERLAY/Cargo.lock\"\n      diff -qr --exclude=target \"$I73_OVERLAY\" \"$C73_OVERLAY\"\n      test -z \"$(git -C \"$I73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n      test -z \"$(git -C \"$C73_ROOT\" status --porcelain=v1 --untracked-files=normal)\"\n      {\n        echo \"I73_SERVER=$I73_ROOT/target/release/hydracache-server\"\n        echo \"C73_SERVER=$C73_ROOT/target/release/hydracache-server\"\n        echo \"I73_HARNESS=$I73_OVERLAY/target/release/performance-integrated-073\"\n        echo \"C73_HARNESS=$C73_OVERLAY/target/release/performance-integrated-073\"\n      } >> \"$GITHUB_ENV\"\n  - name: Falsify mis