d-bundle\n- name: Sign only this run's checked fixed build with the separate key\n  shell: bash\n  env:\n    BUILDER_SIGNING_KEY_HEX: ${{ secrets.HYDRACACHE_074_BUILDER_SIGNING_KEY_HEX }}\n    CONTROLLER_PUBLIC_KEY_HEX: ${{ vars.HYDRACACHE_074_CONTROLLER_PUBLIC_KEY_HEX }}\n    BUILDER_POLICY_SHA256: ${{ vars.HYDRACACHE_074_BUILDER_POLICY_SHA256 }}\n  run: |\n    set -euo pipefail\n    umask 077\n    private=$(mktemp -d \"$RUNNER_TEMP/diagnostic-builder-074.XXXXXXXX\")\n    key=\"$private/key.hex\"\n    trap 'rm -f -- \"$key\"' EXIT\n    test -n \"$BUILDER_SIGNING_KEY_HEX\"\n    printf '%s\\n' \"$BUILDER_SIGNING_KEY_HEX\" > \"$key\"\n    unset BUILDER_SIGNING_KEY_HEX\n    mkdir -m 0700 signed-build\n    target/debug/diagnostic_builder sign \\\n      \"$RUNNER_TEMP/builder-policy.json\" \"$BUILDER_POLICY_SHA256\" \\\n      \"$CONTROLLER_PUBLIC_KEY_HEX\" \"$key\" \\\n      \"$PWD/build-bundle/observation.json\" \"$PWD/build-bundle\" \\\n      \"$PWD/signed-build/build-receipt-v1.json\"\n    cp \"$RUNNER_TEMP/builder-policy.json\" signed-build/builder-policy.json\n    sha256sum signed-build/build-receipt-v1.json > signed-build/build-receipt.sha256\n- uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f\n  with:\n    name: diagnostic-signed-build-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n    path: signed-build/**\n    if-no-files-found: error\n    retention-days: 30\n    overwrite: false\n"
