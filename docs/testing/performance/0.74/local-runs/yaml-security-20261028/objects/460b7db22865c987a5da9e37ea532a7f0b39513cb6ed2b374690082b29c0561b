                      "text": "ci-topology:\n  name: 0.71 CI topology safety gate\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-latest\n  timeout-minutes: 15\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Validate topology through fail-closed watchdog\n    run: python3 scripts/ci/run-with-heartbeat.py --timeout-seconds 600 --heartbeat-seconds 30 --attempt-id \"${{ github.run_attempt }}\" --status-json target/ci-topology/watchdog-status.json --log-file target/ci-topology/command.log -- cargo run -p xtask --locked -- ci-topology-check --release 0.71\n  - name: Retain topology watchdog attempt\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: ci-topology-071-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n      path: target/ci-topology/**\n      if-no-files-found: error\n      retention-days: 30\nmemory-contracts-071:\n  name: 0.71 Memory Contracts\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-latest\n  timeout-minutes: 240\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install pinned Rust 1.94.0\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Generate and close the ownership inventory\n    timeout-minutes: 15\n    run: |\n      cargo run -p xtask --locked -- memory-owner-inventory --release 0.71\n      cargo run -p xtask --locked -- memory-owner-inventory --release 0.71 --check\n      cargo run -p xtask --locked -- memory-ownership-check --release 0.71\n  - name: Validate decision, statistics, allocator, compatibility, and release contracts\n    timeout-minutes: 15\n    run: |\n      cargo run -p xtask --locked -- memory-decision-check --release 0.71\n      cargo run -p xtask --locked -- memory-statistics-check --release 0.71\n      cargo run -p xtask --locked -- allocator-capability-check --release 0.71\n      cargo run -p xtask --locked -- memory-compat-check --release 0.71\n      cargo run -p xtask --locked -- memory-release-policy-check --release 0.71\n      cargo run -p xtask --locked -- memory-contract-check --release 0.71\n      cargo run -p xtask --locked -- memory-campaign-check --release 0.71\n  - name: Run 0.71 contract canaries\n    timeout-minutes: 30\n    run: |\n      cargo test -p xtask --test memory_ownership_071 --locked\n      cargo test -p xtask --test memory_contracts_071 --locked\n      cargo test -p xtask --test memory_decision_071 --locked\n      cargo test -p xtask --test memory_statistics_071 --locked\n      cargo test -p xtask --test memory_profile_071 --locked\n      cargo test -p xtask --test memory_baseline_071 --locked\n      cargo test -p xtask --test allocator_matrix_071 --locked\n      cargo test -p xtask --test memory_host_profile_071 --locked\n      cargo test -p xtask --test memory_compat_071 --locked\n      cargo test -p xtask --test allocation_copy_071 --locked\n      cargo test -p xtask --test memory_campaign_admission_071 --locked\n      cargo test -p xtask --test release_governance_071 --locked\n      cargo run -p xtask --locked -- memory-baseline-check --release 0.71\n  - name: Verify coherent snapshots and phase providers\n    timeout-minutes: 60\n    run: |\n      cargo test -p hydracache --test memory_footprint_071 --locked\n      cargo test -p hydracache --test memory_accounting_071 --locked -- --test-threads=1\n      cargo test -p hydracache --test reclamation_071 --locked\n      cargo test -p hydracache --test representation_071 --locked\n      cargo test -p hydracache --test tag_index_model_071 --locked\n      cargo test -p hydracache --test persistence_memory_071 --locked\n      cargo test -p hydracache-client-transport-axum --test memory_admission_071 --locked\n      cargo test -p hydracache-client-transport-axum --test retention_bounds_071 --locked\n      cargo test -p hydracache-server --test memory_profiles_071 --locked\n      cargo test -p hydracache-server --test hc2_memory_071 --locked\n      cargo test -p hydracache-server --test memory_compat_process_071 --locked\n      cargo test -p hydracache memory_footprint::tests --locked\n      cargo test -p hydracache-loadgen memory_efficiency --locked\n      python scripts/perf/memory-providers/test_provider_contract.py\n      python scripts/perf/memory_campaign_071_test.py\n      python scripts/perf/memory_case_executor_071_test.py\n      python scripts/perf/memory_historical_mirror_071_test.py\n      python scripts/perf/memory_compat_receipt_071_test.py\n      python scripts/perf/test_memory_release_claims_071.py\n      for mode in off production profile; do\n        cargo run -p hydracache-loadgen --bin hydracache-loadgen --locked -- memory-efficiency --provider system --instrumentation-mode \"$mode\" --output-dir \"target/memory-evidence/0.71/profiles/ci-smoke/$mode\"\n      done\n  - name: Prove bounded campaign resume and finalization\n    timeout-minutes: 15\n    run: |\n      python scripts/perf/memory_campaign_071.py plan --campaign-id ci-bounded-${{ github.run_id }}-${{ github.run_attempt }} --case M0-cold --repetitions 1 --rehearsal\n      python scripts/perf/memory_campaign_071.py run --campaign-id ci-bounded-${{ github.run_id }}-${{ github.run_attempt }}\n      python scripts/perf/memory_campaign_071.py resume --campaign-id ci-bounded-${{ github.run_id }}-${{ github.run_attempt }}\n      python scripts/perf/memory_campaign_071.py finalize --campaign-id ci-bounded-${{ github.run_id }}-${{ github.run_attempt }}\n  - name: Install reviewed cargo-semver-checks\n    timeout-minutes: 30\n    run: cargo install cargo-semver-checks --version 0.50.0 --locked\n  - name: Validate every publishable package against v0.70.0\n    timeout-minutes: 180\n    run: |\n      python3 scripts/ci/public_api_compat_071.py --manifest docs/testing/compat/v0.70.0.json --check\n      python3 scripts/ci/public_api_compat_071.py --manifest docs/testing/compat/v0.70.0.json --output target/public-api-compat-071/receipt.json\n  - name: Retain ownership inventory\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: memory-ownership-071-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n      path: |\n        target/memory-evidence/0.71/ownership-inventory.json\n        target/memory-evidence/0.71/profiles/ci-smoke/**\n        target/memory-evidence/0.71/campaigns/ci-bounded-*/**\n        target/public-api-compat-071/**\n      if-no-files-found: error\n      retention-days: 30\nrelease-071-ci-admission:\n  name: Release 0.71 CI Admission\n  if: always() && startsWith(github.ref, 'refs/tags/v0.71.')\n  needs:\n  - ci-topology\n  - memory-contracts-071\n  - memory-regression-fast\n  - docs\n  - rust\n  - msrv\n  runs-on: ubuntu-latest\n  timeout-minutes: 10\n  steps:\n  - name: Require the designated exact-tag core result\n    env:\n      TOPOLOGY_RESULT: ${{ needs.ci-topology.result }}\n      CONTRACTS_RESULT: ${{ needs.memory-contracts-071.result }}\n      MEMORY_RESULT: ${{ needs.memory-regression-fast.result }}\n      DOCS_RESULT: ${{ needs.docs.result }}\n      RUST_RESULT: ${{ needs.rust.result }}\n      MSRV_RESULT: ${{ needs.msrv.result }}\n    shell: bash\n    run: |\n      set -euo pipefail\n      for result in \"$TOPOLOGY_RESULT\" \"$CONTRACTS_RESULT\" \"$MEMORY_RESULT\" \"$DOCS_RESULT\" \"$RUST_RESULT\" \"$MSRV_RESULT\"; do\n        if [[ \"$result\" != \"success\" ]]; then\n          echo \"Release 0.71 core admission refused result=$result\" >&2\n          exit 1\n        fi\n      done\n      echo \"Release 0.71 designated tag admission is green for $GITHUB_SHA.\"\nmemory-regression-fast:\n  name: Memory Regression Fast\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-24.04\n  timeout-minutes: 30\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-memory-regression-fast\n      cache-targets: true\n  - name: Prove behavioral memory canaries are red\n    run: |\n      cargo run -p xtask --locked -- canary-check --release 0.70\n      cargo run -p xtask --locked -- canary-sweep --release 0.70 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.71\n      cargo run -p xtask --locked -- canary-sweep --release 0.71 --tier fast\n  - name: Run exact-candidate memory regression evidence\n    id: memory_fast\n    run: cargo run -p xtask --locked -- evidence-run --release 0.70 --gate fast.memory-regression-070\n  - name: Finalize memory regression lane status\n    if: always()\n    run: cargo run -p xtask --locked -- ci-admission-status --release 0.70 --source \"$HYDRACACHE_EVIDENCE_TESTED_SHA\" --head \"$HYDRACACHE_EVIDENCE_HEAD_SHA\" --base \"$HYDRACACHE_EVIDENCE_BASE_SHA\" --require \"memory-fast=${{ steps.memory_fast.outcome }}\" --output target/release-evidence/lanes/memory-fast-070.json\n  - name: Upload exact-candidate memory evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: memory-regression-fast-070-${{ github.sha }}\n      path: |\n        target/release-evidence/canaries/*.json\n        target/release-evidence/lanes/memory-fast-070.json\n        target/release-evidence/receipts/**\n      if-no-files-found: error\nmemory-diagnostic-hosted:\n  name: Memory Diagnostic (GitHub Hosted)\n  if: github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && inputs.run_memory_diagnostic)\n  runs-on: ubuntu-24.04\n  timeout-minutes: 240\n  env:\n    CARGO_BUILD_JOBS: 2\n    CARGO_INCREMENTAL: 0\n    CARGO_PROFILE_RELEASE_DEBUG: 0\n    LEAK_DURATION_SECONDS: ${{ inputs.memory_diagnostic_duration_seconds || '120' }}\n    LEAK_CYCLES: 3\n    LEAK_BATCH_REQUESTS: 10000\n    MEASUREMENT_AFFINITY: 0\n    MEMORY_DIAGNOSTIC_ENVIRONMENT: github-hosted\n    MEMORY_DIAGNOSTIC_TARGETS: hydra redis\n    REDIS_IMAGE: redis@sha256:3aaec283e6e593bde528077d60280ac1589887067a39273348860837c9346d7e\n    MEMORY_DIAGNOSTIC_OUTPUT: target/memory-diagnostic/github-hosted\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-memory-diagnostic-hosted\n      cache-targets: false\n  - name: Install diagnostic tools\n    timeout-minutes: 15\n    run: |\n      sudo apt-get update\n      sudo apt-get install --yes build-essential jq netcat-openbsd redis-tools\n  - name: Build release daemon\n    run: cargo build --release -p hydracache-server --locked\n  - name: Build pinned redis-benchmark 7.2.5\n    shell: bash\n    run: |\n      set -euo pipefail\n      tools_dir=\"$RUNNER_TEMP/memory-diagnostic-tools\"\n      mkdir --parents \"$tools_dir\"\n      cd \"$tools_dir\"\n      curl --fail --location --retry 3 \\\n        --output redis-7.2.5.tar.gz \\\n        https://download.redis.io/releases/redis-7.2.5.tar.gz\n      printf '%s  redis-7.2.5.tar.gz\\n' \\\n        '5981179706f8391f03be91d951acafaeda91af7fac56beffb2701963103e423d' \\\n        | sha256sum --check --strict\n      tar --extract --gzip --file redis-7.2.5.tar.gz\n      make -C redis-7.2.5 -j1 redis-benchmark\n      test \"$(redis-7.2.5/src/redis-benchmark --version)\" = \"redis-benchmark 7.2.5\"\n      echo \"REDIS_BENCHMARK=$tools_dir/redis-7.2.5/src/redis-benchmark\" >> \"$GITHUB_ENV\"\n  - name: Pull pinned Redis image\n    run: |\n      docker pull \"$REDIS_IMAGE\"\n      docker image inspect \"$REDIS_IMAGE\" > target/redis-image-inspect.json\n  - name: Run HydraCache and Redis memory campaign\n    shell: bash\n    run: scripts/perf/run-memory-leak-stage.sh \"$MEMORY_DIAGNOSTIC_OUTPUT\"\n  - name: Publish report to job summary\n    if: always()\n    shell: bash\n    run: |\n      if [[ -f \"$MEMORY_DIAGNOSTIC_OUTPUT/report.md\" ]]; then\n        cat \"$MEMORY_DIAGNOSTIC_OUTPUT/report.md\" >> \"$GITHUB_STEP_SUMMARY\"\n      fi\n  - name: Build compact diagnostic summary and non-gating trend\n    if: always()\n    env:\n      GH_TOKEN: ${{ github.token }}\n    shell: bash\n    run: |\n      set -euo pipefail\n      summary_dir=\"target/memory-summary\"\n      mkdir --parents \"$summary_dir\"\n      python3 scripts/perf/summarize-memory-diagnostic.py \\\n        --input \"$MEMORY_DIAGNOSTIC_OUTPUT\" \\\n        --output \"$summary_dir/summary.json\"\n      baseline_id=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/artifacts?per_page=100\" \\\n        --jq '.artifacts[] | select(.expired == false and (.name | startswith(\"memory-summary-\"))) | [.created_at, .id] | @tsv' \\\n        | sort --reverse | head -n 1 | cut -f 2)\"\n      if [[ -n \"$baseline_id\" ]]; then\n        baseline_dir=\"$RUNNER_TEMP/memory-summary-baseline\"\n        mkdir --parents \"$baseline_dir\"\n        gh api \"repos/$GITHUB_REPOSITORY/actions/artifacts/$baseline_id/zip\" > \"$baseline_dir/artifact.zip\"\n        unzip -q \"$baseline_dir/artifact.zip\" -d \"$baseline_dir\"\n        baseline_summary=\"$(find \"$baseline_dir\" -name summary.json -type f -print -quit)\"\n        python3 scripts/perf/compare-memory-summaries.py \\\n          --baseline \"$baseline_summary\" \\\n          --candidate \"$summary_dir/summary.json\" \\\n          --output \"$summary_dir/trend.json\"\n      else\n        python3 scripts/perf/compare-memory-summaries.py \\\n          --candidate \"$summary_dir/summary.json\" \\\n          --output \"$summary_dir/trend.json\"\n      fi\n  - name: Upload raw memory evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: memory-diagnostic-${{ github.run_id }}-${{ github.run_attempt }}\n      path: |\n        target/memory-diagnostic/github-hosted\n        target/redis-image-inspect.json\n      if-no-files-found: error\n      retention-days: 30\n  - name: Upload durable compact memory history\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: memory-summary-${{ github.run_id }}-${{ github.run_attempt }}\n      path: target/memory-summary\n      if-no-files-found: error\n      retention-days: 90\nretention-soak-070:\n  name: Retention Soak 0.70\n  if: github.event_name == 'schedule' || startsWith(github.ref, 'refs/tags/v0.70.') || (github.event_name == 'workflow_dispatch' && (inputs.run_retention_soak_070 || inputs.run_release_070_admission))\n  runs-on: ubuntu-24.04\n  timeout-minutes: 60\n  steps:\n  - name: Checkout exact tested candidate\n    uses: actions/checkout@v5\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-retention-soak-070\n      cache-targets: true\n  - name: Run 100-cycle core retention soak\n    timeout-minutes: 20\n    id: core_soak\n    run: cargo run -p xtask --locked -- evidence-run --release 0.70 --gate tool.hydracache.retention-soak-070\n  - name: Run million-mutation client-surface retention soak\n    timeout-minutes: 30\n    id: client_soak\n    run: cargo run -p xtask --locked -- evidence-run --release 0.70 --gate tool.hydracache-client-transport-axum.retention-soak-070\n  - name: Finalize retention soak lane status\n    timeout-minutes: 5\n    if: always()\n    run: cargo run -p xtask --locked -- ci-admission-status --release 0.70 --source \"$HYDRACACHE_EVIDENCE_TESTED_SHA\" --head \"$HYDRACACHE_EVIDENCE_HEAD_SHA\" --base \"$HYDRACACHE_EVIDENCE_BASE_SHA\" --require \"core-soak=${{ steps.core_soak.outcome }}\" --require \"client-soak=${{ steps.client_soak.outcome }}\" --output target/release-evidence/lanes/retention-soak-070.json\n  - name: Upload exact-candidate retention evidence\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: retention-soak-070-${{ github.sha }}\n      path: |\n        target/release-evidence/lanes/retention-soak-070.json\n        target/release-evidence/receipts/**\n      if-no-files-found: error\nrelease-070-admission:\n  name: Release 0.70 Admission\n  if: always() && (startsWith(github.ref, 'refs/tags/v0.70.') || (github.event_name == 'workflow_dispatch' && inputs.run_release_070_admission))\n  needs:\n  - memory-regression-fast\n  - retention-soak-070\n  runs-on: ubuntu-24.04\n  timeout-minutes: 15\n  steps:\n  - name: Checkout exact tested candidate\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n  - name: Materialize fail-loud upstream admission status\n    run: cargo run -p xtask --locked -- ci-admission-status --release 0.70 --source \"$HYDRACACHE_EVIDENCE_TESTED_SHA\" --head \"$HYDRACACHE_EVIDENCE_HEAD_SHA\" --base \"$HYDRACACHE_EVIDENCE_BASE_SHA\" --require \"memory-fast=${{ needs.memory-regression-fast.result }}\" --require \"retention-soak=${{ needs.retention-soak-070.result }}\" --output target/release-evidence/0.70.admission-upstream.json\n  - name: Download exact-candidate memory receipts and canaries\n    uses: actions/download-artifact@v8\n    with:\n      name: memory-regression-fast-070-${{ github.sha }}\n      path: target/release-evidence\n  - name: Download exact-candidate retention receipts\n    uses: actions/download-artifact@v8\n    with:\n      name: retention-soak-070-${{ github.sha }}\n      path: target/release-evidence\n  - name: Validate exact-candidate lane status artifacts\n    run: cargo run -p xtask --locked -- ci-admission-status --release 0.70 --source \"$HYDRACACHE_EVIDENCE_TESTED_SHA\" --head \"$HYDRACACHE_EVIDENCE_HEAD_SHA\" --base \"$HYDRACACHE_EVIDENCE_BASE_SHA\" --lane-status \"memory-fast=target/release-evidence/lanes/memory-fast-070.json\" --lane-status \"retention-soak=target/release-evidence/lanes/retention-soak-070.json\" --output target/release-evidence/0.70.admission-lanes.json\n  - name: Require exact-candidate release 0.70 evidence\n    run: cargo run -p xtask --locked -- release-evidence --release 0.70 --receipts-dir target/release-evidence/receipts --require-ship\n  - name: Upload release 0.70 admission\n    if: always()\n    uses: actions/upload-artifact@v6\n    with:\n      name: release-070-admission-${{ github.sha }}\n      path: target/release-evidence/0.70.*\n      if-no-files-found: error\ndocs:\n  name: Docs\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-latest\n  timeout-minutes: 30\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n  - name: Install Rust\n    uses: dtolnay/rust-toolchain@1.94.0\n    with:\n      components: rustfmt\n  - name: Install Node\n    uses: actions/setup-node@v5\n    with:\n      node-version: 22\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v1-docs-ci\n      cache-targets: true\n  - name: Install mdBook\n    uses: taiki-e/install-action@v2\n    with:\n      tool: mdbook@0.5.2\n  - name: Check docs examples formatting\n    run: cargo fmt --manifest-path docs-site/examples/Cargo.toml --check\n  - name: Check docs examples\n    run: cargo check --manifest-path docs-site/examples/Cargo.toml --all-targets --locked\n  - name: Build docs site\n    run: mdbook build docs-site\n  - name: Check documentation links\n    run: node scripts/docs-link-check.mjs\n  - name: Check release documentation synchronization\n    run: |\n      node --test scripts/docs-release-check.test.mjs\n      node scripts/docs-release-check.mjs\nrust:\n  name: Rust\n  if: github.event_name != 'workflow_dispatch' || inputs.performance_0671_mode == 'off'\n  runs-on: ubuntu-latest\n  timeout-minutes: 120\n  env:\n    CARGO_BUILD_JOBS: 4\n  steps:\n  - name: Checkout\n    uses: actions/checkout@v5\n    with:\n      fetch-depth: 0\n  - name: Install pinned Rust 1.94.0\n    uses: dtolnay/rust-toolchain@1.94.0\n    with:\n      components: rustfmt, clippy\n  - name: Install Java for HC/2 generated-language proof\n    uses: actions/setup-java@v5\n    with:\n      distribution: temurin\n      java-version: '17'\n      cache: maven\n  - name: Install Python for HC/2 offline generated-language proof\n    uses: actions/setup-python@v6\n    with:\n      python-version: '3.12'\n  - name: Install Node\n    uses: actions/setup-node@v5\n    with:\n      node-version: 22\n      cache: npm\n      cache-dependency-path: console/package-lock.json\n  - name: Cache Rust dependencies\n    uses: Swatinem/rust-cache@v2\n    with:\n      prefix-key: v2-rust-with-target\n      cache-targets: true\n  - name: Install cargo-deny\n    uses: taiki-e/install-action@cargo-deny\n  - name: Install pinned cargo-nextest\n    uses: taiki-e/install-action@v2\n    with:\n      tool: cargo-nextest@0.9.137\n  - name: Format\n    run: cargo fmt --all -- --check\n  - name: Check\n    run: cargo check --workspace --all-targets --locked\n  - name: HC/2 generated Rust, Java, and offline Python proof\n    env:\n      PIP_NO_INDEX: '1'\n      PIP_DISABLE_PIP_VERSION_CHECK: '1'\n    run: cargo run -p xtask --locked -- client-plane-spike-check\n  - name: Dependency policy\n    run: cargo deny check\n  - name: Docs consistency\n    run: |\n      cargo test -p xtask --test doc_check --locked\n      cargo run -p xtask --locked -- doc-check\n  - name: Raft mutation baseline\n    run: |\n      cargo test -p xtask --test mutants --locked\n      cargo run -p xtask --locked -- mutants\n  - name: Install management console dependencies for canaries\n    timeout-minutes: 15\n    run: npm ci --prefix console\n  - name: Canary completeness\n    run: |\n      cargo test -p xtask --test canary_check --locked\n      cargo run -p xtask --locked -- canary-check --release 0.64\n      cargo run -p xtask --locked -- canary-sweep --release 0.64 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.65\n      cargo run -p xtask --locked -- canary-sweep --release 0.65 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.66\n      cargo run -p xtask --locked -- canary-sweep --release 0.66 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.67\n      cargo run -p xtask --locked -- canary-sweep --release 0.67 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.67.1\n      cargo run -p xtask --locked -- canary-sweep --release 0.67.1 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.68\n      cargo run -p xtask --locked -- canary-sweep --release 0.68 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.70\n      cargo run -p xtask --locked -- canary-sweep --release 0.70 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.71\n      cargo run -p xtask --locked -- canary-sweep --release 0.71 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.72\n      cargo run -p xtask --locked -- canary-sweep --release 0.72 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.73\n      cargo run -p xtask --locked -- canary-sweep --release 0.73 --tier fast\n      cargo run -p xtask --locked -- canary-check --release 0.74\n      cargo run -p xtask --locked -- canary-sweep --release 0.74 --tier fast\n  - name: Management Center 0.72 admission contract\n    run: |\n      cargo test -p xtask --test management_center_072 --locked\n      cargo run -p xtask --locked -- management-center-check --release 0.72\n      cargo run -p xtask --locked -- release-evidence --release 0.72\n  - name: Release 0.73 performance and evidence contracts\n    run: |\n      cargo test -p xtask --test performance_contract_073 --test performance_local_073 --locked\n      cargo run -p xtask --locked -- performance-contract-check --release 0.73\n      cargo run -p xtask 