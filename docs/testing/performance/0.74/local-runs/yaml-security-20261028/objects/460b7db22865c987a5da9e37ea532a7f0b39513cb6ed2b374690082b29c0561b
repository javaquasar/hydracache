n        umask 077\n        key_file=\"$RUNNER_TEMP/hydracache-074-signing-key\"\n        trap 'rm -f \"$key_file\"' EXIT\n        printf '%s\\n' \"$SIGNING_KEY_HEX\" > \"$key_file\"\n        bundle=target/host-provisioning-074\n        mkdir -p \"$bundle\"\n        target/release/hydracache-long-run-supervisor-074 \\\n          derive-verification-key \"$key_file\" > \"$bundle/verification-key.hex\"\n        install -m 0755 target/release/hydracache-long-run-supervisor-074 \\\n          \"$bundle/hydracache-long-run-supervisor-074\"\n        install -m 0755 scripts/perf/long-run-supervisor-074/provision-host-074.sh \\\n          \"$bundle/provision-host-074.sh\"\n        install -m 0644 scripts/perf/long-run-supervisor-074/hydracache-performance-supervisor-074.service \\\n          \"$bundle/hydracache-performance-supervisor-074.service\"\n        install -m 0644 scripts/perf/long-run-supervisor-074/hydracache-performance-074.sysusers.conf \\\n          \"$bundle/hydracache-performance-074.sysusers.conf\"\n        install -m 0644 scripts/perf/long-run-supervisor-074/hydracache-performance-074.tmpfiles.conf \\\n          \"$bundle/hydracache-performance-074.tmpfiles.conf\"\n        printf '%s\\n' \"$INPUT_SOURCE_SHA\" > \"$bundle/source-commit.txt\"\n        (\n          cd \"$bundle\"\n          sha256sum \\\n            hydracache-long-run-supervisor-074 \\\n            hydracache-performance-074.sysusers.conf \\\n            hydracache-performance-074.tmpfiles.conf \\\n            hydracache-performance-supervisor-074.service \\\n            provision-host-074.sh \\\n            source-commit.txt \\\n            verification-key.hex > bundle.sha256\n          sha256sum --strict --check bundle.sha256\n        )\n        target/release/hydracache-long-run-supervisor-074 \\\n          sign-provisioning-manifest \"$bundle/bundle.sha256\" \"$key_file\" \\\n          \"$bundle/bundle.signature.hex\" > \"$bundle/bundle-manifest.sha256\"\n        test \"$(sha256sum \"$bundle/bundle.sha256\" | cut -d' ' -f1)\" = \\\n          \"$(tr -d '\\r\\n' < \"$bundle/bundle-manifest.sha256\")\"\n        rm -f \"$bundle/bundle-manifest.sha256\" \"$key_file\"\n        trap - EXIT\n    - name: Publish immutable public provisioning bundle\n      uses: actions/upload-artifact@v6\n      with:\n        name: long-run-host-provisioning-074-${{ inputs.source_sha }}-${{ github.run_id }}\n        path: target/host-provisioning-074/**\n        if-no-files-found: error\n        overwrite: true\n        retention-days: 30\n  provision:\n    name: Install and start reviewed supervisor service\n    needs: prepare\n    runs-on:\n    - self-hosted\n    - linux\n    - x64\n    - hydracache-release\n    environment: performance-reference-074\n    timeout-minutes: 15\n    steps:\n    - name: Check out exact reviewed probe source\n      uses: actions/checkout@v5\n      with:\n        fetch-depth: 0\n        persist-credentials: false\n        ref: ${{ inputs.source_sha }}\n    - name: Download immutable public provisioning bundle\n      uses: actions/download-artifact@v8\n      with:\n        name: long-run-host-provisioning-074-${{ inputs.source_sha }}-${{ github.run_id }}\n        path: target/host-provisioning-074\n    - name: Verify source, bundle, and non-interactive root boundary\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n      run: |\n        set -euo pipefail\n        [[ \"$INPUT_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]\n        test \"$(git rev-parse HEAD)\" = \"$INPUT_SOURCE_SHA\"\n        test -z \"$(git status --porcelain=v1 --untracked-files=normal)\"\n        bundle=target/host-provisioning-074\n        test \"$(tr -d '\\r\\n' < \"$bundle/source-commit.txt\")\" = \"$INPUT_SOURCE_SHA\"\n        (cd \"$bundle\" && sha256sum --strict --check bundle.sha256)\n        chmod 0755 \"$bundle/hydracache-long-run-supervisor-074\" \"$bundle/provision-host-074.sh\"\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 --preflight\n    - name: Provision reviewed files, identities, and service\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        REPOSITORY_ID: ${{ github.repository_id }}\n        ACTOR_ID: ${{ github.actor_id }}\n      run: |\n        set -euo pipefail\n        bundle=$(realpath target/host-provisioning-074)\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 \\\n          --bundle-dir \"$bundle\" \\\n          --source-commit \"$INPUT_SOURCE_SHA\" \\\n          --repository-id \"$REPOSITORY_ID\" \\\n          --actor-id \"$ACTOR_ID\" \\\n          --runner-user \"$(id -un)\" \\\n          --runner-uid \"$(id -u)\" \\\n          --runner-gid \"$(id -g)\"\n    - name: Collect post-provisioning receipts without qualification\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n      run: |\n        set -euo pipefail\n        evidence=target/performance-evidence/0.74/reference/w11-host-provisioning\n        mkdir -p \"$evidence\"\n        umask 077\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \\\n          > \"$evidence/provisioning.json\"\n        python3 scripts/perf/performance_long_run_host_capability_074.py \\\n          --source-commit \"$INPUT_SOURCE_SHA\" \\\n          --output \"$evidence/capability-after.json\"\n        python3 -m json.tool \"$evidence/provisioning.json\" >/dev/null\n        python3 -m json.tool \"$evidence/capability-after.json\" >/dev/null\n    - name: Retain provisioning and post-install capability receipts\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-long-run-host-provisioning-074-${{ inputs.source_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.74/reference/w11-host-provisioning/**\n        if-no-files-found: warn\n        retention-days: 90\n"
