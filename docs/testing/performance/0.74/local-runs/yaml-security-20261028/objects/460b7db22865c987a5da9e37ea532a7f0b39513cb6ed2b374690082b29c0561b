dracache-client\n            hydracache-client-hc2\n            hydracache-cluster-chitchat hydracache-cluster-raft\n            hydracache-cluster-transport-axum hydracache-db\n            hydracache-observability hydracache-transport-nats\n            hydracache-transport-redis hydracache-actuator-axum\n            hydracache-cdc-postgres hydracache-client-transport-axum\n            hydracache-cluster hydracache-diesel hydracache-seaorm\n            hydracache-sqlx hydracache-redis-compat hydracache-server\n          )\n        fi\n        for package in \"${packages[@]}\"; do\n          [[ -z \"$package\" ]] && continue\n          cargo add \"$package@${{ inputs.version }}\"\n          cargo check\n        done\n    - name: Add published dependencies\n      working-directory: hydracache-consumer\n      run: |\n        set -euo pipefail\n        manifest=\"$GITHUB_WORKSPACE/target/release-publish/packages.txt\"\n        if [[ -f \"$manifest\" ]]; then\n          mapfile -t packages < \"$manifest\"\n        else\n          packages=(\n            hydracache-client-protocol hydracache-core hydracache-macros\n            hydracache-sql-lint hydracache hydracache-client\n            hydracache-client-hc2\n            hydracache-cluster-chitchat hydracache-cluster-raft\n            hydracache-cluster-transport-axum hydracache-db\n            hydracache-observability hydracache-transport-nats\n            hydracache-transport-redis hydracache-actuator-axum\n            hydracache-cdc-postgres hydracache-client-transport-axum\n            hydracache-cluster hydracache-diesel hydracache-seaorm\n            hydracache-sqlx hydracache-redis-compat hydracache-server\n          )\n        fi\n        for package in \"${packages[@]}\"; do\n          [[ -z \"$package\" ]] && continue\n          cargo add \"$package@${{ inputs.version }}\"\n        done\n        cargo add serde --features derive\n        cargo add serde_json --dev\n        cargo add tokio --features macros,rt-multi-thread\n    - name: Install smoke test fixture\n      timeout-minutes: 15\n      working-directory: hydracache-consumer\n      run: cp \"$GITHUB_WORKSPACE/tests/post-publish-consumer/src/lib.rs\" src/lib.rs\n    - name: Check published consumer\n      working-directory: hydracache-consumer\n      run: cargo check\n    - name: Test published consumer\n      working-directory: hydracache-consumer\n      run: cargo test\n    - name: Build published docs\n      working-directory: hydracache-consumer\n      env:\n        RUSTDOCFLAGS: -D warnings\n      run: cargo doc --no-deps\n"
