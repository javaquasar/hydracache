  os.environ[\"INPUT_APPROVAL_NONCE\"] if operation == \"abort\" else None\n        ),\n    }\n    path = pathlib.Path(\"target/controller-request-074/unsigned.json\")\n    path.write_text(json.dumps(request, sort_keys=True, separators=(\",\", \":\")), encoding=\"utf-8\")\n    PY\n- name: Sign and self-verify the request packet\n  shell: bash\n  env:\n    SIGNING_KEY_HEX: ${{ secrets.HYDRACACHE_074_AUTH_SIGNING_KEY_HEX }}\n  run: |\n    set -euo pipefail\n    test -n \"$SIGNING_KEY_HEX\"\n    umask 077\n    key_file=\"$RUNNER_TEMP/hydracache-074-signing-key\"\n    trap 'rm -f \"$key_file\"' EXIT\n    printf '%s\\n' \"$SIGNING_KEY_HEX\" > \"$key_file\"\n    issued=\"$(date +%s)\"\n    expires=\"$((issued + 300))\"\n    target/release/hydracache-long-run-supervisor-074 build-request \\\n      target/controller-request-074/unsigned.json \\\n      \"$key_file\" \"$issued\" \"$expires\" \\\n      target/controller-request-074/request.json \\\n      > target/controller-request-074/request.sha256\n    rm -f \"$key_file\"\n    trap - EXIT\n    test \"$(sha256sum target/controller-request-074/request.json | cut -d' ' -f1)\" = \\\n      \"$(tr -d '\\r\\n' < target/controller-request-074/request.sha256)\"\n- name: Publish the immutable controller packet\n  uses: actions/upload-artifact@v4\n  with:\n    name: long-run-074-request-${{ inputs.request_id }}\n    path: |\n      target/controller-request-074/request.json\n      target/controller-request-074/request.sha256\n    if-no-files-found: error\n    retention-days: 7\n"
