              "text": "name: Publish Crates\non:\n  workflow_run:\n    workflows:\n    - CI\n    types:\n    - completed\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: Existing release tag to re-qualify and publish\n        required: true\n        type: string\npermissions:\n  contents: read\n  actions: read\nconcurrency:\n  group: crates-release-${{ github.event.workflow_run.head_sha || inputs.tag || github.run_id }}\n  cancel-in-progress: false\njobs:\n  resolve:\n    name: Resolve and validate release candidate\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    outputs:\n      eligible: ${{ steps.resolve.outputs.eligible }}\n      version: ${{ steps.resolve.outputs.version }}\n      tag: ${{ steps.resolve.outputs.tag }}\n      source_sha: ${{ steps.resolve.outputs.source_sha }}\n      metadata_artifact: ${{ steps.resolve.outputs.metadata_artifact }}\n    steps:\n    - name: Checkout candidate commit\n      uses: actions/checkout@v5\n      with:\n        ref: ${{ github.event_name == 'workflow_dispatch' && format('refs/tags/{0}', inputs.tag) || github.event.workflow_run.head_sha }}\n        fetch-depth: 0\n    - name: Resolve tag, CI result, versions, and publish order\n      id: resolve\n      env:\n        EVENT_NAME: ${{ github.event_name }}\n        WORKFLOW_RUN_CONCLUSION: ${{ github.event.workflow_run.conclusion || '' }}\n        WORKFLOW_RUN_SHA: ${{ github.event.workflow_run.head_sha || '' }}\n        WORKFLOW_RUN_ID: ${{ github.event.workflow_run.id || '' }}\n        WORKFLOW_RUN_REF: ${{ github.event.workflow_run.head_branch || '' }}\n        INPUT_TAG: ${{ inputs.tag || '' }}\n        GH_TOKEN: ${{ github.token }}\n      shell: bash\n      run: |\n        set -euo pipefail\n\n        if [[ \"$EVENT_NAME\" == \"workflow_run\" ]]; then\n          if [[ \"$WORKFLOW_RUN_CONCLUSION\" != \"success\" && \"$WORKFLOW_RUN_CONCLUSION\" != \"failure\" ]]; then\n            echo \"CI conclusion is $WORKFLOW_RUN_CONCLUSION; publication is not eligible.\"\n            echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          source_sha=\"$WORKFLOW_RUN_SHA\"\n          git fetch --force --tags origin\n          mapfile -t tags < <(git tag --points-at \"$source_sha\" --list 'v*.*.*')\n          if [[ \"${#tags[@]}\" -eq 0 ]]; then\n            echo \"CI run $source_sha has no release tag; nothing to publish.\"\n            echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n          if [[ \"${#tags[@]}\" -ne 1 ]]; then\n            printf 'Expected one release tag at %s, found: %s\\n' \"$source_sha\" \"${tags[*]}\" >&2\n            exit 1\n          fi\n          release_tag=\"${tags[0]}\"\n        else\n          release_tag=\"$INPUT_TAG\"\n          if [[ ! \"$release_tag\" =~ ^v[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]]; then\n            echo \"Input tag must be a SemVer tag such as v0.65.0, got: $release_tag\" >&2\n            exit 1\n          fi\n          git fetch --force --tags origin\n          if ! git rev-parse -q --verify \"refs/tags/$release_tag\" >/dev/null; then\n            echo \"Tag $release_tag does not exist.\" >&2\n            exit 1\n          fi\n          source_sha=\"$(git rev-list -n1 \"$release_tag\")\"\n          ci_runs=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$source_sha&per_page=100\")\"\n          if ! printf '%s' \"$ci_runs\" | jq -e --arg sha \"$source_sha\" '[.workflow_runs[] | select(.head_sha == $sha and .conclusion == \"success\")] | length > 0' >/dev/null; then\n            echo \"No successful CI run exists for $release_tag at $source_sha.\" >&2\n            exit 1\n          fi\n        fi\n\n        version=\"${release_tag#v}\"\n\n        if [[ \"$version\" == 0.71.* ]]; then\n          if [[ \"$EVENT_NAME\" == \"workflow_run\" && \"$WORKFLOW_RUN_REF\" != \"$release_tag\" ]]; then\n            echo \"CI ref $WORKFLOW_RUN_REF is not release tag $release_tag; nothing to publish.\"\n            echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n          # The source commit already has a complete green main-branch CI run.\n          # The tag run adds one exact-tag 0.71 admission; unrelated legacy or\n          # nightly jobs may fail without changing that release decision.\n          ci_runs=\"$(gh api --paginate \"repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?head_sha=$source_sha&status=completed&per_page=100\")\"\n          if ! printf '%s' \"$ci_runs\" | jq -e --arg sha \"$source_sha\" \\\n            '[.workflow_runs[] | select(.head_sha == $sha and .event == \"push\" and .head_branch == \"main\" and .conclusion == \"success\")] | length > 0' >/dev/null; then\n            echo \"No complete successful main CI run exists at measured source $source_sha.\" >&2\n            exit 1\n          fi\n          if [[ \"$EVENT_NAME\" == \"workflow_run\" ]]; then\n            candidate_run_ids=(\"$WORKFLOW_RUN_ID\")\n          else\n            mapfile -t candidate_run_ids < <(\n              printf '%s' \"$ci_runs\" | jq -r --arg sha \"$source_sha\" --arg tag \"$release_tag\" \\\n                '.workflow_runs[] | select(.head_sha == $sha and .event == \"push\" and .head_branch == $tag and (.conclusion == \"success\" or .conclusion == \"failure\")) | .id'\n            )\n          fi\n          designated_admission=false\n          for run_id in \"${candidate_run_ids[@]}\"; do\n            if gh api --paginate \\\n              \"repos/$GITHUB_REPOSITORY/actions/runs/$run_id/jobs?per_page=100\" \\\n              --jq '.jobs[] | select(.name == \"Release 0.71 CI Admission\" and .conclusion == \"success\") | .id' \\\n              | grep -q .; then\n              designated_admission=true\n              break\n            fi\n          done\n          if [[ \"$designated_admission\" != \"true\" ]]; then\n            echo \"No designated Release 0.71 CI Admission exists for $release_tag at $source_sha.\" >&2\n            exit 1\n          fi\n        elif [[ \"$EVENT_NAME\" == \"workflow_run\" && \"$WORKFLOW_RUN_CONCLUSION\" != \"success\" ]]; then\n          echo \"CI conclusion is $WORKFLOW_RUN_CONCLUSION; publication is not eligible.\"\n          echo \"eligible=false\" >> \"$GITHUB_OUTPUT\"\n          exit 0\n        fi\n\n        git fetch --force origin main\n        if ! git merge-base --is-ancestor \"$source_sha\" origin/main; then\n          echo \"$release_tag does not point to a commit reachable from origin/main.\" >&2\n          exit 1\n        fi\n\n        if [[ \"$version\" == \"0.68.0\" ]]; then\n          hosted_admission=false\n          for attempt in $(seq 1 30); do\n            hc2_runs=\"$(gh api \"repos/$GITHUB_REPOSITORY/actions/workflows/hc2-client-plane.yml/runs?head_sha=$source_sha&status=completed&per_page=100\")\"\n            mapfile -t hc2_run_ids < <(\n              printf '%s' \"$hc2_runs\" | jq -r --arg sha \"$source_sha\" \\\n                '.workflow_runs[] | select(.head_sha == $sha and .conclusion == \"success\") | .id'\n            )\n            for hc2_run_id in \"${hc2_run_ids[@]}\"; do\n              if gh api --paginate \\\n                \"repos/$GITHUB_REPOSITORY/actions/runs/$hc2_run_id/jobs?per_page=100\" \\\n                --jq '.jobs[] | select(.name == \"HC/2 Hosted Release Admission\" and .conclusion == \"success\") | .id' \\\n                | grep -q .; then\n                hosted_admission=true\n                break\n              fi\n            done\n            if [[ \"$hosted_admission\" == \"true\" ]]; then\n              break\n            fi\n            if [[ \"$attempt\" -lt 30 ]]; then\n              echo \"Waiting for HC/2 hosted admission at $source_sha (attempt $attempt/30).\"\n              sleep 60\n            fi\n          done\n          if [[ \"$hosted_admission\" != \"true\" ]]; then\n            echo \"No successful HC/2 Hosted Release Admission exists for 0.68.0 at $source_sha.\" >&2\n            echo \"Java/Python SDK promotion is separate and still requires the deferred fixed-host admission.\" >&2\n            exit 1\n          fi\n        fi\n\n        python - \"$version\" \"$release_tag\" \"$source_sha\" <<'PY'\n        import json\n        import pathlib\n        import re\n        import subprocess\n        import sys\n\n        version, release_tag, source_sha = sys.argv[1:]\n        metadata = json.loads(\n            subprocess.check_output(\n                [\"cargo\", \"metadata\", \"--locked\", \"--format-version\", \"1\"],\n                text=True,\n            )\n        )\n        packages = metadata[\"packages\"]\n        publishable = [\n            package\n            for package in packages\n            if package.get(\"source\") is None and package.get(\"publish\") is None\n        ]\n        versions = {package[\"version\"] for package in publishable}\n        if versions != {version}:\n            raise SystemExit(\n                f\"publishable package versions {sorted(versions)} do not match tag {version}\"\n            )\n\n        # Runtime packages come from the measured tag, while finalization\n        # documentation is committed afterwards on main. The ancestry check\n        # above binds the two without silently retagging unmeasured code.\n        manifest = subprocess.check_output(\n            [\"git\", \"show\", \"origin/main:docs/plans/releases.toml\"], text=True\n        )\n        blocks = re.split(r\"(?m)^\\[\\[release\\]\\]\\s*$\", manifest)\n        matching = None\n        for block in blocks:\n            if re.search(rf'(?m)^\\s*version\\s*=\\s*\"{re.escape(version)}\"\\s*$', block):\n                matching = block\n                break\n        if matching is None:\n            raise SystemExit(f\"release {version} is missing from docs/plans/releases.toml\")\n        status = re.search(r'(?m)^\\s*status\\s*=\\s*\"([^\"]+)\"\\s*$', matching)\n        if status is None or status.group(1) != \"shipped\":\n            actual = status.group(1) if status else \"missing\"\n            raise SystemExit(f\"release {version} has status {actual!r}, expected shipped\")\n\n        release_notes = pathlib.Path(f\"docs/releases/{version}.md\")\n        try:\n            notes_text = subprocess.check_output(\n                [\"git\", \"show\", f\"origin/main:{release_notes}\"], text=True\n            )\n        except subprocess.CalledProcessError as exc:\n            raise SystemExit(f\"missing release notes on main: {release_notes}\") from exc\n\n        by_id = {package[\"id\"]: package[\"name\"] for package in packages}\n        publishable_ids = {package[\"id\"] for package in publishable}\n        dependencies = {package[\"name\"]: set() for package in publishable}\n        for node in metadata[\"resolve\"][\"nodes\"]:\n            if node[\"id\"] not in publishable_ids:\n                continue\n            name = by_id[node[\"id\"]]\n            for dependency in node[\"deps\"]:\n                dependency_id = dependency[\"pkg\"]\n                # Cargo resolves every packaged dependency kind during\n                # `cargo publish`, including dev, build, and target-specific\n                # dependencies. They must all precede the dependent crate.\n                if dependency_id in publishable_ids:\n                    dependencies[name].add(by_id[dependency_id])\n\n        order = []\n        while dependencies:\n            ready = sorted(name for name, deps in dependencies.items() if not deps)\n            if not ready:\n                raise SystemExit(\"publishable workspace dependency graph contains a cycle\")\n            for name in ready:\n                order.append(name)\n                del dependencies[name]\n            for deps in dependencies.values():\n                deps.difference_update(ready)\n\n        output = pathlib.Path(\"target/release-publish\")\n        output.mkdir(parents=True, exist_ok=True)\n        (output / \"release-notes.md\").write_text(notes_text, encoding=\"utf-8\")\n        (output / \"release.env\").write_text(\n            f\"VERSION={version}\\nTAG={release_tag}\\nSOURCE_SHA={source_sha}\\n\",\n            encoding=\"utf-8\",\n        )\n        (output / \"packages.txt\").write_text(\"\\n\".join(order) + \"\\n\", encoding=\"utf-8\")\n        print(f\"release candidate: {release_tag} at {source_sha}\")\n        print(f\"publishable packages: {len(order)}\")\n        print(\"dependency order:\")\n        print(\"\\n\".join(f\"  {index}: {name}\" for index, name in enumerate(order, 1)))\n        PY\n\n        echo \"eligible=true\" >> \"$GITHUB_OUTPUT\"\n        echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n        echo \"tag=$release_tag\" >> \"$GITHUB_OUTPUT\"\n        echo \"source_sha=$source_sha\" >> \"$GITHUB_OUTPUT\"\n        echo \"metadata_artifact=release-publish-metadata-${GITHUB_RUN_ID}\" >> \"$GITHUB_OUTPUT\"\n    - name: Upload release metadata\n      if: steps.resolve.outputs.eligible == 'true'\n      uses: actions/upload-artifact@v6\n      with:\n        name: ${{ steps.resolve.outputs.metadata_artifact }}\n        path: target/release-publish\n        if-no-files-found: error\n        retention-days: 30\n  publish:\n    name: Publish crates.io packages\n    needs: resolve\n    if: needs.resolve.outputs.eligible == 'true'\n    runs-on: ubuntu-latest\n    timeout-minutes: 120\n    environment: release\n    env:\n      CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}\n    steps:\n    - name: Checkout candidate commit\n      uses: actions/checkout@v5\n      with:\n        ref: ${{ needs.resolve.outputs.source_sha }}\n        fetch-depth: 0\n    - name: Install Rust\n      uses: dtolnay/rust-toolchain@stable\n    - name: Download release metadata\n      uses: actions/download-artifact@v8\n      with:\n        name: ${{ needs.resolve.outputs.metadata_artifact }}\n        path: target/release-publish\n    - name: Publish