able(path):\n        try:\n            with open(path, 'rb') as stream:\n                stream.read(1)\n            return True\n        except OSError:\n            return False\n    machine = pathlib.Path('/etc/machine-id').read_bytes().strip()\n    sysctls = {}\n    for name in ('kernel.perf_event_paranoid', 'kernel.unprivileged_bpf_disabled', 'kernel.kptr_restrict', 'kernel.yama.ptrace_scope'):\n        try:\n            sysctls[name] = command('sysctl', '-n', name)\n        except subprocess.CalledProcessError as error:\n            sysctls[name] = f'unavailable:{error.returncode}'\n    value = {\n        'schema_version': 1,\n        'source_sha': os.environ['EXPECTED_SOURCE_SHA'],\n        'lease': {'owner': os.environ['HYDRACACHE_PERFORMANCE_LEASE_OWNER'], 'end': os.environ['HYDRACACHE_PERFORMANCE_LEASE_END']},\n        'host': {\n            'machine_id_sha256': hashlib.sha256(machine).hexdigest(),\n            'node': platform.node(), 'machine': platform.machine(), 'kernel': platform.release(),\n            'cpu_count': os.cpu_count(),\n        },\n        'toolchain': {\n            'rustc': command('rustc', '--version'), 'cargo': command('cargo', '--version'),\n            'strace': command('strace', '--version').splitlines()[0], 'ss': command('ss', '--version'),\n        },\n        'kernel_controls': sysctls,\n        'tracefs_syscall_events_readable': readable('/sys/kernel/tracing/events/syscalls'),\n        'debugfs_syscall_events_readable': readable('/sys/kernel/debug/tracing/events/syscalls'),\n    }\n    pathlib.Path(sys.argv[1]).write_text(json.dumps(value, indent=2, sort_keys=True) + '\\n')\n    PY\n- name: Build exact RESP attribution profiler\n  timeout-minutes: 30\n  shell: bash\n  run: |\n    set -euo pipefail\n    CARGO_TARGET_DIR=target/w9c-kernel-build cargo build \\\n      --manifest-path tools/resp-pipeline-profile-074/Cargo.toml \\\n      --release --locked\n- name: Run counterbalanced syscall attribution\n  shell: bash\n  run: |\n   