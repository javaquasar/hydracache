d tamper tests\n      working-directory: tooling\n      run: node --test scripts/management/capture-baseline-072.test.mjs\n    - name: Capture pre-feature baseline\n      working-directory: tooling\n      run: node scripts/management/capture-baseline-072.mjs --baseline pre_feature --source-root ../baseline-pre-feature --candidate-root ../candidate --output ../candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json\n    - name: Capture published v0.71.0 baseline\n      working-directory: tooling\n      run: node scripts/management/capture-baseline-072.mjs --baseline published_previous --source-root ../baseline-v071 --candidate-root ../candidate --output ../candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json\n    - name: Refuse candidate or source mutation\n      run: |\n        test \"$(git -C candidate rev-parse HEAD)\" = \"$CANDIDATE_SHA\"\n        test -z \"$(git -C candidate status --porcelain --untracked-files=normal)\"\n        test -z \"$(git -C baseline-pre-feature status --porcelain --untracked-files=normal)\"\n        test -z \"$(git -C baseline-v071 status --porcelain --untracked-files=normal)\"\n    - name: Upload immutable baseline evidence\n      uses: actions/upload-artifact@v6\n      with:\n        name: management-baselines-072-${{ env.CANDIDATE_SHA }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: |\n          candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json\n          candidate/target/release-evidence/management-center/0.72/pre-feature-baseline.json.raw.json\n          candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json\n          candidate/target/release-evidence/management-center/0.72/v0.71-baseline.json.raw.json\n        if-no-files-found: error\n        retention-days: 90\n"
