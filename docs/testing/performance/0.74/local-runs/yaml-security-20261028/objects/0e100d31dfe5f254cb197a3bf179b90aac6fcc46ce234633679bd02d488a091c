ight\n    - name: Provision reviewed files, identities, and service\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n        REPOSITORY_ID: ${{ github.repository_id }}\n        ACTOR_ID: ${{ github.actor_id }}\n      run: |\n        set -euo pipefail\n        bundle=$(realpath target/host-provisioning-074)\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 \\\n          --bundle-dir \"$bundle\" \\\n          --source-commit \"$INPUT_SOURCE_SHA\" \\\n          --repository-id \"$REPOSITORY_ID\" \\\n          --actor-id \"$ACTOR_ID\" \\\n          --runner-user \"$(id -un)\" \\\n          --runner-uid \"$(id -u)\" \\\n          --runner-gid \"$(id -g)\"\n    - name: Collect post-provisioning receipts without qualification\n      shell: bash\n      env:\n        INPUT_SOURCE_SHA: ${{ inputs.source_sha }}\n      run: |\n        set -euo pipefail\n        evidence=target/performance-evidence/0.74/reference/w11-host-provisioning\n        mkdir -p \"$evidence\"\n        umask 077\n        sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \\\n          > \"$evidence/provisioning.json\"\n        python3 scripts/perf/performance_long_run_host_capability_074.py \\\n          --source-commit \"$INPUT_SOURCE_SHA\" \\\n          --output \"$evidence/capability-after.json\"\n        python3 -m json.tool \"$evidence/provisioning.json\" >/dev/null\n        python3 -m json.tool \"$evidence/capability-after.json\" >/dev/null\n    - name: Retain provisioning and post-install capability receipts\n      if: always()\n      uses: actions/upload-artifact@v6\n      with:\n        name: performance-long-run-host-provisioning-074-${{ inputs.source_sha }}-${{ github.run_id }}-${{ github.run_attempt }}\n        path: target/performance-evidence/0.74/reference/w11-host-provisioning/**\n        if-no-files-found: warn\n        retention-days: 90\n"
