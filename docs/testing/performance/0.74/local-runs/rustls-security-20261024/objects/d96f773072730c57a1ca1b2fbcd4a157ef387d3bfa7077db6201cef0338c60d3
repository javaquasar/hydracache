//! Public-API security regression; no fixture session secrets are logged.
use rcgen::{BasicConstraints, CertificateParams, CertifiedIssuer, IsCa, KeyPair};
use rustls::{
    client::{
        ClientSessionMemoryCache, ClientSessionStore, Resumption, Tls12ClientSessionValue,
        Tls13ClientSessionValue,
    },
    pki_types::{PrivateKeyDer, PrivatePkcs8KeyDer, ServerName},
    ClientConfig, ClientConnection, HandshakeKind, NamedGroup, RootCertStore, ServerConfig,
    ServerConnection, SupportedProtocolVersion,
};
use std::{
    io::{Cursor, Read, Write},
    sync::{Arc, Mutex},
};

#[derive(Debug, Default)]
struct Evidence {
    tls12: usize,
    tls13: usize,
    unsafe_debug: usize,
}

#[derive(Debug)]
struct SessionProbe {
    cache: ClientSessionMemoryCache,
    evidence: Mutex<Evidence>,
}

// Inspect only the secret field's redaction marker, never store or print the
// session's Debug string. An omitted field is also safe. Compact and pretty
// formatting are checked independently at each actual insertion.
fn redacts_secret_fields(debug: &str) -> bool {
    for field in ["secret:", "master_secret:"] {
        for (offset, marker) in debug.match_indices(field) {
            let value = debug[offset + marker.len()..].trim_start();
            if !value.starts_with("\"[redacted]\"") && !value.starts_with("[redacted]") {
                return false;
            }
        }
    }
    true
}

impl SessionProbe {
    fn record(&self, value: &impl std::fmt::Debug, tls12: bool) {
        let compact = format!("{value:?}");
        let pretty = format!("{value:#?}");
        let kind = if tls12 {
            "Tls12ClientSessionValue"
        } else {
            "Tls13ClientSessionValue"
        };
        let safe = compact.starts_with(kind)
            && pretty.starts_with(kind)
            && redacts_secret_fields(&compact)
            && redacts_secret_fields(&pretty);
        let mut evidence = self.evidence.lock().unwrap();
        evidence.tls12 += usize::from(tls12);
        evidence.tls13 += usize::from(!tls12);
        evidence.unsafe_debug += usize::from(!safe);
    }
}

impl ClientSessionStore for SessionProbe {
    fn set_kx_hint(&self, name: ServerName<'static>, group: NamedGroup) {
        self.cache.set_kx_hint(name, group);
    }
    fn kx_hint(&self, name: &ServerName<'_>) -> Option<NamedGroup> {
        self.cache.kx_hint(name)
    }
    fn set_tls12_session(&self, name: ServerName<'static>, value: Tls12ClientSessionValue) {
        self.record(&value, true);
        self.cache.set_tls12_session(name, value);
    }
    fn tls12_session(&self, name: &ServerName<'_>) -> Option<Tls12ClientSessionValue> {
        self.cache.tls12_session(name)
    }
    fn remove_tls12_session(&self, name: &ServerName<'static>) {
        self.cache.remove_tls12_session(name);
    }
    fn insert_tls13_ticket(&self, name: ServerName<'static>, value: Tls13ClientSessionValue) {
        self.record(&value, false);
        self.cache.insert_tls13_ticket(name, value);
    }
    fn take_tls13_ticket(&self, name: &ServerName<'static>) -> Option<Tls13ClientSessionValue> {
        self.cache.take_tls13_ticket(name)
    }
}

fn pump(client: &mut ClientConnection, server: &mut ServerConnection) {
    for _ in 0..64 {
        let mut progressed = false;
        if client.wants_write() {
            let mut wire = Vec::new();
            client.write_tls(&mut wire).unwrap();
            let mut input = Cursor::new(wire);
            while input.position() < input.get_ref().len() as u64 {
                assert!(server.read_tls(&mut input).unwrap() > 0);
                server.process_new_packets().unwrap();
            }
            progressed = true;
        }
        if server.wants_write() {
            let mut wire = Vec::new();
            server.write_tls(&mut wire).unwrap();
            let mut input = Cursor::new(wire);
            while input.position() < input.get_ref().len() as u64 {
                assert!(client.read_tls(&mut input).unwrap() > 0);
                client.process_new_packets().unwrap();
            }
            progressed = true;
        }
        if !progressed {
            assert!(!client.is_handshaking() && !server.is_handshaking());
            return;
        }
    }
    panic!("in-memory TLS exchange exceeded its finite round bound");
}

fn session_control(version: &'static SupportedProtocolVersion, tls12: bool) {
    let mut ca_params = CertificateParams::new(Vec::<String>::new()).unwrap();
    ca_params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
    let ca = CertifiedIssuer::self_signed(ca_params, KeyPair::generate().unwrap()).unwrap();
    let key = KeyPair::generate().unwrap();
    let cert = CertificateParams::new(vec!["localhost".to_owned()])
        .unwrap()
        .signed_by(&key, &ca)
        .unwrap();
    let mut roots = RootCertStore::empty();
    roots.add(ca.der().clone()).unwrap();
    let provider = Arc::new(rustls::crypto::aws_lc_rs::default_provider());
    let probe = Arc::new(SessionProbe {
        cache: ClientSessionMemoryCache::new(4),
        evidence: Mutex::new(Evidence::default()),
    });
    let mut config = ClientConfig::builder_with_provider(Arc::clone(&provider))
        .with_protocol_versions(&[version])
        .unwrap()
        .with_root_certificates(roots)
        .with_no_client_auth();
    config.resumption = Resumption::store(probe.clone());
    let config = Arc::new(config);
    let server = Arc::new(
        ServerConfig::builder_with_provider(provider)
            .with_protocol_versions(&[version])
            .unwrap()
            .with_no_client_auth()
            .with_single_cert(
                vec![cert.der().clone()],
                PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der())),
            )
            .unwrap(),
    );
    for resumed in [false, true] {
        let mut client = ClientConnection::new(
            Arc::clone(&config),
            ServerName::try_from("localhost").unwrap(),
        )
        .unwrap();
        let mut server = ServerConnection::new(Arc::clone(&server)).unwrap();
        pump(&mut client, &mut server);
        assert_eq!(client.protocol_version(), Some(version.version));
        assert_eq!(
            client.handshake_kind(),
            Some(if resumed {
                HandshakeKind::Resumed
            } else {
                HandshakeKind::Full
            })
        );
        assert_eq!(server.handshake_kind(), client.handshake_kind());
        client.writer().write_all(b"\0\xffsession-control").unwrap();
        pump(&mut client, &mut server);
        let mut bytes = [0; 17];
        server.reader().read_exact(&mut bytes).unwrap();
        assert_eq!(&bytes, b"\0\xffsession-control");
    }
    let evidence = probe.evidence.lock().unwrap();
    assert!(if tls12 {
        evidence.tls12 > 0 && evidence.tls13 == 0
    } else {
        evidence.tls13 > 0 && evidence.tls12 == 0
    });
    assert_eq!(
        evidence.unsafe_debug, 0,
        "session Debug exposed a secret field; values deliberately not logged"
    );
}

#[test]
fn tls12_session_debug_redacts_secrets_without_breaking_resumption() {
    session_control(&rustls::version::TLS12, true);
}

#[test]
fn tls13_session_debug_redacts_secrets_without_breaking_resumption() {
    session_control(&rustls::version::TLS13, false);
}

#[test]
fn debug_oracle_rejects_payloads_and_accepts_only_absent_or_redacted_secrets() {
    for bad in [
        "secret: Zeroizing(PayloadU8([1, 2]))",
        "secret: [1, 2]",
        "master_secret: [1, 2]",
        "secret: \"[redacted]\", secret: [3]",
    ] {
        assert!(!redacts_secret_fields(bad));
    }
    for good in [
        "Tls12ClientSessionValue { suite: X, .. }",
        "secret: \"[redacted]\"",
        "master_secret: [redacted]",
    ] {
        assert!(redacts_secret_fields(good));
    }
}
