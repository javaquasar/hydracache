"""Data-only evidence verification, never imports or runs retained source."""
import hashlib
import json
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parent.parent
folder = root / 'docs/testing/performance/0.74/local-runs/frontier-current-view-20261027'
raw_index = (folder / 'index.json').read_bytes()
index = json.loads(raw_index)
assert index['schema'] == 'hc074-frontier-current-view-evidence-v1'
assert index['package_pass'] is False and index['release_admitted'] is False
digests = set()
for name, row in index['members'].items():
    assert name and not name.startswith('/') and '..' not in Path(name).parts
    digest = row['sha256']
    assert len(digest) == 64 and all(c in '0123456789abcdef' for c in digest)
    path = folder / 'objects' / digest
    raw = path.read_bytes()
    assert len(raw) == row['bytes'] and hashlib.sha256(raw).hexdigest() == digest
    relative = path.relative_to(root).as_posix()
    staged = subprocess.check_output(['git', 'show', ':' + relative], cwd=root, timeout=10)
    assert staged == raw
    digests.add(digest)
assert digests == {p.name for p in (folder / 'objects').iterdir()}
relative = (folder / 'index.json').relative_to(root).as_posix()
assert subprocess.check_output(['git', 'show', ':' + relative], cwd=root, timeout=10) == raw_index
print(json.dumps(dict(members=len(index['members']), objects=len(digests),
    index_sha256=hashlib.sha256(raw_index).hexdigest(), data_and_staged_blobs_exact=True,
    archived_source_executed=False, package_pass=False)))
