"""Read the existing protected attempt only; never launches or repairs it."""
import base64
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(r'C:\Workspace\prj\jq\cashe\hydracache-074')
sys.path.insert(0, str(ROOT / 'tools/wsl-clock-trace-074'))
import run as b
OUT = ROOT / 'target/linux-clock-control-20261023'
remote = json.loads((OUT / 'holder-remote.json').read_bytes())['path']
if not re.fullmatch(r'/tmp/hc074-native-held-root-20261023\.[A-Za-z0-9]{6}', remote):
    raise ValueError('Unexpected protected path')
label = 'holder-inspect-' + sys.argv[1]
if not re.fullmatch('holder-inspect-[0-9]{2}', label):
    raise ValueError('Reader label')
names = ['preflight.log', 'postflight.log', 'matrix.log', 'matrix.exit', 'wrapper.exit',
         'postflight.exit', 'mountinfo-before.log', 'mountinfo-after.log', 'inputs.sha256',
         'holder-session.sh', 'wrapper.log']
code = f'''import base64,hashlib,json,os,pathlib,re,stat
root=pathlib.Path({remote!r})
s=root.lstat()
if not stat.S_ISDIR(s.st_mode) or s.st_uid!=0 or stat.S_IMODE(s.st_mode)!=0o700:
 raise ValueError('Protected directory drift')
names={names!r}
log=(root/'wrapper.log').read_text()
footer=re.search(r'^HC074_NATIVE_HOLDER exit=([0-9]+) postflight_exit=([0-9]+) server=true product=false$',log,re.M)
files={{}}
if footer:
 for name in names:
  p=root/name
  if not p.exists(): continue
  if not stat.S_ISREG(p.lstat().st_mode) or p.stat().st_size>32*1024*1024:
   raise ValueError('Unexpected export member')
  raw=p.read_bytes()
  files[name]={{'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'base64':base64.b64encode(raw).decode()}}
print(json.dumps({{'state':'complete' if footer else 'running','files':files,'retry':False,'server':True,'product':False}}))
'''.encode()
argv = ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o',
        'ConnectTimeout=15', 'hydracache-ax42', 'sudo', '-n', 'python3', '-']
b.put(OUT / (label + '-intent.json'), {'argv': argv, 'script_sha256': b.digest(code), 'read_only': True, 'retry': False})
with (OUT / (label + '.stdout.log')).open('xb') as stdout, (OUT / (label + '.stderr.log')).open('xb') as stderr:
    result = subprocess.run(argv, input=code, stdout=stdout, stderr=stderr, timeout=60, check=False)
b.put(OUT / (label + '-result.json'), {'exit': result.returncode, 'read_only': True, 'retry': False})
if result.returncode:
    raise SystemExit(result.returncode)
response = json.loads((OUT / (label + '.stdout.log')).read_bytes())
if response['state'] != 'complete':
    print('Existing holder attempt is still running; no resubmit')
    raise SystemExit(0)
destination = OUT / 'holder-download'
destination.mkdir()
for name, entry in response['files'].items():
    if name not in names:
        raise ValueError('Unexpected export name')
    raw = base64.b64decode(entry['base64'], validate=True)
    if b.digest(raw) != entry['sha256'] or len(raw) != entry['bytes']:
        raise ValueError('Export bytes changed')
    with (destination / name).open('xb') as stream:
        stream.write(raw)
matrix = (destination / 'matrix.log').read_text()
cases = re.findall(r'^HC074-HELD-LIVE case=([^ ]+) seed=0x074c051e actual_fixed=true actual_consuming=true', matrix, re.M)
summary = {'wrapper_exit': int((destination / 'wrapper.exit').read_text()),
           'matrix_exit': int((destination / 'matrix.exit').read_text()),
           'postflight_exit': int((destination / 'postflight.exit').read_text()),
           'successful_cases': cases, 'libtest_success_summaries': matrix.count('test result: ok. 1 passed; 0 failed; 0 ignored;'),
           'original_observation_reports': matrix.count('HC074-HELD-LIVE-ORIGINAL '),
           'mount_table_unchanged': (destination / 'mountinfo-before.log').read_bytes() == (destination / 'mountinfo-after.log').read_bytes(),
           'server': True, 'product': False, 'original_send': False, 'admission': False, 'retry': False}
b.put(OUT / 'holder-analysis.json', summary)
print(json.dumps(summary, indent=2))
print(matrix[-10000:])
