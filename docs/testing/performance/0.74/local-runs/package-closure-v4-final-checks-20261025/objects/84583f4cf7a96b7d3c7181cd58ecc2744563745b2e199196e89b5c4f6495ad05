"""Preserve final local checks, including the unsuppressed Windows fmt refusal."""
from pathlib import Path
import hashlib
import json

root = Path(__file__).resolve().parent.parent
members, objects = {}, {}
labels = {'package-closure-v4-doc-check-first': 0,
          'package-closure-v4-contract-check-first': 0,
          'package-closure-v4-fmt-check-first': 1,
          'package-closure-v4-xtask-fmt-first': 0,
          'package-closure-v4-reader-final': 0}
for label, expected in labels.items():
    folder = root/'target/source-continuation-20261024'/label
    result = json.loads((folder/'result.json').read_bytes())
    assert result['exit'] == expected and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged']
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        raw = path.read_bytes()
        digest = hashlib.sha256(raw).hexdigest()
        members[label+'/'+path.name] = dict(sha256=digest, bytes=len(raw))
        objects[digest] = raw
raw = Path(__file__).read_bytes()
digest = hashlib.sha256(raw).hexdigest()
members['retainer-source.py'] = dict(sha256=digest, bytes=len(raw))
objects[digest] = raw
out = root/'docs/testing/performance/0.74/local-runs/package-closure-v4-final-checks-20261025'
out.mkdir(exist_ok=False)
(out/'objects').mkdir()
for digest, raw in objects.items():
    with (out/'objects'/digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-package-closure-v4-final-checks-v1', members=members,
             expected_exit=labels, full_workspace_format_pass=False,
             full_package_pass=False, qualification=False, source_or_deadline_changed=False)
with (out/'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, indent=2, sort_keys=True)
    stream.write('\n')
print(json.dumps(dict(members=len(members), index_sha256=hashlib.sha256((out/'index.json').read_bytes()).hexdigest())))
