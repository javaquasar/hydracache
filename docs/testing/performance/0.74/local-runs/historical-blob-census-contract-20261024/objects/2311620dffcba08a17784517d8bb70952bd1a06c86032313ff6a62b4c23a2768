"""Retain each first fault-control source before checks, without runtime admission."""
from pathlib import Path
import hashlib
import json
import os
import runpy
import sys

root = Path(__file__).resolve().parent.parent
label = sys.argv[1]
if not label.replace('-', '').isalnum():
    raise SystemExit('invalid label')
out = root / 'target/blob-fault-source-snapshots-20261024' / label
out.mkdir(parents=True, exist_ok=False)
sources = [*sorted((root / 'tools/historical-blob-batch-074').glob('*.py')),
           *sorted((root / 'tools/historical-blob-batch-074').glob('*.rs')),
           *sorted((root / 'crates/xtask/tests').glob('historical_blob*_074.rs'))]
index = {}
for path in sources:
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    (out / digest).write_bytes(raw)
    index[str(path.relative_to(root)).replace('\\', '/')] = digest
(out / 'index.json').write_text(json.dumps(index, indent=2) + '\n')
os.environ['HC074_BLOB_TRANSPORT_EVIDENCE'] = str(root / 'target/blob-fault-20261024' / label)
runpy.run_path(str(root / 'target/run-fresh-reader-20261024.py'), run_name='__main__')
