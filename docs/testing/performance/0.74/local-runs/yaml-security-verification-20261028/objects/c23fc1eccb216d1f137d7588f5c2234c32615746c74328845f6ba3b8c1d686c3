"""Independent inert byte/coverage audit; never execute archived code or cases."""
from pathlib import Path
import hashlib,json,sys
ROOT=Path(__file__).resolve().parent.parent
PACKET=ROOT/'docs/testing/performance/0.74/local-runs/yaml-security-20261028'
out=ROOT/'target/yaml-verification-20261028';out.mkdir(exist_ok=False)
def sha(raw):return hashlib.sha256(raw).hexdigest()
def write(name,value):(out/name).write_text(json.dumps(value,indent=2,sort_keys=True)+'\n',encoding='utf-8')
write('intent.json',dict(expected_index_sha256=sys.argv[1],source_sha256=sha(Path(__file__).read_bytes()),read_only=True,gate_replayed=False))
(out/'producer.py').write_bytes(Path(__file__).read_bytes())
try:
 raw=(PACKET/'index.json').read_bytes();assert sha(raw)==sys.argv[1]
 index=json.loads(raw);members=index['members'];objects=set()
 for name,row in members.items():
  assert not name.startswith('/') and '..' not in Path(name).parts
  assert set(row)=={'bytes','sha256'} and len(row['sha256'])==64
  path=PACKET/'objects'/row['sha256']
  assert path.is_file() and not path.is_symlink() and not path.is_junction()
  body=path.read_bytes();assert len(body)==row['bytes'] and sha(body)==row['sha256']
  objects.add(row['sha256'])
 assert objects=={p.name for p in (PACKET/'objects').iterdir()}
 def body(name):return (PACKET/'objects'/members[name]['sha256']).read_bytes()
 def load(name):return json.loads(body('capture/'+name))
 for name in ('compare.py','recording.py'):
  source=ROOT/'tools/yaml-parser-review-074'/name
  assert sha(source.read_bytes())==members['source/current/tools/yaml-parser-review-074/'+name]['sha256']
 sys.path.insert(0,str(ROOT/'tools/yaml-parser-review-074'))
 import compare,recording
 corpus=body('capture/preparation/cases.jsonl');cases=list(map(json.loads,corpus.splitlines()))
 assert sha(corpus)=='6e0ca0eb52841f74600a386923898f3da07b770ce7699ca853ed3618a324c78c'
 records={}
 for mode in ('baseline','candidate'):
  first=load('record-recovery/'+mode+'.json');last=load('semantics-'+mode+'-continuation/result.json')
  assert len(first['cases'])==last['first_ordinal']==55 and len(last['cases'])==47
  assert load('probe-'+mode+'/result.json')['exit']==1
  rows=first['cases']+last['cases']
  for i,(case,row) in enumerate(zip(cases,rows)):
   folder='capture/semantics-'+mode+('' if i<55 else '-continuation')+f'/{i:04d}/'
   if i<55:
    recovered=recording.recover(case['id'],body(folder+'result.json'),body(folder+'stdout.log'),body(folder+'stderr.log'))
    assert row==recovered
   else:
    assert row==json.loads(body(folder+'result.json'))
    assert row['value']==json.loads(body(folder+'stdout.log')) and not body(folder+'stderr.log')
   assert row['id']==case['id']
  assert len(rows)==102 and len({r['id'] for r in rows})==102
  records[mode]=rows
 result=compare.compare(cases,records['baseline'],records['candidate'])
 assert result['semantic_contract_pass'] and not result['diagnostic_review_required']
 assert load('workspace/frame-before.json')==load('workspace/frame-after.json')
 assert load('workspace/controller.json')['execution']['retired']
 write('result.json',dict(verified=True,index_sha256=sha(raw),members=len(members),objects=len(objects),
  cases_per_parser=102,executed_case_retries=0,raw_native_records_verified=True,archived_code_executed=False,
  gate_replayed=False,workspace_pass=False,release_admitted=False))
 print(json.dumps(dict(verified=True,members=len(members),objects=len(objects))))
except BaseException as error:
 write('refusal.json',dict(type=type(error).__name__,reason=str(error),verified=False));raise
