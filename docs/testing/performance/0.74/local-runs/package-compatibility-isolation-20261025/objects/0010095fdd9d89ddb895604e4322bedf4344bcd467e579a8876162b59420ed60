"""Retain exact frozen-source restoration and focused outcomes, not package pass."""
from pathlib import Path
import hashlib
import json
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BASE = ROOT/'docs/testing/performance/0.74/local-runs/package-compatibility-isolation-20261025'
sys.path.insert(0, str(ROOT/'tools/xtask-package-attribution-074'))
import helper_capture
import review

def sha(raw): return hashlib.sha256(raw).hexdigest()
def normalized(raw): return raw.decode().replace('\r\n', '\n')
def git(*argv): return subprocess.check_output(['git', '--no-replace-objects', *argv], cwd=ROOT)

code = sys.argv[1]
assert re.fullmatch('[0-9a-f]{40}', code) and git('rev-parse', 'HEAD').decode().strip() == code
members, objects = {}, {}
def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw
def tree(folder, prefix):
    for path in sorted(folder.iterdir()):
        if path.is_file(): add(prefix+'/'+path.name, path.read_bytes())

upstream = {
    'docs/testing/performance/0.74/local-runs/transport-package-20261025/index.json':
        'e9b8a923723360bce644c9de558113bf084630d1c4a72916dd0bfd3d418fc553',
    'docs/testing/performance/0.74/local-runs/package-effect-review-v2-20261025/index.json':
        '58b7a5f845abd8e791b5d150f98f461fc069869195131fe3e76ea620df772dae',
    'docs/testing/performance/0.74/local-runs/preservation-helper-spans-20261025/index.json':
        'f239630ed26fc19beae9ab4163a59e4807747307b81293e859ef6499208b8b99',
    'docs/testing/performance/0.74/local-runs/guard-path-comparison-20261025/index.json':
        'a22199ba4dfda1dfb9f57a21f5785061313fde68cb77cdabfa69d649ec5fcbae',
}
for name, digest in upstream.items(): assert sha((ROOT/name).read_bytes()) == digest
old_folder = ROOT/'docs/testing/performance/0.74/local-runs/transport-package-20261025'
old_index = json.loads((old_folder/'index.json').read_bytes())
v2_folder = ROOT/'docs/testing/performance/0.74/local-runs/package-effect-review-v2-20261025'
v2_index = json.loads((v2_folder/'index.json').read_bytes())
restored = [
    'crates/xtask/tests/authority_context_074.rs',
    'crates/xtask/tests/diagnostic_artifact_fixture_074.rs',
    'crates/xtask/tests/support/performance_contract_074_fixed_slice.rs',
    'tools/authority-runtime-074/gate.rs',
]
for name in restored:
    current = (ROOT/name).read_bytes()
    old = review.member(old_folder, old_index, 'reviewed-source/'+name)
    assert normalized(current) == normalized(old)
    add('restored-predecessor/'+name, old)

changed = git('diff', '--name-only', code+'^', code).decode().splitlines()
assert len(changed) == 9 and 'crates/xtask/tests/package_diagnostics_074.rs' in changed
for name in changed:
    raw = (ROOT/name).read_bytes()
    assert normalized(raw) == normalized(git('show', code+':'+name))
    add('changed-source/'+name, raw)

def cases(raw): return re.findall(r'(?m)^#\[test\]\nfn (\w+)\(', normalized(raw))
def bodies(raw):
    return {m[1]: m[0] for m in re.finditer(
        r'(?ms)^#\[test\]\nfn (\w+)\(.*?(?=^#\[test\]|^#\[path|\Z)', normalized(raw))}
authority = restored[0]
before = review.member(v2_folder, v2_index, 'reviewed-source/'+authority)
original = (ROOT/authority).read_bytes()
diagnostics = (ROOT/'crates/xtask/tests/package_diagnostics_074.rs').read_bytes()
assert len(cases(before)) == 18 and len(cases(original)) == 2 and len(cases(diagnostics)) == 16
old_bodies, new_bodies = bodies(before), bodies(diagnostics)
unchanged = sorted(name for name in new_bodies if name in old_bodies and new_bodies[name].strip() == old_bodies[name].strip())
alias_only = sorted(name for name in new_bodies if name in old_bodies and name not in unchanged
    and new_bodies[name].strip() == old_bodies[name].replace('runtime::guard_path::','guard_path::').strip())
assert len(unchanged) == 12 and len(alias_only) == 2
old_extra = set(cases(before)) - set(cases(original))
assert old_extra - set(cases(diagnostics)) == {'guard_path_comparison_current_source_is_one_exact_predicate_edit'}
assert set(cases(diagnostics)) - old_extra == {'guard_path_comparison_is_isolated_and_original_installation_stays_exact'}
migration = dict(restored_sources=restored, authority_before=18, authority_restored=2,
    diagnostic_cases=16, unchanged_diagnostic_bodies=unchanged, module_alias_only_bodies=alias_only,
    changed_cases=['helper_instrumentation_erases_only_exact_observers_and_preserves_twenty_cases',
                   'guard_path_comparison_is_isolated_and_original_installation_stays_exact'],
    observer_installed=False, path_candidate_installed=False, old_assertions_or_gates_weakened=False)
add('derived/migration.json', (json.dumps(migration, indent=2, sort_keys=True)+'\n').encode())

phases = []
checks = ROOT/'target/source-continuation-20261024'
for folder in sorted(checks.glob('compat-isolation-20261025-*')):
    intent = json.loads((folder/'intent.json').read_bytes())
    result = json.loads((folder/'result.json').read_bytes())
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged'] and intent['source'] == result['source_after']
    assert intent['head'] == 'f58915c15e124ac19e4f04450d6ef9ec400ac6a1'
    for name in changed: assert sha((ROOT/name).read_bytes()) == intent['source'][name]
    tree(folder, 'checks/'+folder.name)
    phases.append(dict(name=folder.name, exit=0, source_head=intent['head']))
assert len(phases) == 11

focused = ['artifact_inventory_reader_074', 'authority_context_074', 'authority_runtime_074',
    'authority_rust_history_074', 'current_tree_input_audit_074', 'current_tree_reader_074',
    'historical_source_cache_074', 'owned_case_074', 'package_diagnostics_074']
outcomes = {}
for phase, targets in [('focused', focused), ('msrv', focused), ('artifact', ['diagnostic_artifact_fixture_074'])]:
    folder = checks/('compat-isolation-20261025-'+phase)
    stdout, stderr = (folder/'stdout.log').read_text(), (folder/'stderr.log').read_text()
    actual = re.findall(r'(?m)^\s+Running tests[\\/](\w+)\.rs ', stderr)
    assert actual == targets
    chunks = [v for v in re.split(r'(?m)^(?=running \d+ tests?$)', stdout) if v.strip()]
    assert len(chunks) == len(targets)
    rows = {}
    for target, chunk in zip(targets, chunks):
        expected = cases((ROOT/('crates/xtask/tests/'+target+'.rs')).read_bytes())
        rows[target] = helper_capture.target_result(chunk.encode(), expected)
    assert sum(len(row['cases']) for row in rows.values()) == (20 if phase == 'artifact' else 54)
    outcomes[phase] = rows
assert outcomes['focused'].keys() == outcomes['msrv'].keys()
for target in focused: assert set(outcomes['focused'][target]['cases']) == set(outcomes['msrv'][target]['cases'])
for phase, count in [('python-history',82),('python-attribution',54)]:
    raw = (checks/('compat-isolation-20261025-'+phase)/'stderr.log').read_text()
    assert re.search(r'Ran '+str(count)+r' tests in [0-9.]+s\s+OK\s*\Z',raw)
add('derived/focused-outcomes.json', (json.dumps(outcomes,indent=2,sort_keys=True)+'\n').encode())
protected = {
    'Cargo.toml':'18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock':'d2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml':'11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
    'tools/authority-storage-source-074/contract.rs':'aefcd4f6a9ed0acc1e072225ea3ed4dda82d2d1ccda0ba4f22ca74459efa64c2',
}
for name, digest in protected.items():
    raw=(ROOT/name).read_bytes(); assert sha(raw)==digest; add('protected/'+name,raw)
for name in ['run-fresh-reader-20261024.py','run-source-step-20261024.py',
             'seal-compat-isolation-20261025.py','verify-compat-isolation-staged-20261025.py']:
    add('retention-coordinators/'+name,(ROOT/'target'/name).read_bytes())
index = dict(schema='hc074-package-compatibility-isolation-evidence-v1',code_commit=code,
    members=members,upstream_indexes=upstream,phases=phases,protected_sha256=protected,
    focused_cases_per_compiler=54,artifact_cases=20,historical_python_cases=82,attribution_python_cases=54,
    full_package_repeated=False,full_package_pass=False,performance_candidate_accepted=False,
    old_v2_review_not_refreshed=True,original_checks_order_frequency_and_windows_changed=False,
    dependencies_changed=False,server=False,services=False,clocks=False,qualification=False,admission=False)
BASE.mkdir(exist_ok=False); (BASE/'objects').mkdir()
for digest, raw in objects.items(): (BASE/'objects'/digest).write_bytes(raw)
(BASE/'index.json').write_bytes((json.dumps(index,indent=2,sort_keys=True)+'\n').encode())
(BASE/'.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps(dict(index_sha256=sha((BASE/'index.json').read_bytes()),members=len(members),objects=len(objects),phases=len(phases)),indent=2))
