+    cctx.wait_for_workers().unwrap();
+    cctx.load_dictionary(b"another").unwrap();
+    cctx.set_parameter(CParameter::NbWorkers(4)).unwrap();
+    cctx.reset(ResetDirective::SessionAndParameters).unwrap();
