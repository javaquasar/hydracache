+        let mut decoder = zstd::Decoder::with_prepared_dictionary(
+            compressed.as_slice(),
+            &prepared,
+        )
+        .expect("decoder");
+        decoder
+            .read_to_end(&mut roundtrip)
+            .expect("decompression failed");
