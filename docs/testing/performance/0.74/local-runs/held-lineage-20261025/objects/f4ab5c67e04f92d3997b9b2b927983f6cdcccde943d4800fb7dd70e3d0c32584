"""Seal one finite synthetic lineage session; no producer invocation."""
from pathlib import Path
import hashlib
import json
import sys

root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(root / 'tools/xtask-package-attribution-074'))
from owned_process_observer import validate

base = root / 'docs/testing/performance/0.74/local-runs/held-lineage-20261025'
members, objects, intents = {}, {}, {}

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

phases = [('lineage-model-first-20261025', 0), ('lineage-model-complete-first-20261025', 1),
          ('lineage-model-final-20261025', 0), ('lineage-native-first-20261025', 0)]
for label, expected in phases:
    folder = root / 'target/source-continuation-20261024' / label
    before = json.loads((folder / 'intent.json').read_bytes())
    after = json.loads((folder / 'result.json').read_bytes())
    assert after['exit'] == expected and after['outer_refusal'] is None
    assert after['source_unchanged'] and after['head_unchanged']
    assert before['source'] == after['source_after']
    intents[label] = before
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())

native = root / 'target/lineage-native-first-20261025'
result = json.loads((native / 'result.json').read_bytes())
schedule = [('two-level', 2), ('three-level', 3), ('wrong-path', 2)]
assert result['passed'] and result['results'] == [dict(label=name, passed=True) for name, _ in schedule]
for name, depth in schedule:
    case = json.loads((native / name / 'result.json').read_bytes())
    assert case['passed'] and case['exit_code'] == 0 and not case['cleanup_errors']
    assert not case['cargo_dispatch'] and not case['product_admission']
    if name == 'wrong-path':
        assert case['refusal'] == case['expected_refusal'] == 'held lineage image/PID mismatch'
        assert case['identities'] == case['samples'] == []
    else:
        assert case['refusal'] is None and len(case['identities']) == depth + 1
        births = [row['creation_100ns'] for row in case['identities']]
        assert births == sorted(births) and len({row['pid'] for row in case['identities']}) == depth + 1
        assert len(case['samples']) == 2 and case['samples'][-1]['terminal']
        assert case['samples'][-1]['creation_100ns'] == births[-1]
        validate(case['samples'][0], case['samples'][1])
    validate(case['root_samples'][0], case['root_samples'][1])
    assert case['root_samples'][-1]['terminal']
    assert sorted((native / name / 'stdout.log').read_text().splitlines()) == [f'node-{i}-complete' for i in range(depth + 1)]
    assert not (native / name / 'stderr.log').read_bytes()
for path in sorted(native.rglob('*')):
    if path.is_file():
        add('native/' + path.relative_to(native).as_posix(), path.read_bytes())

folder = root / 'tools/xtask-package-attribution-074'
for name in ('process_lineage.py', 'lineage_control.py', 'test_process_lineage.py', 'test_lineage_control.py'):
    raw = (folder / name).read_bytes()
    relative = 'tools/xtask-package-attribution-074/' + name
    assert sha(raw) == intents['lineage-model-final-20261025']['source'][relative]
    if not name.startswith('test_'):
        assert sha(raw) == intents['lineage-native-first-20261025']['source'][relative]
    add('code/final-' + name, raw)

bad = (folder / 'test_lineage_control.py').read_text().replace(
    'control.assert_called_once_with(out.resolve() / "two-level", 2, False)',
    'control.assert_called_once_with(out / "two-level", 2, False)').encode()
assert sha(bad) == intents['lineage-model-complete-first-20261025']['source']['tools/xtask-package-attribution-074/test_lineage_control.py']
add('code/first-test_lineage_control.py', bad)
old = (folder / 'test_process_lineage.py').read_text()
begin, end = old.index('    def test_unusable_root_rejected_before_snapshot'), old.index('    def test_wrong_full_image_rejects_matching_basename')
old = (old[:begin] + old[end:]).encode()
assert sha(old) == intents['lineage-model-first-20261025']['source']['tools/xtask-package-attribution-074/test_process_lineage.py']
add('code/first-test_process_lineage.py', old)
add('code/owned_process_observer.py', (folder / 'owned_process_observer.py').read_bytes())
assert b'Ran 111 tests' in objects[members['checks/lineage-model-final-20261025/stderr.log']['sha256']]
assert b'FAILED (failures=1)' in objects[members['checks/lineage-model-complete-first-20261025/stderr.log']['sha256']]
protected = {
    'Cargo.toml': '18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock': 'd2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml': '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
    'tools/authority-storage-source-074/contract.rs': 'aefcd4f6a9ed0acc1e072225ea3ed4dda82d2d1ccda0ba4f22ca74459efa64c2'}
for name, expected in protected.items():
    raw = (root / name).read_bytes()
    assert sha(raw) == expected
    add('protected/' + name, raw)
add('retention/seal-held-lineage-20261025.py', Path(__file__).read_bytes())
index = dict(schema='hc074-held-lineage-controls-v1', members=members, protected_sha256=protected,
             upstream_index_sha256='9812d360f72d9a1ddfd000dbed77353eeffa7520525c8e106f38af3c0f3a03ac',
             phases=[dict(label=name, expected_exit=code) for name, code in phases],
             attribution_python_cases=111, added_python_cases=28, native_sessions=1, native_cases=3,
             first_model_failure_retained=True, native_session_repeated=False,
             cargo_dispatch=False, original_owner_admitted=False, full_package_pass=False,
             live_checks_or_windows_changed=False, server=False, clocks=False, services=False,
             qualification=False, admission=False)
base.mkdir(exist_ok=False)
(base / 'objects').mkdir()
for digest, raw in objects.items():
    (base / 'objects' / digest).write_bytes(raw)
(base / 'index.json').write_bytes((json.dumps(index, indent=2, sort_keys=True) + '\n').encode())
(base / '.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps(dict(index_sha256=sha((base / 'index.json').read_bytes()), members=len(members), objects=len(objects))))
