[package]
name = "hydracache-long-run-supervisor-074"
version = "0.0.0"
edition.workspace = true
license.workspace = true
publish = false
default-run = "hydracache-long-run-supervisor-074"

[features]
fixed-leaf-alloc-probe = []

[dependencies]
ed25519-dalek.workspace = true
fs2.workspace = true
serde.workspace = true
serde_json.workspace = true
sha2.workspace = true
tar = "0.4.44"
thiserror.workspace = true
toml.workspace = true
zstd = "0.13.3"

[dev-dependencies]
tempfile = "3"

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61", features = ["Win32_Storage_FileSystem"] }

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[target.'cfg(target_os = "linux")'.dependencies]
base64.workspace = true
tokio.workspace = true
ring = { version = "=0.17.14", default-features = false, features = ["alloc"] }

[target.'cfg(target_os = "linux")'.dependencies.zbus6]
package = "zbus"
path = "../../source/zbus"
default-features = false
features = ["tokio-multithread", "proxy", "p2p"]

[target.'cfg(target_os = "linux")'.dev-dependencies.zbus6]
package = "zbus"
path = "../../source/zbus"
default-features = false
features = ["hc074-unix-fixture"]
