dentity;\n\n#[cfg(test)]\n#[path = \"diagnostic_kernel_operation_cost.rs\"]\nmod operation_cost;\n\n#[cfg(all(test, target_arch = \"x86_64\"))]\n#[path = \"diagnostic_kernel_operation_tests.rs\"]\nmod operation_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\", target_env = \"gnu\"))]\n#[path = \"diagnostic_namespace_open.rs\"]\nmod fixed_namespace_open;\n\n#[cfg(all(test, target_arch = \"x86_64\", target_env = \"gnu\"))]\n#[path = \"diagnostic_namespace_open_tests.rs\"]\nmod namespace_open_tests;\n\n#[cfg(all(test, target_arch = \"x86_64\", target_env = \"gnu\"))]\n#[path = \"diagnostic_filesystem_projection.rs\"]\nmod filesystem_projection;\n\n#[cfg(all(test, target_arch = \"x86_64\", target_env = \"gnu\"))]\n#[path = \"diagnostic_filesystem_projection_tests.rs\"]\nmod filesystem_projection_tests;\n\n#[derive(Debug, Clone)]\npub struct KernelTimePoint {\n    boot: String,\n    boottime: u64,\n    pub(super) realtime_ns: u64,\n}\npub(super) type TimePoint = KernelTimePoint;\nimpl KernelTimePoint {\n    pub fn boot_id(&self) -> &str {\n        &self.boot\n    }\n    pub fn boottime_ns(&self) -> u64 {\n        self.boottime\n    }\n    pub fn unix_seconds(&self) -> u64 {\n        self.realtime_ns / 1_000_000_000\n    }\n}\npub(super) struct Origin {\n    root: File,\n    id: (u64, u64),\n    boot: String,\n    namespaces: [(File, (u64, u64)); 4],\n}\nconst NAMES: [&str; 4] = [\"user\", \"mnt\", \"pid\", \"time\"];\n\n// BEGIN STACK PID NAME\npub(super) struct PidName {\n    bytes: [u8; 12],\n    start: usize,\n}\nimpl PidName {\n    pub(super) fn new(pid: i32) -> Self {\n        let mut bytes = [0; 12];\n        let mut start = 11;\n        let mut remaining = pid.unsigned_abs();\n        loop {\n            start -= 1;\n            bytes[start] = b'0' + (remaining % 10) as u8;\n            remaining /= 10;\n            if remaining == 0 {\n                break;\n            }\n        }\n        if pid < 0 {\n            start -= 1;\n            bytes[start] = b'-