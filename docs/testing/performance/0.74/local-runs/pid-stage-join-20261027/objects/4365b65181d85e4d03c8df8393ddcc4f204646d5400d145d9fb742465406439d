import difflib
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
log = root/'target/roots-lock-view-20261027/pid-stage-boundaries-first/stdout.log'
rows = [json.loads(line) for line in log.read_text().splitlines() if line.startswith('{')]
row = rows[0]
assert row['path'].endswith('/diagnostic_kernel_origin.rs')
assert row['document'] == row['custody']
before, after = row['document'], row['pid_producer']
left, right = before.splitlines(True), after.splitlines(True)
edits = []
for group in difflib.SequenceMatcher(None, left, right, autojunk=False).get_grouped_opcodes(1):
    a, b, c, d = group[0][1], group[-1][2], group[0][3], group[-1][4]
    current, previous = ''.join(left[a:b]), ''.join(right[c:d])
    assert current
    if (current, previous) not in edits:
        edits.append((current, previous))
projected = before
lines = []
for current, previous in sorted(edits, key=lambda item: (before.count(item[0]), -len(item[0]))):
    count = projected.count(current)
    assert count in (1, 2), (count, current)
    assert 'filesystem(&file, 0x9fa0)?;' not in current
    assert 'libc::O_NOFOLLOW' not in current
    lines.append('    (' + json.dumps(current, ensure_ascii=False) + ', ' + json.dumps(previous, ensure_ascii=False) + ', ' + str(count) + '),')
    projected = projected.replace(current, previous)
assert projected == after
