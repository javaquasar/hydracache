+//! Opt-in pending-only faults. No production process or activation capability.
+use super::*;
+use crate::diagnostic_output_preparation::fixed_intent_storage::reserved_state::original_fence::reservation_fence::{inspect_empty_fence_at_for_test, with_owned_empty_fence_at_for_test};
+use std::io::Read;
+use std::os::fd::RawFd;
+use std::os::unix::{fs::MetadataExt, net::UnixDatagram};
+const ROOT: &str = "HC074_PRIVATE_CUSTODY_LOSS_ROOT";
+const CUT: &str = "HC074_PRIVATE_CUSTODY_LOSS_CUT";
+const AUTHORITY: &str = "HC074_PRIVATE_CUSTODY_LOSS_AUTHORITY";
+
+#[test]
+#[ignore = "manual nonroot original first pending notice loss; no execution"]
+fn original_custody_lost_pending_notice() {
+    let seed = 0x0740_be18_u64;
+    for repeat in 1..=3 {
+        original_owner!(true, |held, _paths, root, leaf| {
+            let before = records(leaf);
+            let origins = held.origins_for_test();
+            let parent_mask = mask();
+            let mut failure = held
+                .prepare_barred_fixture_for_test(3, |_| {
+                    panic!("lost initial notice must never reach the closing frame");
+                })
+                .unwrap_err();
+            assert_eq!(failure.reason_for_test(), "Expired");
+            failure.assert_lost_pending_for_test();
+            assert_eq!(&failure.origins_for_test()[..4], &origins[..4]);
+            assert_eq!(mask(), parent_mask);
+            assert!(failure.refused_for_test());
+            assert_eq!(
+                format!("{:?}", failure.retry_for_test().unwrap_err()),
+                "Refused"
+            );
+            busy(root);
+            drop(failure);
+            busy(root);
+            drop(held);
+            drop(crate::host_execution::lock_host_root(root).unwrap());
+            assert_eq!(records(leaf), before);
+            retained_context_refuses_for_test(root);
+            println!("HC074-CUSTODY-LOSS-NOTICE seed=0x{seed:08x} repeat={repeat} reason=Expired pending_consumed=true expiry_notice=E origins_exact=true sticky=true unchanged=true start=false");
+        });
+    }
+}
+
+// Only the test fixture's atomic custodian pidfd is sent. In particular, never
+// duplicate its private protocol peer, which would mask real owner disconnect.
+fn publish(socket: &UnixDatagram, pidfd: &File, raw: &[u8]) {
+    #[repr(C)]
+    struct Control([usize; 4]);
+    let mut control = Control([0; 4]);
+    let size = unsafe { libc::CMSG_SPACE(std::mem::size_of::<RawFd>() as u32) } as usize;
+    assert!(size <= std::mem::size_of_val(&control));
+    let mut iov = libc::iovec {
+        iov_base: raw.as_ptr().cast_mut().cast(),
+        iov_len: raw.len(),
+    };
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = (&mut control as *mut Control).cast();
+    message.msg_controllen = size;
+    unsafe {
+        let header = libc::CMSG_FIRSTHDR(&message);
+        assert!(!header.is_null());
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(std::mem::size_of::<RawFd>() as u32) as usize;
+        std::ptr::write(libc::CMSG_DATA(header).cast::<RawFd>(), pidfd.as_raw_fd());
+        assert_eq!(
+            libc::sendmsg(socket.as_raw_fd(), &message, libc::MSG_NOSIGNAL),
+            raw.len() as isize
+        );
+    }
+    let mut command = [0u8; 1];
+    std::io::stdin().read_exact(&mut command).unwrap();
+    panic!("death fixture must be killed, never resumed: {command:?}");
+}
+
+#[test]
+#[ignore = "private subprocess for custody owner SIGKILL driver; no execution"]
+fn original_custody_owner_victim() {
+    let path = PathBuf::from(std::env::var_os(ROOT).expect("private driver root required"));
+    assert_eq!(path.parent(), Some(Path::new("/tmp")));
+    assert!(path
+        .file_name()
+        .unwrap()
+        .to_str()
+        .unwrap()
+        .starts_with("hc074-custody-loss-"));
+    assert_eq!(fs::canonicalize(&path).unwrap(), path);
+    for item in [&path, &path.join("context"), &path.join("origin")] {
+        let stat = fs::symlink_metadata(item).unwrap();
+        assert!(stat.is_dir() && !stat.file_type().is_symlink());
+        assert_eq!(
+            (stat.uid(), stat.gid(), stat.mode() & 0o7777),
+            (
+                unsafe { libc::geteuid() },
+                unsafe { libc::getegid() },
+                0o700
+            )
+        );
+        assert_ne!(stat.uid(), 0);
+    }
+    assert_eq!(std::env::temp_dir(), path.join("context"));
+    let cut = std::env::var(CUT).unwrap();
+    if cut == "inspect" {
+        inspect_empty_fence_at_for_test(&path.join("origin"), false);
+        println!("HC074-CUSTODY-LOSS-REPLAY refused=true");
+        return;
+    }
+    assert!(matches!(cut.as_str(), "before-frame" | "after-frame"));
+    let authority = PathBuf::from(std::env::var_os(AUTHORITY).unwrap());
+    assert_eq!(authority.parent(), Some(Path::new("/tmp")));
+    assert_eq!(fs::canonicalize(&authority).unwrap(), authority);
+    assert!(authority
+        .file_name()
+        .unwrap()
+        .to_str()
+        .unwrap()
+        .starts_with("hydracache-authority-"));
+    let socket = UnixDatagram::unbound().unwrap();
+    socket.connect(path.join("notice.sock")).unwrap();
+    let bundle = Bundle::new();
+    with_original_at(
+        false,
+        Some(&authority),
+        |original, _, receiver, sender, model| {
+            with_owned_empty_fence_at_for_test(&path.join("origin"), |fence, root, leaf| {
+                let mut held = accepted(original, fence, leaf, receiver, sender, model)
+                    .prepare_original_outputs_for_test(|_| Ok(()))
+                    .unwrap()
+                    .prepare_custodied_fixture_for_test(&bundle.path, |_, _| {})
+                    .unwrap();
+                let before = records(leaf);
+                let origins = held.origins_for_test();
+                macro_rules! notify {
+                ($barred:expr, $count:expr) => {{
+                    let barred = $barred;
+                    barred.assert_original_for_test();
+                    assert_eq!(&barred.origins_for_test()[..4], &origins[..4]);
+                    assert_eq!(records(leaf), before);
+                    busy(root);
+                    let raw = serde_json::to_vec(&serde_json::json!({
+                        "schema": "hc074-pending-owner-test-v1", "owner": std::process::id(),
+                        "cut": cut, "deadline": barred.deadline_for_test(), "origins": origins,
+                        "closing_authentication": $count,
+                    })).unwrap();
+                    assert!(raw.len() <= 2048);
+                    publish(&socket, &barred.pinned_for_test(), &raw);
+                }};
+            }
+                let (barred, report) = trace::capture(|| {
+                    trace::stage(Stage::Bind);
+                    held.prepare_barred_fixture_for_test(0, |barred| {
+                        if cut == "before-frame" {
+                            notify!(barred, 0);
+                        }
+                    })
+                    .unwrap()
+                });
+                assert_eq!(cut, "after-frame");
+                call_count(&report, Stage::Bind);
+                notify!(&barred, 34);
+            });
+        },
+    );
+}
