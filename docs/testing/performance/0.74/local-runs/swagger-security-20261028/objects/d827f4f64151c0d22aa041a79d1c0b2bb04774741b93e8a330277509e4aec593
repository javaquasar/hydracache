"""Consume retained metadata, then checksum exact migration sources as inert data."""
from pathlib import Path
import hashlib,io,json,subprocess,tarfile,tomllib,urllib.request
ROOT=Path(__file__).resolve().parent.parent
BASE=ROOT/'target/swagger-security-20261028'
OUT=BASE/'upstream'
OUT.mkdir(exist_ok=False)
def sha(raw):return hashlib.sha256(raw).hexdigest()
def write(name,value):(OUT/name).write_text(json.dumps(value,indent=2,sort_keys=True)+'\n')
inputs={name:sha((ROOT/name).read_bytes()) for name in ('Cargo.toml','Cargo.lock','deny.toml','crates/hydracache-sandbox/src/lib.rs')}
write('intent.json',dict(source_sha256=sha(Path(__file__).read_bytes()),inputs=inputs,
 source_commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip(),
 metadata_first_refusal_retained=True,source_code_executed=False))
records={}
with (OUT/'stdout.log').open('x',encoding='utf-8') as stdout,(OUT/'stderr.log').open('x',encoding='utf-8') as stderr:
 try:
  for name,version in (('utoipa','6.0.0'),('utoipa-gen','6.0.1'),('utoipa-swagger-ui-vendored','0.2.0'),('base64','0.23.1')):
   rawindex=(BASE/'catalog'/(name+'.index')).read_bytes()
   row=next(r for r in map(json.loads,rawindex.splitlines()) if r['vers']==version)
   assert not row['yanked'] and tuple(map(int,row['rust_version'].split('.'))) <= (1,88)
   url='https://static.crates.io/crates/'+name+'/'+name+'-'+version+'.crate'
   with urllib.request.urlopen(url,timeout=45) as response:raw=response.read()
   assert sha(raw)==row['cksum']
   folder=OUT/(name+'-'+version);folder.mkdir()
   (folder/'source.crate').write_bytes(raw)
   members={}
   with tarfile.open(fileobj=io.BytesIO(raw),mode='r:gz') as archive:
    for member in archive.getmembers():
     if not member.isfile():continue
     relative=Path(member.name).relative_to(name+'-'+version)
     assert '..' not in relative.parts
     # Reviewed source + licenses; vendored ZIP is retained only as build input data.
     if member.size>32*1024**2:raise ValueError('source member review size')
     data=archive.extractfile(member).read()
     dest=folder/'review-source'/relative;dest.parent.mkdir(parents=True,exist_ok=True)
     dest.write_bytes(data)
     members[relative.as_posix()]=dict(sha256=sha(data),bytes=len(data))
   records[name+'@'+version]=dict(url=url,checksum=row['cksum'],index_sha256=sha(rawindex),
    rust_version=row['rust_version'],metadata=row,members=members)
   stdout.write(json.dumps(dict(name=name,version=version,rust_version=row['rust_version'],members=len(members)))+'\n');stdout.flush()
  assert inputs=={n:sha((ROOT/n).read_bytes()) for n in inputs}
  write('result.json',dict(releases=records,inputs_unchanged=True,source_code_executed=False))
 except BaseException as error:
  write('refusal.json',dict(type=type(error).__name__,reason=str(error)));raise
print((OUT/'stdout.log').read_text())
