 distinct_source_milestones=True,concatenate_results=False,release_admitted=False,
 server=False,services=False,clocks=False,product_workload=False,performance_claim=False,
 archived_code_executed_by_sealer=False)
with (OUT/'index.json').open('x',encoding='utf-8',newline='\n') as stream:
 json.dump(index,stream,indent=2,sort_keys=True);stream.write('\n')
with (OUT/'.gitattributes').open('x',encoding='utf-8',newline='\n') as stream:
 stream.write('objects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\nindex.json -text\n')
