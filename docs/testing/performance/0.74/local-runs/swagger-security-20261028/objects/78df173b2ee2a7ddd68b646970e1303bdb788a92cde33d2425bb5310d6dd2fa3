 controller=read(phase+'/controller.json');execution=controller['execution']
 assert execution['exit']==1 and execution['classification']=='test-failure'
 assert execution['retired'] and not execution['errors']
 assert (execution['bound_seconds'],execution['cleanup_seconds'],execution['capacity_poll_seconds'])==(4800,5,5)
 assert sha((BASE/phase/'request.json').read_bytes())==controller['request_sha256']
 assert read(phase+'/result.json')['source_refs_configuration_environment_unchanged']
