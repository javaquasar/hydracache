import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'target/held-environment-preflight-20261026'
OUT.mkdir(exist_ok=False)
source = ROOT/'target/held-environment-preflight-20261026.sh'
argv = ['wsl.exe', '-d', 'HydraCache074Native', '-u', 'root', '--exec', '/bin/sh',
        '/mnt/c/Workspace/prj/jq/cashe/hydracache-074/target/held-environment-preflight-20261026.sh']
intent = dict(argv=argv, shell_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
    read_only=True, service_mutation=False, clocks_changed=False, original_attempt=False, server=False)
