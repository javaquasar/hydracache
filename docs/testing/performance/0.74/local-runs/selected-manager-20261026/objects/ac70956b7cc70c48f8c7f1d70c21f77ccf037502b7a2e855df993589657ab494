"""Retain read-only selected-environment facts; no integration admission."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'docs/testing/performance/0.74/local-runs/selected-manager-20261026'
RAW = ROOT/'target/held-environment-preflight-20261026'
result = json.loads((RAW/'result.json').read_bytes())
text = (RAW/'stdout.log').read_text(encoding='utf-8')
if result['exit'] != 0 or 'Version=257.13-1~deb13u1' not in text or 'cgroup2fs' not in text:
    raise ValueError('selected manager snapshot differs')
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
paths = [(name, RAW/name) for name in ('intent.json', 'result.json', 'stdout.log', 'stderr.log')]
paths += [('source/'+name, ROOT/'target'/name) for name in
          ('held-environment-preflight-20261026.sh', 'run-held-environment-preflight-20261026.py')]
paths.append(('collector.py', Path(__file__)))
for name, path in paths:
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    dest = OUT/'objects'/digest
    if not dest.exists():
        with dest.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)
index = dict(schema='hc074-selected-manager-readonly-v1', distro='HydraCache074Native',
    version='257.13-1~deb13u1', original_delivery_proved=False, time_admission=False,
    installation=False, services_changed=False, clocks_changed=False, server=False,
    qualification_allowed=False, members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
