"""Finite local correctness cohorts only, with original wrapper bounds."""
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
RUNNER = ROOT / 'target/run-fresh-reader-20261024.py'
JOIN = ['remaining_readers_074', 'fresh_kernel_cost_074', 'held_activation_ingress_074',
        'current_tree_reader_074', 'current_tree_input_audit_074', 'current_frontier_074',
        'authority_reader_phase_074', 'bootstrap_doc_reader_074', 'owned_case_074']
CONTROLS = ['custody_preparation_cost_074', 'document_scratch_cost_074',
            'document_scratch_reader_074', 'package_diagnostics_074']


def test(compiler, targets):
    argv = ['cargo', compiler, 'test', '--offline', '--locked', '--no-fail-fast', '-p', 'xtask']
    for target in targets:
        argv.extend(['--test', target])
    return [*argv, '--', '--test-threads=4']


CASES = [
    ('remaining-readers-candidate-second', test('+1.94.0', JOIN)),
    ('remaining-readers-current-controls-second', test('+1.94.0', CONTROLS)),
    ('remaining-readers-msrv-first', test('+1.88.0', JOIN + CONTROLS)),
    ('remaining-readers-producer-first', [sys.executable, 'tools/remaining-readers-074/generate.py']),
    ('remaining-readers-check-first', ['cargo', '+1.94.0', 'check', '--offline', '--locked', '-p', 'xtask', '--all-targets']),
    ('remaining-readers-clippy-first', ['cargo', '+1.94.0', 'clippy', '--offline', '--locked', '-p', 'xtask', '--all-targets', '--all-features', '--', '-D', 'warnings']),
    ('remaining-readers-fmt-first', ['cargo', '+1.94.0', 'fmt', '-p', 'xtask', '--', '--check']),
    ('remaining-readers-doc-check-first', ['cargo', 'xtask', 'doc-check']),
    ('remaining-readers-contract-check-first', ['cargo', 'xtask', 'performance-contract-check', '--release', '0.74']),
]
for label, argv in CASES:
    result = subprocess.run([sys.executable, str(RUNNER), label, *argv], cwd=ROOT, check=False)
    if result.returncode:
        raise SystemExit(result.returncode)
