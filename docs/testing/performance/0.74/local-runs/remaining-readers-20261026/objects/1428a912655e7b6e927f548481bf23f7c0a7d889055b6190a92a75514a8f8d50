"""Keep the original two failures and exact final caller/source check receipts."""
from pathlib import Path
import hashlib
import json
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BASE = '3e7e0aa343ed51f99651761f9bb7b0b10efd359a'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members, objects, intents = {}, {}, {}


def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


labels = {label: 0 for label in [
    'remaining-readers-candidate-first', 'remaining-readers-candidate-final',
    'remaining-readers-candidate-second', 'remaining-readers-current-controls-second', 'remaining-readers-msrv-first',
    'remaining-readers-producer-first', 'remaining-readers-check-first',
    'remaining-readers-clippy-first', 'remaining-readers-fmt-second',
    'remaining-readers-postformat-current', 'remaining-readers-postformat-msrv',
    'remaining-readers-producer-final', 'remaining-readers-check-final',
    'remaining-readers-clippy-final', 'remaining-readers-fmt-final',
    'remaining-readers-doc-check-first', 'remaining-readers-contract-check-first']}
labels['remaining-readers-baseline-first'] = 101
labels['remaining-readers-current-controls'] = 101
labels['remaining-readers-fmt-first'] = 1
for label, expected in labels.items():
    folder = ROOT / 'target/source-continuation-20261024' / label
    intent = json.loads((folder / 'intent.json').read_bytes())
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == expected and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged'] and intent['head'] == BASE
    assert result['source_after'] == intent['source']
    intents[label] = intent
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())
rules_raw = (ROOT / 'tools/remaining-readers-074/rules.json').read_bytes()
assert sha(rules_raw) == 'b8803a5f12460fa2278ffef033dc0738c4dc925a65a661f701ea09ae9bb6883e'
rules = json.loads(rules_raw)
files = [row['path'] for row in rules['rows']]
for path in files:
    add('baseline/' + path, subprocess.check_output(['git', '--no-replace-objects', 'show', BASE + ':' + path], cwd=ROOT))
    add('declared-delta/' + path + '.raw', subprocess.check_output(['git', '--no-replace-objects', 'diff',
        '--no-ext-diff', '--no-textconv', BASE, '--', path], cwd=ROOT))
files += ['crates/xtask/tests/remaining_readers_074.rs']
files += [path.relative_to(ROOT).as_posix() for path in sorted((ROOT / 'tools/remaining-readers-074').iterdir()) if path.is_file()]
files += ['crates/xtask/tests/support/current_tree_input.rs', 'crates/xtask/tests/support/current_tree_input_rules_074.json',
          'tools/source-successor-view-074/contract.rs', 'tools/source-successor-view-074/rules.json',
          'tools/bootstrap-doc-reader-074/io.rs', 'tools/bootstrap-doc-reader-074/read.rs',
          'tools/authority-reader-phase-074/contract.rs', 'tools/current-frontier-074/contract.rs',
          'tools/current-frontier-074/rules.json', 'tools/current-frontier-074/reader.rs']
for path in files:
    raw = (ROOT / path).read_bytes()
    for label in ['remaining-readers-postformat-current', 'remaining-readers-postformat-msrv',
                  'remaining-readers-clippy-final']:
        assert sha(raw) == intents[label]['source'][path]
    add('source-final/' + path, raw)
for leaf, path in [('contract.rs', 'tools/remaining-readers-074/contract.rs'),
                   ('inputs.rs', 'tools/remaining-readers-074/inputs.rs'),
                   ('remaining_readers_074.rs', 'crates/xtask/tests/remaining_readers_074.rs')]:
    raw = (ROOT / 'target/remaining-readers-initial-source-20261026' / leaf).read_bytes()
    assert sha(raw) == intents['remaining-readers-candidate-first']['source'][path]
    add('initial-source/' + path, raw)
    interim = (ROOT / 'target/remaining-readers-interim-source-20261026' / leaf).read_bytes()
    assert sha(interim) == intents['remaining-readers-candidate-final']['source'][path]
    add('interim-source/' + path, interim)
interim_rules = (ROOT / 'target/remaining-readers-interim-source-20261026/rules.json').read_bytes()
assert sha(interim_rules) == '70e398f840925e2d703b726b07f7e81c189f2e6f8e8733bc15fbc00351405a95'
add('initial-six-caller-rules.json', interim_rules)
preformat = {
    'tools/remaining-readers-074/contract.rs': 'contract.rs',
    'tools/remaining-readers-074/rules.json': 'rules.json',
    'tools/remaining-readers-074/generate.py': 'generate.py',
    'tools/remaining-readers-074/README.md': 'README.md',
    'tools/bootstrap-doc-reader-074/reader.rs': 'bootstrap_reader.rs',
}
for path, leaf in preformat.items():
    raw = (ROOT / 'target/remaining-readers-preformat-20261026' / leaf).read_bytes()
    for label in ['remaining-readers-candidate-second', 'remaining-readers-current-controls-second',
                  'remaining-readers-msrv-first']:
        assert sha(raw) == intents[label]['source'][path]
    add('preformat-source/' + path, raw)
preformat_test = (ROOT / 'target/remaining-readers-interim-source-20261026/remaining_readers_074.rs').read_bytes()
for before, after in [
    (b'fn six_exact_caller_constructions_preserve_all_eighteen_cases_and_assertions()',
     b'fn seven_exact_caller_constructions_preserve_all_eighteen_cases_and_assertions()'),
    (b'let counts = [2, 4, 4, 1, 7, 0];', b'let counts = [2, 4, 4, 1, 7, 0, 0];')]:
    assert preformat_test.count(before) == 1
    preformat_test = preformat_test.replace(before, after)
for label in ['remaining-readers-candidate-second', 'remaining-readers-current-controls-second',
              'remaining-readers-msrv-first']:
    assert sha(preformat_test) == intents[label]['source']['crates/xtask/tests/remaining_readers_074.rs']
add('preformat-source/crates/xtask/tests/remaining_readers_074.rs', preformat_test)
add('preformat-test-reconstruction.json', (json.dumps(dict(
    derived_data_not_new_run=True, base='interim-source/crates/xtask/tests/remaining_readers_074.rs',
    changes=['six_exact to seven_exact case name', 'append zero helper test count'],
    original_raw_source_receipts_matched=True), indent=2) + '\n').encode())
projection = json.loads((ROOT / 'tools/source-successor-view-074/rules.json').read_bytes())
for row in projection['rows']:
    if row['path'] not in ['docs/COMPAT.md', 'tools/long-run-supervisor-074/src/diagnostic_kernel_origin.rs']:
        continue
    for key in ['revision', 'previous_revision']:
        rev = row[key]
        add('producer/' + rev + '/' + row['path'], subprocess.check_output(
            ['git', '--no-replace-objects', 'show', rev + ':' + row['path']], cwd=ROOT))
for name in ['run-fresh-reader-20261024.py', 'run-source-step-20261024.py',
             'run-remaining-readers-final-checks.py', 'run-remaining-readers-postformat-checks.py',
             'retain-remaining-readers-20261026.py']:
    add('coordinator/' + name, (ROOT / 'target' / name).read_bytes())
out = ROOT / 'docs/testing/performance/0.74/local-runs/remaining-readers-20261026'
out.mkdir(exist_ok=True)
(out / 'objects').mkdir()
for digest, raw in objects.items():
    with (out / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-remaining-readers-evidence-v1', baseline_revision=BASE,
             members=members, expected_exit=labels, baseline_cases=27, baseline_failed=2,
             original_cases=57, new_cases=4, each_compiler_distinct_cases=61,
             original_cases_in_modified_files=18, full_package_rerun=False,
             runtime_or_deadline_changes=False, server=False, qualification=False)
with (out / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, sort_keys=True, indent=2)
    stream.write('\n')
print(dict(members=len(members), objects=len(objects), index_sha256=sha((out / 'index.json').read_bytes())))
