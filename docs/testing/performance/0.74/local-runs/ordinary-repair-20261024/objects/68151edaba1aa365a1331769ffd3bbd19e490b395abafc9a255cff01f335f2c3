def retain(name,raw):
    digest=sha(raw);path=DEST/'objects'/digest
    if not path.exists():
        with path.open('xb') as stream:stream.write(raw)
    elif path.read_bytes()!=raw:raise ValueError('Content collision')
    files[name]=dict(bytes=len(raw),sha256=digest)
for folder in sorted(RAW.iterdir()):
    if not folder.is_dir() or not (folder.name.startswith(('owned-case-','owned-case-controls-','owned-case-lint-','owned-case-native-final-','material-lock-strict-','bootstrap-isolation-native-strict-')) or folder.name=='embedded-fast-first'):
        continue
    for path in sorted(folder.rglob('*')):
        if path.is_file() and path.name!='image' and path.suffix not in ('.exe','.pdb'):
            retain('observation/'+path.relative_to(RAW).as_posix(),path.read_bytes())
