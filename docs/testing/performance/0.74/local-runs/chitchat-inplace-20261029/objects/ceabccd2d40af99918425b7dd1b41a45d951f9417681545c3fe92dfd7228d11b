OUT.mkdir(exist_ok=False);(OUT/'objects').mkdir();members={}


def add(name,path):
    raw=path.read_bytes();digest=sha(raw);dest=OUT/'objects'/digest
    if dest.exists():assert dest.read_bytes()==raw
    else:dest.write_bytes(raw)
    assert name not in members;members[name]=dict(sha256=digest,bytes=len(raw))


for path in sorted(BASE.rglob('*')):
    if not path.is_file():continue
    name=path.relative_to(BASE)
    if name.parts[0] in ('targets','vendor','cargo-home'):continue
    if name.name=='source.zip':continue  # All source bytes below; reconstruct from members.json.
    add('capture/'+name.as_posix(),path)
