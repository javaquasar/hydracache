    names.update(json.loads((BASE/'preparation/L2/result.json').read_bytes())['overlays'])
    names.update(p.relative_to(ROOT).as_posix() for p in (ROOT/'tools/windows-workspace-preflight-074').iterdir() if p.is_file())
