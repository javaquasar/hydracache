"""Retain verification/doc-check receipts without making their digest self-referential."""
from pathlib import Path
import hashlib,json
ROOT=Path(__file__).resolve().parent.parent
OUT=ROOT/'docs/testing/performance/0.74/local-runs/dbus-original-owner-verification-20261028'
checks=ROOT/'target/dbus-original-owner-checks-20261028'
sha=lambda b:hashlib.sha256(b).hexdigest()
for mode in ('verify','doc-check'):
    result=json.loads((checks/mode/'result.json').read_bytes())
    execution=json.loads((checks/mode/'execution.json').read_bytes())
    assert result['exit']==0 and result['inputs_unchanged'] and execution['retired'] and not execution['errors']
intent=json.loads((checks/'doc-check/intent.json').read_bytes())['inputs']
assert intent['executable_sha256']==sha((ROOT/'target/debug/xtask.exe').read_bytes())
assert intent['documents']=={p.relative_to(ROOT).as_posix():sha(p.read_bytes()) for p in sorted((ROOT/'docs').rglob('*.md'))}
OUT.mkdir(exist_ok=False);(OUT/'objects').mkdir();members={}
def add(name,path):
    raw=path.read_bytes();digest=sha(raw);dest=OUT/'objects'/digest
    if dest.exists():assert dest.read_bytes()==raw
    else:dest.write_bytes(raw)
    assert name not in members;members[name]=dict(sha256=digest,bytes=len(raw))
for mode in ('verify','doc-check'):
    for p in sorted((checks/mode).iterdir()):
        if p.is_file():add('capture/'+mode+'/'+p.name,p)
for name in ('target/verify-dbus-original-owner-20261028.py','target/dbus-original-owner-step-20261028.py','target/retain-dbus-original-owner-verification-20261028.py'):
    add('source/'+name,ROOT/name)
for name in ('docs/testing/performance/0.74/dbus-original-owner-result-20261028.md','docs/testing/performance/0.74/README.md','docs/testing/performance/0.74/release-closure-execution-plan-20261026.md','docs/testing/performance/0.74/remaining-security-feasibility-20261028.md','docs/articles/007-optimization-starts-with-measurement.md'):
    add('documents/'+name,ROOT/name)
primary=ROOT/'docs/testing/performance/0.74/local-runs/dbus-original-owner-20261028/index.json';add('primary/index.json',primary)
index=dict(schema='hc074-original-owner-verification-v1',members=members,primary_index_sha256=sha(primary.read_bytes()),independent_inert_verification=True,doc_check=True,root_changed=False,release_admitted=False)
(OUT/'index.json').write_text(json.dumps(index,indent=2,sort_keys=True)+'\n',encoding='utf8',newline='\n')
(OUT/'.gitattributes').write_text('objects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\nindex.json -text\n',encoding='utf8',newline='\n')
for row in members.values():
    raw=(OUT/'objects'/row['sha256']).read_bytes();assert sha(raw)==row['sha256'] and len(raw)==row['bytes']
print(json.dumps(dict(members=len(members),objects=len(list((OUT/'objects').iterdir())),index_sha256=sha((OUT/'index.json').read_bytes()))))
