"""One separately preregistered cost-only holder session; no retry or product."""
from pathlib import Path
import hashlib
import json
import re
import subprocess
import sys

ROOT = Path(r'C:\Workspace\prj\jq\cashe\hydracache-074')
OUT = ROOT / 'target/native-preparation-cost-20261024'
sys.path.insert(0, str(ROOT / 'tools/native-server-control-074'))
import profile_session
SSH = ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=15', 'hydracache-ax42']
SCP = ['scp', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=15']


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def put(path, value):
    with path.open('x', encoding='utf-8', newline='\n') as stream:
        json.dump(value, stream, indent=2)
        stream.write('\n')


def call(label, argv, timeout, data=None):
    put(OUT / (label + '-intent.json'), {'argv': argv, 'timeout_seconds': timeout, 'retry': False})
    with (OUT / (label + '.stdout.log')).open('xb') as stdout, (OUT / (label + '.stderr.log')).open('xb') as stderr:
        try:
            rc = subprocess.run(argv, input=data, stdout=stdout, stderr=stderr, cwd=ROOT, timeout=timeout, check=False).returncode
        except subprocess.TimeoutExpired:
            rc = 124
    put(OUT / (label + '-result.json'), {'exit': rc, 'retry': False, 'server': True, 'admission': False, 'product': False})
    if rc:
        raise RuntimeError(f'{label}: first exit {rc}; inspect same attempt, never resubmit')


if subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT).strip():
    raise ValueError('Uncommitted source')
proof = json.loads((ROOT / 'target/bootstrap-original-getunit-20261023/build-proof.json').read_bytes())
for name, sha in proof['checked_sources'].items():
    if digest(ROOT / name) != sha:
        raise ValueError('Build input drift: ' + name)
image = ROOT / 'target/bootstrap-original-getunit-20261023/native-once/libtest'
if digest(image) != 'ca5484aa951414b80aefd0148c7d8f5185a8fdf73bb197cf98a790de59b8cff1':
    raise ValueError('Image drift')
