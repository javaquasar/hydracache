names = ('timing-controls-074', 'build-receipt-v1.json', 'build-log.jsonl', 'Cargo.lock.root', 'Cargo.lock.observer',
         'embedded.json', 'direct.json', 'resp2.json', 'resp3.json')
bundle = ROOT / 'target/diagnostic-start-material-bundle-20261017'
sources = {'profile-session.sh': runner, 'libtest': image}
sources |= {'bundle/' + name: bundle / name for name in names}
manifest = OUT / 'inputs.sha256'
with manifest.open('x', encoding='ascii', newline='\n') as stream:
    for name, path in sorted(sources.items()):
        stream.write(digest(path) + '  ' + name + '\n')
put(OUT / 'session-intent.json', {'git': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
    'input_hashes': {name: digest(path) for name, path in sources.items()}, 'checked_build_sources': len(proof['checked_sources']),
    'case': 'healthy', 'instrumented': True, 'qualification': False, 'admission': False, 'server': True, 'retry': False,
    'product': False, 'original_send': False, 'service_change': False, 'clock_change': False,
    'original_windows_seconds': [300, 60, 10], 'external_bound_seconds': 1200})
call('preflight', SSH + ['sh', '-s'], 45, (ROOT / 'tools/native-server-control-074/preflight.sh').read_bytes())
call('create-upload', SSH + ['sh', '-s'], 30, b'umask 077\nmktemp -d /tmp/hc074-native-cost-upload-20261024.XXXXXX\n')
upload = (OUT / 'create-upload.stdout.log').read_text().strip()
if not re.fullmatch(r'/tmp/hc074-native-cost-upload-20261024\.[A-Za-z0-9]{6}', upload):
    raise ValueError('Unexpected upload path')
call('transfer-main', SCP + [str(runner), str(image), str(manifest), 'hydracache-ax42:' + upload + '/'], 90)
call('transfer-bundle', SCP + ['-r', str(bundle), 'hydracache-ax42:' + upload + '/bundle'], 90)
script = f'''set -eu
[ "$(id -u):$(id -g)" = 0:0 ]
umask 077
upload={upload}
[ "$(stat -c '%a:%u:%g' "$upload")" = 700:1000:1000 ]
[ ! -L "$upload" ]
root=$(mktemp -d /tmp/hc074-native-cost-root-20261024.XXXXXX)
mkdir -m 700 "$root/bundle"
for file in profile-session.sh libtest inputs.sha256; do
 [ -f "$upload/$file" ] && [ ! -L "$upload/$file" ]
 install -m 500 "$upload/$file" "$root/$file"
done
for file in {' '.join(names)}; do
 [ -f "$upload/bundle/$file" ] && [ ! -L "$upload/bundle/$file" ]
 install -m 400 "$upload/bundle/$file" "$root/bundle/$file"
done
chmod 500 "$root/bundle"
cd "$root"
printf '%s\\n' '{digest(runner)}  profile-session.sh' '{digest(manifest)}  inputs.sha256' | sha256sum --check
sha256sum --check inputs.sha256
/bin/sh -n profile-session.sh
printf 'ROOT=%s\\n' "$root"
nohup /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/sh "$root/profile-session.sh" >wrapper.log 2>&1 </dev/null &
printf 'WRAPPER_PID=%s\\n' "$!"
'''.encode()
with (OUT / 'stage-input.sh').open('xb') as stream:
