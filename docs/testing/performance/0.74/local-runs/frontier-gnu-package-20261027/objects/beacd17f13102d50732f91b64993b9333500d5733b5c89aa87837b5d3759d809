#[path = "../../../tools/remaining-readers-074/inputs.rs"]
mod current_inputs;
#[path = "../../../tools/current-frontier-074/reader.rs"]
mod frontier;
#[path = "../../../tools/authority-runtime-074/gate.rs"]
