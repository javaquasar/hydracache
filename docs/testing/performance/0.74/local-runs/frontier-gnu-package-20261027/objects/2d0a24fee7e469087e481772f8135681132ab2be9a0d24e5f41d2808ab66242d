"""Retain exact source, first refusals and the distinct GNU command as data."""
import hashlib
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent
BASE=ROOT/'target/gnu-frontier-local-20261027'
OLD=ROOT/'target/gnu-repaired-local-20261027'
OUT=ROOT/'docs/testing/performance/0.74/local-runs/frontier-gnu-package-20261027'
assert not OUT.exists()
(OUT/'objects').mkdir(parents=True)
members={}

def sha(raw): return hashlib.sha256(raw).hexdigest()
def add(name,raw):
    digest=sha(raw)
    path=OUT/'objects'/digest
    if path.exists(): assert path.read_bytes()==raw
    else:
        with path.open('xb') as stream: stream.write(raw)
    assert name not in members
    members[name]=dict(sha256=digest,bytes=len(raw))
def doc(name,value): add(name,(json.dumps(value,indent=2,sort_keys=True)+'\n').encode())
def folder(prefix,path):
    assert path.is_dir() and not path.is_symlink()
    for file in sorted(path.rglob('*')):
        assert not file.is_symlink()
        if file.is_file(): add(prefix+'/'+file.relative_to(path).as_posix(),file.read_bytes())

