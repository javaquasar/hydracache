import hashlib
import json
from pathlib import Path
import subprocess
import sys

ROOT=Path(__file__).resolve().parent.parent
OLD=ROOT/'tools/package-repaired-gnu-074'
NEW=ROOT/'tools/package-frontier-gate-074'
BASE=ROOT/'target/gnu-frontier-local-20261027'

def sha(raw): return hashlib.sha256(raw).hexdigest()
def replace(raw,before,after,count=1):
    assert raw.count(before)==count,(before,raw.count(before))
    return raw.replace(before,after)
def write(path,raw):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream: stream.write(raw)
def text(path): return path.read_text(encoding='utf-8')

mode=sys.argv[1]
if mode=='tools':
    source=sys.argv[2]
    assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()==source
    request=ROOT/'target/native-frontier-20261027'/source/'request.json'
    request_sha=sha(request.read_bytes())
    for name in ('review.py','runner.py','test_runner.py','.gitattributes'):
        raw=text(OLD/name)
        raw=raw.replace('package-repaired-gnu-074','package-frontier-gate-074').replace('gnu-repaired-local-20261027','gnu-frontier-local-20261027')
        if name=='review.py':
            raw=replace(raw,'fe4b3a0f9060615185895337181780a6f3f55439',source)
            raw=replace(raw,'8b7cb4fea8fa4e6f5c61d1905cf852ba7219913b168e1c32ba229c01d3125383',request_sha)
            raw=replace(raw,'59f8d00f06e3468626b686201957615fa2b1fbb7bfec4020b63bb863aa48ec8a','DATA_DIGEST_PENDING')
            raw=replace(raw,'(391,58,155)','(394,58,156)')
            raw=replace(raw,'dict(sources=391,auxiliary=58','dict(sources=394,auxiliary=58')
        elif name=='runner.py':
            raw=replace(raw,"'fresh_status_reader_074','memory_compat_071','memory_profile_071',", "'fresh_status_reader_074','memory_compat_071','memory_profile_071',\n    'package_frontier_inputs_074','frontier_current_view_074','authority_rust_history_074','current_tree_input_audit_074',")
            raw=replace(raw,"accounting['expected_targets']==12 and accounting['passed']==42", "accounting['expected_targets']==16 and accounting['passed']==67")
        elif name=='test_runner.py':
            raw=replace(raw,'(391,58,155)','(394,58,156)')
            raw=replace(raw,'(8,5)','(2,3)')
            raw=replace(raw,'len(p.FOCUSED),12','len(p.FOCUSED),16')
        write(NEW/name,raw.encode())
    raw=text(ROOT/'target/run-repaired-gnu-local-20261027.py').replace('gnu-repaired-local-20261027','gnu-frontier-local-20261027')
    write(ROOT/'target/run-frontier-gate-local-20261027.py',raw.encode())
    raw=text(ROOT/'target/capture-repaired-gnu-syntax-20261027.py').replace('gnu-repaired-local-20261027','gnu-frontier-local-20261027')
    write(ROOT/'target/capture-frontier-gate-syntax-20261027.py',raw.encode())
    raw=text(ROOT/'target/refresh-repaired-gnu-native-20261027.py')
    raw=replace(raw,"SOURCE='fe4b3a0f9060615185895337181780a6f3f55439'",f"SOURCE='{source}'")
    raw=replace(raw,"OLD='636feb166b273b5c3d6fc0b93c4fccf57560cf03'","OLD='fe4b3a0f9060615185895337181780a6f3f55439'")
    raw=replace(raw,"ROOT=Path('/home/artur/.cache/hydracache-074-frontier-native')/OLD/'repo'","ROOT=Path('/home/artur/.cache/hydracache-074-frontier-native/636feb166b273b5c3d6fc0b93c4fccf57560cf03/repo')")
    raw=raw.replace('gnu-repaired-local-20261027','gnu-frontier-local-20261027')
    raw=replace(raw,'8b7cb4fea8fa4e6f5c61d1905cf852ba7219913b168e1c32ba229c01d3125383',request_sha)
    raw=replace(raw,'44aaf01ea277b78a0ac3b2a77e382e61ac92ffebe0c4ba12a615eee5efd0e3e4','8b7cb4fea8fa4e6f5c61d1905cf852ba7219913b168e1c32ba229c01d3125383')
    write(ROOT/'target/refresh-frontier-gate-native-20261027.py',raw.encode())
    print(dict(source=source,request_sha256=request_sha,generated_only=True,package_pass=False))
elif mode=='data':
    source=sys.argv[2]
    data=json.loads((OLD/'inputs.json').read_bytes())
    old_document=json.loads((ROOT/'target/gnu-repaired-local-20261027/syntax-current/result.json').read_bytes())
    document=json.loads((BASE/'syntax-current/result.json').read_bytes())
    old={r['source']:r for r in old_document['sources']}
    rows={r['source']:r for r in document['sources']}
    changed={p for p in old if old[p]!=rows[p]}
    added=set(rows)-set(old)
    assert changed=={'tools/remaining-readers-074/inputs.rs','crates/xtask/tests/frontier_current_view_074.rs'},changed
    assert added=={'crates/xtask/tests/package_frontier_inputs_074.rs','tools/package-frontier-inputs-074/contract.rs','tools/package-frontier-inputs-074/proof.rs'},added
    assert len(rows)==394 and not(set(old)-set(rows))
    sources={}
    for name,row in rows.items():
        raw=(ROOT/name).read_bytes()
        assert sha(raw)==row['sha256']
        sources[name]=sha(raw.replace(b'\r\n',b'\n'))
        if name not in changed|added:
            assert sources[name]==data['sources'][name] and row==old[name]
    for name,digest in data['auxiliary'].items():
        assert sha((ROOT/name).read_bytes().replace(b'\r\n',b'\n'))==digest
    data.update(schema='hc074-frontier-gnu-source-review-v1',source=source,
        request_sha256=sha((ROOT/'target/native-frontier-20261027'/source/'request.json').read_bytes()),
        sources=sources,syntax_sha256=sha(json.dumps(document,sort_keys=True,separators=(',',':')).encode()),
        changed=sorted(changed),added=sorted(added),
        targets=data['targets'][:2]+sorted(data['targets'][2:]+['tests/package_frontier_inputs_074.rs']),
        delta_review={
          'inherited':'389 complete Rust/AST rows and all 58 auxiliary bodies remain exact relative to the prior complete repaired GNU review. The inherited complete GNU effect groups and first refusals remain applicable; no source is removed.',
          'reader':'Only four literal path names join after old::read and its complete original physical/canonical/runtime checks. Whole current and named predecessor hashes bracket exact inverse edits. The old FRESH branch, unknown fallback, global protected selection and 9/81 rules remain exact. No filesystem/Git IO or observed-state cache is added.',
          'proof':'The frontier source assertion reader adds a pure helper only for the whole changed remaining-reader facade. Both whole hashes, exact inverse import/branch and independent old assertions remain checked. This is source text, never historical execution.',
          'controls':'The new five-case target uses bounded source reads, fixed cached Git show, AST assertion tokens, seeded in-memory byte mutants and one existing stage-0 addition check. No manager, live service, shell/network, credentials or runtime entry is opened. Every new constructor is existing fixed read-only Git infrastructure.'})
    raw=(json.dumps(data,sort_keys=True,indent=2)+'\n').encode()
    write(NEW/'inputs.json',raw)
    path=NEW/'review.py'
    before=text(path)
    after=replace(before,'DATA_DIGEST_PENDING',sha(raw))
    path.write_text(after,encoding='utf-8',newline='\n')
    print(dict(input_sha256=sha(raw),sources=len(sources),targets=len(data['targets']),changed=sorted(changed),added=sorted(added),manual_review_recorded=True,package_pass=False))
else:
