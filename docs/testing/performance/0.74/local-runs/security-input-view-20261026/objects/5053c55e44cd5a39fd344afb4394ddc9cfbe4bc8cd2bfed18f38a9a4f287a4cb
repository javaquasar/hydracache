        'security-input-view-diagnostic-tests-20261026.rs','security-input-view-diagnostic-entry-20261026.rs',
        'security-input-view-first-diagnostic-20261026.rs',Path(__file__).name):
    take('coordinator/'+name,(ROOT/'target'/name).read_bytes())
