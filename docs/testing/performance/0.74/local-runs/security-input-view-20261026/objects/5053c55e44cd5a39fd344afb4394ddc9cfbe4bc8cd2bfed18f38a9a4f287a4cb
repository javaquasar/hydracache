    return subprocess.check_output(['git','--no-replace-objects','show',revision+':'+name],cwd=ROOT)
base = 'fa9e708868b22999d60c9ccd97b694662910a095'
producer = '2a4a771d48ed6ad54288fd15ea7c75b56f4bd80d'
for name in ('Cargo.toml','Cargo.lock','tools/long-run-supervisor-074/src/diagnostic_manager_channel.rs'):
    take('baseline/'+name,frozen(base,name))
    take('producer/'+name,frozen(producer,name))
for label,revision in (('root-baseline',base),('root-historical','33c54b0cda8c330b115009cdf092ad002077cedf')):
