"""Seal exact test-source compatibility, never execution or package admission."""
import hashlib
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
RAW = ROOT/'target/security-input-view-20261026'
OUT = ROOT/'docs/testing/performance/0.74/local-runs/security-input-view-20261026'
PHASES = {
    'focused':101,'oidc-lock':0,'manager-guards':101,
    'focused-diagnostic-successor':101,'manager-diagnostic-successor':101,
    'focused-terminal-root':0,'manager-terminal-root':0,
    'windows-check':0,'windows-clippy':0,'msrv-focused':0,
    'gnu-focused':101,'gnu-git-diagnosis':128,'gnu-explicit-git-context':0,
    'gnu-focused-explicit-git':0,'graph-controls':0,
    'terminal-regression':0,'root-terminal-regression':0,'format':0,'doc':0,'contract':0,
}
counts = {}
for phase,code in PHASES.items():
    result = json.loads((RAW/phase/'result.json').read_bytes())
    if (result['exit'] != code or result['outer_refusal'] is not None or
            result['source_unchanged'] is not True or result['commit_unchanged'] is not True):
        raise ValueError('unexpected first phase outcome: '+phase)
    log = (RAW/phase/'stdout.log').read_text(encoding='utf-8')
    rows = re.findall(r'test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored; (\d+) measured; (\d+) filtered out;',log)
    if rows:
        counts[phase] = dict(targets=len(rows),totals=[sum(int(row[i]) for row in rows) for i in range(5)])
for phase in ('focused-terminal-root','msrv-focused','gnu-focused-explicit-git'):
    if counts[phase] != dict(targets=3,totals=[15,0,0,0,0]):
        raise ValueError('focused compatibility counts differ')
for phase,wanted in (('manager-guards',[9,5,0,0,307]),
        ('manager-diagnostic-successor',[13,1,0,0,307]),('manager-terminal-root',[14,0,0,0,307]),
        ('oidc-lock',[1,0,0,0,320]),('gnu-focused',[0,3,0,0,0])):
    if counts[phase]['totals'] != wanted:
        raise ValueError('first guard counts differ')
if 'Ran 22 tests' not in (RAW/'graph-controls/stderr.log').read_text():
    raise ValueError('independent graph controls differ')
head = subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
if head != 'e468b74fe6034cf7614c70e7002d54eea99166b0':
    raise ValueError('unexpected source head')
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def take(name,raw):
    if name in members:
        raise ValueError('duplicate member')
    digest = hashlib.sha256(raw).hexdigest()
    path = OUT/'objects'/digest
    if not path.exists():
        with path.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw),sha256=digest)
for phase in PHASES:
    for path in sorted((RAW/phase).rglob('*')):
        if path.is_file():
            take('checks/'+phase+'/'+path.relative_to(RAW/phase).as_posix(),path.read_bytes())
paths = ['Cargo.toml','Cargo.lock','deny.toml','docs/COMPAT.md',
    'docs/testing/performance/0.74/qualification-manifest.toml',
    'crates/xtask/tests/performance_contract_074.rs','crates/xtask/tests/security_input_view_074.rs',
    'crates/xtask/tests/source_successor_view_074.rs','crates/xtask/tests/historical_input_view_074.rs',
    'tools/security-input-view-074/contract.rs','tools/security-input-view-074/rules.json',
    'tools/security-input-view-074/README.md','tools/source-successor-view-074/contract.rs',
    'tools/source-successor-view-074/diagnostic.rs','tools/source-successor-view-074/diagnostic-additions.txt',
    'tools/source-successor-view-074/rules.json','tools/authority-runtime-074/gate.rs',
