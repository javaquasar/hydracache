for label,revision in (('doc-previous','a67a5299ab335424e9b11330dc06bd749ea9b859'),
        ('doc-producer','d3256fc08b8da2df424d6da5bce99c0e168939b0')):
    take(label+'/COMPAT.md',frozen(revision,'docs/COMPAT.md'))
for name in ('run-security-input-view-20261026.py','prepare-security-input-view-20261026.py',
        'prepare-diagnostic-doc-view-20261026.py','prepare-security-root-predecessor-20261026.py',
