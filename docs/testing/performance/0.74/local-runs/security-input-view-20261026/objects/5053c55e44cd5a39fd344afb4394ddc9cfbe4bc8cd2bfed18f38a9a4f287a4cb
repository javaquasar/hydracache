    'tools/long-run-supervisor-074/src/diagnostic_manager_channel.rs',
    'tools/long-run-supervisor-074/src/diagnostic_manager_channel_kernel.rs']
for name in paths:
    take('current/'+name,(ROOT/name).read_bytes())
