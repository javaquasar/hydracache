"""Seal saved structural gates and the first independent staged reader."""
from pathlib import Path
import hashlib,json,subprocess,sys
root=Path(__file__).resolve().parent.parent
base=root/'docs/testing/performance/0.74/local-runs/dispatch-result-custody-gates-20261025'
members,objects={},{}
def add(name,raw):
    digest=hashlib.sha256(raw).hexdigest();assert name not in members
    members[name]=dict(sha256=digest,bytes=len(raw));objects[digest]=raw
for label in ('handoff-historical-final-20261025','handoff-compile-final-20261025','handoff-tabnanny-final-20261025',
    'handoff-v3-final-20261025','handoff-doc-check-20261025','handoff-local-contract-20261025'):
    folder=root/'target/source-continuation-20261024'/label
    before=json.loads((folder/'intent.json').read_bytes());after=json.loads((folder/'result.json').read_bytes())
    assert before['source']==after['source_after'] and after['source_unchanged'] and after['head_unchanged']
    assert after['exit']==0 and after['outer_refusal'] is None
    for path in sorted(folder.iterdir()):
        assert path.is_file();add(label+'/'+path.name,path.read_bytes())
assert b'Ran 91 tests' in objects[members['handoff-historical-final-20261025/stderr.log']['sha256']]
reader=root/'target/verify-dispatch-handoff-20261025.py'
receipt=root/'target/dispatch-handoff-staged-reader-first-20261025';receipt.mkdir(exist_ok=False)
argv=[sys.executable,str(reader)]
(receipt/'intent.json').write_text(json.dumps(dict(argv=argv,producer_repeated=False)),encoding='utf-8')
result=subprocess.run(argv,cwd=root,capture_output=True,timeout=30)
(receipt/'stdout.log').write_bytes(result.stdout);(receipt/'stderr.log').write_bytes(result.stderr)
(receipt/'result.json').write_text(json.dumps(dict(exit=result.returncode)),encoding='utf-8')
assert result.returncode==0,result.stderr
assert json.loads(result.stdout)['staged_verified']
for path in sorted(receipt.iterdir()):add('staged-reader/'+path.name,path.read_bytes())
for name in ('retain-dispatch-handoff-gates-20261025.py','verify-dispatch-handoff-20261025.py'):
    add('retention/'+name,(root/'target'/name).read_bytes())
index=dict(schema='hc074-dispatch-result-custody-gates-v1',members=members,
    upstream_index_sha256='3b42f4e9373ef4f99b03935b3af9a1acbc1439c246a71b43e86982bf2e7cf771',
    historical_python_cases=91,actual_target_dispatches=0,full_package_pass=False,admission=False)
base.mkdir(exist_ok=False);(base/'objects').mkdir()
for digest,raw in objects.items():(base/'objects'/digest).write_bytes(raw)
(base/'index.json').write_bytes((json.dumps(index,indent=2,sort_keys=True)+'\n').encode())
(base/'.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps(dict(index_sha256=hashlib.sha256((base/'index.json').read_bytes()).hexdigest(),members=len(members),objects=len(objects))))
