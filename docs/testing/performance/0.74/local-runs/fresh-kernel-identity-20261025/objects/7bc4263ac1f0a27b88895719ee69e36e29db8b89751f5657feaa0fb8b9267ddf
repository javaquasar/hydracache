SOURCE_B64=''
PROTOCOL_B64=''
"""One bounded isolated fresh identity prototype screen; old runtime remains unchanged."""
from pathlib import Path
import base64,hashlib,json,os,signal,subprocess,sys,time
base=Path('/tmp/hc074-server-gate-root-20261025.0k0xbdah');root=base/'fd-identity-screen-first'
upload=Path('/tmp/hc074-server-gate-upload-20261025.pvdj0f6c')
image='6640e1b9b31ae7c87137b335be4f2665d729ea7b4324ee0e874bdbedc346c520'
raw=(base/'server-fault-worker-20261025.py').read_bytes()
assert hashlib.sha256(raw).hexdigest()=='af1e9926e1ad40bc49c1c225d79f5fffc788c715a7889743decea129ec4b17a3'
assert sys.argv[1]==image
scope={};exec(compile(raw.decode().split('started=time.monotonic_ns()\n')[0],'<pinned-preflight>','exec'),scope)
preflight=scope['preflight']
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def publish(name,value):
 with (root/name).open('x') as f:json.dump(value,f,indent=2);f.flush();os.fsync(f.fileno())
def limited():
 os.sched_setaffinity(0,{5});os.setgroups([]);os.setgid(1000);os.setuid(1000)
publish('consumed.json',dict(protocol=json.loads(base64.b64decode(PROTOCOL_B64)),
 baseline_commit='11445ff7304fa49beaf3be16ed6393155f5a183b',retry=False,product=False,admission=False))
result=dict(cases=[],first_refusal=None,postflight_refusal=None,passed=False,runtime_integrated=False)
before=None
try:
 before=preflight();publish('preflight.json',before)
 assert (base/'signer-fixed-home-first/result.json').is_file()
 target=upload/'fd-identity-screen-first';target.mkdir(mode=0o700);os.chown(target,1000,1000)
 for name,raw in [('screen.rs',base64.b64decode(SOURCE_B64)),('protocol.json',base64.b64decode(PROTOCOL_B64))]:
  p=target/name
  with p.open('xb') as f:f.write(raw)
  os.chown(p,1000,1000);os.chmod(p,0o400)
 tool=upload/'toolchain-v3/bin/rustc'
 assert sha(tool)=='103b60e1b1339968c1d74202ea1d45686037e82c4ea3e0569de24b18a1e6836a'
 library=upload/'build-target-v3/release/deps/liblibc-0f6644dfc1fb6414.rlib'
 assert sha(library)=='90c20dc8aa21074c47e80c68f97580539afeaf6e2bea3cf46e9498daa230ad97'
 env=dict(PATH='/usr/bin:/bin',TMPDIR=str(target),HOME=str(upload/'signer-home-first'))
 argv=[str(tool),'--edition=2021','-Copt-level=3','-Cdebuginfo=0','-Dwarnings',
  '--extern','libc='+str(library),str(target/'screen.rs'),'-o',str(target/'screen')]
 publish('build-command.json',dict(argv=argv,env=env,source_sha256=sha(target/'screen.rs'),protocol_sha256=sha(target/'protocol.json')))
 p=subprocess.run(argv,cwd=target,env=env,preexec_fn=limited,capture_output=True,timeout=120)
 (root/'build.stdout.log').write_bytes(p.stdout);(root/'build.stderr.log').write_bytes(p.stderr)
 publish('build-result.json',dict(exit=p.returncode));assert p.returncode==0
 publish('binary.json',dict(sha256=sha(target/'screen'),bytes=(target/'screen').stat().st_size))
 origin=time.monotonic_ns()
 for cohort in range(8):
  assert time.monotonic_ns()-origin<180_000_000_000
  with (root/f'cohort-{cohort}.stdout.log').open('xb') as stdout,(root/f'cohort-{cohort}.stderr.log').open('xb') as stderr:
   argv=[str(target/'screen'),str(cohort)]
   p=subprocess.Popen(argv,cwd=target,env=env,preexec_fn=limited,stdout=stdout,stderr=stderr,start_new_session=True)
   publish(f'cohort-{cohort}-child.json',dict(pid=p.pid,start_ticks=scope['ticks'](p.pid),affinity=sorted(os.sched_getaffinity(p.pid)),argv=argv))
   try:code=p.wait(timeout=20)
   except subprocess.TimeoutExpired:
    os.killpg(p.pid,signal.SIGKILL);p.wait();raise RuntimeError('first leaf process timed out; no retry')
  row=dict(cohort=cohort,exit=code);publish(f'cohort-{cohort}-result.json',row);result['cases'].append(row)
  assert code==0
 result['passed']=len(result['cases'])==8
except BaseException as error:result['first_refusal']=f'{type(error).__name__}: {error}'
finally:
 try:
  after=preflight();assert before is not None and before==after;publish('postflight.json',after)
 except BaseException as error:result['postflight_refusal']=f'{type(error).__name__}: {error}';result['passed']=False
 publish('result.json',result)
