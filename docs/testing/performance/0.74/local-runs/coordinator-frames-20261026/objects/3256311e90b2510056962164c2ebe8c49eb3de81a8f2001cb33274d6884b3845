"""Retain model-only coordinator telemetry proof and synthetic first output."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'docs/testing/performance/0.74/local-runs/coordinator-frames-20261026'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def add(name, raw):
    digest = hashlib.sha256(raw).hexdigest()
    path = OUT/'objects'/digest
    if not path.exists():
        with path.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)
def take(name, path):
    add(name, path.read_bytes())
for label in ('coordinator-frames-model-first', 'coordinator-frames-model-precommit',
              'coordinator-frames-caller-regressions', 'coordinator-frames-accounting-regressions',
              'coordinator-frames-syntax', 'coordinator-frames-synthetic-first'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('coordinator_frames.py', 'test_coordinator_frames.py', 'git_cpu_overhead.py',
             'coordinator-frames-protocol.toml', 'coordinator-frames-design.md'):
    take('source/tools/xtask-package-attribution-074/'+name, ROOT/'tools/xtask-package-attribution-074'/name)
for name in ('coordinator_frames.py', 'test_coordinator_frames.py', 'git_cpu_overhead.py'):
    take('raw-first-model/'+name, ROOT/'target/coordinator-frames-first-model-source'/name)
for part in ('intent.json', 'result.json'):
    take('synthetic/'+part, ROOT/'target/coordinator-frames-synthetic-20261026/first'/part)
take('synthetic/control.py', ROOT/'target/coordinator-frames-synthetic-20261026.py')
for name in ('run-ci-watchdog-step-20261026.py', 'run-source-step-20261024.py'):
    take('runners/'+name, ROOT/'target'/name)
take('collector.py', Path(__file__))
old = ROOT/'docs/testing/performance/0.74/local-runs/pipe-fixture-git-overhead-20261026'
raw = (old/'index.json').read_bytes()
require_sha = '1ba276dcf62f97801f69806ea5efba138c7d47425f30d2563874aa393681fcff'
assert hashlib.sha256(raw).hexdigest() == require_sha
add('baseline/index.json', raw)
entry = json.loads(raw)['members']['source/tools/xtask-package-attribution-074/git_cpu_overhead.py']
body = (old/'objects'/entry['sha256']).read_bytes()
assert len(body) == entry['bytes'] and hashlib.sha256(body).hexdigest() == entry['sha256']
add('baseline/git_cpu_overhead.py', body)
index = dict(schema='hc074-model-coordinator-frames-evidence-v1', source_commit='e6ef8937297042a2cb4f45386af360db6c9c8732',
    new_models=20, caller_regressions=16, accounting_regressions=20, synthetic_cases=4,
    native_control_executed=False, new_workload_calls=0, overhead_accepted=False, package_pass=False,
    server=False, members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members), objects=len(list((OUT/'objects').iterdir()))))
