    def test_gate_is_strict_boolean_and_cli_flag_is_exact(self):
        with patch.object(base, 'AccountingApi') as api:
            for value in (None, 1, 'true'):
                with self.assertRaises(Refusal):
                    base.run('build', 'first', coordinator_frames=value)
            with patch('sys.argv', [base.__file__, 'build', 'first', '--other']), self.assertRaises(Refusal):
                runpy.run_path(base.__file__, run_name='__main__')
            api.assert_not_called()


