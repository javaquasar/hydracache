"""Seal final local checks apart from the model/synthetic packet."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/coordinator-frames-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)
for name, label in [('integrity', 'coordinator-frames-integrity'), ('syntax', 'coordinator-frames-verifier-syntax'),
                    ('check', 'coordinator-frames-check'), ('clippy', 'coordinator-frames-clippy'),
                    ('doc', 'coordinator-frames-doc-check'), ('contract', 'coordinator-frames-contract')]:
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take(name+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('verify.py', 'test_verify.py'):
    take(name, PACKET/name)
take('collector.py', Path(__file__))
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
index = dict(model_index_sha256='7f768549711cb4cdd5a0e2de8bcac1502951499c5a36e28f05c678dd483d2eb1',
    members=members, native_control_executed=False, new_workload_calls=0, package_pass=False, qualification=False, server=False)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
