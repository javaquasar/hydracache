def write(name,value):(OUT/name).write_text(json.dumps(value,indent=2,sort_keys=True)+'\n')
write('intent.json',dict(read_only=True,launcher_sha256=sha(Path(__file__).read_bytes()),gate_replay=False))
db='C:/Users/ArturBuzov/.cargo/advisory-dbs/advisory-db-3157b0e258782691'
