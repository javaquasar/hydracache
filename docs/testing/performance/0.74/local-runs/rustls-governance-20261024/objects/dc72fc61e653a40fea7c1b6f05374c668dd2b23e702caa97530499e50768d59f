"""Retain subsequent structural checks without rewriting preceding packets."""
from pathlib import Path
import hashlib
import json
ROOT=Path(__file__).resolve().parent.parent
RAW=ROOT/'target/security-patch-20261024'
DEST=ROOT/'docs/testing/performance/0.74/local-runs/rustls-governance-20261024'
files={}
DEST.mkdir();(DEST/'objects').mkdir()
def sha(raw):return hashlib.sha256(raw).hexdigest()
def retain(name,raw):
    key=sha(raw);path=DEST/'objects'/key
    if not path.exists():
        with path.open('xb') as stream:stream.write(raw)
    elif path.read_bytes()!=raw:raise ValueError('Collision')
    files[name]=dict(bytes=len(raw),sha256=key)
for name in ('rustls-doc-check','rustls-local-contract'):
    result=json.loads((RAW/name/'result.json').read_bytes())
    if result['exit'] or result['outer_refusal'] or not result['source_unchanged'] or not result['commit_unchanged']:
        raise ValueError('Structural check refused')
    for path in sorted((RAW/name).iterdir()):
        if path.is_file():retain('observation/'+name+'/'+path.name,path.read_bytes())
retain('coordinator/'+Path(__file__).name,Path(__file__).read_bytes())
facts=dict(full_verify_pass=False,release_admission=False,qualification=False,
    working_lock_sha256=sha((ROOT/'Cargo.lock').read_bytes()),
    qualification_manifest_sha256=sha((ROOT/'docs/testing/performance/0.74/qualification-manifest.toml').read_bytes()))
with (DEST/'index.json').open('x',encoding='utf-8',newline='\n') as stream:
    json.dump(dict(schema='hc074-rustls-structural-v1',files=files,facts=facts),stream,indent=2,sort_keys=True);stream.write('\n')
with (DEST/'.gitattributes').open('x',encoding='ascii',newline='\n') as stream:
    stream.write('index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(dict(files=len(files),objects=len(list((DEST/'objects').iterdir())),index_sha256=sha((DEST/'index.json').read_bytes())))
