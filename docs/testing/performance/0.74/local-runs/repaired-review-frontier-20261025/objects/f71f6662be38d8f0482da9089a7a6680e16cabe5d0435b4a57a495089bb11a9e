"""Staged source/data/verdict joins only; no repeat of the selected test target."""
from pathlib import Path
import hashlib,json,subprocess,sys
root=Path(__file__).resolve().parent.parent
base='docs/testing/performance/0.74/local-runs/repaired-review-frontier-20261025'
get=lambda name:subprocess.check_output(['git','show',':'+name],cwd=root)
sha=lambda raw:hashlib.sha256(raw).hexdigest()
raw=get(base+'/index.json');index=json.loads(raw);values={}
for name,row in index['members'].items():
    body=get(base+'/objects/'+row['sha256'])
    assert sha(body)==row['sha256'] and len(body)==row['bytes'];values[name]=body
for name,digest in index['upstream_indexes'].items():assert sha(get(name))==digest
for phase in index['phases']:
    before=json.loads(values['checks/'+phase['name']+'/intent.json'])
    after=json.loads(values['checks/'+phase['name']+'/result.json'])
    assert after['exit']==phase['exit'] and after['outer_refusal'] is None
    assert after['source_unchanged'] and after['head_unchanged'] and before['source']==after['source_after']
sys.path.insert(0,str(root/'tools/xtask-package-attribution-074'))
import contract_frontier_audit as audit,review
frontier=json.loads(values['derived/offline-frontier.json'])
assert audit.analyze(root)==frontier
before=json.loads(values['selected-target/intent.json']);after=json.loads(values['selected-target/result.json'])
assert before['head']==index['code_commit'] and before['bound_seconds']==780 and before['retry'] is False
assert before['source']==after['source_after'] and after['source_unchanged'] and after['head_unchanged']
parsed=review.parse_transcript(values['selected-target/stdout.log'].decode(),values['selected-target/stderr.log'].decode(),
    [audit.TARGET],after['exit'],after['outer_refusal'],780)
saved=json.loads(values['derived/selected-target.json'])
assert saved['selected_target_pass']==parsed.pop('package_pass')==index['selected_target_pass']
for name,value in parsed.items():assert saved[name]==value
observed={c['name'] for r in parsed['targets'] for c in r['cases']}
assert observed<=frontier['source_case_catalog'].keys()
if parsed['complete']:assert observed==frontier['source_case_catalog'].keys()
for name,body in values.items():
    if name.startswith('code/'):
        path=name.removeprefix('code/');assert sha(body)==before['source'][path]
        expected=subprocess.check_output(['git','show',index['code_commit']+':'+path],cwd=root)
        assert body.decode().replace('\r\n','\n')==expected.decode().replace('\r\n','\n')
    if name.startswith('protected/'):
        path=name.removeprefix('protected/');assert sha(body)==index['protected_sha256'][path]==sha((root/path).read_bytes())
assert not saved['full_package_pass'] and not index['full_package_pass'] and not index['full_package_repeated']
receipt=dict(schema='hc074-repaired-review-frontier-staged-readback-v1',index_sha256=sha(raw),members=len(values),
    selected_target_pass=saved['selected_target_pass'],observed_cases=len(observed),declared_cases=321,
    full_package_pass=False,producer_repeated=False,admission=False)
with (root/(base+'-staged-verification.json')).open('x',encoding='utf-8') as stream:
    json.dump(receipt,stream,indent=2,sort_keys=True);stream.write('\n')
print(json.dumps(receipt,sort_keys=True))
