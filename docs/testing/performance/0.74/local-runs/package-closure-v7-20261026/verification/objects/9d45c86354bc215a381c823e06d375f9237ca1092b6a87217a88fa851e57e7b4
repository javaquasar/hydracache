"""Retain offline verifier and final local checks only; no workload execution."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/package-closure-v7-20261026/verification'
assert {p.name for p in OUT.iterdir()} == {'.gitattributes'}
members, objects = {}, {}

def add(name, raw):
    assert name not in members
    digest = hashlib.sha256(raw).hexdigest()
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

for label in ('refusal-verify-first', 'refusal-controls-first', 'doc-final', 'contract-final'):
    folder = ROOT / 'target/package-review-v7-20261026' / label
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['commit_unchanged']
    for path in sorted(folder.rglob('*')):
        if path.is_file():
            add('checks/' + label + '/' + path.relative_to(folder).as_posix(), path.read_bytes())
for name in ('verify.py', 'test_verify.py'):
    add('verifier/' + name, (OUT.parent / name).read_bytes())
for name in ('retain-package-v7-result-20261026.py', Path(__file__).name):
    add('coordinators/' + name, (ROOT / 'target' / name).read_bytes())
for name in ('docs/testing/performance/0.74/package-review-v7-result-20261026.md',
             'docs/testing/performance/0.74/release-closure-execution-plan-20261026.md'):
    add('documents/' + name, (ROOT / name).read_bytes())
(OUT / 'objects').mkdir()
for digest, raw in objects.items():
    with (OUT / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-package-v7-final-checks-v1', members=members,
             package_replayed=False, source_modified=False, services=False, clocks=False,
             server=False, qualification=False, admission=False)
with (OUT / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, sort_keys=True, indent=2)
    stream.write('\n')
print(json.dumps(dict(members=len(members), index_sha256=hashlib.sha256((OUT / 'index.json').read_bytes()).hexdigest())))
