"""Retain all native component first sources/results; no workload or gate replay."""
from pathlib import Path
import hashlib
import json
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/historical-blob-native-20261024'
PHASES = ('blob-native-build-v1', 'blob-native-controls-v1', 'blob-native-controls-v2',
          'blob-native-check', 'blob-native-clippy', 'blob-native-final-controls',
          'blob-native-msrv-controls', 'blob-native-python-controls', 'blob-native-python-syntax',
          'blob-native-python-indentation', 'blob-native-format', 'blob-native-no-expansion-controls',
          'blob-native-no-expansion-msrv', 'blob-native-no-expansion-check',
          'blob-native-no-expansion-clippy', 'blob-native-no-expansion-format')
PROTECTED = {
    'Cargo.toml': '18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock': 'd2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml':
        '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


assert subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT).decode().strip() == \
    'da762d686ec585f872438b19d441ba01d2e5562a'
assert all(sha((ROOT / path).read_bytes()) == digest for path, digest in PROTECTED.items())
members, objects, phases, matrices = {}, {}, [], []


def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


for phase in PHASES:
    folder = ROOT / 'target/source-continuation-20261024' / phase
    intent = json.loads((folder / 'intent.json').read_bytes())
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged']
    assert intent['source'] == result['source_after']
    assert not result['admission'] and not result['qualification']
    for name in ('intent.json', 'stdout.log', 'stderr.log', 'result.json'):
        add(f'checks/{phase}/{name}', (folder / name).read_bytes())
    source = ROOT / 'target/blob-native-source-snapshots-20261024' / phase
    add(f'phase-sources/{phase}/index.json', (source / 'index.json').read_bytes())
    for path, digest in json.loads((source / 'index.json').read_bytes()).items():
        body = (source / digest).read_bytes()
        assert sha(body) == digest == intent['source'][path]
        add(f'phase-sources/{phase}/{path}', body)
    stdout = (folder / 'stdout.log').read_text()
    stderr = (folder / 'stderr.log').read_text()
    rust = re.findall(r'test result: ok\. (\d+) passed; 0 failed;', stdout)
    python = re.search(r'Ran (\d+) tests in ', stderr)
    phases.append(dict(phase=phase, exit=0, rust_target_passes=list(map(int, rust)),
                       python_passes=int(python[1]) if python else None,
                       source_unchanged=True, head_unchanged=True))
    capture = ROOT / 'target/blob-native-transport-20261024' / phase
    if capture.is_dir():
        oracle = json.loads((capture / 'oracle.stdout.json').read_bytes())
        assert not oracle['source_authority'] and len(oracle['cases']) == 6
        completion = json.loads((capture / 'result.json').read_bytes())
        assert len(completion['cases']) == 6 and not completion['admission']
        for number, case in enumerate(oracle['cases']):
            observed = json.loads((capture / f'native-case-{number}.json').read_bytes())
            assert observed['outputs'] == case['expected']
            assert len(case['specs']) == len(case['pins']) == len(case['expected']) == 9
            assert completion['cases'][number]['matched']
            if case['python_prototype'] is not None:
                assert case['python_prototype'] == case['expected'] and case['policy'] == 'disabled'
        assert oracle['cases'][3]['expected'][0] != oracle['cases'][4]['expected'][0]
        assert oracle['cases'][0]['expected'][0] == oracle['cases'][3]['expected'][0]
        for path in sorted(capture.iterdir()):
            assert path.is_file()
            add(f'native/{phase}/{path.name}', path.read_bytes())
        matrices.append(dict(phase=phase, cases=6, matched_results=54, python_prototype_results=18))
    cleanup = capture.with_name(capture.name + '-owned-cleanup')
    if cleanup.is_dir():
        assert {p.name for p in cleanup.iterdir()} == {'park.json', 'overflow.json', 'stdout-overflow.json'}
        for path in sorted(cleanup.iterdir()):
            value = json.loads(path.read_bytes())
            assert int(value['started_pid']) > 0 and value['unrelated_alive']
            assert value['all_writer_authority'] is False
            assert value['result'] == ('Err(Deadline)' if path.name == 'park.json' else 'Err(Budget)')
            add(f'native/{phase}-owned-cleanup/{path.name}', path.read_bytes())

assert len(matrices) == 6
assert next(p for p in phases if p['phase'] == 'blob-native-python-controls')['python_passes'] == 26
for label in ('blob-native-no-expansion-controls', 'blob-native-no-expansion-msrv'):
    assert next(p for p in phases if p['phase'] == label)['rust_target_passes'] == [9, 6]
final_source = ROOT / 'target/blob-native-source-snapshots-20261024/blob-native-no-expansion-controls'
for path, digest in json.loads((final_source / 'index.json').read_bytes()).items():
    assert sha((ROOT / path).read_bytes()) == digest
add('sources/final/README.md', (ROOT / 'tools/historical-blob-batch-074/README.md').read_bytes())
for path in ('target/run-blob-transport-step-20261024.py', 'target/run-fresh-reader-20261024.py',
             'target/run-source-step-20261024.py', 'target/seal-blob-native-20261024.py'):
    add('coordinators/' + Path(path).name, (ROOT / path).read_bytes())
index = dict(schema='hc074-blob-native-differential-evidence-v1',
    code_commit='da762d686ec585f872438b19d441ba01d2e5562a', members=members,
    facts=dict(phases=phases, matrices=matrices, protected_sha256=PROTECTED,
        semantic_repeats_are_not_speedup_samples=True, first_versions_retained=True,
        old_full_missing_strictness_preserved=True, short_queries_expanded=False,
        policy_explicit=True, synthetic_config_isolation=True,
        mutable_refs_or_config_between_observations_proved=False,
        production_pin_authority=False, old_loader_integrated=False, ordinary_package_pass=False,
        original_windows_or_live_frequency_changed=False, dependency_changes=False,
        server=False, service_or_clock=False, original_owner=False, all_writer_authority=False,
        product_workload=False, measurement=False, qualification=False, push=False))
OUT.mkdir(parents=True, exist_ok=False)
(OUT / 'objects').mkdir()
(OUT / '.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for digest, raw in objects.items():
    (OUT / 'objects' / digest).write_bytes(raw)
raw = (json.dumps(index, sort_keys=True, indent=2) + '\n').encode()
(OUT / 'index.json').write_bytes(raw)
print(json.dumps(dict(index_sha256=sha(raw), members=len(members), objects=len(objects), phases=len(phases), matrices=matrices)))
