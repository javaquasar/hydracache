#[test]
fn transport_child_fixture() {
    let Some(mode) = std::env::var_os("HC074_BLOB_CHILD") else {
        return;
    };
    let marker = std::env::var_os("HC074_BLOB_CHILD_MARKER").unwrap();
    fs::write(marker, std::process::id().to_string()).unwrap();
    match mode.to_str().unwrap() {
        "exit" => std::process::exit(7),
        "stdin" => {
            let mut raw = vec![];
            std::io::stdin().read_to_end(&mut raw).unwrap();
            std::io::stdout().write_all(&raw).unwrap();
        }
        "environment" => assert_eq!(
            transport::git(
                Path::new("unused"),
                Replacements::Default,
                &["version"],
                &[],
                Instant::now() + transport::BOUND
            ),
            Err(Refusal::Environment)
        ),
        "overflow" => {
            std::io::stderr()
                .write_all(&vec![b'x'; 64 * 1024 + 1])
                .unwrap();
            loop {
                std::thread::park();
            }
        }
        "park" => loop {
            std::thread::park();
        },
        _ => panic!("fixture mode"),
    }
}
