"""Read-only packet and staged-byte verification; archived code is never run."""
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys
ROOT = Path(__file__).resolve().parent.parent
packets = [('package-effect-syntax-v9-20261027', 'e2c54681e571204fc927d7df3fe99a08303474c52af7a945d1a2764bb601bfc9')]
if len(sys.argv) == 2:
    packets.append(('package-review-v9-20261027', sys.argv[1]))
else:
    assert len(sys.argv) == 1
def sha(raw): return hashlib.sha256(raw).hexdigest()
expected = {}
for label, digest in packets:
    folder = ROOT / 'docs/testing/performance/0.74/local-runs' / label
    raw = (folder / 'index.json').read_bytes()
    assert re.fullmatch('[a-f0-9]{64}', digest) and sha(raw) == digest
    index = json.loads(raw)
    assert index['package_pass'] is False and index['release_admitted'] is False
    digests = set()
    for name, row in index['members'].items():
        path = PurePosixPath(name)
        assert not path.is_absolute() and '..' not in path.parts and path.as_posix() == name
        assert re.fullmatch('[a-f0-9]{64}', row['sha256'])
        body = (folder / 'objects' / row['sha256']).read_bytes()
        assert len(body) == row['bytes'] and sha(body) == row['sha256'], name
        digests.add(row['sha256'])
        expected[(folder / 'objects' / row['sha256']).relative_to(ROOT).as_posix()] = body
    assert {p.name for p in (folder / 'objects').iterdir()} == digests
    expected[(folder / 'index.json').relative_to(ROOT).as_posix()] = raw
names = sorted(expected)
query = b''.join((':' + name + '\n').encode() for name in names)
result = subprocess.run(['git', '--no-replace-objects', 'cat-file', '--batch'], cwd=ROOT,
    input=query, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, check=True)
assert not result.stderr
at = 0
for name in names:
    end = result.stdout.index(b'\n', at)
    header = result.stdout[at:end].split()
    assert len(header) == 3 and header[1] == b'blob', name
    size = int(header[2])
    at = end + 1
    assert result.stdout[at:at + size] == expected[name], name
    assert result.stdout[at + size:at + size + 1] == b'\n'
    at += size + 1
assert at == len(result.stdout)
print(json.dumps(dict(packets=packets, staged_blobs=len(names), data_and_staged_bytes_exact=True,
    archived_code_executed=False, package_pass=False, release_admitted=False)))
