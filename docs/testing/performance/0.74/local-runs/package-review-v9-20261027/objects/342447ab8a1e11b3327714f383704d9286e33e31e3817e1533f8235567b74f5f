def require(value, reason):
    if not value:
        raise ValueError(reason)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def decode(raw):
    def pairs(items):
        value = {}
        for key, item in items:
            require(key not in value, 'duplicate JSON key')
            value[key] = item
        return value
    return json.loads(raw, object_pairs_hook=pairs)


def document_digest(document):
    return sha(json.dumps(document, sort_keys=True, separators=(',', ':')).encode())


def read_inside(root, name):
    relative = Path(name)
    require(not relative.is_absolute() and '..' not in relative.parts, 'nonrelative review input')
    path = (root / relative).resolve(strict=True)
    require(path.is_relative_to(root), 'review input outside repository')
    return path.read_bytes()


def previous(root):
    raw = read_inside(root, PREVIOUS_PACKET + '/index.json')
    require(sha(raw) == PREVIOUS_INDEX_SHA256, 'V8 index drift')
    index = decode(raw)
    values = []
    for name, digest in [('review/gate.json', PREVIOUS_GATE_SHA256), ('syntax/result.json', PREVIOUS_SYNTAX_SHA256)]:
        row = index['members'][name]
        require(row['sha256'] == digest, 'V8 member pointer drift')
        raw = read_inside(root, PREVIOUS_PACKET + '/objects/' + digest)
        require(sha(raw) == digest and len(raw) == row['bytes'], 'V8 member bytes drift')
        values.append(decode(raw))
    gate, document = values
    require((len(gate['sources']), len(gate['auxiliary']), len(gate['targets'])) == (374, 54, 148), 'V8 inventory drift')
    require(document_digest(document) == PREVIOUS_AST_SHA256 and
            {r['source']: r['sha256'] for r in document['sources']} == gate['sources'], 'V8 syntax/source drift')
    return gate, document


def checked_auxiliary(root):
    old = previous(root)[0]['auxiliary']
    require(not old.keys() & EXTRA_AUXILIARY.keys(), 'auxiliary addition collision')
    expected = {**old, **EXTRA_AUXILIARY}
    actual = {name: sha(read_inside(root, name)) for name in expected}
    require(actual == expected and len(actual) == 56, 'reviewed auxiliary input drift')
    return actual


def load_context(root):
    path = root / 'tools/historical-blob-batch-074/module_context_v5.py'
    require(sha(path.read_bytes()) == CONTEXT_SHA256, 'context body drift')
    spec = importlib.util.spec_from_file_location('hc074_checked_context_v9', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def target_catalog(root):
    manifest = tomllib.loads(read_inside(root, 'crates/xtask/Cargo.toml').decode())
    require(manifest['package']['name'] == 'xtask' and manifest['package'].get('autotests', True)
            and 'test' not in manifest, 'default package discovery drift')
    return ['unittests src/lib.rs', 'unittests src/main.rs'] + sorted(
        'tests/' + p.name for p in (root / 'crates/xtask/tests').glob('*.rs'))


def source_review(root, document):
    root = root.resolve(strict=True)
    require(document_digest(document) == REVIEWED_AST_SHA256, 'unreviewed v9 syntax/source inventory')
    require(document['executed_input_code'] is False and document['compiler_expansion'] is False, 'source-only inventory scope')
    rows = {r['source']: r for r in document['sources']}
    require(len(rows) == len(document['sources']) == 386, 'duplicate or changed source count')
    prior, old_document = previous(root)
    old = {r['source']: r for r in old_document['sources']}
    require(not old.keys() - rows.keys(), 'old source removal')
    changed = {name for name in old if old[name] != rows[name]}
    added = rows.keys() - old.keys()
    require({n: rows[n]['sha256'] for n in changed} == CHANGED and len(changed) == 17, 'manual changed source/AST delta drift')
    require({n: rows[n]['sha256'] for n in added} == ADDED and len(added) == 12, 'manual added source/AST delta drift')
    constructors = []
    for name, row in rows.items():
        require(Path(name).suffix == '.rs' and sha(read_inside(root, name)) == row['sha256'], 'source bytes/path drift')
        for site in row['sites']:
            require(site['kind'] != 'include', 'unexpanded include edge')
            if site['kind'] in ('command-constructor', 'macro-command-constructor'):
                require(site['detail'] not in {'literal:ssh', 'literal:systemctl', 'literal:systemd-run', 'literal:wsl', 'literal:timedatectl'}, 'host/service constructor')
                constructors.append(dict(source=name, **site))
    auxiliary = checked_auxiliary(root)
    additions, unresolved = load_context(root).module_edges(root, document)
    require(not additions and not unresolved, 'module graph not closed')
    discovered = {p.relative_to(root).as_posix() for folder in ('crates/xtask/src', 'crates/xtask/tests')
                  for p in (root / folder).rglob('*.rs')}
    require(discovered <= rows.keys(), 'new uncensused Rust source')
    targets = target_catalog(root)
    expected = prior['targets'][:2] + sorted(prior['targets'][2:] + NEW_TARGETS)
    require(targets == expected and len(set(targets)) == len(targets) == 153, 'default target catalog drift')
    return dict(schema='hc074-package-effect-review-v9', reviewed_ast_sha256=REVIEWED_AST_SHA256,
        previous_ast_sha256=PREVIOUS_AST_SHA256, sources={n: r['sha256'] for n, r in rows.items()},
        auxiliary=auxiliary, targets=targets, constructors=constructors,
        changed_sources=sorted(changed), added_sources=sorted(added), delta_review=DELTA_REVIEW,
        inherited_review={k: v for k, v in prior.items() if 'review' in k},
        source_effect_review_complete=True, formal_whole_program_proof=False,
        package_dispatched=False, package_pass=False, linux_or_all_features_cleared=False,
        original_execution_or_product_or_qualification_admission=False)


def environment_preflight(root):
    checked_auxiliary(root)
    path = root / 'tools/historical-blob-batch-074/package_effects_review_v8.py'
    require(sha(path.read_bytes()) == PREVIOUS_REVIEW_SHA256, 'inherited environment review body drift')
    spec = importlib.util.spec_from_file_location('hc074_checked_review_v8_environment', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.environment_preflight(root)


