"""Independent data-only accounting; no archived producer/image execution."""
import json,sys,re,tomllib
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT/'tools/chitchat-package-r5-074'));import model as m
BASE=m.BASE
PHASES=('stage','resolve','package','build194','build188','pure194','rest194','pure188','rest188','registry','consumer194','consumer188')

def owned(get,prefix,bound=1200,expect=0):
    value=json.loads(get(prefix+'execution.json'));intent=json.loads(get(prefix+'intent.json'))
    m.need(value['retired'] and value['errors']==[] and value['exit']==expect,'complete original retired owner')
    m.need(value['bound_seconds']==intent['bound']==bound and value['capacity_poll_seconds']==value['cleanup_seconds']==5,'unchanged ownership bounds')
    return intent

def reconcile(get):
    _,u,lock=m.parent();source=m.project(u,lock);source['Cargo.lock']=get('state/resolved.lock');m.verify_source(source,u)
    raw=get('artifact/'+m.PREFIX+'.crate');files=m.verify_crate(raw,u,source);receipt=json.loads(get('artifact/receipt.json'))
    m.need(receipt['sha256']==m.sha(raw) and receipt['members']=={n:m.sha(b) for n,b in files.items()},'whole exact real package inventory')
    root_map=json.loads(get('input/frozen-root-map.json'))
    for phase in PHASES:
        base='native/'+phase+'/';result=json.loads(get(base+'result.json'));inner=json.loads(get(base+'session-result.json'))
        m.need(result['complete'] and inner['complete'] and all(result[k] is False for k in ('root_adopted','registry_qualified','release_admitted')),'whole first final phase, no promotion')
        intent=owned(get,base)
        m.need(intent['session_bound']==1100 and intent['floor']==4*1024**3 and intent['retry'] is False,'whole original local/native origin')
        m.need(all(intent['source'][n]==h for n,h in root_map.items()),'every complete original Root field preserved')
    package_intent=owned(get,'native/package/cargo-package/',780)
    m.need('package' in package_intent['argv'] and '--locked' in package_intent['argv'] and '--offline' in package_intent['argv'] and '--no-verify' not in package_intent['argv'],'actual Cargo package verifier, not canonical-tar substitution')
    passed=0;catalogs=[]
    for compiler,version in [('194','1.94.0'),('188','1.88.0')]:
        base='native/build'+compiler+'/'
        m.need(('release: '+version+'\n').encode() in get(base+'rustc-version/stdout.log'),'actual pinned compiler')
        for action in ('build','check','clippy'):owned(get,base+action+'/')
        argv=json.loads(get(base+'clippy/intent.json'))['argv'];m.need('--all-targets' in argv and '--all-features' in argv and argv[-3:]==['--','-D','warnings'],'full strict unchanged lint contract')
        rows=[json.loads(s) for s in get(base+'build/stdout.log').decode().splitlines() if s.startswith('{')]
        images=[r for r in rows if r.get('reason')=='compiler-artifact' and r.get('executable') and r['target']['kind']==['lib'] and r['profile']['test']]
        image=json.loads(get('state/image-'+compiler+'.json'))
        m.need(len(images)==1 and not images[0]['fresh'] and images[0]['executable']==image['path'],'fresh actual extracted-package image')
        names=json.loads(get('state/catalog-'+compiler+'.json'));catalogs.append(names)
        m.need(len(names)==len(set(names))==100,'complete unchanged upstream library catalog')
        selected=[]
        for mode in ('pure','rest'):
            prefix='native/'+mode+compiler+'/';selection=json.loads(get(prefix+'selection.json'))
            selected+=selection['selected'];m.need(set(selection['selected'])|set(selection['unexecuted'])==set(names),'whole catalog partition')
            for i,test in enumerate(selection['selected']):
                folder=prefix+f'case-{i:03}/';intent=owned(get,folder,5)
                m.need(intent['argv']==[image['path'],'--exact',test,'--test-threads=1','--nocapture'] and intent['image_sha256']==image['sha256'],'exact held selected test image')
                text=get(folder+'stdout.log').decode()
                m.need(re.findall(r'^test (.+?) (?:- should panic )?\.\.\. ',text,re.M)==[test] and f'1 passed; 0 failed; 0 ignored; 0 measured; {len(names)-1} filtered out;' in text,'complete actual case outcomes')
                passed+=1
        m.need(len(selected)==len(set(selected))==len(names) and set(selected)==set(names),'no omitted or duplicated library case')
    m.need(catalogs[0]==catalogs[1] and passed==200,'same complete compiler catalogs')
    registry=json.loads(get('native/registry/registry-review.json'));m.need(registry['complete'] and registry['local_registry_resolved'] and registry['checksum_negative'] and not registry['patch_fallback'] and not registry['public_registry_qualified'],'exact local registry scope')
    owned(get,'native/registry/checksum-negative/',expect=101)
    registry_frame=json.loads(get('state/consumer.json'))
    m.need(registry_frame['checksum']==m.sha(raw) and registry_frame['registry'].startswith('registry+file:///'),'exact independently resolved checksum/source')
    owned(get,'native/registry/registry-seed/')
    metadata=json.loads(get('native/registry/registry-seed/stdout.log'))
    fork=[p for p in metadata['packages'] if p['name']==m.NAME]
    m.need(len(fork)==1 and fork[0]['version']==m.VERSION and fork[0]['source']==registry_frame['registry'],'raw independent Cargo resolution under owned identity')
    consumers=0
    for compiler in ('194','188'):
        prefix='native/consumer'+compiler+'/';result=json.loads(get(prefix+'consumer-review.json'))
        m.need(result['complete'] and result['passed']==6 and result['actual_registry'] and not result['public_registry_qualified'],'actual public-surface prepublication consumer')
        for action in ('default-check','build','check','clippy','catalog'):owned(get,prefix+action+'/',10 if action=='catalog' else 1200)
        names=json.loads(get(prefix+'catalog.json'));image=json.loads(get(prefix+'image.json'));m.need(len(names)==6,'whole consumer catalog')
        for i,test in enumerate(names):
            folder=prefix+f'case-{i:02}/';intent=owned(get,folder,5)
            text=get(folder+'stdout.log').decode()
            m.need(intent['argv']==[image['path'],'--exact',test,'--test-threads=1','--nocapture'] and intent['image_sha256']==image['sha256']
                and re.findall(r'^test (.+?) (?:- should panic )?\.\.\. ',text,re.M)==[test]
                and '1 passed; 0 failed; 0 ignored; 0 measured; 5 filtered out;' in text,'complete exact consumer work');consumers+=1
    policy=[]
    for name in ('owned','upstream'):
        prefix='policy/commands/'+name+'/';result=json.loads(get(prefix+'result.json'));intent=owned(get,prefix)
        m.need(result['complete'] and result['policy_passed'] and result['database_commit']=='2295466c4e9df26647fd67d8fa1c705ac2fc7f81','same fresh complete advisory cut under both identities')
        m.need(intent['argv'][-1]=='all' and '--disable-fetch' in intent['argv'] and '--offline' in intent['argv'] and '--locked' in intent['argv'],'no reduced policy check')
        for line in get(prefix+'stderr.log').decode().splitlines():
            try:fields=json.loads(line).get('fields',{})
            except json.JSONDecodeError:continue
            m.need(fields.get('severity')!='error','raw complete policy verdict')
        policy.append(name)
    return dict(complete=True,source_tar_sha256=m.sha(get('input/source.tar')),cargo_crate_sha256=m.sha(raw),crate_bytes=len(raw),source_members=len(files),
        reversible_condition_sites=8,format_only_sites=1,library_cases=passed,consumer_cases=consumers,policy_identities=policy,
        upstream_integration_runtime_qualified=False,local_registry_qualified=True,public_registry_qualified=False,
        upstream_MTU_fixed=False,resources_qualified=False,CPU_qualified=False,RSS_qualified=False,root_adopted=False,release_admitted=False)

if __name__=='__main__':
    result=reconcile(lambda name:(BASE/name).read_bytes());folder=BASE/'analysis';folder.mkdir(exist_ok=True)
    with (folder/'result.json').open('x',encoding='utf8') as f:json.dump(result,f,indent=2,sort_keys=True)
    print(json.dumps(result))
