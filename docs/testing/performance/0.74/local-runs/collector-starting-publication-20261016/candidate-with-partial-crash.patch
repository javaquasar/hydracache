+        } else {
+            0o400
+        }
+    );
+    match stage {
+        "Created" | "CreateDirectorySynced" => assert!(raw.is_empty()),
+        "PrefixWritten" => {
+            assert!(!raw.is_empty());
+            assert!(validate_retained_collector_starting(&raw, &request, &reserved).is_err());
+        }
+        _ => {
+            validate_retained_collector_starting(&raw, &request, &reserved).unwrap();
