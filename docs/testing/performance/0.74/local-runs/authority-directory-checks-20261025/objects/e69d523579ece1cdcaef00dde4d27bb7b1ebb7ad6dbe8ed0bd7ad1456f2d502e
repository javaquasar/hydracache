from pathlib import Path
import hashlib,json
root=Path(__file__).resolve().parent.parent
members,objects={},{}
def add(name,raw):
 assert name not in members
 digest=hashlib.sha256(raw).hexdigest();members[name]={'bytes':len(raw),'sha256':digest};objects[digest]=raw
for label in ['authority-directory-staged-review-20261025','authority-directory-final-doc-check-20261025','authority-directory-final-contract-20261025']:
 folder=root/'target/source-continuation-20261024'/label
 result=json.loads((folder/'result.json').read_bytes())
 assert result['exit']==0 and result['outer_refusal'] is None and result['source_unchanged'] and result['head_unchanged']
 for p in sorted(folder.iterdir()):add('checks/'+label+'/'+p.name,p.read_bytes())
for name in ['verify-staged-authority-directory-20261025.py','retain-authority-directory-checks-20261025.py']:
 add('coordinator/'+name,(root/'target'/name).read_bytes())
primary=root/'docs/testing/performance/0.74/local-runs/authority-directory-cost-20261025/index.json'
assert hashlib.sha256(primary.read_bytes()).hexdigest()=='6df2aa8770bc5621c9339ae03f245721c6ff8164e253c4fa77ab7dbaa9fbf5a5'
base=root/'docs/testing/performance/0.74/local-runs/authority-directory-checks-20261025'
base.mkdir(exist_ok=False);(base/'objects').mkdir()
for digest,raw in objects.items():(base/'objects'/digest).write_bytes(raw)
index={'schema':'hc074-directory-final-checks-v1','members':members,
 'upstream_index_sha256':'6df2aa8770bc5621c9339ae03f245721c6ff8164e253c4fa77ab7dbaa9fbf5a5',
 'primary_staged_review_passed':True,'doc_check':True,'local_nonpromotable_contract':True,
 'full_package':False,'full_holder_passed':False,'measurements_repeated':False,'admission':False}
raw=(json.dumps(index,sort_keys=True,indent=2)+'\n').encode();(base/'index.json').write_bytes(raw)
(base/'.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps({'index_sha256':hashlib.sha256(raw).hexdigest(),'members':len(members),'objects':len(objects)}))
