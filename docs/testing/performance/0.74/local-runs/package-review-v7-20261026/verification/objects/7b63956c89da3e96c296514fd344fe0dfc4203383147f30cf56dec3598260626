"""Append-only data retention; no code execution, gate dispatch or pin changes."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/package-review-v7-20261026/verification'
assert {p.name for p in OUT.iterdir()} == {'.gitattributes'}
members, objects = {}, {}

def add(name, raw):
    assert name not in members
    digest = hashlib.sha256(raw).hexdigest()
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

for label in ('v7-controls-first', 'prior-controls-first', 'module-controls-first',
              'doc-first', 'contract-first', 'format-first'):
    folder = ROOT / 'target/package-review-v7-20261026' / label
    value = json.loads((folder / 'result.json').read_bytes())
    assert value['exit'] == 0 and value['outer_refusal'] is None
    assert value['source_unchanged'] and value['commit_unchanged']
    for path in folder.iterdir():
        if path.is_file():
            add('checks/' + label + '/' + path.name, path.read_bytes())
for name in ('intent.json', 'result.json'):
    add('cleanup/' + name, (ROOT / 'target/package-review-v7-20261026/symbol-cleanup-first' / name).read_bytes())
for name in ('package_effects_review_v7.py', 'package_replay_v7.py', 'retain_package_review_v7.py',
             'test_package_effects_review_v7.py', 'test_package_replay_v7.py'):
    add('implementation/' + name, (ROOT / 'tools/historical-blob-batch-074' / name).read_bytes())
for name in ('cleanup-obsolete-symbols-v7-20261026.ps1', Path(__file__).name):
    add('coordinators/' + name, (ROOT / 'target' / name).read_bytes())
(OUT / 'objects').mkdir()
for digest, raw in objects.items():
    with (OUT / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-package-review-v7-checks-v1', members=members,
             default_package_dispatched=False, services=False, clocks=False, server=False,
             product_candidate=False, qualification=False, admission=False)
with (OUT / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, sort_keys=True, indent=2)
    stream.write('\n')
print(json.dumps(dict(members=len(members), index_sha256=hashlib.sha256((OUT / 'index.json').read_bytes()).hexdigest())))
