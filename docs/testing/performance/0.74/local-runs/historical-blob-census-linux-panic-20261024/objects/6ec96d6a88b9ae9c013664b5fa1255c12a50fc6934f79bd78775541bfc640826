def add(name, raw):
    assert name not in files
    files[name] = dict(sha256=hashlib.sha256(raw).hexdigest(), base64=base64.b64encode(raw).decode())


def git_object(oid, kind):
    if oid in objects:
        assert objects[oid]['kind'] == kind
        return base64.b64decode(objects[oid]['raw_b64'])
    assert len(oid) == 40 and all(c in '0123456789abcdef' for c in oid)
    result = subprocess.run(['git', '--no-replace-objects', 'cat-file', kind, oid], cwd=root,
                            capture_output=True, timeout=10)
    assert result.returncode == 0 and not result.stderr
    raw = result.stdout
    envelope = kind.encode() + b' ' + str(len(raw)).encode() + b'\0' + raw
    assert hashlib.sha1(envelope).hexdigest() == oid
    objects[oid] = dict(kind=kind, sha256=hashlib.sha256(raw).hexdigest(), raw_b64=base64.b64encode(raw).decode())
    assert len(objects) <= 64 and sum(len(base64.b64decode(v['raw_b64'])) for v in objects.values()) <= 2*1024**2
    add('repo/.git/objects/' + oid[:2] + '/' + oid[2:], zlib.compress(envelope))
    return raw


def source_closure(revision, path):
    commit = git_object(revision, 'commit')
    tree = commit.splitlines()[0].removeprefix(b'tree ').decode('ascii')
    parts = path.split('/')
    for index, part in enumerate(parts):
        raw = git_object(tree, 'tree')
        offset, entries = 0, {}
        while offset < len(raw):
            nul = raw.index(b'\0', offset)
            mode, name = raw[offset:nul].split(b' ', 1)
            oid = raw[nul+1:nul+21].hex()
            assert len(oid) == 40 and name not in entries
            entries[name] = (mode, oid)
            offset = nul + 21
        mode, tree = entries[part.encode()]
        if index == len(parts)-1:
            assert mode == b'100644'
            git_object(tree, 'blob')
        else:
            assert mode == b'40000'


