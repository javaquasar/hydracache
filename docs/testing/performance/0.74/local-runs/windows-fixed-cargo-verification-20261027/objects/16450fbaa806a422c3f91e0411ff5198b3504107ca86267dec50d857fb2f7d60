from pathlib import Path
import hashlib,json,subprocess
root=Path(__file__).resolve().parent.parent
base=root/'docs/testing/performance/0.74/local-runs/windows-fixed-cargo-20261027'
raw=(base/'index.json').read_bytes()
assert hashlib.sha256(raw).hexdigest()=='f5b09e77da3bf55cd6b14f1a898b40ce74b1f267117e0ab6508778c33f650afa'
index=json.loads(raw)
assert len(index['members'])==245 and index['windows_package_pass']
assert not index['workspace_pass'] and not index['release_admitted'] and not index['archived_code_executed']
assert (index['package_targets'],index['package_cases_passed'],index['workspace_stages_completed'],index['workspace_stages_unstarted'],index['security_advisories'])==(156,1351,11,9,11)
digests=set()
def member(name):
    row=index['members'][name]
    blob=(base/'objects'/row['sha256']).read_bytes()
    assert hashlib.sha256(blob).hexdigest()==row['sha256'] and len(blob)==row['bytes'],name
    digests.add(row['sha256'])
    return blob
for name in index['members']:
    blob=member(name)
    if name.startswith('source/current/'):
        path='tools/windows-workspace-preflight-074/'+name.rsplit('/',1)[-1]
        assert subprocess.check_output(['git','show',index['actual_sources']['workspace']+':'+path],cwd=root)==blob==(root/path).read_bytes()
assert len(digests)==109 and {p.name for p in (base/'objects').iterdir()}==digests
for mode,commit in index['actual_sources'].items():
    before=json.loads(member('capture/'+mode+'/frame-before.json'))
    after=json.loads(member('capture/'+mode+'/frame-after.json'))
    assert before==after and before['head']==commit
    for name,digest in before['helpers'].items():
        if name.startswith('tools/windows-workspace-preflight-074/'):
            blob=subprocess.check_output(['git','show',commit+':'+name],cwd=root)
            assert hashlib.sha256(blob).hexdigest()==digest,name
selected=subprocess.check_output(['git','diff','--cached','--name-only','-z'],cwd=root).split(b'\0')
count=0
for path in selected:
    if not path:continue
    name=path.decode()
    if '/local-runs/windows-fixed-cargo-20261027/' in name:
        assert subprocess.check_output(['git','show',':'+name],cwd=root)==(root/name).read_bytes(),name
        count+=1
assert count==111
print(json.dumps(dict(member_references=245,objects=109,exact_staged_packet_blobs=count,
    both_actual_source_commits_verified=True,archived_code_executed=False,
    windows_package_pass=True,workspace_pass=False,release_admitted=False)))
