def get(url):
    request = urllib.request.Request(url, headers={'User-Agent': 'HydraCache-074-offline-audit',
                                                   'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read()


ref_url = 'https://api.github.com/repos/microsoft/WSL/git/ref/tags/2.5.10'
ref_raw = get(ref_url)
ref = json.loads(ref_raw)
if ref['object'] != {'sha': COMMIT, 'type': 'commit',
                      'url': 'https://api.github.com/repos/microsoft/WSL/git/commits/' + COMMIT}:
    raise ValueError('Changed upstream release tag')
url = 'https://raw.githubusercontent.com/microsoft/WSL/' + COMMIT + '/src/windows/common/WslClient.cpp'
raw = get(url)
source = raw.decode('utf-8')
body = source[source.index('int RunDebugShell()'):source.index('int WslMain(')]
tokens = ('CreateFileW(', 'RelayStandardInput(', 'InterruptableRelay(', 'THROW_HR(HCS_E_CONNECTION_CLOSED)')
if not all(token in body for token in tokens):
    raise ValueError('Different reviewed source structure')
