"""Retain model-only leaves, including first fixture error and original bodies."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'docs/testing/performance/0.74/local-runs/capture-leaves-20261026'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def add(name, raw):
    digest = hashlib.sha256(raw).hexdigest()
    path = OUT/'objects'/digest
    if not path.exists():
        with path.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


def take(name, path):
    add(name, path.read_bytes())


for label in ('capture-leaves-model-first', 'capture-leaves-model-precommit', 'capture-leaves-model-final',
              'capture-leaves-model-closure', 'capture-leaves-regressions-first', 'capture-leaves-syntax-first',
              'capture-leaves-check-first', 'capture-leaves-clippy-first', 'capture-leaves-postcommit'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('capture_leaves.py', 'test_capture_leaves.py', 'git_cpu_overhead.py',
             'capture-leaves-design.md', 'capture-leaves-protocol.toml', 'coordinator_frames.py', 'git_job_cpu.py'):
    take('source/tools/xtask-package-attribution-074/'+name, ROOT/'tools/xtask-package-attribution-074'/name)
take('source/scripts/ci/watchdog_windows_job.py', ROOT/'scripts/ci/watchdog_windows_job.py')
for label, directory in (('first12', 'capture-leaves-first-source'), ('pre15', 'capture-leaves-precommit-source'),
                         ('final17', 'capture-leaves-final17-source')):
    for name in ('capture_leaves.py', 'test_capture_leaves.py', 'git_cpu_overhead.py'):
        take('history/'+label+'/'+name, ROOT/'target'/directory/name)
for name in ('run-ci-watchdog-step-20261026.py', 'run-source-step-20261024.py'):
    take('runners/'+name, ROOT/'target'/name)
take('collector.py', Path(__file__))
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
old = ROOT/'docs/testing/performance/0.74/local-runs/coordinator-native-20261026'
raw = (old/'index.json').read_bytes()
assert hashlib.sha256(raw).hexdigest() == '55b802621e147681f9478a164053a04c055ec28d8d35227d68d49ad0b4de380f'
add('baseline/index.json', raw)
for name in ('source/tools/xtask-package-attribution-074/git_cpu_overhead.py',
             'source/tools/xtask-package-attribution-074/coordinator_frames.py',
             'source/tools/xtask-package-attribution-074/git_job_cpu.py',
             'source/scripts/ci/watchdog_windows_job.py', 'source/tools/xtask-package-attribution-074/pipe_capture.rs'):
    entry = json.loads(raw)['members'][name]
    body = (old/'objects'/entry['sha256']).read_bytes()
    assert len(body) == entry['bytes'] and hashlib.sha256(body).hexdigest() == entry['sha256']
    add('baseline/'+name, body)
index = dict(schema='hc074-model-capture-leaves-evidence-v1', source_commit='8a0a10cab2a87da519e882838b11645d702fb5e9',
    models=18, regressions=56, first_model_tests=12, first_model_errors=1,
    native_control_executed=False, new_workload_calls=0, overhead_accepted=False, package_pass=False, server=False, members=members)
raw = (json.dumps(index, indent=2, sort_keys=True)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members), objects=len(list((OUT/'objects').iterdir()))))
