"""Seal the paired public-SPKI regression and the isolated lock repair."""
import hashlib
import json
from pathlib import Path
import re
import subprocess
import tomllib

ROOT = Path(__file__).resolve().parent.parent
RAW = ROOT/'target/webpki-patch-20261026'
OUT = ROOT/'docs/testing/performance/0.74/local-runs/webpki-security-20261026'
PHASES = ('webpki-baseline', 'webpki-update', 'webpki-candidate', 'webpki-msrv',
    'webpki-regression', 'webpki-linux', 'webpki-policy', 'webpki-check', 'webpki-clippy',
    'webpki-format', 'webpki-resp-all', 'webpki-doc', 'webpki-contract')
base = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()


def git(name):
    return subprocess.check_output(['git', 'show', base+':'+name], cwd=ROOT)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


old = tomllib.loads(git('Cargo.lock').decode())
new = tomllib.loads((ROOT/'Cargo.lock').read_text())
before = next(p for p in old['package'] if p['name'] == 'rustls-webpki')
after = next(p for p in new['package'] if p['name'] == 'rustls-webpki')
if (before['version'], after['version']) != ('0.103.15', '0.103.16'):
    raise ValueError('unexpected package version')
before.update(version=after['version'], checksum=after['checksum'])
if old != new:
    raise ValueError('unrelated lock delta')
for name in ('Cargo.toml', 'deny.toml'):
    if (ROOT/name).read_bytes().replace(b'\r\n', b'\n') != git(name):
        raise ValueError('manifest/MSRV/policy delta')
test = 'crates/hydracache-redis-compat/tests/tls_spki_security_074.rs'
oracle = (ROOT/test).read_bytes()
baseline = json.loads((RAW/'webpki-baseline/intent.json').read_bytes())
if baseline['source'][test] != sha(oracle):
    raise ValueError('paired regression source changed')
vectors = json.loads((ROOT/'target/webpki-fixtures-20261026/vectors.json').read_bytes())
embedded = re.findall(r'\("([A-Z0-9]+\.spki\.der)", "([0-9a-f]+)"\)', oracle.decode())
if len(embedded) != 8 or {name: body for name, body in embedded} != {p['name']: p['hex'] for p in vectors['vectors']}:
    raise ValueError('public fixtures differ from pinned upstream')
counts = {}
for phase in PHASES:
    result = json.loads((RAW/phase/'result.json').read_bytes())
    expected = 101 if phase == 'webpki-baseline' else 1 if phase == 'webpki-policy' else 0
    if (result['exit'] != expected or result['outer_refusal'] is not None or
            result['source_contract'] is not True or result['commit_unchanged'] is not True):
        raise ValueError('focused result differs: '+phase)
    text = (RAW/phase/'stdout.log').read_text(encoding='utf-8')
    rows = re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored; (\d+) measured; (\d+) filtered out;', text)
    if rows:
        counts[phase] = dict(targets=len(rows), totals=[sum(int(row[i]) for row in rows) for i in range(5)])
text = (RAW/'webpki-baseline/stdout.log').read_text(encoding='utf-8')
if 'left: 8' not in text or '1 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out' not in text:
    raise ValueError('first vulnerable-version result differs')
ids = sorted(set(re.findall(r'ID: (RUSTSEC-\d{4}-\d{4})', (RAW/'webpki-policy/stderr.log').read_text(encoding='utf-8'))))
expected_ids = ['RUSTSEC-2024-0449'] + ['RUSTSEC-2026-'+v for v in ('0367','0368','0369','0370','0371','0372','0381','0383','0386')]
if ids != expected_ids:
    raise ValueError('remaining policy findings differ')
db = Path('C:/Users/ArturBuzov/.cargo/advisory-dbs/advisory-db-3157b0e258782691')
if (subprocess.check_output(['git','rev-parse','HEAD'],cwd=db,text=True).strip() != '84d943a6deeb8cc6c6f632531aaf4f1c62275239'
        or subprocess.check_output(['git','status','--porcelain'],cwd=db)):
    raise ValueError('advisory database changed')
qual = 'docs/testing/performance/0.74/qualification-manifest.toml'
if sha((ROOT/qual).read_bytes()) != '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc':
    raise ValueError('qualification changed')
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, raw):
    digest = sha(raw)
    dest = OUT/'objects'/digest
    if not dest.exists():
        with dest.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for phase in PHASES:
    for path in sorted((RAW/phase).iterdir()):
        if path.is_file():
            take('checks/'+phase+'/'+path.name, path.read_bytes())
for name in ('Cargo.toml', 'Cargo.lock', 'deny.toml'):
    take('baseline/'+name, git(name))
    take('source/'+name, (ROOT/name).read_bytes())
for name in (test, test.replace('.rs', '.LICENSE'), qual):
    take('source/'+name, (ROOT/name).read_bytes())
for path in sorted((ROOT/'target/webpki-fixtures-20261026').iterdir()):
    if path.is_file():
        take('upstream/'+path.name, path.read_bytes())
for name in ('fetch-webpki-fixture-20261026.py', 'run-webpki-step-20261026.py', Path(__file__).name):
    take('coordinator/'+name, (ROOT/'target'/name).read_bytes())
index = dict(schema='hc074-webpki-spki-security-v1', base_commit=base, counts=counts,
    baseline_accepted_keys=8, fixed_rejected_keys=8, same_oracle_bytes=True,
    old_version='0.103.15', new_version='0.103.16', unrelated_lock_delta=False,
    msrv='1.88', advisory_database_commit='84d943a6deeb8cc6c6f632531aaf4f1c62275239',
    remaining_advisories=ids, policy_pass=False, full_package_pass=False,
    production_original_delivery=False, server=False, release_admitted=False, members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=sha(raw), members=len(members), counts=counts))
