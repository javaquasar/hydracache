        need(os.getuid()==os.getgid()==1000,'fixed nonroot native operator')
        root.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
        need(root.parent.resolve()==root.parent and root.parent.stat().st_uid==1000,'private native parent')
    root.mkdir(mode=0o700,exist_ok=False)
    codec=load(ROOT/'tools/dbus-source-package-074/package.py','zstd_fault_native_codec')
    ledger={}
    for path in (BASE/'input').glob('registry-*.json'):
        for name,digest in json.loads(path.read_bytes()).items():
            need(name not in ledger or ledger[name]==digest,'identical union source identity');ledger[name]=digest
    need(ledger,'nonempty native registry')
    for name,digest in ledger.items():
        capacity();body=(BASE/'input/archives'/(name+'.crate')).read_bytes();need(sha(body)==digest,'native official archive')
        members=codec.unpack(body,name);folder=root/'vendor'/name;folder.mkdir(parents=True)
        for relative,raw in members.items():
            path=folder/relative;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(raw)
        write(folder,'.cargo-checksum.json',dict(package=digest,files={n:sha(raw) for n,raw in members.items()}))
    (root/'cargo-home').mkdir(mode=0o700)
    (root/'cargo-home/config.toml').write_text(configuration(),encoding='utf8')


