    cache=Path.home()/'.cargo/registry/cache/index.crates.io-1949cf8c6b5b557f'
    before=tomllib.loads((ROOT/'Cargo.lock').read_text(encoding='utf8'))
    # Source identities for new versions come from the already frozen S lock.
    prior=tomllib.loads((ROOT/'tools/chitchat-mtu-review-074/patches/tested-fixture.lock').read_text(encoding='utf8'))
    checks={p['name']+'-'+p['version']:p['checksum'] for p in prior['package'] if p.get('source','').startswith('registry+')}
    inputs=BASE/'input';inputs.mkdir();archives=inputs/'archives';archives.mkdir()
    sources={}
    for name in ('zstd-0.14.3','zstd-safe-8.2.0'):
        body=(cache/(name+'.crate')).read_bytes();need(sha(body)==checks[name],'prior official archive: '+name)
        (archives/(name+'.crate')).write_bytes(body)
        sources[name]=codec.unpack(body,name)
    upstream=BASE/'fixtures/upstream';upstream.mkdir(parents=True)
    for name,body in sources['zstd-safe-8.2.0'].items():
        path=upstream/name;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(body)
    for name in ('Cargo.toml','Cargo.lock'):
        path=upstream/name
        if path.exists():(out/('packaged-safe-'+name)).write_bytes(path.read_bytes())
    manifest=upstream/'Cargo.toml';manifest.write_bytes(manifest.read_bytes()+b'\n[workspace]\n')
    probe=BASE/'fixtures/probe';probe.mkdir(parents=True)
    (probe/'Cargo.toml').write_text('[package]\nname="hc074-zstd-security-fault-probe"\nversion="0.0.0"\nedition="2021"\nrust-version="1.88"\npublish=false\n[lib]\npath="../../../../tools/zstd-security-fault-074/probe.rs"\n[dependencies]\nzstd="=0.14.3"\nzstd-safe={version="=8.2.0",features=["std","seekable"]}\n[workspace]\n',encoding='utf8')
    for folder in (probe,upstream):(folder/'Cargo.lock').write_bytes((ROOT/'Cargo.lock').read_bytes())
    write(out,'official-sources.json',{name:{member:sha(body) for member,body in members.items()} for name,members in sources.items()})
    need(len(before['package'])==683,'unchanged root package set')


def archives(kind):
    import tomllib
    lock=tomllib.loads((BASE/'fixtures'/kind/'Cargo.lock').read_text(encoding='utf8'))
    cache=Path.home()/'.cargo/registry/cache/index.crates.io-1949cf8c6b5b557f'
    ledger={}
    for row in lock['package']:
        if not row.get('source','').startswith('registry+'):continue
        name=row['name']+'-'+row['version'];body=(cache/(name+'.crate')).read_bytes()
        need(sha(body)==row['checksum'],'whole resolved official archive: '+name)
        path=BASE/'input/archives'/(name+'.crate')
        if path.exists():need(path.read_bytes()==body,'unchanged existing archive')
        else:path.write_bytes(body)
        ledger[name]=row['checksum']
    write(BASE/'input','registry-'+kind+'.json',ledger)


def registry():
    codec=load(ROOT/'tools/dbus-source-package-074/package.py','zstd_fault_registry_codec')
    for path in (BASE/'input').glob('registry-*.json'):
        for name,digest in json.loads(path.read_bytes()).items():
            body=(BASE/'input/archives'/(name+'.crate')).read_bytes()
            need(sha(body)==digest,'whole held registry archive')
            directory=vendor_root()/'vendor'/name
            for relative,raw in codec.unpack(body,name).items():
                member=directory/relative
                need(not member.is_symlink() and member.read_bytes()==raw,'fresh actual registry source: '+name+'/'+relative)


def seed():
