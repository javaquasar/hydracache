def accounting(raw,names):
    import re
    rows=re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored; (\d+) measured; (\d+) filtered out;',raw)
    need(len(rows)==1,'one complete test result')
    counts=tuple(map(int,rows[0]))
    need(counts==(len(names),0,0,0,0),'unfiltered/unignored complete native result')
    return dict(passed=counts[0],failed=0,ignored=0,filtered=0)


