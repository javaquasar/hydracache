def need(value,reason):
    if not value:raise ValueError(reason)


def write(folder,name,value):
    with (folder/name).open('x',encoding='utf8',newline='\n') as out:
        json.dump(value,out,indent=2,sort_keys=True);out.write('\n')


def load(path,name):
    spec=importlib.util.spec_from_file_location(name,path)
    value=importlib.util.module_from_spec(spec);spec.loader.exec_module(value);return value


def source():
    names=set(PINNED)|{'Cargo.toml','.cargo/config.toml'}
    names|={p.relative_to(ROOT).as_posix() for p in TOOLS.iterdir() if p.is_file()}
    names|={p.relative_to(ROOT).as_posix() for p in (BASE/'fixtures').rglob('*') if p.is_file()}
    names|={p.relative_to(ROOT).as_posix() for p in (BASE/'input').rglob('*') if p.is_file()}
    values={}
    for name in sorted(names):
        path=ROOT/name
        need(path.is_file() and not path.is_symlink() and not getattr(path,'is_junction',lambda:False)(),'regular held source: '+name)
        values[name]=sha(path.read_bytes())
    for name,digest in PINNED.items():need(values[name]==digest,'original root/tool pin: '+name)
    return values


