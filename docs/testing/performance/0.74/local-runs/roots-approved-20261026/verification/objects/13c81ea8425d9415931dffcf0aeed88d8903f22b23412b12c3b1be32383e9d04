"""Retain final data-only controls and local structural checks, never replay."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/roots-approved-20261026/verification'
assert {p.name for p in OUT.iterdir()} == {'.gitattributes'}
members, objects = {}, {}

def add(name, raw):
    assert name not in members
    digest = hashlib.sha256(raw).hexdigest()
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

for phase in ('packet-verify-first', 'packet-controls-first', 'doc-final', 'contract-final'):
    folder = ROOT / 'target/roots-approved-20261026' / phase
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_contract'] and result['source_unchanged'] and result['commit_unchanged']
    for path in folder.iterdir():
        assert path.is_file()
        add('checks/' + phase + '/' + path.name, path.read_bytes())
for name in ('verify.py', 'test_verify.py'):
    add('verifier/' + name, (OUT.parent / name).read_bytes())
for name in ('docs/testing/performance/0.74/roots-approved-result-20261026.md',
             'docs/testing/performance/0.74/release-closure-execution-plan-20261026.md'):
    add('documents/' + name, (ROOT / name).read_bytes())
add('coordinator/' + Path(__file__).name, Path(__file__).read_bytes())
(OUT / 'objects').mkdir()
for digest, raw in objects.items():
    with (OUT / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-approved-roots-final-checks-v1', members=members,
             package_replayed=False, archived_code_executed=False, production_trust_changed=False,
             server=False, services=False, clocks=False, qualification=False, release_admitted=False)
with (OUT / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, sort_keys=True, indent=2)
    stream.write('\n')
print(json.dumps(dict(members=len(members), index_sha256=hashlib.sha256((OUT / 'index.json').read_bytes()).hexdigest())))
