"""Retain exact source-only scan inputs, not an execution or package receipt."""
from pathlib import Path
import hashlib
import json
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/historical-blob-batch-074'))
import package_effects_review_v6 as gate

OUT = ROOT / 'docs/testing/performance/0.74/local-runs/package-review-v6-20261026'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members = {}
def add(name, raw):
    assert name not in members
    members[name] = raw

document = json.loads((ROOT / 'target/package-v6-syntax-first-20261026/result.json').read_bytes())
assert gate.legacy.document_digest(document) == gate.REVIEWED_AST_SHA256
for row in document['sources']:
    raw = (ROOT / row['source']).read_bytes()
    assert sha(raw) == row['sha256']
    add('fixture/' + row['source'], raw)
for name, digest in gate.AUXILIARY.items():
    raw = (ROOT / name).read_bytes()
    assert sha(raw) == digest
    add('fixture/' + name, raw)
for label in ('package-v6-syntax-build-first', 'package-v6-syntax-first'):
    folder = ROOT / 'target/source-continuation-20261024' / label
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == 0 and result['source_unchanged'] and result['head_unchanged']
    for path in folder.iterdir():
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())
for path in (ROOT / 'target/package-v6-syntax-first-20261026').iterdir():
    assert path.is_file()
    add('syntax/' + path.name, path.read_bytes())
add('previous/v5-syntax.json', (ROOT / gate.PREVIOUS_SYNTAX).read_bytes())
for name in ('run-ci-watchdog-step-20261026.py', 'run-source-step-20261024.py', Path(__file__).name):
    add('coordinator/' + name, (ROOT / 'target' / name).read_bytes())
OUT.mkdir(exist_ok=False)
(OUT / 'objects').mkdir()
index = dict(schema='hc074-package-review-v6-syntax-v1',
    source_commit='6e4913efbd89a81f32baef8f32a1646284caab5a',
    syntax_sha256=gate.REVIEWED_AST_SHA256, execution_effects_review_complete=False,
    package_dispatched=False, package_pass=False, members={})
for name, raw in sorted(members.items()):
    digest = sha(raw)
    path = OUT / 'objects' / digest
    if path.exists():
        assert path.read_bytes() == raw
    else:
        with path.open('xb') as stream:
            stream.write(raw)
    index['members'][name] = dict(sha256=digest, bytes=len(raw))
raw = (json.dumps(index, indent=2, sort_keys=True) + '\n').encode()
with (OUT / 'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=sha(raw), members=len(members), objects=len(list((OUT / 'objects').iterdir()))))
