"""Seal post-documentation checks separately from the immutable first run."""
from pathlib import Path
import hashlib
import json

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/package-closure-v6-20261026/final-checks'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members = {}
for suffix in ('doc-check', 'contract-check', 'syntax-integrity', 'result-integrity', 'bytecode', 'indent'):
    folder = ROOT / 'target/source-continuation-20261024' / ('package-v6-final-' + suffix)
    intent, result = (json.loads((folder / name).read_bytes()) for name in ('intent.json', 'result.json'))
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged'] and intent['source'] == result['source_after']
    assert intent['head'] == 'fa9e708868b22999d60c9ccd97b694662910a095'
    for path in folder.iterdir():
        assert path.is_file()
        members[suffix + '/' + path.name] = path.read_bytes()
for packet in ('package-review-v6-20261026', 'package-closure-v6-20261026'):
    for name in ('verify.py', 'test_verify.py'):
        members['verifier/' + packet + '/' + name] = (
            ROOT / 'docs/testing/performance/0.74/local-runs' / packet / name).read_bytes()
members['collector.py'] = Path(__file__).read_bytes()
OUT.mkdir(exist_ok=False)
(OUT / 'objects').mkdir()
index = dict(schema='hc074-v6-final-checks-v1', package_pass=False, product_or_qualification_admission=False, members={})
for name, raw in sorted(members.items()):
    digest = sha(raw)
    path = OUT / 'objects' / digest
    if path.exists():
        assert path.read_bytes() == raw
    else:
        with path.open('xb') as stream:
            stream.write(raw)
    index['members'][name] = dict(sha256=digest, bytes=len(raw))
raw = (json.dumps(index, indent=2, sort_keys=True) + '\n').encode()
with (OUT / 'index.json').open('xb') as stream:
    stream.write(raw)
for name, row in index['members'].items():
    body = (OUT / 'objects' / row['sha256']).read_bytes()
    assert len(body) == row['bytes'] and sha(body) == row['sha256']
print(dict(index_sha256=sha(raw), members=len(members), objects=len(list((OUT / 'objects').iterdir())),
           package_pass=False, staged_readback=True))
