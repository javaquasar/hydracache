"""Source/auxiliary/target refusal controls; never executes a package."""
import copy
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

import package_effects_review_v6 as gate

ROOT = Path(__file__).resolve().parents[2]
PACKET = 'docs/testing/performance/0.74/local-runs/package-review-v6-20261026'
INDEX = '4788224085aadbfa874f16d13826fc34d2c32ac880116d7e959c8e27df53a062'


class RepairedWindowsScope(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.temp = tempfile.TemporaryDirectory()
        cls.addClassCleanup(cls.temp.cleanup)
        cls.root = Path(cls.temp.name).resolve()
        folder = ROOT / PACKET
        raw = (folder / 'index.json').read_bytes()
        assert gate.sha(raw) == INDEX
        for name, row in json.loads(raw)['members'].items():
            body = (folder / 'objects' / row['sha256']).read_bytes()
            assert gate.sha(body) == row['sha256'] and len(body) == row['bytes']
            if name == 'syntax/result.json':
                cls.document = json.loads(body)
            if name.startswith('fixture/') or name == 'previous/v5-syntax.json':
                path = cls.root / (name[8:] if name.startswith('fixture/') else gate.PREVIOUS_SYNTAX)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(body)
        cls.targets = ['unittests src/lib.rs', 'unittests src/main.rs'] + [
            'tests/' + path.name for path in sorted((cls.root / 'crates/xtask/tests').glob('*.rs'))]

    def review(self, document=None):
        with patch.object(gate.legacy.package_replay_audit, 'audit', return_value={'targets': self.targets}):
            return gate.source_review(self.root, self.document if document is None else document)

    def test_fixed_368_sources_45_auxiliary_145_targets_do_not_admit_product(self):
        result = self.review()
        self.assertEqual((len(result['sources']), len(result['auxiliary']), len(result['targets'])), (368, 45, 145))
        self.assertEqual((len(result['changed_sources']), len(result['added_sources'])), (3, 3))
        self.assertTrue(result['source_effect_review_complete'])
        for name in ('package_dispatched', 'package_pass', 'formal_whole_program_proof',
                     'linux_or_all_features_cleared', 'original_execution_or_product_or_qualification_admission'):
            self.assertFalse(result[name])

    def test_v5_still_refuses_new_graph(self):
        with self.assertRaisesRegex(ValueError, 'unreviewed v5'):
            gate.previous.source_review(self.root, self.document)

    def test_source_document_cannot_learn_its_own_pin_or_enable_execution(self):
        bad = copy.deepcopy(self.document)
        bad['executed_input_code'] = True
        with self.assertRaisesRegex(ValueError, 'unreviewed v6'):
            self.review(bad)
        with patch.object(gate, 'REVIEWED_AST_SHA256', gate.legacy.document_digest(bad)):
            with self.assertRaisesRegex(ValueError, 'source-only'):
                self.review(bad)

    def test_changed_added_and_unchanged_ast_are_all_exact(self):
        for name in (*gate.CHANGED, *gate.ADDED, 'crates/xtask/tests/census_cost_074.rs'):
            bad = copy.deepcopy(self.document)
            row = next(row for row in bad['sources'] if row['source'] == name)
            row['sites'].append(dict(kind='function-call', scope='fixture', detail='unreviewed'))
            with patch.object(gate, 'REVIEWED_AST_SHA256', gate.legacy.document_digest(bad)):
                with self.assertRaisesRegex(ValueError, 'source/AST delta'):
                    self.review(bad)

    def test_missing_duplicate_module_and_host_effects_refuse(self):
        for mode in ('missing', 'duplicate', 'module', 'include', 'host'):
            bad = copy.deepcopy(self.document)
            if mode == 'missing':
                bad['sources'].pop()
            elif mode == 'duplicate':
                bad['sources'].append(bad['sources'][0])
            else:
                kind, detail = {'module': ('module', 'default-module-path'),
                                'include': ('include', 'unreviewed.rs'),
                                'host': ('command-constructor', 'literal:ssh')}[mode]
                bad['sources'][0]['sites'].append(dict(kind=kind, scope='absent', detail=detail))
            with patch.object(gate, 'REVIEWED_AST_SHA256', gate.legacy.document_digest(bad)):
                with self.assertRaises(ValueError):
                    self.review(bad)

    def test_rust_heartbeat_companion_descriptor_and_old_auxiliary_are_fixed(self):
        original = Path.read_bytes
        for name in (*gate.CHANGED, *gate.ADDED, *gate.EXTRA_AUXILIARY,
                     '.cargo/config.toml', gate.PREVIOUS_SYNTAX):
            target = self.root / name
            with patch.object(Path, 'read_bytes', lambda path: b'changed' if path == target else original(path)):
                with self.assertRaises(ValueError):
                    self.review()

    def test_catalog_cannot_drop_add_duplicate_or_reorder(self):
        for targets in (self.targets[:-1], self.targets + ['tests/unknown.rs'],
                        self.targets + [self.targets[0]], list(reversed(self.targets))):
            with patch.object(self, 'targets', targets):
                with self.assertRaisesRegex(ValueError, 'target catalog'):
                    self.review()

    def test_preserved_v5_auxiliary_pins_change_only_for_explicit_heartbeat_successor(self):
        changed = {name for name in gate.previous.AUXILIARY
                   if gate.previous.AUXILIARY[name] != gate.AUXILIARY[name]}
        self.assertEqual(changed, {'scripts/ci/run-with-heartbeat.py'})
        self.assertEqual(len(set(gate.AUXILIARY) - set(gate.previous.AUXILIARY)), 3)
        with patch.object(gate, 'CHANGED', {}):
            with self.assertRaisesRegex(ValueError, 'changed source/AST delta'):
                self.review()


if __name__ == '__main__':
    unittest.main()
