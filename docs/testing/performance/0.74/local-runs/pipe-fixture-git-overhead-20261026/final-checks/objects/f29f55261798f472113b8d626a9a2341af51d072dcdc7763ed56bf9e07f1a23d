"""Append final raw check receipts, leaving the native index untouched."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/pipe-fixture-git-overhead-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)
for name, label in [('integrity', 'pipe-git-overhead-integrity'), ('syntax', 'pipe-git-overhead-verifier-syntax'),
                    ('doc', 'pipe-git-overhead-doc-check'), ('contract', 'pipe-git-overhead-contract')]:
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take(name+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('verify.py', 'test_verify.py'):
    take(name, PACKET/name)
take('collector.py', Path(__file__))
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
index = dict(native_index_sha256='1ba276dcf62f97801f69806ea5efba138c7d47425f30d2563874aa393681fcff',
             members=members, package_pass=False, qualification=False, server=False)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
