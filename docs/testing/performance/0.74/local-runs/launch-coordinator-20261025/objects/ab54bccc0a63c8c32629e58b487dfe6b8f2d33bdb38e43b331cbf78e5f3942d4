"""Seal fixed receipt, semantic controls and original-wrapper observations."""
from pathlib import Path
import hashlib,json
root=Path(__file__).resolve().parent.parent
base=root/'docs/testing/performance/0.74/local-runs/launch-coordinator-20261025'
members,objects,intents={},{},{}
def sha(raw):return hashlib.sha256(raw).hexdigest()
def add(name,raw):
    assert name not in members
    digest=sha(raw);members[name]=dict(sha256=digest,bytes=len(raw));objects[digest]=raw
labels=['coordinator-model-first-20261025','launch-preflight-first-20261025',
    'launch-coordinator-python-first-20261025','coordinator-native-first-20261025',
    'launch-coordinator-python-final-20261025','launch-coordinator-preservation-final-20261025']
for label in labels+['coordinator-native-20261025-'+mode for mode in ('healthy','wrong-path','census-fault')]:
    folder=root/'target/source-continuation-20261024'/label
    before=json.loads((folder/'intent.json').read_bytes());after=json.loads((folder/'result.json').read_bytes())
    assert after['exit']==0 and after['outer_refusal'] is None
    assert after['source_unchanged'] and after['head_unchanged'] and before['source']==after['source_after']
    assert before['bound_seconds']==(780 if label.startswith('coordinator-native-20261025-') else 1200)
    intents[label]=before
    for path in sorted(folder.iterdir()):
        assert path.is_file();add('checks/'+label+'/'+path.name,path.read_bytes())
for name in ('intent.json','result.json'):
    add('preflight/'+name,(root/'target/launch-preflight-first-20261025'/name).read_bytes())
preflight=json.loads((root/'target/launch-preflight-first-20261025/result.json').read_bytes())
assert preflight['preflight_pass'] and not preflight['dispatch_authorized']
assert preflight['build_source_inputs']==2028 and preflight['reviewed_rust_sources']==343
native=root/'target/coordinator-native-first-20261025'
assert json.loads((native/'result.json').read_bytes())['passed']
for mode,expected in [('healthy',None),('wrong-path','held lineage image/PID mismatch'),('census-fault','injected census fault')]:
    result=json.loads((native/mode/'result.json').read_bytes());obs=result['observation']
    assert result['passed'] and not result['cleanup_errors'] and result['first_refusal'] is None
    assert not result['live_owner_custody_retained'] and obs['owner_exit_observed'] and obs['owner_returncode']==0
    assert obs['first_refusal']==expected and obs['observations_complete']==(mode=='healthy')
    if mode=='healthy':assert len(obs['identities'])==4 and obs['samples'][-1]['terminal']
    else:assert not obs['identities'] and not obs['samples']
    if mode=='census-fault':assert obs['discovery_snapshots']==1
    folder=root/'target/source-continuation-20261024'/('coordinator-native-20261025-'+mode)
    assert sorted((folder/'stdout.log').read_text().splitlines())==['node-0-complete','node-1-complete','node-2-complete']
    assert not (folder/'owned-cleanup.log').exists()
for path in sorted(native.rglob('*')):
    if path.is_file():add('native/'+path.relative_to(native).as_posix(),path.read_bytes())
code=['observation_coordinator.py','coordinator_control.py','launch_preflight.py',
    'test_observation_coordinator.py','test_coordinator_control.py','test_launch_preflight.py',
    'process_lineage.py','owned_process_observer.py','lineage_control.py']
for name in code:
    relative='tools/xtask-package-attribution-074/'+name;raw=(root/relative).read_bytes()
    assert sha(raw)==intents[labels[-1]]['source'][relative]
    if not name.startswith('test_'):assert sha(raw)==intents['coordinator-native-first-20261025']['source'][relative]
    add('code/'+name,raw)
