index = dict(schema='hc074-preservation-sweeps-v1', code_commit=CODE, members=members,
    facts=dict(phases=phases, protected_sha256=PROTECTED, original_packet_sha256=sweep.PACKET_SHA256,
        original_source_commit=sweep.COMMIT, source_verdict_proven_show_read_lower_bound=3116,
        selected_sweeps=7, original_target_cases=20, original_target_reported_ns=108310000000,
        unique_revision_path_keys=3116, unique_blob_oids=465, repeated_object_references=2651,
        exact_key_cache_hits_in_selected_sweeps=0, metadata_tree_reads=7,
        first_preflight_tree_reads=0, first_command_index_oracle_refusal=True,
        first_locality_source_reconstructed_and_hash_matched=True, final_python_controls=31,
        helper_protocol_prepared_not_executed=True, per_call_or_case_timing_measured=False,
        original_replacement_refs_or_config_attested=False, original_package_completed=False,
        normalizers_or_product_changed=False, live_checks_order_frequency_or_windows_changed=False,
        package_replayed=False, cache_or_persistent_child_installed=False,
        server=False, services=False, clocks=False, dependencies_changed=False, qualification=False))
out = ROOT / BASE
out.mkdir(parents=True, exist_ok=False)
(out / 'objects').mkdir()
(out / '.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for digest, raw in objects.items():
    (out / 'objects' / digest).write_bytes(raw)
raw = (json.dumps(index, indent=2, sort_keys=True) + '\n').encode()
(out / 'index.json').write_bytes(raw)
