from pathlib import Path
import hashlib
import json
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BASE = 'docs/testing/performance/0.74/local-runs/preservation-sweeps-20261025'
CODE = 'cc9d2546ddc8740706cdbdef6e5c8e55bfb363c6'
sys.path.insert(0, str(ROOT / 'tools/xtask-package-attribution-074'))
import sweep_review as sweep
import tree_locality as locality
PROTECTED = {
    'Cargo.toml': '18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock': 'd2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml': '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
    sweep.SOURCE: sweep.SOURCE_SHA256,
}
def sha(raw):
    return hashlib.sha256(raw).hexdigest()


members, objects, phases = {}, {}, []
def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


def tree(folder, prefix):
    for path in sorted(folder.rglob('*')):
        if path.is_file():
            add(prefix + '/' + path.relative_to(folder).as_posix(), path.read_bytes())


assert subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT).decode().strip() == CODE
checks = ROOT / 'target/source-continuation-20261024'
failed = {'sweep-trees-20261025-controls', 'sweep-trees-20261025-first'}
for folder in sorted(checks.iterdir()):
    if not folder.is_dir() or not folder.name.startswith(('sweep-review-20261025-', 'sweep-trees-20261025-', 'sweep-protocol-20261025-', 'sweep-finish-20261025-')):
        continue
    intent = json.loads((folder / 'intent.json').read_bytes())
    result = json.loads((folder / 'result.json').read_bytes())
    expected = 1 if folder.name in failed else 0
    assert result['exit'] == expected and result['outer_refusal'] is None, folder
    assert result['source_unchanged'] and result['head_unchanged'] and intent['source'] == result['source_after']
    tree(folder, 'checks/' + folder.name)
    phases.append(dict(phase=folder.name, exit=expected))

values = sweep.load_snapshot(ROOT)
report = sweep.analyze_snapshot(values)
first = checks / 'sweep-review-20261025-first/stdout.log'
assert report == json.loads(first.read_bytes())
for name, raw in values.items():
    add('original/' + name, raw)
add('original/index.json', (ROOT / sweep.PACKET / 'index.json').read_bytes())
add('derived/sweeps.json', first.read_bytes())
