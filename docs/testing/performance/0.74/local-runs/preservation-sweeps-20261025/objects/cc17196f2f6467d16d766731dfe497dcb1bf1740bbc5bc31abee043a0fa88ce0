local = locality.load_capture(folder)
assert local == json.loads((folder / 'locality.json').read_bytes())
assert (local['logical_revision_path_requests'], local['unique_blob_oids'], local['references_beyond_first_per_blob']) == (3116, 465, 2651)
for revision in ('1ed3dead07420bf2e6094355cbd512543aa3d245', 'e45f2a706c19ba1b89f929f6a8f76c151b356221'):
    names = ('sweep_review.py', 'test_sweep_review.py') if revision.startswith('1ed3') else ('tree_locality.py', 'test_tree_locality.py')
    for name in names:
        path = 'tools/xtask-package-attribution-074/' + name
        add('intermediate-source/' + revision[:8] + '/' + name,
            subprocess.check_output(['git', 'show', revision + ':' + path], cwd=ROOT))
failed_intent = json.loads((checks / 'sweep-trees-20261025-controls/intent.json').read_bytes())['source']
name = 'tools/xtask-package-attribution-074/test_tree_locality.py'
raw = (checks / 'sweep-trees-20261025-controls/test_tree_locality.py.raw').read_bytes()
assert sha(raw) == failed_intent[name]
add('first-refusal-source/test_tree_locality.py', raw)
name = 'tools/xtask-package-attribution-074/tree_locality.py'
raw = subprocess.check_output(['git', 'show', 'e45f2a70:' + name], cwd=ROOT)
assert raw.count(b"type(row['index']) is int and ") == 1
raw = raw.replace(b"type(row['index']) is int and ", b'', 1)
assert sha(raw) == failed_intent[name]
add('reconstructed-first-source/tree_locality.py', raw)
for path in sorted((ROOT / 'tools/xtask-package-attribution-074').iterdir()):
    if path.is_file():
        add('final-source/tools/xtask-package-attribution-074/' + path.name, path.read_bytes())
for name, digest in PROTECTED.items():
    raw = (ROOT / name).read_bytes()
    assert sha(raw) == digest
    add('protected/' + name, raw)
for name in ('deny.toml', 'tools/authority-runtime-074/gate.rs', 'tools/authority-runtime-074/io.rs',
             'tools/authority-storage-source-074/contract.rs', 'crates/xtask/tests/support/census_provider_input.rs',
             'tools/historical-blob-batch-074/transport.rs', 'crates/xtask/tests/support/performance_contract_074_fixed_slice.rs'):
    raw = (ROOT / name).read_bytes()
    old = subprocess.check_output(['git', 'show', 'a5c57944:' + name], cwd=ROOT)
    assert raw.replace(b'\r\n', b'\n') == old.replace(b'\r\n', b'\n')
    add('unchanged-source/' + name, raw)
for name in ('run-source-step-20261024.py', 'run-fresh-reader-20261024.py', 'capture-sweep-trees-20261025.py',
             'seal-preservation-sweeps-20261025.py', 'verify-preservation-sweeps-staged-20261025.py'):
