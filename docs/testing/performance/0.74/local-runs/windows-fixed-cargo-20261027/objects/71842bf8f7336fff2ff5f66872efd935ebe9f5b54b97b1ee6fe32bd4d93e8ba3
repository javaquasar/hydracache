from pathlib import Path
import hashlib,json,sys
root=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(root/'tools/windows-workspace-preflight-074'))
import accounting
out=root/'target/windows-fixed-cargo-20261027/workspace-parser-baseline'
out.mkdir(exist_ok=False)
prior=root/'docs/testing/performance/0.74/local-runs/local-milestone-20261024'
index_raw=(prior/'index.json').read_bytes()
index=json.loads(index_raw)
values={}
members={}
for name in ('stdout.log','stderr.log'):
    row=index['members']['observation/full-verify-first/'+name]
    raw=(prior/'objects'/row['sha256']).read_bytes()
    assert hashlib.sha256(raw).hexdigest()==row['sha256'] and len(raw)==row['bytes']
    values[name]=raw.decode()
    members[name]=row
    with (out/name).open('xb') as stream:stream.write(raw)
with (out/'source.py').open('xb') as stream:stream.write(Path(accounting.__file__).read_bytes())
try:
    accounting.workspace(values['stdout.log'],values['stderr.log'],dict(classification='test-failure',exit=1))
except ValueError as error:
    value=dict(expected_refusal_observed=True,reason=str(error),no_workload_replay=True,
        old_index_sha256=hashlib.sha256(index_raw).hexdigest(),members=members)
    assert 'unrecognized Cargo target' in str(error)
    with (out/'result.json').open('x',encoding='utf-8') as stream:json.dump(value,stream,indent=2)
    print(json.dumps(value))
else:raise AssertionError('original regression no longer reproduces')
