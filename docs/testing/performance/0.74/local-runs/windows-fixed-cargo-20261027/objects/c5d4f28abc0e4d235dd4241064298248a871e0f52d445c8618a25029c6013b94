    'capture-fixed-cargo-security-lf-20261027.py','check-fixed-cargo-docs-20261027.py','seal-fixed-cargo-20261027.py'):
    add('helper/'+name,root/'target'/name)
index=dict(schema='hc074-local-evidence-collection-v1',members=members,
    actual_sources=sources,archived_code_executed=False,
    windows_package_pass=True,workspace_pass=False,release_admitted=False,
    package_targets=156,package_cases_passed=1351,workspace_stages_completed=11,
    workspace_failed_stage='dependency policy',workspace_stages_unstarted=9,security_advisories=11,
    source_frames_unchanged=True,original_jobs_retired=True,retries=False,server=False)
raw=(json.dumps(index,indent=2,sort_keys=True)+'\n').encode()
with (out/'index.json').open('xb') as stream:stream.write(raw)
with (out/'.gitattributes').open('x',encoding='utf-8',newline='\n') as stream:
    stream.write('objects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\nindex.json -text\n')
print(json.dumps(dict(index_sha256=sha(raw),members=len(members),objects=len(list((out/'objects').iterdir())),
    windows_package_pass=True,workspace_pass=False,release_admitted=False)))
