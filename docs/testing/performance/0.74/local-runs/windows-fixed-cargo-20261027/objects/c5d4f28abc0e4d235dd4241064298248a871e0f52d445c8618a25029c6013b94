"""Retain distinct actual gates and all preceding controls/refusals as inert data."""
from pathlib import Path
import hashlib,json,subprocess,tempfile
root=Path(__file__).resolve().parent.parent
base=root/'target/windows-fixed-cargo-20261027'
out=root/'docs/testing/performance/0.74/local-runs/windows-fixed-cargo-20261027'
assert not out.exists()
def read(name):return json.loads((base/name).read_bytes())
def sha(raw):return hashlib.sha256(raw).hexdigest()
for phase,n in [('controls-first',38),('controls-final',41),('controls-workspace-final',42)]:
    result=read(phase+'/result.json')
    assert result['exit']==0 and result['source_unchanged'] and result['head_unchanged']
    assert ('Ran '+str(n)+' tests').encode() in (base/phase/'stderr.log').read_bytes()
for phase in ('frame-diagnostic','preflight-package','package','workspace'):
    result=read(phase+'-capture/result.json')
    assert result['exit']==(1 if phase=='workspace' else 0)
    assert result['source_unchanged'] and result['head_unchanged']
sources={'package':'f62436aa6271793e157272b2a02957576b84c92e',
         'workspace':'2fe613bf866f31c1800addb10790d350656b1790'}
for mode,head in sources.items():
