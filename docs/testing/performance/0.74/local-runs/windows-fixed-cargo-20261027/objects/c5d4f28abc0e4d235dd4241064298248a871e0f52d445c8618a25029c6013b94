assert read('workspace-parser-baseline-reviewed/result.json')['expected_refusal_observed']
assert not list((base/'workspace-parser-baseline').iterdir())
assert not list((base/'security-postflight').iterdir())
assert read('doc-check-current/result.json')['exit']==0
assert read('doc-check-current/result.json')['source_frame_unchanged']
assert sha((root/'Cargo.lock').read_bytes())=='e385c45d47050299da7e79a5133d5ec71ca3ea77f6bafbc36744968dff2d28b5'
assert sha((root/'docs/testing/performance/0.74/qualification-manifest.toml').read_bytes())=='11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc'
(out/'objects').mkdir(parents=True)
members={}
def add(name,path):
    assert path.is_file() and not path.is_symlink() and not path.is_junction()
    raw=path.read_bytes();digest=sha(raw);obj=out/'objects'/digest
    if obj.exists():assert obj.read_bytes()==raw
    else:
        with obj.open('xb') as stream:stream.write(raw)
    assert name not in members
    members[name]=dict(sha256=digest,bytes=len(raw))
for path in sorted(base.rglob('*')):
    if path.is_file():add('capture/'+path.relative_to(base).as_posix(),path)
for path in sorted((root/'tools/windows-workspace-preflight-074').iterdir()):
    if path.is_file():add('source/current/'+path.name,path)
for phase in ('controls-first','controls-final','controls-workspace-final'):
    count=0
    for line in (base/phase/'stdout.log').read_text().splitlines():
        if line.startswith('retained-fixture '):
            folder=Path(line.removeprefix('retained-fixture ')).resolve(strict=True)
            assert folder.is_relative_to(Path(tempfile.gettempdir()).resolve()) and folder.name.startswith('hc074-owned-envelope-')
        elif line.startswith('retained-dispatch-fixture '):
            folder=Path(line.removeprefix('retained-dispatch-fixture ')).resolve(strict=True)
            assert folder.is_relative_to(root/'target') and folder.name.startswith('worker-request-fault-')
        else:raise ValueError('unknown fixture output')
        for path in folder.iterdir():
            if path.is_file():add('fixture/'+phase+'/'+str(count)+'/'+path.name,path)
        count+=1
    assert count==(3 if phase=='controls-first' else 4)
for name in ('record-fixed-cargo-20261027.py','verify-fixed-cargo-stage-20261027.py',
    'verify-workspace-account-stage-20261027.py','workspace-parser-regression-20261027.py',
