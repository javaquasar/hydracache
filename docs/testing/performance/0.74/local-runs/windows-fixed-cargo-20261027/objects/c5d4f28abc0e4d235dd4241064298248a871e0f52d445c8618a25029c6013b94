    assert before==after and before['head']==head
    result=read(mode+'/result.json');controller=read(mode+'/controller.json')
    assert result['source_refs_configuration_environment_unchanged'] and not result['release_admitted']
    execution=controller['execution']
    assert execution['retired'] and not execution['errors'] and execution['cleanup_seconds']==5
    assert execution['bound_seconds']==(780 if mode=='package' else 4800)
    assert execution['exit']==(0 if mode=='package' else 1)
    assert controller['request_sha256']==sha((base/mode/'request.json').read_bytes())
    assert len(before['targets'])==156 and len(before['workspace_members'])==36
package=read('package/accounting.json')
assert package['complete'] and package['package_pass']
assert (package['expected_targets'],package['scheduled_targets'],package['completed_targets'],package['passed'],package['failed'],package['ignored'])==(156,156,156,1351,0,0)
workspace=read('workspace/accounting.json')
assert not workspace['complete'] and not workspace['workspace_pass']
assert len(workspace['stages'])==21
assert sum(row['state']=='complete' for row in workspace['stages'])==11
assert workspace['stages'][11]==dict(name='dependency policy',state='incomplete-or-failed')
