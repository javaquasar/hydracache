"""Seal source-gate repair and first ordinary integration outcomes, no execution."""
from pathlib import Path, PurePosixPath
import hashlib
import json
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
RAW = ROOT / 'target/status-field-scan-20261024'
DEST = ROOT / 'docs/testing/performance/0.74/local-runs/source-guard-entry-first-20261024'
def sha(raw):
    return hashlib.sha256(raw).hexdigest()
def read(path):
    return json.loads(path.read_bytes())
if read(RAW / 'source-guard-complete-result.json')['Exit'] != 0:
    raise ValueError('Complete source gate red')
if read(RAW / 'source-guard-final-checks-result.json')['Exit'] != 0:
    raise ValueError('Focused/check/Clippy gate red')
source_log = (RAW / 'source-guard-complete.log').read_text()
if '321 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out;' not in source_log:
    raise ValueError('Complete original test membership changed')
entries = {}
for lane, expected in [('194', 0), ('188', 101)]:
    folder = RAW / ('entry-integration-' + lane + '-first')
    intent, result = read(folder / 'intent.json'), read(folder / 'result.json')
    if result['exit'] != expected or not result['source_unchanged'] or intent['source'] != result['source_after']:
        raise ValueError('Incomplete first entry lane')
    for name, digest in intent['source'].items():
        part = PurePosixPath(name)
        if part.is_absolute() or '..' in part.parts or ':' in name or '\\' in name:
            raise ValueError('Unsafe source proof')
        if sha((ROOT / name).read_bytes()) != digest:
            raise ValueError('Checked runtime source changed: ' + name)
    text = (folder / 'stdout.log').read_text()
    counts = re.findall(r'test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored; (\d+) measured; (\d+) filtered out;', text)
    entries[lane] = dict(exit=expected, target_results=[list(map(int, row)) for row in counts],
        failed_names=re.findall(r'^test (\S+) \.\.\. FAILED$', text, re.M),
        source_unchanged=True, selected_targets=intent['targets'])
if len(entries['194']['target_results']) != 11 or len(entries['188']['failed_names']) != 3:
    raise ValueError('Unexpected first integration membership')
qualification = ROOT / 'docs/testing/performance/0.74/qualification-manifest.toml'
if sha(qualification.read_bytes()) != '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc':
    raise ValueError('Qualification changed')
for name, expected in [
    ('target/bootstrap-original-getunit-20261023/native-once/libtest', 'ca5484aa951414b80aefd0148c7d8f5185a8fdf73bb197cf98a790de59b8cff1'),
    ('target/status-field-scan-20261024/runtime-images/gnu194', 'ae77d1bb99f339fc259e4cc6c9a664edc3e713c7da19c5475f582a16c7d26365'),
    ('target/status-field-scan-20261024/runtime-images/msrv188', 'ae33035a42392fe3f7fe7776c399e40a33198587786337643e7c6031a220d225')]:
    if sha((ROOT / name).read_bytes()) != expected:
        raise ValueError('Pinned image changed')
facts = dict(source_gate=dict(passed=321, failed=0, ignored=0, filtered=0,
    first_repair_passed=315, first_repair_failed=6, first_clippy_duplicate_module_refusal=True,
    final_focused_check_clippy_passed=True, repair_commit='11ad3be9'), entry_lanes=entries,
    runtime_commit='81f4add2', ordinary_complete_lib_gate_still_red=True,
    cleanup=read(RAW / 'pdb-compression-result.json'), qualification_sha256=sha(qualification.read_bytes()),
    original_owner_manual_run=False, ignored_manual_gates=False, product_measurement=False,
    no_retry=True, admission=False, server=False, clocks_changed=False, services_changed=False,
    original_windows_seconds=[300,60,10], all_writer_retirement=False, release_ready=False)
DEST.mkdir()
(DEST / 'objects').mkdir()
files = {}
def retain(name, raw):
    digest = sha(raw)
    target = DEST / 'objects' / digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    elif target.read_bytes() != raw:
        raise ValueError('Content collision')
    files[name] = dict(bytes=len(raw), sha256=digest)
for path in sorted(RAW.glob('source-guard-*')):
    if path.is_file():
        retain('observation/' + path.name, path.read_bytes())
for path in sorted(RAW.glob('pdb-compression*')):
    if path.is_file():
        retain('observation/' + path.name, path.read_bytes())
for lane in entries:
    folder = RAW / ('entry-integration-' + lane + '-first')
    for path in sorted(folder.iterdir()):
        retain('observation/' + folder.name + '/' + path.name, path.read_bytes())
retain('coordinator/run-entry-integration-once.py', (RAW / 'run-entry-integration-once.py').read_bytes())
for name in subprocess.check_output(['git','diff-tree','--no-commit-id','--name-only','-r','11ad3be9'], cwd=ROOT, text=True).splitlines():
    retain('source/' + name, (ROOT / name).read_bytes())
retain('coordinator/' + Path(__file__).name, Path(__file__).read_bytes())
retain('analysis/facts.json', (json.dumps(facts,indent=2,sort_keys=True)+'\n').encode())
index = dict(schema='hc074-source-guard-entry-first-v1', files=files, facts=facts)
with (DEST/'index.json').open('x',encoding='utf-8',newline='\n') as stream:
    json.dump(index,stream,indent=2,sort_keys=True)
    stream.write('\n')
with (DEST/'.gitattributes').open('x',encoding='ascii',newline='\n') as stream:
    stream.write('index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for row in files.values():
    raw=(DEST/'objects'/row['sha256']).read_bytes()
    if len(raw)!=row['bytes'] or sha(raw)!=row['sha256']:
        raise ValueError('Retained object mismatch')
print(dict(files=len(files),objects=len(list((DEST/'objects').iterdir())),index_sha256=sha((DEST/'index.json').read_bytes())))
