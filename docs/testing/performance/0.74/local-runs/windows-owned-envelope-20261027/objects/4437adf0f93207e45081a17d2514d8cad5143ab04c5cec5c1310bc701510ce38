from pathlib import Path
import hashlib,json,subprocess
root=Path(__file__).resolve().parent.parent
base=root/'target/windows-cleanup-gate-20261027'
result=json.loads((base/'envelope-final-capture/result.json').read_bytes())
assert result['exit']==0 and result['source_unchanged'] and result['head_unchanged']
names=subprocess.check_output(['git','diff','--cached','--name-only'],cwd=root).decode().splitlines()
assert names==['tools/windows-workspace-preflight-074/README.md','tools/windows-workspace-preflight-074/owned.py','tools/windows-workspace-preflight-074/test_owned.py']
for name in names:
    blob=subprocess.check_output(['git','show',':'+name],cwd=root)
    assert blob==(root/name).read_bytes()
    assert hashlib.sha256(blob).hexdigest()==result['source_after'][name]
with (base/'staged-code-verified.json').open('x',encoding='utf-8') as stream:json.dump(dict(exact_staged_blobs=3,focused_gate_exit=0),stream)
print('three exact staged blobs match the complete green focused command')
