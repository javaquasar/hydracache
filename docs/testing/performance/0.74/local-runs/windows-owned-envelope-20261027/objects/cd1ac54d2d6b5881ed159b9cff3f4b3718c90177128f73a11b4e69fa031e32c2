        assert line.startswith('retained-fixture ')
        folder=Path(line.removeprefix('retained-fixture ')).resolve(strict=True)
        assert folder.is_relative_to(Path(tempfile.gettempdir()).resolve())
        assert folder.name.startswith('hc074-owned-envelope-')
        result=json.loads((folder/'result.json').read_bytes())
        assert result['retired']
        for path in folder.iterdir():
            if path.is_file():add('fixture/'+phase+'/'+str(count)+'/'+path.name,path)
        count+=1
