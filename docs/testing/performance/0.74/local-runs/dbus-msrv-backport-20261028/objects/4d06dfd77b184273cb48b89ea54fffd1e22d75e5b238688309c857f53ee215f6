[target.'cfg(target_os = "linux")'.dev-dependencies.rustix]
version = "1.1.5"
features = ["thread"]

[target."cfg(windows)".dependencies.windows-sys]
version = "0.61.2"
features = ["Win32_Networking_WinSock"]
optional = true

[target."cfg(windows)".dev-dependencies.uds_windows]
version = "1.2.1"

[lints.rust.unexpected_cfgs]
level = "warn"
priority = 0
check-cfg = [
    "cfg(zruntime_poll)",
    "cfg(zruntime_kqueue)",
]

[profile.bench]
codegen-units = 1
debug = 2
strip = "none"
