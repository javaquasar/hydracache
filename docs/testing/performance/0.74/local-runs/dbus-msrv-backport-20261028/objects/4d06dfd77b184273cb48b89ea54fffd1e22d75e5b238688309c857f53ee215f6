[dependencies.futures-core]
version = "0.3.34"
optional = true
default-features = false

[dependencies.futures-io]
version = "0.3.34"
optional = true

[dependencies.tracing]
version = "0.1.44"
features = ["std"]
optional = true
default-features = false

[dev-dependencies.criterion]
version = "5.0.2"
features = ["async"]
package = "codspeed-criterion-compat"

[dev-dependencies.futures]
