[target.'cfg(any(unix, target_os = "wasi"))'.dependencies.rustix]
version = "1.1.5"
features = [
    "event",
    "pipe",
    "std",
    "time",
]
optional = true
default-features = false

[target.'cfg(not(all(target_os = "wasi", target_env = "p1")))'.dependencies.socket2]
version = "0.6.5"
