  else:
   path=dest/'zbus/src/match_rule/mod.rs';before=path.read_text(encoding='utf-8')
   after=before
   for fmt,arg in (('arg{i}','arg'),('arg{i}path','arg_path')):
    old='            let key = format_args!("'+fmt+'");\n            write_match_rule_string_component(f, key, '+arg+', &mut first_component)?;'
    new='            write_match_rule_string_component(f, format_args!("'+fmt+'"), '+arg+', &mut first_component)?;'
