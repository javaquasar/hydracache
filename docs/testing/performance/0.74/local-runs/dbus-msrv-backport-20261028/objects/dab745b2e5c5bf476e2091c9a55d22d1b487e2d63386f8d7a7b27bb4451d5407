  if raw.replace(b'\r\n',b'\n').startswith(prefix):raw=raw.replace(b'\r\n',b'\n')[len(prefix):]
  p.require(raw.startswith(b'use ') and b''.join(raw.split())==b''.join(before.split()),'whitespace-only source projection')
  (dest/'zbus/src/match_rule/mod.rs').write_bytes(raw)
  import difflib
  (out/'format.patch').write_text(''.join(difflib.unified_diff(before.decode().splitlines(True),raw.decode().splitlines(True),fromfile='Q/zbus/src/match_rule/mod.rs',tofile='F/zbus/src/match_rule/mod.rs')),encoding='utf-8',newline='\n')
 write(out,'result.json',dict(files=files(dest),root_inputs=roots,variant=variant,
  source_body_changed=variant in ('Q','F'),compiler_floor_experiment_only=variant not in ('U','A'),release_admitted=False))
 print('prepared '+variant)
def snapshot():
 names=subprocess.check_output(['git','ls-files','-z','--cached','--others','--exclude-standard','--','Cargo.toml','Cargo.lock','deny.toml','.cargo','crates','tools','scripts'],cwd=ROOT).split(b'\0')
 return {n.decode():sha((ROOT/n.decode()).read_bytes()) for n in sorted(set(names)) if n}
def run(label,worker):
 match=re.fullmatch(r'(resolve|fetch|pin|floor|build|list|test|check|clippy|policy|format-view|format)-(U|M|P|A|Q|F)-(194|188)',label)
 p.require(match is not None,'fixed local step');action,variant,compiler=match.groups()
 p.require((action not in ('resolve','fetch') or (variant,compiler)==('U','194')) and (action!='floor' or (variant,compiler)==('U','188')),'fixed preparation/refusal commands')
 p.require(action!='pin' or (variant,compiler)==('P','194'),'fixed compatible UUID lock control')
 folder=BASE/'fixtures'/variant;review=json.loads((BASE/('prepare-'+variant)/'result.json').read_bytes())
 expected=review['files']
 if variant=='U' and action!='resolve':expected=json.loads((BASE/'resolve-U-194/result.json').read_bytes())['fixture_after']
 if variant=='P' and action!='pin':expected=json.loads((BASE/'pin-P-194/result.json').read_bytes())['fixture_after']
 def guard():
  p.require(root_inputs()==review['root_inputs'],'exact protected root inputs')
  p.require(files(folder)==expected,'exact whole fixture before command')
 identity=sha(json.dumps(dict(files=expected,compiler=compiler),sort_keys=True).encode())
 target=BASE/'targets'/variant/compiler/identity
 cargo=['cargo','+1.94.0' if compiler=='194' else '+1.88.0']
 common=['--offline','--locked','--manifest-path',str(folder/'Cargo.toml'),'--target-dir',str(target),'-p','dbus-probe-074']
 artifact=None;listing=None
 if action=='resolve':argv=cargo+['generate-lockfile','--manifest-path',str(folder/'Cargo.toml')]
 elif action in ('format-view','format'):
  argv=['rustfmt','+1.94.0','--edition','2024',*(['--emit','stdout'] if action=='format-view' else ['--check']),str(folder/'zbus/src/match_rule/mod.rs')]
 elif action=='pin':argv=cargo+['update','--offline','--manifest-path',str(folder/'Cargo.toml'),'--package','uuid','--precise','1.23.4']
 elif action=='fetch':argv=cargo+['fetch','--locked','--manifest-path',str(folder/'Cargo.toml')]
 elif action in ('floor','check','clippy'):
  argv=cargo+['clippy' if action=='clippy' else 'check',*common,'--all-targets','--all-features']+(['--','-D','warnings'] if action=='clippy' else [])
 elif action=='build':argv=cargo+['test',*common,'--lib','--no-run','--message-format=json']
 elif action=='policy':argv=cargo+['deny','--manifest-path',str(folder/'Cargo.toml'),'--offline','--locked','check','--config',str(ROOT/'deny.toml')]
 else:
  build=json.loads((BASE/f'build-{variant}-{compiler}/result.json').read_bytes())
  p.require(build['exit']==0 and build['unchanged'],'actual successful build')
  artifact=build['artifact'];image=Path(artifact['path'])
  p.require(image.resolve().is_relative_to(target) and not image.is_symlink() and not image.is_junction() and sha(image.read_bytes())==artifact['sha256'],'bound compiler image')
  if action=='list':argv=[str(image),'--list']
  else:
   listing=json.loads((BASE/f'list-{variant}-{compiler}/result.json').read_bytes())
   p.require(listing['exit']==0 and listing['artifact']==artifact and listing['unchanged'],'actual complete native catalog')
   argv=[str(image),'--test-threads=1','--show-output']
 out=BASE/label
 if worker:
  guard()
  def capacity():
   if shutil.disk_usage(ROOT).free<p.FLOOR:raise owned.CapacityError('original 4 GiB floor')
  result=owned._owned(owned.load_job().WindowsJob(),argv,str(ROOT),capacity,bound=1200)
  write(out,'execution.json',result);raise SystemExit(result['exit'])
 out.mkdir(exist_ok=False);(out/'launcher.py').write_bytes(Path(__file__).read_bytes())
 with (out/'stdout.log').open('xb') as stdout,(out/'stderr.log').open('xb') as stderr:
  try:
   guard();before=snapshot();head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip()
   write(out,'intent.json',dict(argv=argv,source=before,head=head,variant=variant,compiler=compiler,
    artifact=artifact,fixture_before=expected,bound=1200,floor=p.FLOOR,capacity_poll=5,retirement=5,retry=False,server=False,services=False,clocks=False))
   child=subprocess.Popen([sys.executable,'-B',str(Path(__file__)),label,'--worker'],cwd=ROOT,
    stdin=subprocess.DEVNULL,stdout=stdout,stderr=stderr,env=dict(os.environ,CARGO_INCREMENTAL='0',CARGO_BUILD_JOBS='2'))
   try:code=child.wait(timeout=1210)
   except subprocess.TimeoutExpired:
    child.kill();child.wait(timeout=5);raise ValueError('owned worker lost; no PID fallback')
   after=files(folder)
   if action=='resolve' and code==0:
    p.require(set(after)==set(expected)|{'Cargo.lock'} and all(after[n]==v for n,v in expected.items()),'only standalone lock added')
   elif action=='pin' and code==0:
    p.require(set(after)==set(expected) and [n for n in expected if after[n]!=expected[n]]==['Cargo.lock'],'only standalone lock changed')
