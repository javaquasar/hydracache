   else:guard()
   execution=json.loads((out/'execution.json').read_bytes())
   unchanged=before==snapshot() and head==subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip()
   p.require(unchanged and execution['retired'] and not execution['errors'],'whole source/head and original Job retirement')
   result=dict(exit=code,unchanged=unchanged,fixture_after=after,artifact=artifact,release_admitted=False)
   raw=(out/'stdout.log').read_bytes()
   if action=='build' and code==0:
    messages=[json.loads(line) for line in raw.splitlines()]
    found=[m for m in messages if m.get('reason')=='compiler-artifact' and m['target']['name']=='dbus_probe_074' and m['target']['kind']==['lib'] and m['profile']['test'] and m.get('executable')]
    p.require(len(found)==1 and [m['success'] for m in messages if m.get('reason')=='build-finished']==[True],'actual successful artifact')
    image=Path(found[0]['executable']);p.require(image.resolve().is_relative_to(target) and Path(found[0]['target']['src_path']).resolve()==(folder/'probe/src/lib.rs').resolve(),'artifact input')
    result['artifact']=dict(path=str(image),sha256=sha(image.read_bytes()),bytes=image.stat().st_size)
   if artifact:p.require(sha(Path(artifact['path']).read_bytes())==artifact['sha256'],'original image postflight')
   if action=='list' and code==0:
    names=[line[:-6] for line in raw.decode().splitlines() if line.endswith(': test')]
