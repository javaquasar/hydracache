    after=after.replace(old,new,1)
   path.write_text(after,encoding='utf-8',newline='\n')
   import difflib
   (out/'source.patch').write_text(''.join(difflib.unified_diff(before.splitlines(True),after.splitlines(True),fromfile='P/zbus/src/match_rule/mod.rs',tofile='Q/zbus/src/match_rule/mod.rs')),encoding='utf-8',newline='\n')
 else:
  prior=json.loads((BASE/'format-view-Q-194/result.json').read_bytes())
  p.require(prior['exit']==0 and prior['unchanged'],'retained pure format projection')
  source=BASE/'fixtures/Q';p.require(files(source)==json.loads((BASE/'prepare-Q/result.json').read_bytes())['files'],'exact original Q')
  shutil.copytree(source,dest)
  raw=(BASE/'format-view-Q-194/stdout.log').read_bytes()
  before=(dest/'zbus/src/match_rule/mod.rs').read_bytes()
