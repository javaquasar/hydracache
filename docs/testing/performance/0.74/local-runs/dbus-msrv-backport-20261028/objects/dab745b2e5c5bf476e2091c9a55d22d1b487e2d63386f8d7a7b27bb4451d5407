   stream.write(('\n#[cfg(test)]\n#[path = '+json.dumps(overlay.as_posix())+']\nmod match_rule_review;\n').encode())
  if variant=='A':
   for name in ('zbus','zbus_macros','zbus_utils'):
    path=dest/name/'Cargo.toml';raw=path.read_text(encoding='utf-8')
    p.require(raw.count('rust-version = "1.88"')==1,'counterpart original floor')
