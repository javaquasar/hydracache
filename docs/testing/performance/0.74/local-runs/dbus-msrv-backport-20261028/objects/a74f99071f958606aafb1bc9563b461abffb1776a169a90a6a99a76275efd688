 'docs/testing/performance/0.74/qualification-manifest.toml','tools/chitchat-mtu-review-074/accounting.py',
 'tools/windows-workspace-preflight-074/owned.py','tools/windows-workspace-preflight-074/prepare.py',
 'scripts/ci/watchdog_windows_job.py'):
 add('source/'+name,ROOT/name)
for path in sorted((ROOT/'target').glob('*dbus*20261028.py')):add('producer/'+path.name,path)
