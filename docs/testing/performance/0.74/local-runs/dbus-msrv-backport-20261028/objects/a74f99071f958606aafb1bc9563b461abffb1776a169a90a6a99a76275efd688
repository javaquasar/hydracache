from pathlib import Path
import hashlib,json,subprocess
ROOT=Path(__file__).resolve().parent.parent;BASE=ROOT/'target/dbus-backport-20261028'
OUT=ROOT/'docs/testing/performance/0.74/local-runs/dbus-msrv-backport-20261028'
sha=lambda b:hashlib.sha256(b).hexdigest()
steps={};native=0
for top in sorted(BASE.iterdir()):
 if not (top/'execution.json').is_file():continue
 execution=json.loads((top/'execution.json').read_bytes());result=json.loads((top/'result.json').read_bytes())
 assert execution['retired'] and not execution['errors'] and result['unchanged']
 expected=101 if top.name in ('floor-U-188','check-M-188','check-P-188') else 0
 assert result['exit']==execution['exit']==expected
 if 'accounting' in result:
  assert result['accounting']['test_pass'] and result['accounting']['selected']==5
  native+=result['accounting']['passed']
 if result.get('artifact'):
  artifact=result['artifact'];assert sha(Path(artifact['path']).read_bytes())==artifact['sha256']
 steps[top.name]=dict(exit=expected,retired=True,native_accounting=result.get('accounting'),
  source_head=json.loads((top/'intent.json').read_bytes())['head'])
assert native==20
for variant in ('F','F2'):
 assert json.loads((BASE/('prepare-'+variant)/'refusal.json').read_bytes())['inert_prepare_failure']
