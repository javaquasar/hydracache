"""Offline independent accounting; never rerun a parser, compiler or consumer."""
from pathlib import Path
import json
import re

import run as w


def catalog(rows):
    result={}
    for row in rows:
        name=row['target'];cases=row['cases']
        w.p.require(name not in result and len(cases)==len(set(cases)),'duplicate target/case inventory')
        w.p.require(row['passed']+row['ignored']==len(cases),'complete case inventory')
        result[name]=row
    w.p.require(result,'nonempty actual consumer inventory')
    return result


def probe(raw,candidate):
    corpus=re.findall(r'HC074-MD-CORPUS index=\d+ name=[0-9a-f]+ events=[0-9a-f]+ html=[0-9a-f]*',raw)
    w.p.require(len(corpus)==8 and [int(re.search(r'index=(\d+)',v)[1]) for v in corpus]==list(range(8)), 'complete ordered corpus')
    rows=re.findall(r'HC074-MD-GROWTH option=(wiki|consumer) repeats=(\d+) count=(\d+) cap=1000000',raw)
    growth={(label,int(n)):int(count) for label,n,count in rows}
    expected={(label,n) for label in ('wiki','consumer') for n in (1,2,4,8,16,32,64)}
    w.p.require(len(rows)==len(growth)==14 and set(growth)==expected,'complete unfiltered growth inventory')
    if candidate:w.p.require(all(count==4*n+1 for (_,n),count in growth.items()),'fixed linear event oracle')
    else:w.p.require(all(growth[(label,16)]==327676 for label in ('wiki','consumer')),'original first counterexample')
    return corpus


def generated(folder,compiler):
    from consumer import PACKAGES
    result={};bindings=[]
    for line in (folder/'build/stdout.log').read_text().splitlines():
        row=json.loads(line)
        if row.get('reason')!='build-script-executed':continue
        for package in PACKAGES:
            prefix='path+'+(w.ROOT/'crates'/package).as_uri()+'#'
            if row['package_id'].startswith(prefix):
                directory=Path(row['out_dir'])
                w.p.require(directory.resolve().is_relative_to(w.BASE/'consumer-targets'/compiler),'actual generated output custody')
                bindings.append(dict(package=package,out_dir=str(directory)))
                for path in sorted(directory.iterdir()):
                    if path.is_file() and path.suffix in ('.rs','.bin'):
                        w.p.require(not path.is_symlink() and not path.is_junction(),'generated regular output')
                        name=package+'/'+path.name
                        w.p.require(name not in result,'duplicate actual generated output')
                        result[name]=w.sha(path.read_bytes())
    expected=json.loads((folder/'generated.json').read_bytes())
    w.p.require(sorted(v['package'] for v in bindings)==sorted(PACKAGES) and result==expected,'exact actual Cargo output binding')
    for name,digest in expected.items():w.p.require(w.sha((folder/'generated'/name).read_bytes())==digest,'exact retained generated bytes')
    return dict(bindings=bindings,generated=expected,matched=True)


def main():
    out=w.BASE/'analysis-2';out.mkdir(exist_ok=False)
    (out/'producer.py').write_bytes(Path(__file__).read_bytes())
    result=dict(complete=False,release_admitted=False,performance_claim=False)
    try:
        matrix={};all_corpus=[]
        for platform in ('windows','gnu'):
            for compiler in ('194','188'):
                values={}
                for mode in ('baseline','candidate'):
                    folder=w.BASE/(('test-'+mode+'-'+compiler) if platform=='windows' else ('gnu-'+compiler+'/'+mode+'-test'))
                    values[mode]=probe((folder/'stdout.log').read_text(),mode=='candidate')
                w.p.require(values['baseline']==values['candidate'],'exact parser events/HTML corpus')
                all_corpus.append(values['candidate'])
                matrix[platform+'-'+compiler]=dict(cases=8,events_html_equal=True,baseline_16_events=327676,candidate_16_events=65)
        w.p.require(all(c==all_corpus[0] for c in all_corpus),'cross-platform corpus')
        consumers={}
        for compiler in ('194','188'):
            modes={};order={}
            for mode in ('baseline','candidate'):
                folder=w.BASE/('consumer-'+mode+'-'+compiler)
                receipt=json.loads((folder/'result.json').read_bytes())
                w.p.require(receipt['complete'] and receipt['source_unchanged'] and receipt['head_unchanged'],'complete actual consumer receipt')
                binding=generated(folder,compiler)
                w.p.write(out,'generated-'+mode+'-'+compiler+'.json',binding)
                modes[mode]=(catalog(receipt['counts']),binding['generated'])
                order[mode]=[row['target'] for row in receipt['counts']]
            w.p.require(modes['baseline']==modes['candidate'],'exact per-target cases and generated bytes')
            rows=list(modes['candidate'][0].values())
            consumers[compiler]=dict(targets=len(rows),passed=sum(v['passed'] for v in rows),ignored=sum(v['ignored'] for v in rows),
                case_catalog_equal=True,generated_files=len(modes['candidate'][1]),generated_equal=True,
                actual_cargo_output_bound=True,artifact_arrival_order_equal=order['baseline']==order['candidate'],raw_arrival_orders=order)
        result.update(complete=True,matrix=matrix,consumers=consumers,first_inert_failure_retained=True,
            first_inert_failure_cause='Compared parallel Cargo artifact arrival order instead of target identity; no product/test rerun',
            runtime_claim=False)
    except BaseException as error:result['first_refusal']=dict(type=type(error).__name__,reason=str(error))
    w.p.write(out,'result.json',result)
    w.p.require(result['complete'],'complete offline attribution')
    print(json.dumps(dict(complete=True,consumers=consumers)))


if __name__=='__main__':main()
