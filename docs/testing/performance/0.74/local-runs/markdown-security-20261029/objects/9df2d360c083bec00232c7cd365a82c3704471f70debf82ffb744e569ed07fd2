name: Performance CPU Attribution 0.73

on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: "Exact lowercase 40-character diagnostic source commit"
        required: true
        type: string
      lease_owner:
        description: "Operator holding the serialized performance-host lease"
        required: true
        type: string
      lease_end:
        description: "Approved lease end in RFC3339 form"
        required: true
        type: string
  push:
    branches:
      - docs/0.73-evidence-driven-performance-plan
    paths:
      - .github/workflows/performance-cpu-attribution-073.yml
      - scripts/perf/performance_cpu_attribution_073.py
      - docs/testing/performance/0.73/cpu-attribution-contract.toml

permissions:
  contents: read

concurrency:
  group: performance-reference-073-host
  cancel-in-progress: false

jobs:
  attribute:
    name: Non-promotable observer CPU attribution
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-073
    timeout-minutes: 60
    env:
      HYDRACACHE_PERFORMANCE_PROTECTED_ENV: performance-reference-073
      HYDRACACHE_PERFORMANCE_DEDICATED_BARE_METAL: "1"
      HYDRACACHE_PERFORMANCE_DAEMON_CPUSET: ${{ vars.HYDRACACHE_MEMORY_DAEMON_CPUSET || '5-6' }}
      HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET: ${{ vars.HYDRACACHE_MEMORY_LOADGEN_CPUSET || '7' }}
      HYDRACACHE_PERFORMANCE_COLLECTOR_CPUSET: ${{ vars.HYDRACACHE_MEMORY_COLLECTOR_CPUSET || '0' }}
      EVIDENCE_DIR: target/performance-evidence/0.73/reference/cpu-attribution

    steps:
      - name: Checkout exact diagnostic source
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Resolve source and serialized lease
        shell: bash
        env:
          INPUT_SOURCE_SHA: ${{ inputs.source_sha }}
          INPUT_LEASE_OWNER: ${{ inputs.lease_owner }}
          INPUT_LEASE_END: ${{ inputs.lease_end }}
        run: |
          set -euo pipefail
          source_sha="${INPUT_SOURCE_SHA:-$GITHUB_SHA}"
          lease_owner="${INPUT_LEASE_OWNER:-$GITHUB_ACTOR}"
          lease_end="${INPUT_LEASE_END:-$(date --utc --date='+1 hour' --iso-8601=seconds)}"
          [[ "$source_sha" =~ ^[0-9a-f]{40}$ ]]
          test "$(git rev-parse HEAD)" = "$source_sha"
          test -n "$lease_owner"
          date --date="$lease_end" >/dev/null
          {
            echo "HYDRACACHE_PERFORMANCE_LEASE_OWNER=$lease_owner"
            echo "HYDRACACHE_PERFORMANCE_LEASE_END=$lease_end"
            echo "EXPECTED_SOURCE_SHA=$source_sha"
          } >> "$GITHUB_ENV"

      - name: Expose and verify required host tools
        shell: bash
        run: |
          set -euo pipefail
          rust_bin="$HOME/.cargo/bin"
          test -x "$rust_bin/cargo"
          test -x "$rust_bin/rustc"
          echo "$rust_bin" >> "$GITHUB_PATH"
          cargo --version
          rustc --version
          pidstat -V

      - name: Capture pre-diagnostic calibration
        shell: bash
        run: |
          set -euo pipefail
          cargo run -p xtask --locked -- perf-memory-preflight \
            --release 0.73 \
            --profile performance-reference-073-v1 \
            --output "$RUNNER_TEMP/performance-073-preflight.json"

      - name: Build exact standalone attribution harness
        shell: bash
        run: cargo build --manifest-path tools/performance-observer-073/Cargo.toml --release --locked

      - name: Run counterbalanced four-mode attribution
        shell: bash
        run: |
          set -euo pipefail
          python3 scripts/perf/performance_cpu_attribution_073.py \
            --binary tools/performance-observer-073/target/release/performance-observer-073 \
            --output "$EVIDENCE_DIR/campaign" \
            --rate 10000 \
            --repeats 5 \
            --window-seconds 5 \
            --warmup-operations 5000 \
            --seed 73110 \
            --cpu-set "$HYDRACACHE_PERFORMANCE_LOADGEN_CPUSET" \
            --source-sha "$EXPECTED_SOURCE_SHA"

      - name: Capture post-diagnostic calibration
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          cargo run -p xtask --locked -- perf-memory-preflight \
            --release 0.73 \
            --profile performance-reference-073-v1 \
            --output "$RUNNER_TEMP/performance-073-postflight.json"

      - name: Seal diagnostic packet
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$EVIDENCE_DIR"
          cp "$RUNNER_TEMP/performance-073-preflight.json" "$EVIDENCE_DIR/preflight.json"
          cp "$RUNNER_TEMP/performance-073-postflight.json" "$EVIDENCE_DIR/postflight.json"
          python3 - "$EVIDENCE_DIR" "$EXPECTED_SOURCE_SHA" <<'PY'
          import hashlib
          import json
          import pathlib
          import sys

          root = pathlib.Path(sys.argv[1])
          source_sha = sys.argv[2]
          before_path = root / "preflight.json"
          after_path = root / "postflight.json"
          diagnostic_path = root / "campaign" / "cpu-attribution.json"
          before = json.loads(before_path.read_text(encoding="utf-8"))
          after = json.loads(after_path.read_text(encoding="utf-8"))
          diagnostic = json.loads(diagnostic_path.read_text(encoding="utf-8"))
          if before["host_fingerprint"] != after["host_fingerprint"]:
              raise SystemExit("host fingerprint drifted across CPU attribution")
          if before["identity_probes"] != after["identity_probes"]:
              raise SystemExit("host identity or held policy drifted across CPU attribution")
          if before["lease"] != after["lease"]:
              raise SystemExit("serialized lease changed across CPU attribution")
          if before["source_sha"] != source_sha or after["source_sha"] != source_sha:
              raise SystemExit("host receipts do not bind the diagnostic source")
          if before["result"] != "success" or after["result"] != "success":
              raise SystemExit("pre/post host calibration did not pass")
          if diagnostic["source_sha"] != source_sha or diagnostic["candidate_data_present"]:
              raise SystemExit("CPU attribution is not baseline-only diagnostic evidence")
          if not diagnostic["diagnostic_complete"]:
              raise SystemExit("CPU attribution did not retain a complete four-mode block")
          digest = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
          manifest = {
              "schema_version": 1,
              "release": "0.73",
              "profile_id": "observer-cpu-attribution-073-v1",
              "source_sha": source_sha,
              "result": "complete-diagnostic",
              "host_fingerprint": before["host_fingerprint"],
              "preflight_sha256": digest(before_path),
              "postflight_sha256": digest(after_path),
              "cpu_attribution_sha256": digest(diagnostic_path),
              "candidate_data_present": False,
              "candidate_measurement_authorized": False,
              "acceptance_decision_allowed": False,
              "silent_retry_allowed": False,
          }
          (root / "campaign-manifest.json").write_text(
              json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
          )
          PY

      - name: Retain CPU attribution packet
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: performance-cpu-attribution-073-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: target/performance-evidence/0.73/reference/cpu-attribution/**
          if-no-files-found: error
          retention-days: 90
