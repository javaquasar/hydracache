from pathlib import Path
import hashlib,json,subprocess,tarfile
root=Path(__file__).resolve().parent.parent
out=root/'target/authorized-server-session-20261025/download-evidence';out.mkdir(exist_ok=False)
remote='/tmp/hc074-server-gate-export-20261025.ay9gvta_'
argv=['scp','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','ConnectTimeout=15',
 f'hydracache-ax42:{remote}/raw.tar',f'hydracache-ax42:{remote}/manifest.json',str(out)]
(out/'intent.json').write_text(json.dumps(dict(argv=argv,retry=False)),encoding='utf-8')
with (out/'stdout.log').open('xb') as stdout,(out/'stderr.log').open('xb') as stderr:p=subprocess.run(argv,stdout=stdout,stderr=stderr,timeout=60)
(out/'result.json').write_text(json.dumps(dict(exit=p.returncode)),encoding='utf-8')
assert p.returncode==0
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
assert sha(out/'raw.tar')=='0240328673423b7d0d8a2ec3da3098cec50961a3ef4fb52a7fbecdea99244631'
assert sha(out/'manifest.json')=='3e1b93040874f766d517249f61b12358f64292a4d4df9c454862cc6de668a752'
manifest=json.loads((out/'manifest.json').read_bytes())
raw=out/'raw';raw.mkdir()
with tarfile.open(out/'raw.tar') as archive:
 members=archive.getmembers();assert len(members)==len(manifest['files'])==67
 assert {m.name for m in members}==set(manifest['files'])
 for m in members:
  assert m.isfile() and Path(m.name).name==m.name
  data=archive.extractfile(m).read()
  expected=manifest['files'][m.name]
  assert len(data)==expected['bytes'] and hashlib.sha256(data).hexdigest()==expected['sha256']
  (raw/m.name).write_bytes(data)
print(json.dumps(dict(download_verified=True,members=len(members))))
