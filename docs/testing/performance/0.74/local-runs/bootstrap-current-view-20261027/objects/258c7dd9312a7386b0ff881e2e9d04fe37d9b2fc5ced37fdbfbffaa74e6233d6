fn all_old_cases_guards_rules_and_the_observation_primitive_remain_exact() {
    for path in [
        "tools/bootstrap-doc-reader-074/contract.rs",
        "tools/bootstrap-doc-reader-074/rules.json",
        "tools/bootstrap-doc-reader-074/reader.rs",
        "tools/bootstrap-doc-reader-074/proof.rs",
        "tools/source-successor-view-074/contract.rs",
        "tools/source-successor-view-074/rules.json",
        "tools/source-successor-view-074/diagnostic.rs",
        "tools/source-successor-view-074/diagnostic-additions.txt",
        "tools/security-input-view-074/contract.rs",
        "tools/security-input-view-074/rules.json",
        "tools/roots-lock-view-074/contract.rs",
        "tools/roots-lock-view-074/rules.json",
        "tools/authority-runtime-074/gate.rs",
        "tools/authority-runtime-074/io.rs",
        "Cargo.toml",
        LOCK,
        fixture::PATH,
        REGISTRY,
        "docs/testing/performance/0.74/qualification-manifest.toml",
    ] {
        assert_eq!(raw(path), frozen(STEP, path), "{path}");
    }
    for name in [
        "bootstrap_build_owner_074",
        "bootstrap_child_boundary_074",
        "bootstrap_child_census_074",
        "bootstrap_child_reader_074",
        "bootstrap_current_image_074",
        "bootstrap_enrollment_074",
        "bootstrap_entry_binding_074",
        "bootstrap_image_census_074",
        "bootstrap_installed_origin_074",
    ] {
        let path = format!("crates/xtask/tests/{name}.rs");
        assert_eq!(raw(&path), frozen(STEP, &path));
    }
    let path = "crates/xtask/tests/bootstrap_doc_reader_074.rs";
    let old = frozen(STEP, path);
    let now = raw(path);
    assert_eq!(predicates(&now), predicates(&old));
    let expected = old
        .replacen(
            "../../../tools/bootstrap-doc-reader-074/io.rs",
            "../../../tools/bootstrap-doc-reader-074/fixture.rs",
            1,
        )
        .replacen(
            "fn raw(path: &str) -> String {\n    std::fs::read_to_string",
            "fn raw(path: &str) -> String {\n    let raw = std::fs::read_to_string",
            1,
        )
        .replacen(
            "        .replace(\"\\r\\n\", \"\\n\")\n}",
            "        .replace(\"\\r\\n\", \"\\n\");\n    docs::assertion_input(path, raw)\n}",
            1,
        );
    assert_eq!(now, expected);
    let path = "tools/bootstrap-doc-reader-074/read.rs";
    let old = frozen(STEP, path);
    let now = raw(path);
    assert_eq!(
        now.split_once("// Separate from").unwrap().0,
        old.split_once("pub fn read_with(").unwrap().0
    );
    assert_eq!(
        now.split_once("pub fn read_with(").unwrap().1,
        old.split_once("pub fn read_with(").unwrap().1
    );
    let path = "tools/bootstrap-doc-reader-074/io.rs";
    let old = frozen(STEP, path);
    let now = raw(path);
    assert_eq!(
        now.split_once("pub fn project(")
            .unwrap()
            .1
            .split_once("pub fn read_to_string(")
            .unwrap()
            .0,
        old.split_once("pub fn project(")
            .unwrap()
            .1
            .split_once("pub fn read_to_string(")
            .unwrap()
            .0
    );
}
