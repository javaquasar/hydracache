CASES = [
    ('current-frontier-msrv-first', ['cargo', '+1.88.0', 'test', '--offline', '--locked', '--no-fail-fast', '-p', 'xtask',
       '--test', 'current_frontier_074', '--test', 'current_tree_input_audit_074', '--test', 'current_tree_reader_074',
