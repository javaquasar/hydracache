    ('current-frontier-producer-first', [sys.executable, 'tools/current-frontier-074/generate.py']),
    ('current-frontier-check-first', ['cargo', '+1.94.0', 'check', '--offline', '--locked', '-p', 'xtask', '--all-targets']),
    ('current-frontier-clippy-first', ['cargo', '+1.94.0', 'clippy', '--offline', '--locked', '-p', 'xtask', '--all-targets', '--all-features', '--', '-D', 'warnings']),
