"""Review original complete-command attempt without running its unfinished suffix."""
from pathlib import Path
import hashlib
import json
import sys
import tomllib

ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(ROOT/'tools/xtask-package-attribution-074'))
import review
folder=ROOT/'target/source-continuation-20261024/package-replay-v2-first-reviewed'
intent=json.loads((folder/'intent.json').read_bytes()); result=json.loads((folder/'result.json').read_bytes())
assert intent['argv']==review.ARGV and intent['bound_seconds']==780 and intent['retry'] is False
assert intent['head']=='baffe6000f747ea6bc830f338f2673b0874129b7'
assert result['source_unchanged'] and result['head_unchanged'] and intent['source']==result['source_after']
manifest=(ROOT/'crates/xtask/Cargo.toml').read_bytes()
assert hashlib.sha256(manifest).hexdigest()==intent['source']['crates/xtask/Cargo.toml']
catalog=review.catalog(intent['source'],tomllib.loads(manifest.decode()))
report=review.parse_transcript((folder/'stdout.log').read_text(),(folder/'stderr.log').read_text(),
    catalog,result['exit'],result['outer_refusal'],780)
with (ROOT/'target/package-review-v2-first-result-20261025.json').open('x',encoding='utf-8') as stream:
    json.dump(report,stream,sort_keys=True,indent=2); stream.write('\n')
print(json.dumps({k:v for k,v in report.items() if k not in ('targets','unstarted_targets','incomplete_target')},indent=2))
print(json.dumps(dict(incomplete_target=None if report['incomplete_target'] is None else
    {k:v for k,v in report['incomplete_target'].items() if k!='cases'},
    unstarted_targets=report['unstarted_targets'],
    failed_targets=[dict(target=v['target'],failed_cases=[c['name'] for c in v['cases'] if c['verdict']=='FAILED'])
                    for v in report['targets'] if v['failed']]),indent=2))
