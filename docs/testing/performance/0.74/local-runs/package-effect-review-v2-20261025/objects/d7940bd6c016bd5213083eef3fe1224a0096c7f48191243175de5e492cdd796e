def require(value, message):
    if not value:
        raise ValueError(message)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def previous_document(root):
    folder = root/PREVIOUS_PACKET
    raw = (folder/'index.json').read_bytes()
    require(sha(raw) == PREVIOUS_INDEX_SHA256, 'old packet identity')
    entry = json.loads(raw)['members']['syntax/final-closure/result.json']
    raw = (folder/'objects'/entry['sha256']).read_bytes()
    require(len(raw) == entry['bytes'] and sha(raw) == entry['sha256'], 'old syntax object')
    result = json.loads(raw)
    require(legacy.document_digest(result) == PREVIOUS_AST_SHA256 == legacy.REVIEWED_AST_SHA256,
            'old review remains immutable')
    return result


def source_review(root, document):
    root = root.resolve(strict=True)
    require(legacy.document_digest(document) == REVIEWED_AST_SHA256, 'unreviewed v2 syntax/source inventory')
    require(document['executed_input_code'] is False and document['compiler_expansion'] is False, 'source-only inventory scope')
    additions, unresolved = legacy.syntax_audit.module_edges(root, document)
    require(not additions and not unresolved, 'module graph not closed')
    sources = {v['source']: v['sha256'] for v in document['sources']}
    require(len(sources) == len(document['sources']) == 342, 'duplicate or changed source count')
    constructors = []
    for row in document['sources']:
        path = (root/row['source']).resolve(strict=True)
        require(path.is_relative_to(root) and path.suffix == '.rs' and sha(path.read_bytes()) == row['sha256'], 'source bytes/path drift')
        for site in row['sites']:
            require(site['kind'] != 'include', 'unexpanded include edge')
            if site['kind'] in ('command-constructor', 'macro-command-constructor'):
                require(site['detail'] not in {'literal:ssh', 'literal:systemctl', 'literal:systemd-run',
                    'literal:wsl', 'literal:timedatectl'}, 'host/service constructor requires separate review')
                constructors.append(dict(source=row['source'], **site))
    old = {v['source']: v for v in previous_document(root)['sources']}
    new = {v['source']: v for v in document['sources']}
    changed = {path for path in old.keys() & new.keys() if old[path] != new[path]}
    added = new.keys() - old.keys()
    require(not old.keys() - new.keys() and len(changed) == 4 and len(added) == 8, 'unreviewed old-source delta')
    require({path: sources[path] for path in changed | added} == REVIEWED_DELTA, 'manual delta pins drift')
    expected_aux = {**legacy.REVIEWED_AUXILIARY, **EXTRA_AUXILIARY}
    auxiliary = {path: sha((root/path).read_bytes()) for path in expected_aux}
    require(auxiliary == expected_aux and len(auxiliary) == 28, 'reviewed auxiliary input drift')
    catalog = legacy.package_replay_audit.audit(root)['targets']
    require(len(catalog) == 136 and catalog.count('tests/direct_output_cost_074.rs') == 1, 'default target catalog drift')
    return dict(schema='hc074-package-effect-review-v2',
        method='separate manual delta review plus fixed complete AST/module inventory; not automatic pin refresh',
        scope='Windows default features; --lib --tests; no --ignored; four case threads/780 seconds',
        reviewed_ast_sha256=REVIEWED_AST_SHA256, previous_ast_sha256=PREVIOUS_AST_SHA256,
        sources=sources, auxiliary=auxiliary, constructors=constructors, targets=catalog,
        added_sources=sorted(added), changed_sources=sorted(changed),
        inherited_review=legacy.REVIEW, delta_review=DELTA_REVIEW,
        source_effect_review_complete=True, formal_whole_program_proof=False,
        linux_or_all_features_cleared=False, package_pass=False,
        original_execution_or_product_or_qualification_admission=False)


def negative_program_preflight(root):
    # Windows search may include CWD, application directory and system paths,
    # not just PATH. This is a presence guard, not executable provenance proof.
    candidates = [root, root/'target/debug/deps', root/'target/debug']
    if os.environ.get('SystemRoot'):
        system = Path(os.environ['SystemRoot'])
        candidates.extend((system, system/'System32', system/'System'))
    require(shutil.which(NEGATIVE_PROGRAM) is None and all(not (p/NEGATIVE_PROGRAM).exists() for p in candidates),
            'negative-control executable unexpectedly exists')
    return dict(negative_fixture_executable_absent=True)


def environment_preflight(root):
    result = legacy.environment_preflight(root)
    result.update(negative_program_preflight(root))
    return result


