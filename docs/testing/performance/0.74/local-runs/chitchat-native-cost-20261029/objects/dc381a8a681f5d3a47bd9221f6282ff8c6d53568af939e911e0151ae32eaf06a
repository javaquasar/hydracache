"""Read-only disassembly of the refused tag control; no native test replay."""
from pathlib import Path
import importlib.util,json,os,subprocess,sys
ROOT=Path('C:/Workspace/prj/jq/cashe/hydracache-074') if os.name=='nt' else Path('/mnt/c/Workspace/prj/jq/cashe/hydracache-074')
sys.path.insert(0,str(ROOT/'tools/chitchat-native-cost-074'))
import common as c
OUT=ROOT/'target/chitchat-native-cost-scope-20261029/inspect-tag'
if len(sys.argv)==2 and sys.argv[1]=='query':
    image=json.loads((c.REAL/c.RELBASE/'build-P/native/artifact.json').read_bytes())
    path=Path(image['path']);assert c.sha(path.read_bytes())==image['sha256']
    symbols=subprocess.run(['/usr/bin/nm','-n',str(path)],capture_output=True,timeout=30,check=True).stdout.decode()
    chosen=[v.split()[-1] for v in symbols.splitlines() if 'native_rust_tag_control' in v]
    assert len(chosen)==1
    result=subprocess.run(['/usr/bin/objdump','-d','--disassemble='+chosen[0],str(path)],capture_output=True,timeout=30,check=True)
    (OUT/'control-assembly.log').write_bytes(result.stdout);(OUT/'symbols.log').write_text(symbols,encoding='utf8')
    assert c.sha(path.read_bytes())==image['sha256']
    print(json.dumps(dict(complete=True,symbol=chosen[0],image=image,read_only=True)));raise SystemExit(0)
if len(sys.argv)==2 and sys.argv[1]=='native':
    group=c.load(ROOT/'scripts/ci/watchdog_linux_group.py','tag_inspection_group').LinuxGroup()
    value=c.owned._owned(group,[sys.executable,'-B',str(Path(__file__)),'query'],str(ROOT),c.capacity,bound=1200)
    c.write(OUT,'native-execution.json',value);raise SystemExit(value['exit'])
if len(sys.argv)==2 and sys.argv[1]=='worker':
    argv=['wsl.exe','-d','Ubuntu','-u','artur','--exec','/usr/bin/python3','-B','/mnt/c/Workspace/prj/jq/cashe/hydracache-074/target/inspect-native-tag-20261029.py','native']
    value=c.owned._owned(c.owned.load_job().WindowsJob(),argv,str(ROOT),c.capacity,bound=1200)
    c.write(OUT,'execution.json',value);raise SystemExit(value['exit'])
assert len(sys.argv)==1
OUT.mkdir(exist_ok=False);(OUT/'producer.py').write_bytes(Path(__file__).read_bytes())
with (OUT/'stdout.log').open('xb') as stdout,(OUT/'stderr.log').open('xb') as stderr:
    p=subprocess.run([sys.executable,'-B',str(Path(__file__)),'worker'],stdout=stdout,stderr=stderr,stdin=subprocess.DEVNULL,timeout=1210)
    result=dict(complete=p.returncode==0,exit=p.returncode)
    for name in ('execution.json','native-execution.json'):
        r=json.loads((OUT/name).read_bytes());assert r['exit']==0 and r['retired'] and not r['errors']
    c.write(OUT,'result.json',result)
print(json.dumps(result));raise SystemExit(p.returncode)
