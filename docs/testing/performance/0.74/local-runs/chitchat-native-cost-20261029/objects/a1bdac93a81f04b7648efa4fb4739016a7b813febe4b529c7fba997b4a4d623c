        value=c.owned._owned(group,[sys.executable,'-B',str(Path(__file__)),'session',label,frame],str(c.ROOT),c.capacity,bound=1200)
        real=c.REAL/c.RELBASE/label;c.write(real,'native-envelope.json',value)
