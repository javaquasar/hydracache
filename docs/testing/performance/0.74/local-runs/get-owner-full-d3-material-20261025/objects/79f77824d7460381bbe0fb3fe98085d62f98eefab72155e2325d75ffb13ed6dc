SOURCE_B64=''
SOURCE_SHA='3da40d063215f4ad1b56ad24f1c825bad182b5701e988509214499cd68984b21'
CONTRACT_B64=''
CONTRACT_SHA='2890472199c1ccbc9c35c01d4ed52e14ccf3a37587965157bd984a9d5c9ed705'
from pathlib import Path
import base64, hashlib, json, os, signal, subprocess, sys
base = Path('/tmp/hc074-server-gate-root-20261025.0k0xbdah'); root = base/'get-owner-provider-control-first'
upload = Path('/tmp/hc074-server-gate-upload-20261025.pvdj0f6c')
raw = (base/'server-fault-worker-20261025.py').read_bytes()
assert hashlib.sha256(raw).hexdigest() == 'af1e9926e1ad40bc49c1c225d79f5fffc788c715a7889743decea129ec4b17a3'
assert sys.argv[1] == '6640e1b9b31ae7c87137b335be4f2665d729ea7b4324ee0e874bdbedc346c520'
scope = {}; exec(compile(raw.decode().split('started=time.monotonic_ns()\n')[0], '<pinned-preflight>', 'exec'), scope)

def publish(name, value):
    with (root/name).open('x') as f: json.dump(value, f, indent=2); f.flush(); os.fsync(f.fileno())
def write(path, raw):
    with path.open('xb') as f: f.write(raw); f.flush(); os.fsync(f.fileno())
def limited():
    os.sched_setaffinity(0, {0,5,6,7}); os.setgroups([]); os.setgid(1000); os.setuid(1000)
def execute(name, argv, env, bound):
    publish(name+'-command.json', dict(argv=argv, env=env, uid=1000, gid=1000, bound_seconds=bound))
    with (root/(name+'.stdout.log')).open('xb') as out, (root/(name+'.stderr.log')).open('xb') as err:
        child = subprocess.Popen(argv, env=env, preexec_fn=limited, stdout=out, stderr=err, start_new_session=True)
        publish(name+'-child.json', dict(pid=child.pid, start_ticks=scope['ticks'](child.pid)))
        try: code = child.wait(timeout=bound)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL); child.wait(); raise RuntimeError('first timeout; no retry')
    publish(name+'-result.json', dict(exit=code)); return code

result = dict(passed=False, first_refusal=None, postflight_refusal=None, product_fixture_started=False, synthetic_control_only=True, admission=False)
before = None
try:
    before = scope['preflight'](); publish('preflight.json', before)
    work = upload/'get-owner-provider-control-first'; work.mkdir(mode=0o700); os.chown(work,1000,1000)
    source = base64.b64decode(SOURCE_B64); contract = base64.b64decode(CONTRACT_B64)
    assert hashlib.sha256(source).hexdigest() == SOURCE_SHA and hashlib.sha256(contract).hexdigest() == CONTRACT_SHA
    write(root/'source.c',source); write(root/'contract.toml',contract); write(work/'source.c',source); os.chown(work/'source.c',1000,1000)
    env = dict(PATH='/usr/bin:/bin', LANG='C')
    code = execute('compile',['/usr/bin/cc','-std=c11','-O2','-Wall','-Wextra','-Werror',str(work/'source.c'),'-o',str(work/'control')],env,60)
    assert code == 0, 'first compiler refusal'
    publish('image.json',dict(sha256=hashlib.sha256((work/'control').read_bytes()).hexdigest(), source_sha256=SOURCE_SHA, contract_sha256=CONTRACT_SHA))
    code = execute('control',[str(work/'control')],dict(env,GLIBC_TUNABLES='glibc.mem.decorate_maps=1'),10)
    assert code == 0, 'first capability-control refusal'
    report = json.loads((root/'control.stdout.log').read_bytes())
    assert report['provider_capability_control_passed'] is True and report['admission'] is False
    result['passed'] = True
except BaseException as error: result['first_refusal'] = f'{type(error).__name__}: {error}'
finally:
    try:
        after = scope['preflight'](); assert before is not None and before == after; publish('postflight.json',after)
    except BaseException as error: result['postflight_refusal'] = f'{type(error).__name__}: {error}'; result['passed'] = False
    publish('result.json',result)
