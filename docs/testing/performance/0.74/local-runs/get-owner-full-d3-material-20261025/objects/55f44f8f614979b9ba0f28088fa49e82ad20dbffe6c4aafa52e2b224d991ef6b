from pathlib import Path
import base64, hashlib, json, sys

base = Path('/tmp/hc074-server-gate-root-20261025.0k0xbdah')
group = 'get-owner-d3-build-first'
root = base / group
assert json.loads((root / 'result.json').read_bytes())['passed'] is True
members = {}
images = {}
for p in sorted(root.iterdir()):
    assert not p.is_symlink()
    if not p.is_file():
        continue
    if p.name in ('timing-off', 'timing-on'):
        h = hashlib.sha256()
        with p.open('rb') as f:
            for block in iter(lambda: f.read(1048576), b''):
                h.update(block)
        receipt = json.loads((root / ('image-' + p.name[7:] + '.json')).read_bytes())
        images[p.name] = dict(bytes=p.stat().st_size, sha256=h.hexdigest(), receipt=receipt)
        continue
    raw = p.read_bytes()
    assert len(raw) <= 16 * 1024**2
    members[group + '/' + p.name] = dict(bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest(), base64=base64.b64encode(raw).decode())
raw = (base / 'server-fault-worker-20261025.py').read_bytes()
assert hashlib.sha256(raw).hexdigest() == 'af1e9926e1ad40bc49c1c225d79f5fffc788c715a7889743decea129ec4b17a3'
sys.argv = ['readonly', '6640e1b9b31ae7c87137b335be4f2665d729ea7b4324ee0e874bdbedc346c520']
scope = {}
exec(compile(raw.decode().split('started=time.monotonic_ns()\n')[0], '<pinned-preflight>', 'exec'), scope)
print(json.dumps(dict(complete=True, members=members, images=images, final_frame=scope['preflight'](), read_only=True, product_workload_started=False)))
