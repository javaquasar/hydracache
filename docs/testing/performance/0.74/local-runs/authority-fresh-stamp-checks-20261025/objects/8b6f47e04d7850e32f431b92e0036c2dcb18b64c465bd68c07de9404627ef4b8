from pathlib import Path
import hashlib,json,subprocess
root=Path(__file__).resolve().parent.parent
prefix='docs/testing/performance/0.74/local-runs/authority-fresh-stamp-20261025/'
raw=subprocess.check_output(['git','show',':'+prefix+'index.json'],cwd=root)
assert hashlib.sha256(raw).hexdigest()=='19bd1fa220d0b77cbcfbea33ccd1491f423acc1726d13714ffa802355b09d81c'
index=json.loads(raw);assert len(index['members'])==244
digests=sorted({item['sha256'] for item in index['members'].values()});assert len(digests)==172
queries=[':'+prefix+'objects/'+digest for digest in digests]
p=subprocess.run(['git','cat-file','--batch'],input=('\n'.join(queries)+'\n').encode(),cwd=root,capture_output=True,check=True)
objects={};offset=0
for digest in digests:
 newline=p.stdout.index(b'\n',offset);header=p.stdout[offset:newline].split();assert header[1]==b'blob'
 size=int(header[2]);offset=newline+1;blob=p.stdout[offset:offset+size];offset+=size
 assert p.stdout[offset:offset+1]==b'\n';offset+=1
 assert hashlib.sha256(blob).hexdigest()==digest;objects[digest]=blob
assert offset==len(p.stdout)
members={}
for name,item in index['members'].items():
 assert not Path(name).is_absolute() and '..' not in Path(name).parts
 blob=objects[item['sha256']];assert len(blob)==item['bytes'];members[name]=blob
for key,path in [('tool/review.py','tools/authority-fresh-stamp-074/review.py'),
 ('dependencies/identity-review.py','tools/kernel-fresh-identity-074/review.py'),
 ('dependencies/profile-review.py','tools/native-server-control-074/profile_review.py')]:
 assert members[key]==(root/path).read_bytes()
scope={'__file__':str(root/'target/audit-authority-stamp-20261025.py'),'__name__':'saved_byte_verifier'}
exec(compile(members['coordinator/audit-authority-stamp-20261025.py'],'<staged-audit>','exec'),scope)
files={name.removeprefix('server/'):blob for name,blob in members.items() if name.startswith('server/') and name!='server/final-frame.json'}
sources={n:members['source/'+n] for n in scope['NAMES']}
for name,raw in sources.items():assert raw==(root/'tools/long-run-supervisor-074/src'/name).read_bytes()
facts=scope['review'](files,json.loads(members['server/final-frame.json']),sources,members['source/baseline-fixture.rs'])
assert facts==json.loads(members['session/authority-stamp-offline-review/result.json'])
for name,digest in index['protected_inputs'].items():assert hashlib.sha256((root/name).read_bytes()).hexdigest()==digest
assert not index['admission'] and not index['full_holder_passed']
print(json.dumps(dict(staged_byte_review=True,members=244,objects=172,leaf_screen=True,installed_leaf_screen=True,
 authority_tests_passed=57,full_holder_passed=False,admission=False)))
