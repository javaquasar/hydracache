"""Retain final offline governance checks separately from the native packet."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/closure-preflight-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    sha = hashlib.sha256(raw).hexdigest()
    obj = OUT/'objects'/sha
    if not obj.exists():
        with obj.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=sha)


for phase in ('closure-ci-integrity', 'closure-ci-doc', 'closure-ci-contract'):
    for name in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+phase+'/'+name, ROOT/'target/source-continuation-20261024'/phase/name)
for name in ('index.json', 'verify.py'):
    take('main/'+name, PACKET/name)
take('collector.py', Path(__file__))
index = dict(schema='hc074-closure-ci-final-checks-v1', implementation_commit='bf3f048bd',
             package_pass=False, server_admitted=False, members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
