"""Append-only retention of closure scope and CI controls, no admission."""
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT/'docs/testing/performance/0.74/local-runs/closure-preflight-20261026'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    dest = OUT/'objects'/digest
    if not dest.exists():
        with dest.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for phase in ('authorized-server-preflight', 'linux-ci-group-baseline', 'linux-ci-group-candidate',
              'linux-ci-group-candidate-v2', 'linux-ci-group-extended-v2'):
    folder = ROOT/'target'/(phase+'-20261026')
    for path in sorted(folder.iterdir()):
        if path.is_file():
            take('native/'+phase+'/'+path.name, path)
for label in ('closure-scope-models-first', 'closure-scope-check', 'linux-watchdog-models-v2',
              'linux-watchdog-models-portable-v3', 'linux-watchdog-existing-controls',
              'linux-watchdog-ci-regression', 'linux-watchdog-check', 'linux-watchdog-clippy',
              'linux-watchdog-windows-controls', 'linux-watchdog-windows-native-cli'):
    for name in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+name, ROOT/'target/source-continuation-20261024'/label/name)
for path in sorted((ROOT/'target/linux-watchdog-windows-compat-20261026').rglob('*')):
    if path.is_file():
        take('windows/'+path.relative_to(ROOT/'target/linux-watchdog-windows-compat-20261026').as_posix(), path)
for name in ('scripts/ci/run-with-heartbeat.py', 'scripts/ci/watchdog_linux_group.py',
             'scripts/ci/watchdog_windows_job.py', 'scripts/ci/test_watchdog_linux_group_models.py',
             'scripts/ci/test_watchdog_linux_074.py', 'scripts/ci/test_watchdog_windows_074.py',
             'tools/release-closure-074/scope.py', 'tools/release-closure-074/test_scope.py',
             'docs/testing/performance/0.74/release-closure-scope-20261026.toml',
             'docs/testing/performance/0.74/qualification-manifest.toml',
             'target/posix-watchdog-baseline-20261026.py',
             'target/linux-ci-group-first-candidate-20261026.py',
             'target/run-linux-ci-group-control-20261026.py'):
    take('source/'+name, ROOT/name)
take('collector.py', Path(__file__))
index = dict(schema='hc074-closure-preflight-ci-evidence-v1',
    base_commit=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
    uncommitted_sources=True, performance_claim=False, freeze_c74_allowed=False,
    package_pass=False, production_original_delivery=False, qualification_allowed=False,
    server_scope='isolated synthetic CI fixtures, no service/clock/install/product changes', members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
