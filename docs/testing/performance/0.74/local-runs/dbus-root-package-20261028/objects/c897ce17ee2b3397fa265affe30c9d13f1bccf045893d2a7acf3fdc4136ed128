def git_snapshot():
    return dict(head=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT).decode().strip(),
        tracked=subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=no'], cwd=ROOT).decode())


def source_names():
    # Root members are preserved by the reviewed manifest; all tracked member data stays.
    import tomllib
    members = tomllib.loads((ROOT/'Cargo.toml').read_text())['workspace']['members']
    names = subprocess.check_output(['git', 'ls-files', '-z', '--', *members], cwd=ROOT).split(b'\0')
    names = {p.decode() for p in names if p}
    recipe = json.loads(app.member('candidate/fileset.json'))
    names |= {v['path'] for v in recipe['operations']}
    names |= {'Cargo.toml','Cargo.lock','deny.toml','.cargo/config.toml',
              'docs/testing/performance/0.74/qualification-manifest.toml'}
    return sorted(names)


def hashes(names):
    if os.name == 'posix':
        import source_guard
        return source_guard.hashes(ROOT, names)
    result = {}
    for name in names:
        path = ROOT/name
        need(path.resolve().is_relative_to(ROOT.resolve()) and not path.is_symlink() and not path.is_junction(),
             'regular actual root source')
        result[name] = sha(path.read_bytes())
    return result


def guard(receipt):
    need(hashes(receipt['source']) == receipt['source'], 'actual root source drift')
    need(hashes(receipt['helpers']) == receipt['helpers'], 'package helper drift')


