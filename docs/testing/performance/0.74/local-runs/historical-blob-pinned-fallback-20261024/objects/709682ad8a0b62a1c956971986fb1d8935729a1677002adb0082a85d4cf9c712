"""Seal pinned-fallback candidate without altering any earlier first packet."""
from pathlib import Path
import hashlib
import json
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BASE = 'docs/testing/performance/0.74/local-runs/historical-blob-pinned-fallback-20261024'
PHASES = ('blob-aba-build-v1', 'blob-aba-controls-v1', 'blob-aba-transport-v1',
          'blob-aba-check', 'blob-aba-clippy', 'blob-aba-format', 'blob-aba-msrv-v1',
          'blob-aba-python-controls', 'blob-aba-doc-check')
PROTECTED = {
    'Cargo.toml': '18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock': 'd2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml':
        '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
}
CODE = '930b82b2ee5216f904dbc0e4aea6c94826c43212'
PREVIOUS = 'docs/testing/performance/0.74/local-runs/historical-blob-fault-20261024'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


members, objects, phases = {}, {}, []


def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


assert subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT).decode().strip() == CODE
old = (ROOT / PREVIOUS / 'index.json').read_bytes()
assert sha(old) == '37d771195efc42b8757d32b4b9634fdb114f97d8c13747b7b3ee4a9094a8b3a3'
for value in json.loads(old)['members'].values():
    raw = (ROOT / PREVIOUS / 'objects' / value['sha256']).read_bytes()
    assert sha(raw) == value['sha256'] and len(raw) == value['bytes']
add('previous/index.json', old)
for phase in PHASES:
    folder = ROOT / 'target/source-continuation-20261024' / phase
    intent = json.loads((folder / 'intent.json').read_bytes())
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['exit'] == 0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged']
    assert intent['source'] == result['source_after']
    assert not result['admission'] and not result['qualification']
    for name in ('intent.json', 'stdout.log', 'stderr.log', 'result.json'):
        add(f'checks/{phase}/{name}', (folder / name).read_bytes())
    source = ROOT / 'target/blob-fault-source-snapshots-20261024' / phase
    add(f'phase-sources/{phase}/index.json', (source / 'index.json').read_bytes())
    for path, digest in json.loads((source / 'index.json').read_bytes()).items():
        raw = (source / digest).read_bytes()
        assert sha(raw) == digest == intent['source'][path]
        add(f'phase-sources/{phase}/{path}', raw)
    stdout = (folder / 'stdout.log').read_text()
    stderr = (folder / 'stderr.log').read_text()
    phases.append(dict(phase=phase, exit=0,
        rust_target_passes=list(map(int, re.findall(r'test result: ok\. (\d+) passed; 0 failed;', stdout))),
        python_passes=int(match[1]) if (match := re.search(r'Ran (\d+) tests in ', stderr)) else None))
    for suffix in ('', '-mutations', '-owned-cleanup'):
        capture = ROOT / 'target/blob-fault-20261024' / (phase + suffix)
        if capture.is_dir():
            for path in sorted(capture.iterdir()):
                assert path.is_file()
                add(f'observations/{phase}{suffix}/{path.name}', path.read_bytes())

assert [p['rust_target_passes'] for p in phases[:3]] == [[], [9, 5], [6]]
assert next(p for p in phases if p['phase'] == 'blob-aba-msrv-v1')['rust_target_passes'] == [9, 5, 6]
assert next(p for p in phases if p['phase'] == 'blob-aba-python-controls')['python_passes'] == 31
for phase in ('blob-aba-controls-v1', 'blob-aba-msrv-v1'):
    folder = ROOT / 'target/blob-fault-20261024' / (phase + '-mutations')
    values = {p.name.split('-', 1)[1]: json.loads(p.read_bytes()) for p in folder.iterdir()}
    for name in ('fallback-aba-Default', 'tree-ref-aba-Default', 'tree-config-aba', 'late-wrong-fallback-no-prefix'):
        assert values[name + '.json']['refusal'] == 'FallbackOutput'
    assert len(values['fallback-aba-Disabled.json']['outputs']) == 2
    assert len(values['tree-ref-aba-Disabled.json']['outputs']) == 1
    assert len(values['duplicate-fallback-control.json']['outputs']) == 3
    assert values['observer-original-deadline.json']['refusal'] == 'Deadline'
    assert values['result.json']['pinned_output_component_gate']
    assert values['result.json']['caller_admission_gate'] is False
for phase in ('blob-aba-transport-v1', 'blob-aba-msrv-v1'):
    capture = ROOT / 'target/blob-fault-20261024' / phase
    oracle = json.loads((capture / 'oracle.stdout.json').read_bytes())
    assert len(oracle['cases']) == 6
    for number, case in enumerate(oracle['cases']):
        actual = json.loads((capture / f'native-case-{number}.json').read_bytes())
        assert actual['outputs'] == case['expected']
        assert len(case['specs']) == len(case['pins']) == len(case['expected']) == 9
    assert json.loads((capture / 'result.json').read_bytes())['admission'] is False
final = ROOT / 'target/blob-fault-source-snapshots-20261024/blob-aba-msrv-v1'
for path, digest in json.loads((final / 'index.json').read_bytes()).items():
    assert sha((ROOT / path).read_bytes()) == digest
for path, digest in PROTECTED.items():
    assert sha((ROOT / path).read_bytes()) == digest
for path in ('target/run-blob-fault-step-20261024.py', 'target/run-fresh-reader-20261024.py',
             'target/run-source-step-20261024.py', 'target/seal-blob-aba-20261024.py'):
    add('coordinators/' + Path(path).name, (ROOT / path).read_bytes())
for path in ('tools/historical-blob-batch-074/README.md',
             'docs/articles/007-optimization-starts-with-measurement.md',
             'docs/testing/performance/0.74/README.md',
             'docs/testing/performance/0.74/historical-blob-pinned-fallback-result-20261024.md',
             'docs/testing/performance/0.74/historical-blob-fault-result-20261024.md',
             'docs/testing/performance/0.74/release-closure-audit-20261024.md'):
    add('documentation/' + path, (ROOT / path).read_bytes())
index = dict(schema='hc074-pinned-fallback-output-evidence-v1', code_commit=CODE, members=members,
    facts=dict(phases=phases, protected_sha256=PROTECTED, previous_first_packet_verified=True,
        original_cuts_retained=True, fallback_output_pins_independent=True,
        pinned_output_component_gate=True, caller_admission_gate=False,
        production_pin_authority=False, old_loader_integrated=False, ordinary_package_pass=False,
        live_frequency_or_original_windows_changed=False, dependency_changes=False,
        server=False, service_or_clock=False, product_workload=False, measurement=False,
        qualification=False, push=False))
out = ROOT / BASE
out.mkdir(parents=True, exist_ok=False)
(out / 'objects').mkdir()
(out / '.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for digest, raw in objects.items():
    (out / 'objects' / digest).write_bytes(raw)
raw = (json.dumps(index, sort_keys=True, indent=2) + '\n').encode()
(out / 'index.json').write_bytes(raw)
print(json.dumps(dict(index_sha256=sha(raw), members=len(members), objects=len(objects), phases=phases)))
