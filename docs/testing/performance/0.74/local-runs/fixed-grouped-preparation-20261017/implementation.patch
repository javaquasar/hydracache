+pub struct OriginalGroupedPreparation<'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p> {
+    alarm: Option<Alarm>,
+    bounds: Option<Bounds>,
+    last: Option<KernelTimePoint>,
