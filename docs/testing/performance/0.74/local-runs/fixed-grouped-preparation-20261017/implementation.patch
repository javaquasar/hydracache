+                .material
+                .outputs
+                .corrupt_descriptor_for_test(3),
+            "alarm" => tests::set(self.alarm.as_ref().unwrap(), 0, 0, libc::TFD_TIMER_ABSTIME),
+            _ => panic!("unknown grouped fault"),
+        }
+    }
