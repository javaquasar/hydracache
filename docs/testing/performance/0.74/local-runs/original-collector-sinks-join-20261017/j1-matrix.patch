+                );
+                assert_eq!(
+                    report.stages[Stage::Publish as usize].signature_calls,
+                    46 * 17
+                );
+                assert!(report.first_time.is_none());
+                println!("HC074-OUTPUT-JOIN-COST sample={sample} rounds=46 ipc={report:?}");
+                owner.revalidate().unwrap();
