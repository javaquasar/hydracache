      "phase": "corrected-source-audit",
      "command": "$ErrorActionPreference='Stop'\n$base='61d664e97337f535b51f191561f6914a56f5b082'\n$loss='tools/long-run-supervisor-074/src/diagnostic_signer_owned_root_loss.rs'\n$old=(git show \"${base}:$loss\") -join \"`n\"\n$new=(Get-Content -LiteralPath $loss) -join \"`n\"\n$boundary='#[cfg(test)]'\nif($old.Substring(0,$old.IndexOf($boundary)) -cne $new.Substring(0,$new.IndexOf($boundary))){throw 'non-test loss code changed'}\n$rootTests='tools/long-run-supervisor-074/src/diagnostic_signer_owned_root_tests.rs'\n$expected=(git show \"${base}:$rootTests\") -join \"`n\"\n$actual=(Get-Content -LiteralPath $rootTests) -join \"`n\"\n$header='pub(super) mod images;'\nif($actual.Substring(0,$actual.IndexOf($header)+$header.Length) -cne $expected.Substring(0,$expected.IndexOf($header)+$header.Length)){throw 'original root-test header changed'}\nif($actual.Substring($actual.IndexOf('#[test]')) -cne $expected.Substring($expected.IndexOf('#[test]'))){throw 'original root-test bodies changed'}\nforeach($name in @('rejected_rights_are_closed_even_for_foreign_credentials_or_truncation','truncated_ancillary_rights_close_every_delivered_or_truncated_writer')){\n $start=$old.IndexOf(\"    fn $name() {\")\n $end=$old.IndexOf('    #[test]',$start)\n $body=$old.Substring($start,$end-$start)\n $body=$body.Substring($body.IndexOf('{')+1)\n $body=$body.Substring(0,$body.LastIndexOf('}'))\n $startNew=$new.IndexOf(\"    fn $name() {\")\n $endNew=$new.IndexOf('    #[test]',$startNew)\n $wrapped=$new.Substring($startNew,$endNew-$startNew)\n $wrapped=$wrapped.Substring($wrapped.IndexOf('|| {')+4)\n $endBody=$wrapped.LastIndexOf('},')\n if($endBody -lt 0){throw 'wrapper missing'}\n $wrapped=$wrapped.Substring(0,$endBody)\n if(($body -replace '\\s','') -cne ($wrapped -replace '\\s','')){throw \"original EOF fixture changed: $name\"}\n}\n$changed=@(git diff --name-only $base -- tools crates Cargo.toml Cargo.lock .github)\nif(@(Compare-Object $changed @($loss,$rootTests)).Count -ne 0){throw 'source inventory'}\nWrite-Output 'Verified unchanged non-test loss source, unchanged original EOF fixture bodies modulo indentation, additive exec/guard support only before original root tests, and exact two-file tooling inventory. No product/dependency/workflow changes.'",
