+cfg = 'all (target_os = "linux" , target_arch = "x86_64")'
+env = ""
+reason = "Cost diagnostic only; refusal is not successful preparation or admission"
+tier = "manual"
+required_features = []
+required_env = ["HC074_START_MATERIAL_BUNDLE"]
+required_tools = ["cargo"]
