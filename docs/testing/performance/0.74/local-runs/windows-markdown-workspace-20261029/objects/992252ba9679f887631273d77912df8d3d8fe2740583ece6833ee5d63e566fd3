          test "$(systemctl is-active "$SUPERVISOR_SERVICE" || true)" = active
          test "$(systemctl show "$SUPERVISOR_SERVICE" --property=NRestarts --value)" = 0
          test ! -e /run/hydracache-perf/controller-loss-smoke-v1.json
          if test -f "$EVIDENCE_DIR/analysis.json"; then
            python3 - <<'PY'
          import json
          import os
          import pathlib

          receipt = json.loads(
              (pathlib.Path(os.environ["EVIDENCE_DIR"]) / "analysis.json").read_text()
          )
          assert receipt["schema_version"] == "hydracache-w11-role-overhead-rehearsal-v1"
          assert receipt["evidence_class"] == "non-product-role-overhead-rehearsal"
          assert receipt["promotable"] is False
          assert receipt["pairs_per_role"] == 5
          assert receipt["host_receipt_sha256"] == os.environ["HOST_RECEIPT_SHA256"]
          assert receipt["decision"]["role_overhead_qualification_complete"] is False
          assert receipt["decision"]["release_admission_allowed"] is False
          PY
          fi

      - name: Retain role-overhead rehearsal evidence
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: performance-long-run-role-overhead-smoke-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: target/performance-evidence/0.74/reference/w11-role-overhead-smoke/**
          if-no-files-found: error
          retention-days: 90
