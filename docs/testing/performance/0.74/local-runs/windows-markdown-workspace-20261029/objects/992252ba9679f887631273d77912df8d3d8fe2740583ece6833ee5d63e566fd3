name: Performance Long-Run Host Capability 0.74

on:
  workflow_dispatch:
    inputs:
      mode:
        description: Read-only probe, or explicitly bootstrap the protected provisioning workflow
        required: true
        default: probe
        type: choice
        options:
          - probe
          - provision
          - host-observation
          - start-bundle
          - controller
          - controller-start-abort-rehearsal
          - controller-start-seal-rehearsal
          - controller-c74-start-seal-rehearsal
          - controller-attach-abort-rehearsal
          - controller-attach-seal-rehearsal
          - systemd-smoke
          - controller-loss-smoke
          - campaign-lifecycle-smoke
          - campaign-progress-loss-smoke
          - campaign-measurement-loss-smoke
          - campaign-lease-expiry-smoke
          - supervisor-overhead-smoke
          - role-overhead-smoke
      controller_source_sha:
        description: Exact installed tooling source for controller mode
        required: false
        default: ""
        type: string
      controller_operation:
        description: Typed controller operation
        required: false
        default: start
        type: choice
        options:
          - start
          - attach
          - seal
          - abort
      campaign_id:
        description: Frozen campaign id for controller mode
        required: false
        default: ""
        type: string
      manifest_sha256:
        description: Frozen manifest digest for controller mode
        required: false
        default: ""
        type: string
      expected_state_revision:
        description: Expected durable revision for controller or recovery attach mode
        required: false
        default: ""
        type: string
      abort_expected_state_revision:
        description: Expected revision after recovery attach and before same-run abort
        required: false
        default: ""
        type: string
      seal_expected_state_revision:
        description: Expected revision after terminal attach and before same-run seal
        required: false
        default: ""
        type: string
      request_id:
        description: New UUIDv4 for controller mode or rehearsal start
        required: false
        default: ""
        type: string
      attach_request_id:
        description: New UUIDv4 for the same-run rehearsal attach
        required: false
        default: ""
        type: string
      abort_request_id:
        description: New UUIDv4 for the same-run rehearsal abort
        required: false
        default: ""
        type: string
      seal_request_id:
        description: New UUIDv4 for the same-run rehearsal seal
        required: false
        default: ""
        type: string
      approval_nonce_sha256:
        description: Required only for controller abort
        required: false
        default: ""
        type: string
      start_bundle_run_id:
        description: Bundle workflow run id for revision-zero start
        required: false
        default: ""
        type: string
      start_bundle_artifact_name:
        description: Exact six-file bundle artifact for revision-zero start
        required: false
        default: ""
        type: string
  push:
    branches:
      - feat/0.74-resp-native-throughput
    paths:
      - .github/workflows/performance-long-run-host-capability-074.yml
      - scripts/perf/performance_long_run_host_capability_074.py
      - scripts/perf/test_performance_long_run_host_capability_074.py
      - scripts/perf/performance_long_run_supervisor_overhead_074.py
      - scripts/perf/test_performance_long_run_supervisor_overhead_074.py

permissions:
  contents: read

concurrency:
  group: performance-reference-074-host
  cancel-in-progress: false

jobs:
  probe:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'probe'
    name: Read-only systemd and supervisor capability probe
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 10
    env:
      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-host-capability

    steps:
      - name: Check out exact probe source
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify immutable source and probe tests
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test -z "$(git status --porcelain=v1 --untracked-files=normal)"
          python3 -m unittest scripts.perf.test_performance_long_run_host_capability_074

      - name: Collect read-only host capability receipt
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$EVIDENCE_DIR"
          python3 scripts/perf/performance_long_run_host_capability_074.py \
            --source-commit "$GITHUB_SHA" \
            --output "$EVIDENCE_DIR/capability.json"

      - name: Retain host capability receipt
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: performance-long-run-host-capability-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: target/performance-evidence/0.74/reference/w11-host-capability/**
          if-no-files-found: error
          retention-days: 90

  provision:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'provision'
    name: Explicit protected provisioning bootstrap
    permissions:
      contents: read
    uses: ./.github/workflows/performance-long-run-host-provision-074.yml
    with:
      source_sha: ${{ github.sha }}
    secrets: inherit

  host-observation:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'host-observation'
    name: Read-only canonical host observation export
    permissions:
      contents: read
    uses: ./.github/workflows/performance-long-run-host-observation-074.yml
    with:
      source_sha: ${{ github.sha }}
      host_id: reference-074

  start-bundle:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'start-bundle'
    name: Immutable non-product start bundle
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-start-bundle-074.yml
    with:
      source_sha: ${{ github.sha }}
      host_id: reference-074

  controller:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller'
    name: Signed detached supervisor controller
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: ${{ inputs.controller_operation }}
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: ${{ inputs.expected_state_revision }}
      request_id: ${{ inputs.request_id }}
      approval_nonce_sha256: ${{ inputs.approval_nonce_sha256 }}
      start_bundle_run_id: ${{ inputs.start_bundle_run_id }}
      start_bundle_artifact_name: ${{ inputs.start_bundle_artifact_name }}
    secrets: inherit

  controller-rehearsal-start:
    if: >-
      github.event_name == 'workflow_dispatch' &&
      (inputs.mode == 'controller-start-abort-rehearsal' ||
       inputs.mode == 'controller-start-seal-rehearsal')
    name: Signed non-product rehearsal start
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: start
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "0"
      request_id: ${{ inputs.request_id }}
      start_bundle_run_id: ${{ inputs.start_bundle_run_id }}
      start_bundle_artifact_name: ${{ inputs.start_bundle_artifact_name }}
    secrets: inherit

  controller-rehearsal-attach:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-abort-rehearsal'
    needs: controller-rehearsal-start
    name: Attach the same protected controller run
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: attach
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "2"
      request_id: ${{ inputs.attach_request_id }}
    secrets: inherit

  controller-rehearsal-abort:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-abort-rehearsal'
    needs: controller-rehearsal-attach
    name: Abort and clean the same protected controller run
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: abort
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "3"
      request_id: ${{ inputs.abort_request_id }}
      approval_nonce_sha256: ${{ inputs.approval_nonce_sha256 }}
    secrets: inherit

  controller-rehearsal-terminal:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-seal-rehearsal'
    needs: controller-rehearsal-start
    name: Wait for exact non-product terminal unit
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 16
    steps:
      - name: Wait only for the deterministic successful terminal shape
        shell: bash
        env:
          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}
        run: |
          set -euo pipefail
          [[ "$INPUT_CAMPAIGN_ID" =~ ^[0-9a-f]{64}$ ]]
          unit="hydracache-performance-074-i74-${INPUT_CAMPAIGN_ID}.service"
          for _ in $(seq 1 445); do
            active="$(systemctl show "$unit" --property ActiveState --value)"
            sub="$(systemctl show "$unit" --property SubState --value)"
            main_pid="$(systemctl show "$unit" --property MainPID --value)"
            result="$(systemctl show "$unit" --property Result --value)"
            if [[ "$active" = active && "$sub" = exited && "$main_pid" = 0 && "$result" = success ]]; then
              exit 0
            fi
            if [[ "$active" =~ ^(failed|inactive)$ ]]; then
              printf 'terminal rehearsal unit failed early: %s/%s pid=%s result=%s\n' \
                "$active" "$sub" "$main_pid" "$result" >&2
              exit 1
            fi
            sleep 2
          done
          printf 'terminal rehearsal unit did not complete inside the bounded wait\n' >&2
          exit 1

  controller-rehearsal-seal:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-seal-rehearsal'
    needs: controller-rehearsal-terminal-attach
    name: Seal the same protected controller run
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: seal
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "3"
      request_id: ${{ inputs.seal_request_id }}
    secrets: inherit

  controller-rehearsal-terminal-attach:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-start-seal-rehearsal'
    needs: controller-rehearsal-terminal
    name: Attach the successful terminal evidence
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: attach
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "2"
      request_id: ${{ inputs.attach_request_id }}
    secrets: inherit

  controller-c74-rehearsal-start:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-c74-start-seal-rehearsal'
    name: Start the non-product C74 continuation
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: start
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: ${{ inputs.expected_state_revision }}
      request_id: ${{ inputs.request_id }}
    secrets: inherit

  controller-c74-rehearsal-terminal:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-c74-start-seal-rehearsal'
    needs: controller-c74-rehearsal-start
    name: Wait for exact non-product C74 terminal unit
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 16
    steps:
      - name: Wait only for the deterministic successful C74 terminal shape
        shell: bash
        env:
          INPUT_CAMPAIGN_ID: ${{ inputs.campaign_id }}
        run: |
          set -euo pipefail
          [[ "$INPUT_CAMPAIGN_ID" =~ ^[0-9a-f]{64}$ ]]
          unit="hydracache-performance-074-c74-${INPUT_CAMPAIGN_ID}.service"
          for _ in $(seq 1 445); do
            active="$(systemctl show "$unit" --property ActiveState --value)"
            sub="$(systemctl show "$unit" --property SubState --value)"
            main_pid="$(systemctl show "$unit" --property MainPID --value)"
            result="$(systemctl show "$unit" --property Result --value)"
            if [[ "$active" = active && "$sub" = exited && "$main_pid" = 0 && "$result" = success ]]; then
              exit 0
            fi
            if [[ "$active" =~ ^(failed|inactive)$ ]]; then
              printf 'C74 terminal rehearsal unit failed early: %s/%s pid=%s result=%s\n' \
                "$active" "$sub" "$main_pid" "$result" >&2
              exit 1
            fi
            sleep 2
          done
          printf 'C74 terminal rehearsal unit did not complete inside the bounded wait\n' >&2
          exit 1

  controller-c74-rehearsal-terminal-attach:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-c74-start-seal-rehearsal'
    needs: controller-c74-rehearsal-terminal
    name: Attach the successful C74 terminal evidence
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: attach
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "7"
      request_id: ${{ inputs.attach_request_id }}
    secrets: inherit

  controller-c74-rehearsal-seal:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-c74-start-seal-rehearsal'
    needs: controller-c74-rehearsal-terminal-attach
    name: Seal the same protected C74 continuation
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: seal
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: "8"
      request_id: ${{ inputs.seal_request_id }}
    secrets: inherit

  controller-recovery-attach:
    if: >-
      github.event_name == 'workflow_dispatch' &&
      (inputs.mode == 'controller-attach-abort-rehearsal' ||
       inputs.mode == 'controller-attach-seal-rehearsal')
    name: Reattach after supervisor recovery
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: attach
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: ${{ inputs.expected_state_revision }}
      request_id: ${{ inputs.attach_request_id }}
    secrets: inherit

  controller-recovery-abort:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-attach-abort-rehearsal'
    needs: controller-recovery-attach
    name: Abort after same-run recovery attach
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: abort
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: ${{ inputs.abort_expected_state_revision }}
      request_id: ${{ inputs.abort_request_id }}
      approval_nonce_sha256: ${{ inputs.approval_nonce_sha256 }}
    secrets: inherit

  controller-recovery-seal:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-attach-seal-rehearsal'
    needs: controller-recovery-attach
    name: Seal after same-run terminal attach
    permissions:
      contents: read
      actions: read
    uses: ./.github/workflows/performance-long-run-qualification-074.yml
    with:
      source_sha: ${{ inputs.controller_source_sha }}
      host_id: reference-074
      operation: seal
      campaign_id: ${{ inputs.campaign_id }}
      manifest_sha256: ${{ inputs.manifest_sha256 }}
      expected_state_revision: ${{ inputs.seal_expected_state_revision }}
      request_id: ${{ inputs.seal_request_id }}
    secrets: inherit

  systemd-smoke:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'systemd-smoke'
    name: Bounded non-product systemd smoke
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 10
    env:
      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-systemd-smoke
    steps:
      - name: Check out exact smoke source
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify source and read-only system bus access
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test -z "$(git status --porcelain=v1 --untracked-files=normal)"
          cargo test -p hydracache-long-run-supervisor-074 \
            systemd_unit::tests::reads_a_real_loaded_service_over_dbus \
            --locked -- --ignored --exact

      - name: Run bounded fixture-only transient unit smoke
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$EVIDENCE_DIR"
          sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \
            > "$EVIDENCE_DIR/provisioning.json"
          test "$(python3 -c 'import json, os; print(json.load(open(os.environ["EVIDENCE_DIR"] + "/provisioning.json"))["source_commit"])')" = "$GITHUB_SHA"
          sudo -n /usr/local/sbin/hydracache-provision-host-074 --systemd-smoke \
            > "$EVIDENCE_DIR/systemd-smoke.json"
          python3 - <<'PY'
          import json
          import os
          import pathlib

          receipt = json.loads(
              (pathlib.Path(os.environ["EVIDENCE_DIR"]) / "systemd-smoke.json").read_text()
          )
          assert receipt["schema_version"] == "hydracache-w11-systemd-smoke-v1"
          assert receipt["fixture_command"] == "/usr/bin/sleep 1"
          assert receipt["product_candidate_started"] is False
          assert receipt["saw_running"] is True
          assert receipt["running_main_pid"] > 0
          assert receipt["terminal"]["active_state"] == "active"
          assert receipt["terminal"]["sub_state"] == "exited"
          assert receipt["terminal"]["result"] == "success"
          after_stop = receipt["after_stop"]
          assert after_stop is None or (
              after_stop["active_state"] == "inactive"
              and after_stop["sub_state"] == "dead"
              and after_stop["main_pid"] == 0
          )
          PY

      - name: Retain bounded systemd smoke receipt
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: performance-long-run-systemd-smoke-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: target/performance-evidence/0.74/reference/w11-systemd-smoke/**
          if-no-files-found: error
          retention-days: 90

  controller-loss-smoke:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'controller-loss-smoke'
    name: Bounded fixture controller-loss smoke
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 10
    env:
      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-controller-loss-smoke
    steps:
      - name: Check out exact controller-loss smoke source
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify source and controller-loss fixture tests
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test -z "$(git status --porcelain=v1 --untracked-files=normal)"
          cargo test -p hydracache-long-run-supervisor-074 \
            systemd_smoke::tests::controller_loss_spec_is_long_enough_to_outlive_its_caller_and_stays_non_product \
            --locked -- --exact

      - name: Start fixture and let the starting controller exit
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$EVIDENCE_DIR"
          sudo -n /usr/local/sbin/hydracache-provision-host-074 --emit-receipt \
            > "$EVIDENCE_DIR/provisioning.json"
          test "$(python3 -c 'import json, os; print(json.load(open(os.environ["EVIDENCE_DIR"] + "/provisioning.json"))["source_commit"])')" = "$GITHUB_SHA"
          sudo -n /usr/local/sbin/hydracache-provision-host-074 --controller-loss-smoke-start \
            > "$EVIDENCE_DIR/start.json"

      - name: Reattach from a new controller process and stop the exact fixture
        shell: bash
        run: |
          set -euo pipefail
          sleep 2
          sudo -n /usr/local/sbin/hydracache-provision-host-074 --controller-loss-smoke-resume \
            > "$EVIDENCE_DIR/resume.json"
          python3 - <<'PY'
          import json
          import os
          import pathlib

          root = pathlib.Path(os.environ["EVIDENCE_DIR"])
          started = json.loads((root / "start.json").read_text())
          resumed = json.loads((root / "resume.json").read_text())
          assert started["schema_version"] == "hydracache-w11-controller-loss-start-v1"
          assert resumed["schema_version"] == "hydracache-w11-controller-loss-resume-v1"
          assert started["unit_name"] == resumed["unit_name"]
          assert started["fixture_command"] == resumed["fixture_command"] == "/usr/bin/sleep 30"
          assert started["product_candidate_started"] is False
          assert resumed["product_candidate_started"] is False
          assert resumed["original_controller_exited"] is True
          assert resumed["fixture_identity_unchanged"] is True
          assert resumed["observed_before_stop"]["main_pid"] == started["fixture"]["pid"]
          after_stop = resumed["after_stop"]
          assert after_stop is None or (
              after_stop["active_state"] == "inactive"
              and after_stop["sub_state"] == "dead"
              and after_stop["main_pid"] == 0
          )
          PY

      - name: Retain bounded controller-loss smoke receipt
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: performance-long-run-controller-loss-smoke-074-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: target/performance-evidence/0.74/reference/w11-controller-loss-smoke/**
          if-no-files-found: error
          retention-days: 90

  campaign-lifecycle-smoke:
    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'campaign-lifecycle-smoke'
    name: Campaign-shaped controller-loss lifecycle smoke
    runs-on: [self-hosted, linux, x64, hydracache-release]
    environment: performance-reference-074
    timeout-minutes: 10
    env:
      EVIDENCE_DIR: target/performance-evidence/0.74/reference/w11-campaign-lifecycle-smoke
    steps:
      - name: Check out exact campaign lifecycle smoke source
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify source and campaign lifecycle fixture tests
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test -z "$(git status --porcelain=v1 --untracked-files=normal)"
          cargo test -p hydracache-long-run-supervisor-074 \
            campaign_smoke::tests::derived_request_id_is_a_lowercase_v4_uuid \
            --locked -- --exact

      - name: Start campaign-shaped fixture and let the controller exit
        shell: bash
        run: |
          set -euo pipefail
          test "$(systemctl is-active hydracache-performance-supervisor-074.service || true)" = inactive
