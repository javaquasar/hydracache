"""Retain final offline/check receipts separately from the first native packet."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/coordinator-native-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for label in ('coordinator-native-integrity-first', 'coordinator-native-syntax-first',
              'coordinator-native-check-first', 'coordinator-native-clippy-first',
              'coordinator-native-doc-first', 'coordinator-native-contract-first', 'coordinator-native-models-first'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('verify.py', 'test_verify.py'):
    take(name, PACKET/name)
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
take('collector.py', Path(__file__))
index = dict(schema='hc074-coordinator-native-final-checks-v1', checks=7,
    native_index_sha256='55b802621e147681f9478a164053a04c055ec28d8d35227d68d49ad0b4de380f',
    new_native_attempts=0, overhead_accepted=False, package_pass=False, members=members)
raw = (json.dumps(index, indent=2, sort_keys=True)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
