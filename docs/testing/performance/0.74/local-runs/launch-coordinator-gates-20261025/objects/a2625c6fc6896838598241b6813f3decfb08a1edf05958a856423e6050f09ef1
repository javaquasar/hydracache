(base/'.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps(dict(index_sha256=hashlib.sha256((base/'index.json').read_bytes()).hexdigest(),members=len(members),objects=len(objects))))
