for name in ('retain-launch-coordinator-gates-20261025.py','verify-launch-coordinator-20261025.py'):
    add('retention/'+name,(root/'target'/name).read_bytes())
index=dict(schema='hc074-fixed-launch-coordinator-gates-v1',members=members,
    upstream_index_sha256='b29405c011bf7e05f0b13d0695ffacb4b19d4d2a6337ec3036568473720f6838',
    historical_python_cases=91,native_session_repeated=False,full_package_pass=False,admission=False)
base.mkdir(exist_ok=False);(base/'objects').mkdir()
for digest,raw in objects.items():(base/'objects'/digest).write_bytes(raw)
