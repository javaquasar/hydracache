import hashlib,json,subprocess,sys
root=Path(__file__).resolve().parent.parent
base=root/'docs/testing/performance/0.74/local-runs/launch-coordinator-gates-20261025'
members,objects={},{}
def add(name,raw):
    digest=hashlib.sha256(raw).hexdigest();assert name not in members
    members[name]=dict(sha256=digest,bytes=len(raw));objects[digest]=raw
for label in ['launch-coordinator-historical-20261025','launch-coordinator-compile-20261025',
    'launch-coordinator-tabnanny-20261025','launch-coordinator-v3-20261025',
    'launch-coordinator-doc-check-20261025','launch-coordinator-local-contract-20261025']:
    folder=root/'target/source-continuation-20261024'/label
