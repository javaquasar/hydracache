(receipt/'stdout.log').write_bytes(result.stdout);(receipt/'stderr.log').write_bytes(result.stderr)
(receipt/'result.json').write_text(json.dumps(dict(exit=result.returncode)),encoding='utf-8')
assert result.returncode==0,result.stderr
assert json.loads(result.stdout)['staged_verified']
