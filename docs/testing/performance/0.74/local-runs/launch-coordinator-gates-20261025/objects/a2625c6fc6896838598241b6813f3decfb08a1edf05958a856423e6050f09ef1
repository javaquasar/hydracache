    assert before['source']==after['source_after'] and after['source_unchanged'] and after['head_unchanged']
    assert after['exit']==0 and after['outer_refusal'] is None
    for path in sorted(folder.iterdir()):
        assert path.is_file();add(label+'/'+path.name,path.read_bytes())
assert b'Ran 91 tests' in objects[members['launch-coordinator-historical-20261025/stderr.log']['sha256']]
reader=root/'target/verify-launch-coordinator-20261025.py'
receipt=root/'target/launch-coordinator-staged-reader-first-20261025';receipt.mkdir(exist_ok=False)
argv=[sys.executable,str(reader)]
(receipt/'intent.json').write_text(json.dumps(dict(argv=argv,producer_repeated=False)),encoding='utf-8')
