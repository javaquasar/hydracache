import preservation_reuse_audit as audit

members,objects,phases={},{},[]
def sha(raw): return hashlib.sha256(raw).hexdigest()
def add(name,raw):
    assert name not in members
    digest=sha(raw); members[name]=dict(sha256=digest,bytes=len(raw)); objects[digest]=raw
checks=ROOT/'target/source-continuation-20261024'
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip()==CODE
for folder in sorted(checks.iterdir()):
    if not folder.is_dir() or not folder.name.startswith('reuse-audit-20261025-'): continue
    intent=json.loads((folder/'intent.json').read_bytes()); result=json.loads((folder/'result.json').read_bytes())
    assert result['exit']==0 and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged'] and intent['source']==result['source_after']
    for path in sorted(folder.iterdir()):
        if path.is_file(): add('checks/'+folder.name+'/'+path.name,path.read_bytes())
    phases.append(folder.name)
result=audit.audit(ROOT)
stored=json.loads((checks/'reuse-audit-20261025-offline-final/stdout.log').read_bytes())
assert result==stored
add('derived/audit.json',(json.dumps(result,indent=2,sort_keys=True)+'\n').encode())
source_files=('tools/xtask-package-attribution-074/preservation_reuse_audit.py',
              'tools/xtask-package-attribution-074/test_preservation_reuse_audit.py')
final=json.loads((checks/'reuse-audit-20261025-offline-final/intent.json').read_bytes())['source']
for path in source_files:
    raw=(ROOT/path).read_bytes(); assert sha(raw)==final[path]
    assert raw==subprocess.check_output(['git','show',CODE+':'+path],cwd=ROOT)
    add('source/'+path,raw)
# Exact inverse of the two known test additions and the clarified report field.
# These are reconstructed old bytes, explicitly labeled and checked against the
# original pre-execution source maps, not claimed as raw first capture copies.
first=json.loads((checks/'reuse-audit-20261025-offline/intent.json').read_bytes())['source']
path=source_files[0]
raw=(ROOT/path).read_bytes().replace(b'preplanned_prefetch_changes_conditional_observation_schedule',
                                  b'batching_changes_conditional_observation_schedule')
assert sha(raw)==first[path]; add('first-reconstructed-source/'+path,raw)
path=source_files[1]
raw=(ROOT/path).read_bytes()
line=b"        with self.assertRaises(ValueError): audit.analyze([frame('a', ['ls-files', '--', audit.SCOPE])])\n"
