from pathlib import Path
import hashlib
import json
import subprocess
import sys

ROOT=Path(__file__).resolve().parent.parent
BASE=ROOT/'docs/testing/performance/0.74/local-runs/preservation-reuse-audit-20261025'
CODE='11d777a5cd13bcc1fc68784d113b7a211062ac46'
