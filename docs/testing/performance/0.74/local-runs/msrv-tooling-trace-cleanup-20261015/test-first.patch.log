+    registry.aggregate_budget_seconds += 1;
+    let problems = xtask::fast_suite::validate_registry(&root, &registry, "0.64", None).unwrap();
+    assert!(
+        problems
+            .iter()
+            .any(|problem| problem
+                == "aggregate_budget_seconds must be the reviewed 1680s PR ceiling")
+    );
+}
