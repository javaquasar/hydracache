"""Seal first boundary control and model failures without replaying a process."""
from pathlib import Path
import hashlib
import json

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/git-process-boundary-20261026'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members = {}
def add(name, raw):
    assert name not in members
    members[name] = raw

labels = ['git-boundary-model-first', 'git-boundary-model-final', 'git-boundary-close-budget-first',
          'git-boundary-close-budget-fixed', 'git-boundary-all-models', 'git-boundary-check',
          'git-boundary-bytecode', 'git-boundary-indent', 'git-boundary-final-scope-models',
          'git-boundary-clippy', 'git-boundary-fmt', 'git-boundary-final-python',
          'git-boundary-precommit-models', 'git-boundary-native-first']
for label in labels:
    folder = ROOT / 'target/source-continuation-20261024' / label
    intent, result = (json.loads((folder / name).read_bytes()) for name in ('intent.json', 'result.json'))
    assert result['exit'] == (1 if label == 'git-boundary-close-budget-first' else 0)
    assert result['source_unchanged'] and result['head_unchanged'] and result['outer_refusal'] is None
    assert intent['source'] == result['source_after']
    for path in folder.iterdir():
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())
native = json.loads(members['checks/git-boundary-native-first/intent.json'])
assert native['head'] == '3807c4749873d9a3e9495c755bbf3ef1f73f9c7b'
for path in (ROOT / 'target/git-process-boundary-20261026/first').iterdir():
    assert path.is_file()
    add('native/' + path.name, path.read_bytes())
result = json.loads(members['native/result.json'])
assert result['passed'] and result['refusal'] is None and result['cleanup_errors'] == []
assert not members['native/stdout.log'] and not members['native/stderr.log']
for name in ('git_process_boundary.py', 'test_git_process_boundary.py', 'owned_process_observer.py',
             'process_lineage.py', 'git-boundary-protocol.toml', 'git-boundary-design.md'):
    path = 'tools/xtask-package-attribution-074/' + name
    raw = (ROOT / path).read_bytes()
    assert sha(raw) == native['source'][path]
    add('source/' + path, raw)
for name in ('package_effects_review_v6.py', 'package_effects_review_v5.py', 'package_effects_review.py', 'census_cost.py'):
    path = 'tools/historical-blob-batch-074/' + name
    raw = (ROOT / path).read_bytes()
    assert sha(raw) == native['source'][path]
    add('source/' + path, raw)
before = json.loads(members['checks/git-boundary-close-budget-first/intent.json'])
for name in ('git_process_boundary.py', 'test_git_process_boundary.py'):
    raw = (ROOT / 'target/git-boundary-pre-close-budget-20261026' / name).read_bytes()
    assert sha(raw) == before['source']['tools/xtask-package-attribution-074/' + name]
    add('raw-before-close-budget/' + name, raw)
for name in ('run-ci-watchdog-step-20261026.py', 'run-source-step-20261024.py', Path(__file__).name):
    add('collector/' + name, (ROOT / 'target' / name).read_bytes())
OUT.mkdir(exist_ok=False)
(OUT / 'objects').mkdir()
index = dict(schema='hc074-git-process-boundary-evidence-v1',
             source_commit=native['head'], native_control_attempts=1, performance_cohort=False,
             package_pass=False, server=False, product_admission=False, members={})
for name, raw in sorted(members.items()):
    digest = sha(raw)
    path = OUT / 'objects' / digest
    if path.exists():
        assert path.read_bytes() == raw
    else:
        with path.open('xb') as stream:
            stream.write(raw)
    index['members'][name] = dict(sha256=digest, bytes=len(raw))
raw = (json.dumps(index, indent=2, sort_keys=True) + '\n').encode()
with (OUT / 'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=sha(raw), members=len(members), objects=len(list((OUT / 'objects').iterdir()))))
