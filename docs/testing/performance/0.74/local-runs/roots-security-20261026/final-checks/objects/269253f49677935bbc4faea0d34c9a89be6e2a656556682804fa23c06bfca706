"""Bounded final archive-only checks after restoring accepted runtime inputs."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
label, *argv = sys.argv[1:]
if not label.replace('-', '').isalnum() or not argv:
    raise SystemExit('invalid label/command')
OUT = ROOT/'target/roots-final-20261026'/label
OUT.mkdir(parents=True, exist_ok=False)
names = subprocess.check_output(['git','ls-files','-z','--','Cargo.toml','Cargo.lock','deny.toml','crates','tools','.cargo'], cwd=ROOT).split(b'\0')
def snapshot():
    return {n.decode(): hashlib.sha256((ROOT/n.decode()).read_bytes()).hexdigest() for n in names if n}
before = snapshot()
head = subprocess.check_output(['git','rev-parse','HEAD'], cwd=ROOT, text=True).strip()
for name in ('Cargo.lock', 'crates/hydracache-redis-compat/Cargo.toml'):
    original = subprocess.check_output(['git','show',head+':'+name], cwd=ROOT)
    if (ROOT/name).read_bytes().replace(b'\r\n', b'\n') != original:
        raise SystemExit('accepted input not restored: '+name)
intent = dict(argv=argv, source_commit=head, source=before, bound_seconds=180,
              server=False, services=False, clocks=False, original_owner=False,
              qualification=False, product_load=False, accepted_inputs_restored=True)
(OUT/'intent.json').write_text(json.dumps(intent, indent=2)+'\n')
start = time.monotonic()
with (OUT/'stdout.log').open('xb') as stdout, (OUT/'stderr.log').open('xb') as stderr:
    process = subprocess.Popen(argv, cwd=ROOT, stdout=stdout, stderr=stderr,
        env=dict(os.environ, CARGO_INCREMENTAL='0', CARGO_BUILD_JOBS='2'))
    (OUT/'process.json').write_text(json.dumps(dict(pid=process.pid)))
    try:
        code = process.wait(timeout=180)
        refusal = None
    except subprocess.TimeoutExpired:
        # This finalizer runs only bounded ordinary local check commands.
        subprocess.run(['taskkill','/PID',str(process.pid),'/T','/F'], check=False, timeout=15)
        code = process.wait(timeout=15)
        refusal = 'outer-timeout'
result = dict(exit=code, outer_refusal=refusal, wall_seconds=time.monotonic()-start,
              source_unchanged=before == snapshot(),
              commit_unchanged=head == subprocess.check_output(['git','rev-parse','HEAD'], cwd=ROOT, text=True).strip(),
              free_bytes=shutil.disk_usage(ROOT).free, release_admitted=False)
(OUT/'result.json').write_text(json.dumps(result, indent=2)+'\n')
print(result)
raise SystemExit(int(code != 0 or refusal is not None or not result['source_unchanged'] or not result['commit_unchanged']))
