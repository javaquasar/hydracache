"""Append final archive checks; never rewrite the pending candidate index."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RAW = ROOT/'target/roots-final-20261026'
OUT = ROOT/'docs/testing/performance/0.74/local-runs/roots-security-20261026/final-checks'
phases = ('integrity', 'tamper', 'doc', 'contract', 'doc-compiled-binary', 'staged-git')
for phase in phases:
    result = json.loads((RAW/phase/'result.json').read_bytes())
    expected_exit, expected_refusal = (1, 'outer-timeout') if phase == 'doc' else (0, None)
    if (result['exit'] != expected_exit or result['outer_refusal'] != expected_refusal
            or result['source_unchanged'] is not True or result['commit_unchanged'] is not True):
        raise ValueError('first final check differs: '+phase)
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}
def take(name, raw):
    digest = hashlib.sha256(raw).hexdigest()
    dest = OUT/'objects'/digest
    if not dest.exists():
        with dest.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)
for phase in phases:
    for path in sorted((RAW/phase).iterdir()):
        if path.is_file():
            take('checks/'+phase+'/'+path.name, path.read_bytes())
for name in ('check-roots-archive-20261026.py', 'verify-roots-git-20261026.py',
             'doc-from-compiled-roots-20261026.py', Path(__file__).name):
    take('coordinator/'+name, (ROOT/'target'/name).read_bytes())
for name in ('verify.py', 'test_verify.py'):
    take('verifier/'+name, (OUT.parent/name).read_bytes())
index = dict(schema='hc074-roots-archive-final-v1',
    parent_index_sha256=hashlib.sha256((OUT.parent/'index.json').read_bytes()).hexdigest(),
    first_cargo_doc_build_timeout_preserved=True, doc_semantic_check_separate_compiled_artifact=True,
    active_runtime_restored=True, candidate_accepted=False, trust_scope_approved=False,
    policy_pass=False, full_package_pass=False, release_admitted=False, members=members)
raw = (json.dumps(index, sort_keys=True, indent=2)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members), release_admitted=False))
