"""Capture exact changed caller/consumer bodies as well as shared reader sources."""
from pathlib import Path
import hashlib
import json
import runpy
import sys

root = Path(__file__).resolve().parent.parent
label = sys.argv[1]
assert label.replace('-', '').isalnum()
out = root / 'target/census-integration-sources-20261024' / label
out.mkdir(parents=True, exist_ok=False)
sources = ('crates/xtask/tests/support/census_provider_input.rs',
    'crates/xtask/tests/support/census_provider_input_legacy.rs',
    'crates/xtask/tests/held_complete_role_census_074.rs',
    'crates/xtask/tests/role_census_reader_074.rs',
    'tools/historical-blob-batch-074/linux-census-fixture.toml')
index = {}
for name in sources:
    raw = (root / name).read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    (out / digest).write_bytes(raw)
    index[name] = digest
(out / 'index.json').write_text(json.dumps(index, indent=2)+'\n')
runpy.run_path(str(root / 'target/run-blob-fault-step-20261024.py'), run_name='__main__')
