"""Seal caller integration sources, every first refusal and final native controls."""
from pathlib import Path
import base64
import hashlib
import json
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BASE = 'docs/testing/performance/0.74/local-runs/historical-blob-census-integration-20261024'
CODE = 'ae508a57220fe95b11887b81f16ff05263f1dee9'
PROTECTED = {
    'Cargo.toml':'18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock':'d2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml':'11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
}
members, objects, phases = {}, {}, []


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw


assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip() == CODE
for folder in sorted((ROOT / 'target/source-continuation-20261024').glob('census-integrate-*')):
    phase = folder.name
    intent = json.loads((folder/'intent.json').read_bytes())
    result = json.loads((folder/'result.json').read_bytes())
    expected = 101 if phase in ('census-integrate-current-v1','census-integrate-clippy') else 0
    assert result['exit']==expected and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['head_unchanged'] and intent['source']==result['source_after']
    for name in ('intent.json','stdout.log','stderr.log','result.json'):
        add(f'checks/{phase}/{name}',(folder/name).read_bytes())
    for kind, parent in (('sources','blob-fault-source-snapshots-20261024'),('caller-sources','census-integration-sources-20261024')):
        source = ROOT/'target'/parent/phase
        if source.is_dir():
            raw_index = (source/'index.json').read_bytes()
            add(f'{kind}/{phase}/index.json',raw_index)
            for path,digest in json.loads(raw_index).items():
                raw = (source/digest).read_bytes()
                assert sha(raw)==digest==intent['source'][path]
                add(f'{kind}/{phase}/{path}',raw)
    passes = list(map(int,re.findall(r'test result: ok\. (\d+) passed; 0 failed;', (folder/'stdout.log').read_text())))
    if phase in ('census-integrate-current-receipts','census-integrate-msrv-receipts'):
        assert passes == [4,9,11,5,6,2]
        assert 'warning:' not in (folder/'stderr.log').read_text()
    phases.append(dict(phase=phase,exit=expected,rust_passes=passes))
    for suffix in ('','-caller','-census-contract','-mutations','-cleanup'):
        capture = ROOT/'target/blob-fault-20261024'/(phase+suffix)
        if capture.is_dir():
            for path in sorted(capture.rglob('*')):
                if path.is_file():
                    add(f'observations/{phase}/{suffix or "transport"}/{path.relative_to(capture).as_posix()}',path.read_bytes())

first = ROOT/'target/census-integration-first-source-20261024'
intent = json.loads((ROOT/'target/source-continuation-20261024/census-integrate-current-v1/intent.json').read_bytes())
for path in first.iterdir():
    original = ('crates/xtask/tests/support/' if path.name.startswith('census_provider') else 'crates/xtask/tests/')+path.name
    raw = path.read_bytes()
    assert sha(raw)==intent['source'][original]
    add('first-caller-source/'+original,raw)
for version in ('v1','v2','v3','v4'):
    folder = ROOT/'target'/('census-integration-linux'+('' if version=='v1' else '-'+version)+'-20261024')
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add(f'linux/{version}/{path.name}',path.read_bytes())
    value = json.loads((folder/'stdout.json').read_bytes())
    assert value['component_tests_passed'] and value['source_unchanged'] and value['owned_root_removed']
    assert value['uid']==1000 and value['active_groups_after']==[] and value['boot_before']==value['boot_after']
    assert value['locked_packages']==33
    payload = json.loads((folder/'input.json').read_bytes())
    for name,entry in payload['files'].items():
        raw = base64.b64decode(entry['base64'],validate=True)
        assert sha(raw)==entry['sha256']==value['sources'][name]
        add(f'linux-input/{version}/{name}',raw)
    for phase in value['phases']:
        for stream in ('stdout','stderr'):
            add(f'linux-checks/{version}/{phase["name"]}.{stream}',base64.b64decode(phase[stream+'_b64'],validate=True))
    for name,raw in value['evidence'].items():
        add(f'linux-observations/{version}/{name}',base64.b64decode(raw,validate=True))
    for toolchain in ('1.94.0','1.88.0'):
        tests=[p for p in value['phases'] if p['name'].startswith(toolchain+'-') and not p['name'].endswith('-build')]
        assert len(tests)==5
        for phase,count in zip(tests,(9,5,6,11,2)):
            assert phase['code']==0 and phase['reason'] is None and phase['effective_bound']==phase['bound']==90
            assert f'test result: ok. {count} passed; 0 failed;' in base64.b64decode(phase['stdout_b64']).decode()
for path,digest in PROTECTED.items():
    assert sha((ROOT/path).read_bytes())==digest
for path in ('tools/historical-blob-batch-074/README.md','docs/articles/007-optimization-starts-with-measurement.md',
    'docs/testing/performance/0.74/README.md','docs/testing/performance/0.74/release-closure-audit-20261024.md',
    'docs/testing/performance/0.74/historical-blob-census-linux-panic-result-20261024.md',
    'docs/testing/performance/0.74/historical-blob-census-integration-result-20261024.md'):
    add('final/'+path,(ROOT/path).read_bytes())
for name in ('run-census-integrate-step-20261024.py','run-blob-fault-step-20261024.py','run-fresh-reader-20261024.py',
    'run-source-step-20261024.py','run-census-linux-20261024.py','seal-census-integration-20261024.py',
    'verify-census-integration-staged-20261024.py'):
    add('coordinators/'+name,(ROOT/'target'/name).read_bytes())
index = dict(schema='hc074-static-pin-census-integration-v1',code_commit=CODE,members=members,
    facts=dict(phases=phases,protected_sha256=PROTECTED,caller_integrated=True,extra_guard_git_reads=False,
        windows_tests_per_toolchain=37,linux_wsl_tests_per_toolchain=33,python_controls=45,
        caller_profiles=5,operations_per_profile=5,comparison_paths=4,toolchains=['1.94.0','1.88.0'],
        native_roots_removed=4,first_source_expectation_refusal_retained=True,first_duplicate_mod_refusal_retained=True,
        earlier_msrv_warnings_retained=True,independent_static_references=True,production_pin_authority=False,
        original_clock_admitted=False,arbitrary_unbounded_equivalence=False,full_package_pass=False,
        numerical_performance_claim=False,original_checks_or_deadlines_changed=False,dependency_baseline_changed=False,
        server=False,services_or_clocks=False,product_workload=False,original_owner=False,qualification=False,push=False))
out = ROOT/BASE
out.mkdir(parents=True,exist_ok=False)
(out/'objects').mkdir()
(out/'.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
for digest,raw in objects.items():
    (out/'objects'/digest).write_bytes(raw)
raw=(json.dumps(index,sort_keys=True,indent=2)+'\n').encode()
(out/'index.json').write_bytes(raw)
print(json.dumps(dict(index_sha256=sha(raw),members=len(members),objects=len(objects),phases=len(phases))))
