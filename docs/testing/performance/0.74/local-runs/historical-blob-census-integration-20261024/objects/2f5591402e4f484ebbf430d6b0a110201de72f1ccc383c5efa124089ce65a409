"""Independent staged bytes, provenance, cleanup and no-extra-read profile proof."""
from pathlib import Path
import base64
import hashlib
import json
import subprocess
import sys
import tomllib
import zlib

ROOT=Path(__file__).resolve().parent.parent
BASE='docs/testing/performance/0.74/local-runs/historical-blob-census-integration-20261024'


def git(args,raw=None):
    return subprocess.check_output(['git',*args],cwd=ROOT,input=raw)


def staged(path):
    return git(['show',':'+path])


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


index_raw=staged(BASE+'/index.json')
assert index_raw==(ROOT/BASE/'index.json').read_bytes()
index=json.loads(index_raw)
assert index['code_commit']=='ae508a57220fe95b11887b81f16ff05263f1dee9'
objects={}
for item in index['members'].values():
    digest=item['sha256']
    if digest not in objects:
        path=BASE+'/objects/'+digest
        objects[digest]=staged(path)
        assert objects[digest]==(ROOT/path).read_bytes()
    assert sha(objects[digest])==digest and len(objects[digest])==item['bytes']


def member(name):
    return objects[index['members'][name]['sha256']]


def profiles(get):
    pins=json.loads(get('producer.stdout.json'))
    assert pins['caller_integrated'] and pins['test_fixture_pin_integrity'] and not pins['production_pin_authority']
    specs=[v['spec'] for v in pins['cases']]
    for case in pins['cases']:
        raw=bytes.fromhex(case['stdout_hex'])
        assert sha(raw)==case['pin']['sha256'] and len(raw)==case['pin']['bytes']
    assert json.loads(get('result.json'))['caller_integrated']
    for mode in ('clean','trace','config','config-error','repository-error'):
        line=next(v for v in get(mode+'.stdout.log').decode().splitlines() if '"operations"' in v)
        value=json.loads(line[line.index('{'):])
        assert value['caller_integrated'] and value['mode']==mode and len(value['operations'])==5
        total=0
        for op in value['operations']:
            name=op['operation']
            failed=mode.endswith('error') and name!='unrelated'
            expected={'original':[specs[0]],'accepts':[specs[1]],'view':[specs[0]] if failed else specs,
                'unrelated':[],'mismatch':[specs[1]]}[name]
            assert op['old_git_argv']==op['candidate_git_argv']==op['facade_git_argv']==op['integrated_git_argv']
            assert [v[3] for v in op['integrated_git_argv']]==expected
            assert all(v[1:3]==['--no-replace-objects','show'] and len(v)==4 for v in op['integrated_git_argv'])
            assert op['old_error']==op['facade_error']==op['integrated_error']
            assert op['old_panic_kind']==op['facade_panic_kind']==op['integrated_panic_kind']
            assert op['old_success']==op['facade_success']==op['integrated_success']==(not failed)
            if failed:
                assert op['old_error']=='missing exact material fixture source' and 'Process' in op['candidate']['Err']
            else:
                assert 'Ok' in op['candidate'] and op['old_error'] is None
                if name=='unrelated':
                    assert op['candidate_events']==[] and op['outputs']==[]
            total+=4*len(expected)
        starts=[json.loads(v) for v in get(mode+'.trace.jsonl').decode().splitlines() if json.loads(v)['event']=='start']
        assert len(starts)==total+(0 if mode.endswith('error') else 1)


