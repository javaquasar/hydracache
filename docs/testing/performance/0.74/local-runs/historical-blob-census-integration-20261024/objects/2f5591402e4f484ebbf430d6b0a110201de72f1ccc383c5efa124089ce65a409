known={(p['name'],p['version'],p.get('source'),p.get('checksum')) for p in tomllib.loads((ROOT/'Cargo.lock').read_text())['package']}
for version in ('v1','v2','v3','v4'):
    native=json.loads(member(f'linux/{version}/stdout.json'))
    assert native['source_unchanged'] and native['owned_root_removed'] and native['active_groups_after']==[]
    assert native['boot_before']==native['boot_after'] and native['component_tests_passed'] and native['uid']==1000
    lock=tomllib.loads(base64.b64decode(native['resolved_lock_b64']).decode())['package']
    assert len(lock)==33
    for p in lock:
        if p['name']=='hc074-historical-blob-linux-fixture':
            assert p['version']=='0.0.0' and 'source' not in p
        else:
            assert (p['name'],p['version'],p.get('source'),p.get('checksum')) in known
    payload=json.loads(member(f'linux/{version}/input.json'))
    for name,item in payload['files'].items():
        raw=base64.b64decode(item['base64'],validate=True)
        assert sha(raw)==item['sha256']==native['sources'][name]
        assert raw==member(f'linux-input/{version}/{name}')
        if name.startswith('repo/.git/objects/'):
            assert hashlib.sha1(zlib.decompress(raw)).hexdigest()==''.join(name.split('/')[-2:])
        elif version=='v4':
            source='tools/historical-blob-batch-074/linux-census-fixture.toml' if name=='repo/crates/xtask/Cargo.toml' else name.removeprefix('repo/')
            assert raw==(ROOT/source).read_bytes()
            assert git(['hash-object','--stdin','--path',source],raw).strip()==git(['rev-parse',':'+source]).strip()
    if version=='v4':
        for toolchain in ('1.94.0','1.88.0'):
            profiles(lambda name:member(f'linux-observations/{version}/{toolchain}-census-contract/{name}'))
            oracle=json.loads(member(f'linux-observations/{version}/{toolchain}/oracle.stdout.json'))
            assert len(oracle['cases'])==6
            for number,case in enumerate(oracle['cases']):
                observed=json.loads(member(f'linux-observations/{version}/{toolchain}/native-case-{number}.json'))
                assert observed['outputs']==case['expected']
