DEST.mkdir()
(DEST / 'objects').mkdir()
files = {}


def retain(name, raw):
    digest = sha(raw)
    destination = DEST / 'objects' / digest
    if not destination.exists():
        with destination.open('xb') as stream:
            stream.write(raw)
    elif destination.read_bytes() != raw:
        raise ValueError('Hash collision')
    files[name] = dict(bytes=len(raw), sha256=digest)


for path in sorted(SOURCE.rglob('*')):
    if not path.is_file() or path.name == 'parser' or ('runtime-images' in path.parts and path.name != 'receipt.json'):
        continue
    retain('observation/' + path.relative_to(SOURCE).as_posix(), path.read_bytes())
for scope in ('tools/status-field-scan-074', 'tools/status-field-gate-074'):
    for path in sorted((ROOT / scope).rglob('*')):
        if path.is_file() and '__pycache__' not in path.parts:
