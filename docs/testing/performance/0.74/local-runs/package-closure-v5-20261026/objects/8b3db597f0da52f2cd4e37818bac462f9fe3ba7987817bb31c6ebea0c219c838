"""Retain first fixed-bound package outcome; never launches or retries a test."""
from pathlib import Path
import hashlib
import json
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'tools/xtask-package-attribution-074'))
import review

OUT = ROOT / 'docs/testing/performance/0.74/local-runs/package-closure-v5-20261026'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
members = {}


def add(name, raw):
    assert name not in members
    members[name] = raw


labels = ['package-effect-v5-controls-first', 'package-replay-v5-controls-first', 'package-v5-focused-final',
          'package-v5-review-first', 'package-v5-check-first', 'package-v5-clippy-first', 'package-v5-fmt-first',
          'package-v5-contract-doc-first', 'package-v5-preflight-first', 'package-v5-cleanup-observation-first',
          'package-v5-postflight-review-first', 'package-v5-first']
for label in labels:
    folder = ROOT / 'target/source-continuation-20261024' / label
    intent, result = (json.loads((folder / name).read_bytes()) for name in ('intent.json', 'result.json'))
    assert result['exit'] == (1 if label == 'package-v5-first' else 0)
    assert result['head_unchanged']
    assert result['source_unchanged'] == (label != 'package-effect-v5-controls-first')
    assert result['outer_refusal'] == ('outer-timeout' if label == 'package-v5-first' else None)
    for file in folder.iterdir():
        assert file.is_file()
        add('checks/' + label + '/' + file.name, file.read_bytes())
for label in ['preflight-first', 'first']:
    for file in (ROOT / 'target/reviewed-package-v5-20261026' / label).iterdir():
        assert file.is_file()
        add('coordinator/' + label + '/' + file.name, file.read_bytes())
gate = json.loads(members['coordinator/first/gate.json'])
assert gate['head'] == '9cc82116af63c7eac2e6ca4a6ff4c4f5e815a8c3'
post = json.loads(members['checks/package-v5-postflight-review-first/stdout.log'])
assert {k: v for k, v in gate.items() if k != 'head'} == post
full = 'checks/package-v5-first/'
intent, result = (json.loads(members[full + name]) for name in ('intent.json', 'result.json'))
assert intent['source'] == result['source_after'] and intent['head'] == gate['head']
analysis = review.parse_transcript(members[full + 'stdout.log'].decode(), members[full + 'stderr.log'].decode(),
                                   gate['targets'], result['exit'], result['outer_refusal'], intent['bound_seconds'])
assert (analysis['expected_targets'], analysis['completed_targets'], analysis['passed'], analysis['failed']) == (144, 76, 457, 3)
assert len(analysis['unstarted_targets']) == 67 and analysis['incomplete_target']['declared'] == 4
assert len(analysis['incomplete_target']['cases']) == 3 and not analysis['package_pass']
add('derived/accounting.json', (json.dumps(analysis, indent=2, sort_keys=True) + '\n').encode())
for name, digest in gate['auxiliary'].items():
    raw = (ROOT / name).read_bytes()
    assert sha(raw) == digest
    add('auxiliary/' + name, raw)
for name in ['package_effects_review_v5.py', 'package_replay_v5.py',
             'test_package_effects_review_v5.py', 'test_package_replay_v5.py']:
    path = 'tools/historical-blob-batch-074/' + name
    raw = (ROOT / path).read_bytes()
    assert sha(raw) == intent['source'][path]
    add('implementation/' + path, raw)
path = 'tools/xtask-package-attribution-074/review.py'
raw = (ROOT / path).read_bytes()
assert sha(raw) == '0229d4067fffd0d0b5acee7d864efc64aadfb201de1ea3f17944a2f8dddf3c4d'
add('parser/' + path, raw)
for name in ['run-package-v5-focused-20261026.py', 'run-package-v5-checks-20261026.py',
             'read-package-v5-cleanup-20261026.py', 'run-fresh-reader-20261024.py',
             'run-source-step-20261024.py', 'run-xtask-package-780-20261024.py', Path(__file__).name]:
    add('wrapper/' + name, (ROOT / 'target' / name).read_bytes())
path = 'docs/testing/performance/0.74/package-closure-v5-contract-20261026.md'
add('contract.md', (ROOT / path).read_bytes())
OUT.mkdir(parents=True, exist_ok=True)
(OUT / 'objects').mkdir()
index = dict(schema='hc074-package-closure-v5-evidence-v1',
    source_commit=gate['head'], sources=365, auxiliary=42, expected_targets=144,
    completed_targets=76, passed_completed=457, failed_completed=3,
    incomplete_target='tests/held_preparation_cost_074.rs', unstarted_targets=67,
    package_pass=False, qualification=False, server=False, automatic_retry=False, members={})
for name, raw in sorted(members.items()):
    digest = sha(raw)
    path = OUT / 'objects' / digest
    if path.exists():
        assert path.read_bytes() == raw
    else:
        with path.open('xb') as stream:
            stream.write(raw)
    index['members'][name] = dict(sha256=digest, bytes=len(raw))
raw = (json.dumps(index, indent=2, sort_keys=True) + '\n').encode()
with (OUT / 'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=sha(raw), members=len(members), objects=len(list((OUT / 'objects').iterdir()))))
