"""Retain first inputs/failures and corrected step checks, never dispatch a package."""
import hashlib
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent
BASE = ROOT / 'target/roots-lock-view-20261027'
OUT = ROOT / 'docs/testing/performance/0.74/local-runs/roots-lock-view-20261027'
assert {p.name for p in OUT.iterdir()} == {'.gitattributes'}
members, objects = {}, {}

def add(name, raw):
    assert name not in members
    digest = hashlib.sha256(raw).hexdigest()
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

phases = ('baseline-first', 'focused-first', 'focused-corrected', 'focused-final', 'parser-build',
          'syntax-first', 'check-first', 'review-first', 'clippy-first', 'msrv-first', 'gnu-first',
          'v8-controls-first', 'v8-controls-corrected', 'v8-controls-final', 'format-first', 'doc-first', 'contract-first')
expected = {'baseline-first':101, 'focused-first':101, 'focused-corrected':101, 'v8-controls-first':1}
for phase in phases:
    folder = BASE / phase
    value = json.loads((folder / 'result.json').read_bytes())
    assert value['exit'] == expected.get(phase, 0) and value['outer_refusal'] is None
    assert value['source_unchanged'] and value['commit_unchanged']
    for path in sorted(folder.rglob('*')):
        if path.is_file():
            add('checks/' + phase + '/' + path.relative_to(folder).as_posix(), path.read_bytes())
for phase in ('focused-final','msrv-first','gnu-first'):
    rows = re.findall(r'test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored;',
                      (BASE / phase / 'stdout.log').read_text(encoding='utf-8'))
    assert len(rows) == 4 and [sum(int(v[n]) for v in rows) for n in range(3)] == [22,0,0]
for name in ('Cargo.toml','Cargo.lock','deny.toml','docs/testing/performance/0.74/qualification-manifest.toml'):
    add('protected/' + name, (ROOT / name).read_bytes())
for folder in ('tools/roots-lock-view-074',):
    for path in sorted((ROOT / folder).iterdir()):
        if path.is_file():
            add('implementation/' + folder + '/' + path.name, path.read_bytes())
for name in ('crates/xtask/tests/roots_lock_view_074.rs', 'crates/xtask/tests/security_input_view_074.rs',
             'tools/source-successor-view-074/contract.rs'):
    add('implementation/' + name, (ROOT / name).read_bytes())
for name in ('package_effects_review_v8.py','package_replay_v8.py','test_package_effects_review_v8.py','test_package_replay_v8.py'):
    path = 'tools/historical-blob-batch-074/' + name
    add('implementation/' + path, (ROOT / path).read_bytes())
    # The still-staged pre-EOF-normalization bodies are exact bytes, not a
    # reconstruction or an execution of archived code.
    add('pre-format/' + path, subprocess.check_output(['git','show',':'+path],cwd=ROOT))
for name, phase, source in (('roots-lock-view-first-tests-20261027.rs','focused-first','crates/xtask/tests/roots_lock_view_074.rs'),
                           ('roots-lock-view-first-security-tests-20261027.rs','focused-corrected','crates/xtask/tests/security_input_view_074.rs')):
    raw = (ROOT / 'target' / name).read_bytes()
    intent = json.loads((BASE / phase / 'intent.json').read_bytes())
    assert hashlib.sha256(raw).hexdigest() == intent['source'][source]
    add('first-source/' + source, raw)
add('first-source/test_package_effects_review_v8.py', (ROOT / 'target/roots-lock-view-first-v8-tests-20261027.py').read_bytes())
for name in ('run-roots-lock-view-20261027.py','prepare-roots-lock-view-20261027.py',
             'capture-package-review-v8-20261027.py','retain-package-review-v8-20261027.py', Path(__file__).name):
    add('coordinators/' + name, (ROOT / 'target' / name).read_bytes())
(OUT / 'objects').mkdir()
for digest, raw in objects.items():
    with (OUT / 'objects' / digest).open('xb') as stream:
        stream.write(raw)
index = dict(schema='hc074-roots-lock-view-step-evidence-v1', members=members, phases=list(phases),
             implementation_commit='83e1408df0db1ca5892b2f4cce58479b942fe22e',
             first_failures=expected, first_rust_sources_match_preexecution_hashes=True,
             first_v8_test_source_preexecution_hash_available=False,
             input_rust_executed=False, product_runtime_changed=False,
             live_checks_or_origins_changed=False, package_dispatched=False, package_pass=False,
             server=False, services=False, clocks=False, qualification=False, release_admitted=False)
with (OUT / 'index.json').open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(index, stream, sort_keys=True, indent=2)
    stream.write('\n')
print(json.dumps(dict(members=len(members), index_sha256=hashlib.sha256((OUT / 'index.json').read_bytes()).hexdigest())))
