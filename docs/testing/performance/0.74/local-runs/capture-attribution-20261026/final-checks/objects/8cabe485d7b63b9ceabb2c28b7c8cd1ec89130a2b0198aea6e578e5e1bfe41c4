"""Retain final offline evidence controls, without rewriting first analysis."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKET = ROOT/'docs/testing/performance/0.74/local-runs/capture-attribution-20261026'
OUT = PACKET/'final-checks'
OUT.mkdir(exist_ok=False)
(OUT/'objects').mkdir()
members = {}


def take(name, path):
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    target = OUT/'objects'/digest
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(raw)
    members[name] = dict(bytes=len(raw), sha256=digest)


for label in ('capture-attribution-integrity-first', 'capture-attribution-integrity-precommit',
              'capture-attribution-verifier-syntax', 'capture-attribution-doc-first', 'capture-attribution-contract-first'):
    for part in ('intent.json', 'result.json', 'stdout.log', 'stderr.log'):
        take('checks/'+label+'/'+part, ROOT/'target/source-continuation-20261024'/label/part)
for name in ('verify.py', 'test_verify.py'):
    take(name, PACKET/name)
take('first-verify.py', ROOT/'target/capture-attribution-first-verify.py')
take('first-test-verify.py', ROOT/'target/capture-attribution-first-test-verify.py')
take('qualification-manifest.toml', ROOT/'docs/testing/performance/0.74/qualification-manifest.toml')
take('collector.py', Path(__file__))
index = dict(schema='hc074-capture-attribution-final-checks-v1', checks=5,
    analysis_index_sha256='055c7f306ad9dafb55b85a578ec788231a11f504e2117830991cdc0c5436a5b8',
    new_workload_calls=0, workload_replayed=False, overhead_accepted=False, package_pass=False, members=members)
raw = (json.dumps(index, indent=2, sort_keys=True)+'\n').encode()
with (OUT/'index.json').open('xb') as stream:
    stream.write(raw)
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(), members=len(members)))
