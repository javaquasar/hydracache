+            progress.packet.received_time().boottime_ns(),
+            prepared
+                .consent_to_sign()
+                .starting_state
+                .cell_started_monotonic_ns
+                .unwrap(),
+        ]
+    }
+}
diff --git a/tools/long-run-supervisor-074/src/diagnostic_original_custody_join_process_tests.rs b/tools/long-run-supervisor-074/src/diagnostic_original_custody_join_process_tests.rs
