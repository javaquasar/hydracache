+            let bounds = boundaries(
+                state.reserved_monotonic_ns,
+                state
+                    .cell_started_monotonic_ns
+                    .ok_or(OriginalGroupedPrepError::Binding)?,
+                progress.packet.received_time().boottime_ns(),
+                state.last_observed_monotonic_ns,
