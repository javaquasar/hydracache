+            Ok(()) => Ok(held),
+            Err(error) => {
+                held.refuse();
+                Err(OriginalCustodyFailure {
+                    error,
+                    held: Box::new(held),
+                })
+            }
+        }
+    }
+    #[cfg(test)]
+    pub(crate) fn custody_origins_for_test(&self) -> [u64; 4] {
