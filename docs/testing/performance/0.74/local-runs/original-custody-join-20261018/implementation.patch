+}
+fn frozen(path: &str, commit: &str) -> String {
+    let out = std::process::Command::new("git")
+        .args(["show", &format!("{commit}:{path}")])
+        .current_dir(root())
+        .output()
+        .unwrap();
+    assert!(out.status.success(), "{path}");
+    String::from_utf8(out.stdout).unwrap().replace('\r', "")
