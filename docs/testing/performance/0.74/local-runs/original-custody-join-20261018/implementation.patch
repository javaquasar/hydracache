+    fn prepare_custodied_with(
+        self,
+        #[cfg(test)] fixture: Option<&std::path::Path>,
+        #[cfg(test)] checkpoint: &mut dyn FnMut(
+            &'static str,
+            &mut OriginalCustodiedPreparation<'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
