+            #[cfg(test)]
+            None,
+            #[cfg(test)]
+            &mut |_, _| {},
+        )
+    }
+    #[cfg(test)]
+    pub(crate) fn prepare_custodied_fixture_for_test(
+        self,
+        fixture: &std::path::Path,
