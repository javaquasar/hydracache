"""Retain the two finite synthetic controls, not a measurement cohort."""
from pathlib import Path
import hashlib
import json
import sys

root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(root / 'tools/xtask-package-attribution-074'))
import owned_process_observer as observer

base = root / 'docs/testing/performance/0.74/local-runs/owned-process-observer-20261025'
members, objects = {}, {}

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def add(name, raw):
    assert name not in members
    digest = sha(raw)
    members[name] = dict(sha256=digest, bytes=len(raw))
    objects[digest] = raw

labels = ['owned-observer-unit-first-20261025', 'owned-observer-native-first-20261025',
          'owned-observer-python-final-20261025', 'owned-observer-complete-controls-20261025',
          'owned-observer-final-native-20261025']
receipts = {}
for label in labels:
    folder = root / 'target/source-continuation-20261024' / label
    before = json.loads((folder / 'intent.json').read_bytes())
    after = json.loads((folder / 'result.json').read_bytes())
    assert after['exit'] == 0 and after['outer_refusal'] is None
    assert after['source_unchanged'] and after['head_unchanged']
    assert before['source'] == after['source_after']
    assert before['bound_seconds'] == 1200
    receipts[label] = before
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add('checks/' + label + '/' + path.name, path.read_bytes())

for name in ['owned-process-control-first-20261025', 'owned-process-final-control-20261025']:
    folder = root / 'target' / name
    result = json.loads((folder / 'result.json').read_bytes())
    assert result['passed'] and result['exit_code'] == 0 and result['refusal'] is None
    assert not result['product_admission'] and not result['cargo_dispatch_admission']
    assert len(result['samples']) >= 2 and result['samples'][-1]['terminal']
    assert not any(row['terminal'] for row in result['samples'][:-1])
    previous = None
    for row in result['samples']:
        observer.validate(previous, row)
        if previous:
            assert row['observed_monotonic_ns'] >= previous['observed_monotonic_ns']
        previous = row
    assert (folder / 'payload.bin').read_bytes() == b'x' * 262144
    assert (folder / 'stdout.txt').read_bytes().strip() == b'synthetic-child-complete'
    assert not (folder / 'stderr.txt').read_bytes()
    for path in sorted(folder.iterdir()):
        assert path.is_file()
        add('native/' + name + '/' + path.name, path.read_bytes())

relative = 'tools/xtask-package-attribution-074/owned_process_observer.py'
current = (root / relative).read_bytes()
assert sha(current) == receipts[labels[-1]]['source'][relative]
initial = current.decode().replace(
    '        except BaseException as error:\n            try:\n                self.close()\n            except Exception as close_error:\n                error.add_note(f"attachment cleanup: {close_error}")\n            raise\n',
    '        except BaseException:\n            self.close()\n            raise\n')
initial = initial.replace('    except BaseException as error:\n        result["refusal"]',
                          '    except Exception as error:\n        result["refusal"]')
initial = initial.replace(
    '            try:\n                child.kill()\n                child.wait(timeout=5)\n            except Exception as error:\n                result["passed"] = False\n                result["cleanup_error"] = str(error)\n',
    '            child.kill()\n            child.wait(timeout=5)\n').encode()
assert sha(initial) == receipts[labels[1]]['source'][relative]
add('code/first-native-owned_process_observer.py', initial)
add('code/final-owned_process_observer.py', current)
test_name = 'tools/xtask-package-attribution-074/test_owned_process_observer.py'
test_raw = (root / test_name).read_bytes()
assert sha(test_raw) == receipts[labels[3]]['source'][test_name]
add('code/test_owned_process_observer.py', test_raw)
assert b'Ran 83 tests' in objects[members['checks/' + labels[3] + '/stderr.log']['sha256']]
protected = {
    'Cargo.toml': '18a8a27cf140a1d6eb31c8316ee39bb7d5832866a990346eee16cd0c30de344b',
    'Cargo.lock': 'd2c7736ebaa8381cece9162bbbf384db60c46111051e4e78e51d4bae12feaf5c',
    'docs/testing/performance/0.74/qualification-manifest.toml': '11917570528020b5e1eb275a5ad9509ba358e6a6ca044647d1235b685659b0bc',
    'tools/authority-storage-source-074/contract.rs': 'aefcd4f6a9ed0acc1e072225ea3ed4dda82d2d1ccda0ba4f22ca74459efa64c2'}
for name, expected in protected.items():
    raw = (root / name).read_bytes()
    assert sha(raw) == expected
    add('protected/' + name, raw)
add('retention/seal-owned-observer-20261025.py', Path(__file__).read_bytes())
index = dict(schema='hc074-owned-process-control-v1', members=members,
             protected_sha256=protected, model_cases=21, attribution_python_cases=83,
             synthetic_controls=2, target_dispatches=0, measurement_cohorts=0,
             first_outcomes_preserved=True, source_checks_or_windows_changed=False,
             cargo_dispatch_admission=False, full_package_pass=False,
             server=False, services=False, clocks=False, product_load=False,
             qualification=False, admission=False)
base.mkdir(exist_ok=False)
(base / 'objects').mkdir()
for digest, raw in objects.items():
    (base / 'objects' / digest).write_bytes(raw)
(base / 'index.json').write_bytes((json.dumps(index, indent=2, sort_keys=True) + '\n').encode())
(base / '.gitattributes').write_bytes(b'index.json text eol=lf\nobjects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n')
print(json.dumps(dict(index_sha256=sha((base / 'index.json').read_bytes()), members=len(members), objects=len(objects))))
