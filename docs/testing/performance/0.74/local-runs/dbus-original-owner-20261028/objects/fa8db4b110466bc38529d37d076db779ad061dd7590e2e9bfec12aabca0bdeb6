pub(super) struct Operation {
    pub(super) file: File,
    pub(super) deadline: u64,
}
impl Operation {
    pub(super) fn new() -> Result<Self> {
        let deadline = clock()?
            .checked_add(2_000_000_000)
            .ok_or(ChannelError::Context)?;
        let fd = unsafe {
            libc::timerfd_create(libc::CLOCK_BOOTTIME, libc::TFD_CLOEXEC | libc::TFD_NONBLOCK)
        };
        if fd < 0 {
            return Err(ChannelError::Io);
        }
        let file = unsafe { File::from_raw_fd(fd) };
        let spec = libc::itimerspec {
            it_interval: libc::timespec {
                tv_sec: 0,
                tv_nsec: 0,
            },
            it_value: libc::timespec {
                tv_sec: (deadline / 1_000_000_000) as _,
                tv_nsec: (deadline % 1_000_000_000) as _,
            },
        };
        if unsafe {
            libc::timerfd_settime(fd, libc::TFD_TIMER_ABSTIME, &spec, std::ptr::null_mut())
        } != 0
        {
            return Err(ChannelError::Io);
        }
        Ok(Self { file, deadline })
    }
}
