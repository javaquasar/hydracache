// D: budget guards only; the ambiguous path retains the exact S predictor.
impl CompressedStreamWriter {
    pub(crate) fn fits_budget_after<S: Serializable + ?Sized>(
        &mut self,
        item: &S,
        budget: usize,
    ) -> bool {
        let n = item.serialized_len();
        assert!(n > 0);
        let total = self.uncompressed_block.len() + n;
        let old = self.output.len()
            + total
            + if total > self.block_threshold { 6 } else { 3 }
            + 1;
        if old > budget {
            #[cfg(test)]
            inplace_review::record(2);
            return false;
        }
        assert!(self.block_threshold > 0);
        let conservative =
            self.output.len() + total + 3 * total.div_ceil(self.block_threshold) + 1;
        if conservative <= budget {
            #[cfg(test)]
            inplace_review::record(3);
            return true;
        }
        self.serialized_len_upperbound_after(item) <= budget
    }
}
