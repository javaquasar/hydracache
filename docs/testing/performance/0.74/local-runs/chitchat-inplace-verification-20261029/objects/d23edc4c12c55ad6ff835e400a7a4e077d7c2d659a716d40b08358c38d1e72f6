"""Retain current-source checks and exact original source-capsule containers."""
from pathlib import Path
import hashlib
import json
import subprocess

ROOT=Path(__file__).resolve().parent.parent
BASE=ROOT/'target/chitchat-inplace-20261029'
OUT=ROOT/'docs/testing/performance/0.74/local-runs/chitchat-inplace-verification-20261029'
sha=lambda raw:hashlib.sha256(raw).hexdigest()
(OUT/'objects').mkdir(exist_ok=False);members={}


def add(name,path):
    body=path.read_bytes();digest=sha(body);dest=OUT/'objects'/digest
    if dest.exists():assert dest.read_bytes()==body
    else:dest.write_bytes(body)
    assert name not in members;members[name]=dict(sha256=digest,bytes=len(body))


for path in sorted(OUT.iterdir()):
    if path.is_file():add('byte-verifier/'+path.name,path)
verified=json.loads((OUT/'stdout.log').read_bytes());assert verified['complete']
for mode in ('format-helpers','format-check','performance-contract','doc-check'):
    folder=BASE/'final-checks'/mode
    result=json.loads((folder/'result.json').read_bytes());assert result['complete']
    execution=json.loads((folder/'execution.json').read_bytes());assert execution['exit']==0 and execution['retired'] and not execution['errors']
    for path in sorted(folder.iterdir()):
        if path.is_file():add('checks/'+mode+'/'+path.name,path)
docs=json.loads((BASE/'final-checks/doc-check/intent.json').read_bytes())['documents']
for name,digest in docs.items():
    assert sha((ROOT/name).read_bytes())==digest
    add('documents/'+name,ROOT/name)
for context in ('native-copy-prepare','native-copy-portable-prepare'):
    result=json.loads((BASE/context/'result.json').read_bytes());archive=BASE/context/'source.zip'
    assert sha(archive.read_bytes())==result['archive_sha256']
    add('capsules/'+context+'/source.zip',archive)
for name in ('target/chitchat-inplace-final-20261029.py','target/verify-chitchat-inplace-20261029.py',
             'target/retain-chitchat-inplace-final-20261029.py'):
    add('source/'+name,ROOT/name)
index=dict(schema='hc074-chitchat-inplace-verification-v1',members=members,
    primary_index_sha256='9381608b814a7fcdc16835ece436534fc1d48f816039023f9c0adbc16a234fd1',
    source_head_observation=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip(),
    doc_check=True,formatting=True,performance_contract=True,primary_bytes_and_raw_logs_verified=True,
    original_capsule_container_bytes_retained=True,archived_code_executed=False,root_adopted=False,release_admitted=False)
(OUT/'index.json').write_text(json.dumps(index,indent=2,sort_keys=True)+'\n',encoding='utf8',newline='\n')
(OUT/'.gitattributes').write_text('* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\n',encoding='utf8',newline='\n')
for row in members.values():
    raw=(OUT/'objects'/row['sha256']).read_bytes();assert len(raw)==row['bytes'] and sha(raw)==row['sha256']
print(json.dumps(dict(members=len(members),objects=len(list((OUT/'objects').iterdir())),index_sha256=sha((OUT/'index.json').read_bytes()))))
