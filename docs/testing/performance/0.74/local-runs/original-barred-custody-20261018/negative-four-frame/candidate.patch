+    ) -> Result<
+        OriginalBarredCustody<'held, 'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
+        BarredCustodyFailure<'held, 'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
+    > {
+        self.prepare_barred_with(
+            #[cfg(test)]
+            0,
+            #[cfg(test)]
+            |_| {},
+        )
+    }
+    fn prepare_barred_with(
+        self,
+        #[cfg(test)] fault: u8,
+        #[cfg(test)] checkpoint: impl FnOnce(
+            &mut OriginalBarredCustody<'held, 'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
+        ),
+    ) -> Result<
+        OriginalBarredCustody<'held, 'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
+        BarredCustodyFailure<'held, 'join, 'storage, 'o, 't, 'r, 'c, 'b, 's, 'a, 'p>,
+    > {
+        let mut held = OriginalBarredCustody {
+            kernel: None,
+            plan: self,
+            ready: false,
+        };
+        let result = (|| {
+            if held.is_refused() {
+                return Err(BarredCustodyError::Refused);
+            }
+            if capture(held.plan.original)? != held.plan.inventory {
+                return Err(OriginalCustodyError::Binding.into());
+            }
+            held.plan.original.inspect_deadline()?;
+            held.kernel = Some(KernelCustodian::spawn(
+                [held.plan.inventory.fds[0], held.plan.inventory.fds[1]],
+                #[cfg(test)]
+                fault,
+            )?);
+            held.kernel
+                .as_ref()
+                .ok_or(BarredCustodyError::Child)?
+                .observe(held.plan.inventory.fds[1], true)?;
+            #[cfg(test)]
+            checkpoint(&mut held);
+            held.validate()?;
+            held.ready = true;
+            Ok(())
+        })();
+        match result {
+            Ok(()) => Ok(held),
+            Err(error) => {
+                held.plan.original.refuse();
+                Err(BarredCustodyFailure {
+                    error,
+                    held: Box::new(held),
+                })
+            }
+        }
+    }
+}
