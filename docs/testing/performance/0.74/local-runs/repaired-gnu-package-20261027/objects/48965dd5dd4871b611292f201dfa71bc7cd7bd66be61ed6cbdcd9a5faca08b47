"""Retain the distinct repaired GNU result and all first controls as data."""
import hashlib
import json
from pathlib import Path
import re

ROOT=Path(__file__).resolve().parent.parent
BASE=ROOT/'target/gnu-repaired-local-20261027'
OUT=ROOT/'docs/testing/performance/0.74/local-runs/repaired-gnu-package-20261027'
assert not OUT.exists()
(OUT/'objects').mkdir(parents=True)
members={}
def add(name,raw):
    digest=hashlib.sha256(raw).hexdigest()
    obj=OUT/'objects'/digest
    if obj.exists(): assert obj.read_bytes()==raw
    else: obj.write_bytes(raw)
    assert name not in members
    members[name]=dict(sha256=digest,bytes=len(raw))
def doc(name,value): add(name,(json.dumps(value,indent=2,sort_keys=True)+'\n').encode())
phases=['export-current','parser-build','syntax-capture','native-refresh-capture',
 'controls-windows-first','controls-native','controls-windows-corrected','review-native-first',
 'focused-native-capture','full-native-capture','check-native-capture','clippy-native-capture']
summary={}
for phase in phases:
    folder=BASE/phase
    result=json.loads((folder/'result.json').read_bytes())
    expected=1 if phase in ('controls-windows-first','full-native-capture') else 0
    assert result['exit']==expected and result['outer_refusal'] is None
    assert result['source_unchanged'] and result['commit_unchanged']
    summary[phase]={k:result[k] for k in ('exit','outer_refusal','source_unchanged','commit_unchanged','free_after')}
    for path in sorted(folder.rglob('*')):
        if path.is_file(): add('capture/'+phase+'/'+path.relative_to(folder).as_posix(),path.read_bytes())
for phase in ('native-refresh','syntax-current','focused','full','check','clippy'):
    for path in sorted((BASE/phase).rglob('*')):
        if path.is_file(): add('attempt/'+phase+'/'+path.relative_to(BASE/phase).as_posix(),path.read_bytes())
full=json.loads((BASE/'full/accounting.json').read_bytes())
assert (full['expected_targets'],full['completed_targets'],full['passed'],full['failed'],full['ignored'])==(155,155,1340,2,0)
assert full['complete'] and not full['package_pass'] and full['incomplete_target'] is None and not full['unstarted_targets']
controller=json.loads((BASE/'full/controller.json').read_bytes())
assert controller['retired'] and controller['classification']=='test-failure' and controller['exit']==101 and not controller['cleanup_errors']
failures=[]
text=(BASE/'full/stdout.log').read_text()
for name,block in re.findall(r'---- (.*?) stdout ----\n(.*?)(?=\n---- |\n\nfailures:)',text,re.S):
    starts=list(re.finditer(r"(?m)^thread '.* panicked at ",block))
    tail=block[starts[-1].start():] if starts else block
    failures.append(dict(case=name,terminal_lines=tail.splitlines()[:8],
        frontier_lines=[line for line in block.splitlines() if line.startswith('CURRENT_TREE_FRONTIER ')]))
doc('analysis/failures.json',failures)
for name in ('review.py','runner.py','test_runner.py','inputs.json','.gitattributes'):
    add('accepted-helper/'+name,(ROOT/'tools/package-repaired-gnu-074'/name).read_bytes())
data=json.loads((ROOT/'tools/package-repaired-gnu-074/inputs.json').read_bytes())
for name,expected in {**data['sources'],**data['auxiliary']}.items():
    raw=(ROOT/name).read_bytes()
    assert hashlib.sha256(raw.replace(b'\r\n',b'\n')).hexdigest()==expected
    add('fixture/'+name,raw)
source='fe4b3a0f9060615185895337181780a6f3f55439'
for name in ('intent.json','request.json','result.json'):
    add('transfer/'+name,(ROOT/'target/native-frontier-20261027'/source/name).read_bytes())
for name in ('run-repaired-gnu-local-20261027.py','capture-repaired-gnu-syntax-20261027.py',
 'refresh-repaired-gnu-native-20261027.py','build-repaired-gnu-review-data-20261027.py',
 'seal-repaired-gnu-20261027.py','read-repaired-gnu-failures-20261027.py'):
    add('local-helper/'+name,(ROOT/'target'/name).read_bytes())
doc('analysis/scope.json',dict(source=source,review_sources=391,auxiliary=58,targets=155,
    focused_passes=42,full_passes=1340,full_failures=2,full_package_pass=False,
    first_outcomes_retained=True,prior_gnu_result_unchanged=True,
    native_checkout_advanced_not_newly_cloned=True,old_checkout_directory_name_is_not_source_identity=True,
    scripts_perf_in_new_outer_map=True,all_live_checks_unchanged=True,original_windows_seconds=[300,60,10],
    qualification=False,product_load=False,services=False,clocks=False,server=False,release_admitted=False,
    phases=summary))
raw=(json.dumps(dict(schema='hc074-local-evidence-collection-v1',members=members,
    archived_code_executed=False,complete=True,package_pass=False,release_admitted=False),indent=2,sort_keys=True)+'\n').encode()
(OUT/'index.json').write_bytes(raw)
(OUT/'.gitattributes').write_text('objects/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof\nindex.json -text\n',encoding='utf-8',newline='\n')
print(dict(index_sha256=hashlib.sha256(raw).hexdigest(),members=len(members),objects=len(list((OUT/'objects').iterdir()))))
