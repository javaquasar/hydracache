 assert len(rows)==67 and sorted(n.decode() for n,s in rows)==listing['inventory'] and all(s==b'ok' for _,s in rows)
 line=[v.decode() for v in raw.splitlines() if v.startswith(b'HC074-REPLY-STATE ')];assert len(line)==1;models.append(line[0])
 assert 'seed=0740e518 sequences=512 random_steps=16384' in line[0]
