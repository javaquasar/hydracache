def project(name,raw):
 p.require(sha(raw)==PINS[name],'original source pin '+name)
 s=raw.decode();s=s.replace('zbus::zvariant::','zbus::wire::')
 for old,new in FLAGS.items():s=s.replace('Flags::'+old,'Flags::'+new)
 s=s.replace('zbus::message::Flags::NO_REPLY_EXPECTED as u8','zbus::message::Flags::NO_REPLY_EXPECTED.bits()')
 if name.endswith('_exchange_tests.rs'):
  for module in ('socket','negotiated'):
   route=f'#[path = "diagnostic_dispatch_{"exchange_socket" if module=="socket" else "negotiated"}_tests.rs"]\nmod {module}_tests;\n'
   p.require(s.count(route)==1,'excluded transport route');s=s.replace(route,'',1)
 # Remove only eager builder-result unwraps. Tokenize strings atomically so
 # parentheses inside paths/signatures cannot affect the matching call.
 tokens=list(re.finditer(r'"(?:\\.|[^"\\])*"|[A-Za-z_][A-Za-z_0-9]*|[^\s]',s))
 edits=[];setters={'method_call','method_return','error','destination','sender','interface','path','member','with_flags'}
 for i,t in enumerate(tokens):
  if t.group()!='unwrap' or i<2 or [x.group() for x in tokens[i-1:i+3]]!=['.','unwrap','(',')'] or tokens[i-2].group()!=')':continue
  depth=1;j=i-3
  while j>=0 and depth:
   depth+=(tokens[j].group()==')')-(tokens[j].group()=='(');j-=1
  if j>=0 and tokens[j].group() in setters:edits.append((tokens[i-1].start(),tokens[i+2].end()))
 for a,b in reversed(edits):s=s[:a]+s[b:]
 return s.encode(),len(edits)

