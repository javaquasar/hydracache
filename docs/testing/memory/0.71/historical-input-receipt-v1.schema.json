{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydracache.dev/schemas/0.71/historical-input-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "branch", "tag", "commit", "checkout_clean", "files", "mirror"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "const": "0.71" },
    "branch": { "const": "explore/0.67-telemetry-hazelcast" },
    "tag": { "const": "explore-0.67-telemetry-20260803" },
    "commit": { "const": "dbc2f82f7f303528b3cca7842818730c82232b9c" },
    "checkout_clean": { "const": true },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "object_id", "archive_sha256", "byte_length", "manifest_sha256", "restored_manifest_sha256", "verified_at", "retention_deadline"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "object_id": { "type": "string", "minLength": 1 },
        "archive_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "restored_manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "verified_at": { "type": "string", "format": "date-time" },
        "retention_deadline": { "type": "string", "format": "date-time" }
      }
    }
  }
}
