{
  "name": "hydracache-management-console",
  "version": "0.72.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node ./scripts/embed-dist.mjs && node ./scripts/check-static.mjs",
    "serve": "node ./scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src ./vite.config.ts",
    "test:unit": "vitest run",
    "test:canary:w4": "vitest run src/history.test.ts -t \"collection pauses while hidden or offline\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config ./playwright.config.mjs",
    "unit": "npm run typecheck && npm run lint && npm run test:unit && npm run supply-chain && node --test ./tests/package.test.js",
    "test": "npm run build && npm run unit && npm run test:e2e",
    "supply-chain": "node ./scripts/check-supply-chain.mjs",
    "package": "npm run build && npm run supply-chain && node ./scripts/package-management-center.mjs package",
    "verify-package": "node ./scripts/package-management-center.mjs verify"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "happy-dom": "20.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
